        <Item class="ModuleScript" referent="ROJO_295">
          <Properties>
            <string name="Name">Audio</string>
            <string name="Source">local Root=game.ReplicatedStorage.FlyFightPaper
local Sounds=game:GetService("SoundService")
local Audio={}
local definitions={
 pellet={"action_jump_land.mp3",2.1,.1},staple={9113075143,1,.45},rubber={"action_swim.mp3",2.6,.1},
 paperclip={9116163687,1.25,.5},eraser={"impact_water.mp3",1.3,.5},pencil={"impact_explosion_03.mp3",1.8,.15},
 lock={"volume_slider.ogg",1.2,.5},lockbeep={"volume_slider.ogg",2.4,.3},incoming={"volume_slider.ogg",.9,.5},nearmiss={"action_swim.mp3",2.2,.12},empty={"action_falling.ogg",1.4,.15},
 fan={"action_swim.mp3",1.4,.2},land={"action_jump_land.mp3",1,.25},service={"volume_slider.ogg",1.9,.2},
 death={"action_jump_land.mp3",1.5,.35},hit={"volume_slider.ogg",3,.35},windup={"action_falling.ogg",2.2,.2},kill={"impact_explosion_03.mp3",2.4,.3},start={"volume_slider.ogg",2.2,.25},finish={"volume_slider.ogg",.7,.3},purchase={"volume_slider.ogg",2.6,.2},
}
local pool,available,busy={},{},{}
function Audio.play(name)
 local definition=definitions[name];if not definition then return end
 local sound=table.remove(available)
 if not sound then
  if #pool&gt;=16 then return end
  sound=Instance.new("Sound");sound.Parent=Sounds;table.insert(pool,sound)
 end
 -- A number is a Creator Store sound (paperclip: Pro Sound Effects "Key Dings Metal Clinking 11", a ting; staple: "Air Stapler Gun 2").
 sound.SoundId=type(definition[1])=="number" and "rbxassetid://"..definition[1] or "rbxasset://sounds/"..definition[1];sound.PlaybackSpeed=definition[2];sound.Volume=definition[3]*(Root:GetAttribute("SoundVolume") or 1)
 local token={};busy[sound]=token;sound:Play()
 task.delay((name=="death" or name=="eraser" or name=="paperclip") and .6 or .22,function()if busy[sound]==token then sound:Stop();busy[sound]=nil;table.insert(available,sound) end end)
end
function Audio.start(getPlane)
 local ambience=Instance.new("Sound");ambience.Name="ClassroomAmbience";ambience.SoundId="rbxasset://sounds/action_footsteps_plastic.mp3";ambience.PlaybackSpeed=.55;ambience.Looped=true;ambience.Volume=.015;ambience.Parent=Sounds;ambience:Play()
 -- Background music: a shuffled playlist of free APM tracks licensed for Roblox games (Alan: faster, playful, a
 -- playlist). Add or remove ids here. The Music slider sets it; the classroom hum follows the Sound slider.
 local playlist={1844592742,1836626222,1842246698,1842172723} -- Action Kids, Frisky, Funky Thing, Disguise
 for i=#playlist,2,-1 do local j=math.random(i);playlist[i],playlist[j]=playlist[j],playlist[i] end
 local music=Instance.new("Sound");music.Name="Music";music.Parent=Sounds
 local track=0
 local function nextTrack() track=track%#playlist+1;music.SoundId="rbxassetid://"..playlist[track];music:Play() end
 music.Ended:Connect(nextTrack)
 -- Volume glides to the slider's value (a quarter second), so a jump from 0 to 100% fades instead of blasting.
 local glide=TweenInfo.new(.25)
 local function volumes()
  game:GetService("TweenService"):Create(ambience,glide,{Volume=.015*(Root:GetAttribute("SoundVolume") or 1)}):Play()
  game:GetService("TweenService"):Create(music,glide,{Volume=.2*(Root:GetAttribute("MusicVolume") or 1)}):Play()
 end
 Root:GetAttributeChangedSignal("MusicVolume"):Connect(volumes);Root:GetAttributeChangedSignal("SoundVolume"):Connect(volumes)
 volumes();nextTrack()
 local lastPhase
 local Players=game:GetService("Players")
 Players.LocalPlayer:GetAttributeChangedSignal("MenuMessage"):Connect(function()
  local value=Players.LocalPlayer:GetAttribute("MenuMessage") or ""
  if value:find("Purchased") or value:find("simulation complete") or value:find("Part unlocked") then Audio.play("purchase") end
 end)
 Root:WaitForChild("RoundView").OnClientEvent:Connect(function(s)
  if s.phase~=lastPhase then if s.phase=="ACTIVE" then Audio.play("start") elseif s.phase=="RESULTS" then Audio.play("finish") end;lastPhase=s.phase end
 end)
 local function combat(events)
  for _,event in ipairs(events) do
   -- Own shots already played on the click frame (except erasers, which wait for the server).
   local own=event.owner==tostring(Players.LocalPlayer.UserId) and event.weapon~="eraser"
   if event.kind=="shot" and not own and (event.position-workspace.CurrentCamera.CFrame.Position).Magnitude&lt;250 then Audio.play(event.weapon)
   elseif event.kind=="death" and (event.position-workspace.CurrentCamera.CFrame.Position).Magnitude&lt;300 then Audio.play("death") end
  end
 end
 Root:WaitForChild("CombatEvents").OnClientEvent:Connect(combat)
 Root:WaitForChild("CombatCosmetics").OnClientEvent:Connect(combat)
 Players.LocalPlayer:GetAttributeChangedSignal("NearMissAt"):Connect(function() Audio.play("nearmiss") end)
 local state,life,lift,lock,incoming,message,beepAt,lockBeepAt
 game:GetService("RunService").Heartbeat:Connect(function()
  local p=getPlane();if not p or not p.Parent then return end
  local nextState=p:GetAttribute("State");local nextLift=p:GetAttribute("Lift");local nextLock=p:GetAttribute("LockProgress");local nextIncoming=math.max(p:GetAttribute("IncomingLockUntil") or 0,p:GetAttribute("EraserIncomingUntil") or 0)&gt;workspace:GetServerTimeNow()
  if life==p:GetAttribute("Life") then
   if nextState=="FLYING" and lift and nextLift&gt;lift+10 then Audio.play("fan") elseif lift and lift&gt;0 and nextLift&lt;=0 then Audio.play("empty") end
   if state=="LANDING" and nextState=="DESK" then Audio.play("land") end
   if lock and lock&lt;1 and nextLock and nextLock&gt;=1 then Audio.play("lock") end
   -- Beeps while the eraser is locking, faster as it gets closer.
   if nextLock and nextLock&gt;0 and nextLock&lt;1 and os.clock()-(lockBeepAt or 0)&gt;.3-.2*nextLock then Audio.play("lockbeep");lockBeepAt=os.clock() end
   -- A locked-on eraser warns with a repeating beep until the lock breaks.
   if nextIncoming and (not incoming or os.clock()-beepAt&gt;.35) then Audio.play("incoming");beepAt=os.clock() end
   local nextMessage=p:GetAttribute("Message")
   if message~=nextMessage and nextMessage and nextMessage:find("complete") then Audio.play("service") end
   message=nextMessage
  end
  state,life,lift,lock,incoming=nextState,p:GetAttribute("Life"),nextLift,nextLock,nextIncoming
 end)
end
return Audio
</string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="ROJO_296">
          <Properties>
            <string name="Name">Bootstrap</string>
            <string name="Source">-- Synced from src/client by default.project.json.
local Players = game:GetService("Players")
local Root = game:GetService("ReplicatedStorage"):WaitForChild("FlyFightPaper")
require(script.Parent.Loading).show()
local loadingEvents={Root:WaitForChild("RoundView").OnClientEvent:Connect(function()end),Root:WaitForChild("CombatEvents").OnClientEvent:Connect(function()end),Root:WaitForChild("CombatCosmetics").OnClientEvent:Connect(function()end)}
require(script.Parent.Loading).run()
require(script.Parent.FanSpin).start()
require(script.Parent.DeskPieces).start()
require(script.Parent.TowerClock).start()
task.spawn(require(script.Parent.SpeedPickups).start)
require(script.Parent.FanWind).start()
local Flight = require(script.Parent.FlightController)
local Camera = require(script.Parent.ChaseCamera)
local HUD = require(script.Parent.FlightHUD)
local planes = workspace:WaitForChild("Planes")
local Menu=require(script.Parent.MenuController)
Menu.start()
local action = Root:WaitForChild("FlightAction")
local plane, stopFlight
local function attach(model)
 if model.Name ~= tostring(Players.LocalPlayer.UserId) then return end
 if stopFlight then stopFlight() end
 plane = model
 model:WaitForChild("Root")
 stopFlight = Flight.start(model)
end
planes.ChildAdded:Connect(attach)
for _, model in ipairs(planes:GetChildren()) do attach(model) end
Camera.start(function() return plane end)
HUD.start(function() return plane end, function(name,value) action:FireServer(name,value) end)
local effects=require(script.Parent.CombatEffects).start(function() return plane end)
require(script.Parent.CombatController).start(function() return plane end,effects)
require(script.Parent.Audio).start(function()return plane end)
require(script.Parent.Tutorial).start(function()return plane end)
require(script.Parent.DevTools).start(Menu)
for _,connection in ipairs(loadingEvents) do connection:Disconnect() end
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ROJO_297">
          <Properties>
            <string name="Name">ChaseCamera</string>
            <string name="Source">-- Chase camera for mouse-aim: looks along the aim, sits behind the plane, never leaves the room.
local RunService = game:GetService("RunService")
local Root = game:GetService("ReplicatedStorage"):WaitForChild("FlyFightPaper")
local FlightState = require(script.Parent.FlightController).state
local Camera = {}

-- Feel tuning. Position follows a bit slower than rotation so turns read as motion.
local DISTANCE, HEIGHT, LOOK_AHEAD = 24, 6, 60
local POSITION_RESPONSE, ROTATION_RESPONSE = 9, 16
local BASE_FOV, MAX_EXTRA_FOV, FOV_RESPONSE = 72, 12, 4
local SHAKE_ON_HIT, SHAKE_ON_NEAR_MISS, SHAKE_DECAY = 0.6, 0.3, 3

local function smooth(rate, dt)
	return 1 - math.exp(-rate * dt)
end

local function speedLines()
	local part = Instance.new("Part")
	part.Name = "SpeedLines"
	part.Anchored, part.CanCollide, part.CanQuery, part.CanTouch, part.CastShadow = true, false, false, false, false
	part.Transparency, part.Size = 1, Vector3.new(36, 24, 1)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Shape, emitter.ShapeStyle = Enum.ParticleEmitterShape.Box, Enum.ParticleEmitterShapeStyle.Volume
	emitter.EmissionDirection = Enum.NormalId.Back
	emitter.Orientation = Enum.ParticleOrientation.VelocityParallel
	emitter.Speed, emitter.Lifetime = NumberRange.new(140, 180), NumberRange.new(0.18, 0.25)
	emitter.Size = NumberSequence.new(0.06)
	emitter.Squash = NumberSequence.new(4)
	emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.3, 0.55), NumberSequenceKeypoint.new(1, 1) })
	emitter.LightEmission, emitter.Rate = 0.4, 0
	emitter.Parent = part
	return part, emitter
end

function Camera.start(getPlane)
	local position, look, up
	local previousHealth, previousLife, shake, fov = 0, nil, 0, BASE_FOV
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { workspace:FindFirstChild("Arena") or workspace:WaitForChild("GreyboxRoom") }
	params.RespectCanCollide = true
	local lines, emitter = speedLines()
	-- A smaller shake when an enemy shot passes close by.
	game:GetService("Players").LocalPlayer:GetAttributeChangedSignal("NearMissAt"):Connect(function()
		shake = math.max(shake, SHAKE_ON_NEAR_MISS)
	end)
	RunService:BindToRenderStep("PlaneCamera", Enum.RenderPriority.Camera.Value + 1, function(dt)
		local plane = getPlane()
		local body = plane and plane.Parent and plane:FindFirstChild("Root")
		local camera = workspace.CurrentCamera
		if not body then lines.Parent = nil; return end
		camera.CameraType = Enum.CameraType.Scriptable
		-- The camera rolls with the aim, so it stays behind the pilot through loops and inverted flight.
		local aim = FlightState.aim or body.CFrame.LookVector
		local aimUp = FlightState.aimUp or Vector3.yAxis
		local focus = body.Position + aimUp * 2
		if not position then position, look, up = focus - aim * DISTANCE + aimUp * HEIGHT, aim, aimUp end
		up = up:Lerp(aimUp, smooth(ROTATION_RESPONSE, dt)).Unit
		local desired = focus - aim * DISTANCE + up * HEIGHT
		if (desired - position).Magnitude &gt; 150 then position, look = desired, aim end
		position = position:Lerp(desired, smooth(POSITION_RESPONSE, dt))
		look = look:Lerp(aim, smooth(ROTATION_RESPONSE, dt)).Unit
		-- Pull in when a wall or building sits between the plane and the camera.
		local offset = position - focus
		local hit = offset.Magnitude &gt; 0.1 and workspace:Spherecast(focus, 1.5, offset, params)
		local final = hit and focus + offset.Unit * math.max(2, hit.Distance - 0.5) or position
		local health = plane:GetAttribute("Health") or 0
		if previousLife == plane:GetAttribute("Life") and health &lt; previousHealth then shake = SHAKE_ON_HIT end
		previousLife, previousHealth = plane:GetAttribute("Life"), health
		shake = math.max(0, shake - SHAKE_DECAY * dt)
		local jitter = CFrame.identity
		if shake &gt; 0 and not Root:GetAttribute("ReducedShake") then
			local t = os.clock() * 40
			jitter = CFrame.Angles(math.noise(t, 1) * shake * 0.05, math.noise(t, 2) * shake * 0.05, 0)
		end
		camera.CFrame = CFrame.lookAt(final, focus + look * LOOK_AHEAD, up) * jitter
		-- Wider view and speed lines when faster than cruise (boost, speed power-ups, dives).
		local cruise = math.max(1, plane:GetAttribute("Speed") or 1)
		local overspeed = plane:GetAttribute("State") == "FLYING" and math.clamp(body.AssemblyLinearVelocity.Magnitude / cruise - 1, 0, 0.4) / 0.4 or 0
		fov += (BASE_FOV + MAX_EXTRA_FOV * overspeed - fov) * smooth(FOV_RESPONSE, dt)
		camera.FieldOfView = fov
		emitter.Rate = overspeed &gt; 0.15 and 60 * overspeed or 0
		lines.CFrame = camera.CFrame * CFrame.new(0, 0, -30)
		lines.Parent = camera
	end)
end
return Camera
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ROJO_298">
          <Properties>
            <string name="Name">CombatController</string>
            <string name="Source">local Players=game:GetService("Players")
local Input=game:GetService("UserInputService")
local Run=game:GetService("RunService")
local RS=game:GetService("ReplicatedStorage")
local Root=RS:WaitForChild("FlyFightPaper")
local Controller={}
function Controller.start(getPlane,effects)
 local remote=Root:WaitForChild("CombatInput")
 local held={false,false};local seq,life,clock=0,nil,0
 local function groupFor(input)
  if input.UserInputType==Enum.UserInputType.MouseButton1 or input.KeyCode==Enum.KeyCode.ButtonR2 then return 1 end
  if input.UserInputType==Enum.UserInputType.MouseButton2 or input.KeyCode==Enum.KeyCode.ButtonL2 then return 2 end
 end
 local function send(which)
  local p=getPlane();if not p or not p.Parent or p:GetAttribute("State")~="FLYING" then return end
  if life~=p:GetAttribute("Life") then life=p:GetAttribute("Life");seq=0 end
  local body=p:FindFirstChild("Root");if not body then return end
  seq+=1
  remote:FireServer({group=which,down=held[which] and not Root:GetAttribute("OverlayOpen"),direction=effects.aim(body,which),at=workspace:GetServerTimeNow(),life=life,seq=seq})
 end
 Input.InputBegan:Connect(function(input,processed)
  if processed or Input:GetFocusedTextBox() or Root:GetAttribute("OverlayOpen") then return end
  local which=groupFor(input)
  if which then held[which]=true;effects.press(which,true);send(which) end
 end)
 Input.InputEnded:Connect(function(input)
  local which=groupFor(input)
  if which then held[which]=false;effects.press(which,false);send(which) end
 end)
 Input.WindowFocusReleased:Connect(function()held={false,false};effects.press(1,false);effects.press(2,false);send(1);send(2)end)
 -- While firing, refresh the aim 30 times a second: the server fires each round along the latest aim it has,
 -- and a 0.1 s old aim misses a turning plane at range. Idle triggers resync 10 times a second.
 Run.Heartbeat:Connect(function(dt)
  clock+=dt
  local firing=held[1] or held[2]
  if clock&gt;=(firing and 1/30 or .1) then
   clock=0
   for which=1,2 do if held[which] or not firing then send(which) end end
  end
 end)
end
return Controller
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ROJO_299">
          <Properties>
            <string name="Name">CombatEffects</string>
            <string name="Source">local RS=game:GetService("ReplicatedStorage")
local Run=game:GetService("RunService")
local Players=game:GetService("Players")
local Tween=game:GetService("TweenService")
local Root=RS:WaitForChild("FlyFightPaper")
local Fans=require(Root.Generated.Gameplay).world.fans
local Catalog=require(Root.Shared.Catalog).new(require(Root.Generated.Catalog),require(Root.Generated.Gameplay))
local Rules=require(Root.Shared.CombatRules)
local Config=require(Root.Generated.Gameplay).combat
local Aircraft=require(Root.Shared.Aircraft)
local Audio=require(script.Parent.Audio)
local FlightState=require(script.Parent.FlightController).state
local assist=math.cos(math.rad(require(Root.Generated.Gameplay).combat.gun_assist_deg))
local convergence=require(Root.Generated.Gameplay).combat.gun_convergence_studs
local Effects={}
-- Gun assist: when the nose is within a few degrees of the lead marker, shots go to the marker.
-- The nose always trails a moving aim slightly; this closes that gap. The server allows the same leeway.
function Effects.aim(body,weapon)
 local leadFor=FlightState.leadFor
 if leadFor and weapon then
  local direction=(leadFor(weapon)-body.Position).Unit
  if body.CFrame.LookVector:Dot(direction)&gt;=assist then return direction end
 end
 return body.CFrame.LookVector
end
local colors={pellet=Color3.fromRGB(255,240,170),staple=Color3.fromRGB(220,230,240),rubber=Color3.fromRGB(250,180,100),paperclip=Color3.fromRGB(125,225,255),eraser=Color3.fromRGB(255,145,175),pencil=Color3.fromRGB(255,210,70)}
function Effects.start(getPlane)
 local folder=Instance.new("Folder");folder.Name="CombatEffects";folder.Parent=workspace
 local pool,active={},{}
 local created,activeCount=0,0
 local equipment=Root.Assets:FindFirstChild("EquipmentParts")
 local function acquire(weapon)
  local kind=weapon or "paper"
  pool[kind]=pool[kind] or {}
  local cap=Root:GetAttribute("Quality")=="Low" and 64 or Root:GetAttribute("Quality")=="Medium" and 128 or 256
  if activeCount&gt;=cap then return nil end
  if #pool[kind]&gt;0 then activeCount+=1;local p=table.remove(pool[kind]);p.Transparency=0;return p end
  if created&gt;=cap then
   -- A full pool of another projectile type must not silence this weapon's visuals.
   for _,free in pairs(pool) do if #free&gt;0 then table.remove(free):Destroy();created-=1;break end end
   if created&gt;=cap then return nil end
  end
  created+=1;activeCount+=1
  local look=Aircraft.shotLook(weapon)
  local template=look or weapon and equipment and equipment:FindFirstChild("ammo_"..weapon)
  local p=template and template.MeshId~="" and template:Clone() or Instance.new("Part")
  p:SetAttribute("OwnLook",look~=nil)
  p:SetAttribute("EffectKind",kind);p:SetAttribute("EffectRotation",template and template.CFrame.Rotation or CFrame.identity)
  p.Name="ShotVisual";p.Anchored=true;p.CanCollide=false;p.CanQuery=false;p.CanTouch=false;p.CastShadow=false
  local start=Instance.new("Attachment");start.Name="StreakStart";start.Parent=p
  local finish=Instance.new("Attachment");finish.Name="StreakEnd";finish.Parent=p
  local beam=Instance.new("Beam");beam.Name="Streak";beam.Attachment0=start;beam.Attachment1=finish;beam.FaceCamera=true
  beam.LightEmission=1;beam.Width0=.5;beam.Width1=.15;beam.Enabled=false;beam.Parent=p
  return p
 end
 local function release(id)
  local shot=active[id];if not shot then return end
  shot.part.Streak.Enabled=false;shot.part.Parent=nil;table.insert(pool[shot.part:GetAttribute("EffectKind")],shot.part);active[id]=nil;activeCount-=1
 end
 -- Paper shreds and dust puffs: a few pooled emitters moved to each impact and fired with Emit().
 local function emitter(name,texture,color,lifetime,speed)
  local e=Instance.new("ParticleEmitter");e.Name=name;e.Texture=texture;e.Color=ColorSequence.new(color)
  e.Lifetime=lifetime;e.Speed=speed;e.SpreadAngle=Vector2.new(180,180);e.Rate=0;e.LightInfluence=1
  return e
 end
 local function sizes(e,from,to) e.Size=NumberSequence.new({NumberSequenceKeypoint.new(0,from),NumberSequenceKeypoint.new(1,to)}) end
 local function shredEmitter()
  local e=emitter("Shreds","rbxasset://textures/particles/SquareParticle.png",Color3.fromRGB(246,243,230),NumberRange.new(.6,1.2),NumberRange.new(12,30))
  e.Squash=NumberSequence.new(.6);e.Rotation=NumberRange.new(0,360);e.RotSpeed=NumberRange.new(-420,420)
  e.Acceleration=Vector3.new(0,-35,0);e.Drag=3;sizes(e,.45,.3)
  e.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,0),NumberSequenceKeypoint.new(.8,0),NumberSequenceKeypoint.new(1,1)})
  return e
 end
 local function puffEmitter(color)
  local e=emitter("Puff","rbxasset://textures/particles/smoke_main.dds",color,NumberRange.new(.35,.6),NumberRange.new(4,10))
  e.Drag=4;sizes(e,1,4);e.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,.35),NumberSequenceKeypoint.new(1,1)})
  return e
 end
 local bursts,burstIndex={},0
 for i=1,8 do
  local a=Instance.new("Attachment");a.Name="CombatBurst";a.Parent=workspace.Terrain
  shredEmitter().Parent=a;puffEmitter(Color3.fromRGB(225,220,205)).Parent=a;bursts[i]=a
 end
 local function burst(position,shreds,puffs,scale)
  if not position or (position-workspace.CurrentCamera.CFrame.Position).Magnitude&gt;700 then return end
  if Root:GetAttribute("Quality")=="Low" then shreds=math.ceil(shreds/2) end
  burstIndex=burstIndex%#bursts+1;local a=bursts[burstIndex];a.WorldPosition=position
  sizes(a.Shreds,.45*scale,.3*scale);sizes(a.Puff,scale,4*scale)
  if shreds&gt;0 then a.Shreds:Emit(shreds) end
  if puffs&gt;0 then a.Puff:Emit(puffs) end
 end
 local feed={}
 local myId=tostring(Players.LocalPlayer.UserId)
 -- Damage direction: a red bar on a ring around the screen centre, on the side the shot came from.
 local function incoming(gui,attackerId)
  local attacker=workspace:FindFirstChild("Planes") and workspace.Planes:FindFirstChild(attackerId)
  local root=attacker and attacker:FindFirstChild("Root");if not root then return end
  local camera=workspace.CurrentCamera.CFrame
  local offset=camera:VectorToObjectSpace(root.Position-camera.Position)
  local angle=(math.abs(offset.X)+math.abs(offset.Y)&lt;1e-3) and math.pi or math.atan2(offset.X,offset.Y)
  local bar=Instance.new("Frame");bar.Name="DamageDirection";bar.AnchorPoint=Vector2.new(.5,.5);bar.BorderSizePixel=0
  bar.Size=UDim2.fromOffset(70,10);bar.BackgroundColor3=Color3.fromRGB(255,70,60);bar.Rotation=math.deg(angle)
  bar.Position=UDim2.new(.5,math.sin(angle)*190,.5,-math.cos(angle)*190);bar.Parent=gui
  Tween:Create(bar,TweenInfo.new(.9),{BackgroundTransparency=1}):Play()
  game:GetService("Debris"):AddItem(bar,1)
 end
 -- Hit marker: a white X on the nose dot for each confirmed hit; a bigger red X for a kill.
 local function marker(gui,kill)
  local nose=gui:FindFirstChild("NoseDot");local x=gui:FindFirstChild("HitMarker")
  if not x then
   x=Instance.new("Frame");x.Name="HitMarker";x.AnchorPoint=Vector2.new(.5,.5);x.BackgroundTransparency=1;x.Parent=gui
   for i,angle in ipairs({45,-45}) do
    local bar=Instance.new("Frame");bar.Name="Bar"..i;bar.AnchorPoint=Vector2.new(.5,.5);bar.Position=UDim2.fromScale(.5,.5)
    bar.Size=UDim2.new(1,0,0,3);bar.Rotation=angle;bar.BorderSizePixel=0;bar.Parent=x
   end
  end
  x.Position=nose and nose.Position or UDim2.fromScale(.5,.5);x.Size=UDim2.fromOffset(kill and 40 or 22,kill and 40 or 22)
  for _,bar in ipairs(x:GetChildren()) do
   bar.BackgroundColor3=kill and Color3.fromRGB(255,80,70) or Color3.new(1,1,1);bar.BackgroundTransparency=0
   Tween:Create(bar,TweenInfo.new(kill and .5 or .18),{BackgroundTransparency=1}):Play()
  end
 end
 local function notify(event)
  if event.kind=="hit" then
   -- Bigger hits tear off more paper: a pellet a few scraps, a pencil a shower.
   burst(event.position,math.clamp(math.floor(3+event.damage/2),3,30),event.damage&gt;=20 and 2 or 1,event.damage&gt;=20 and 1.6 or 1)
  elseif event.kind=="death" then burst(event.position,60,8,2.2) end
  local gui=Players.LocalPlayer.PlayerGui:FindFirstChild("FlightHUD");if not gui then return end
  if event.kind=="hit" and event.owner==myId then
   marker(gui,false);Audio.play("hit")
  elseif event.kind=="hit" and event.target==myId then
   incoming(gui,event.owner)
  elseif event.kind=="death" or event.kind=="prop" then
   if event.kind=="death" then
   if event.killerId==myId then marker(gui,true);Audio.play("kill") end
   table.insert(feed,1,event.killer and (event.killer.." &gt; "..event.victim) or (event.victim.." lost a plane"))
   while #feed&gt;4 do table.remove(feed) end
   local text=gui:FindFirstChild("KillFeed");if text then text.Text=table.concat(feed,"\n") end
   end
  end
 end
 local function drawShot(id,weapon,position,direction,speed,expires,time,enemy)
  local part=acquire(weapon)
  if not part then return end
  -- Erasers are missiles: drawn big, with a smoke trail, so everyone can see one coming.
  local row=Catalog:get(weapon);local missile=row and row.homing
  if missile and not part:FindFirstChild("Smoke") then
   local smoke=puffEmitter(Color3.fromRGB(240,236,228));smoke.Name="Smoke";smoke.Rate=70;smoke.Speed=NumberRange.new(1,3)
   smoke.Lifetime=NumberRange.new(.7,1.1);sizes(smoke,1.2,3.5);smoke.Parent=part
  end
  if part:IsA("MeshPart") then
   part.Size=Aircraft.shotSize(weapon,missile,part:GetAttribute("OwnLook") and Aircraft.shotLook(weapon))
   if not part:GetAttribute("OwnLook") then part.Material=Enum.Material.SmoothPlastic;part.Color=Color3.new(1,1,1) end
  else part.Material=Enum.Material.Neon;part.Color=colors[weapon];part.Size=Vector3.new(.14,.14,4) end
  part.Parent=folder
  local rotation=part:GetAttribute("EffectRotation") or CFrame.identity
  local length=math.clamp(speed*.018,8,24)
  part.StreakEnd.Position=rotation:VectorToObjectSpace(Vector3.new(0,0,length))
  part.Streak.Color=ColorSequence.new(colors[weapon]);part.Streak.Enabled=true
  active[id]={part=part,position=position,direction=direction,speed=speed,expires=expires,time=time,homing=missile,ballistic=row and not missile and row or nil,flown=0,wobble=row and row.wobble_studs or 0,enemy=enemy}
 end
 local function hostile(ownerId)
  local mine=workspace.Planes:FindFirstChild(myId);local other=workspace.Planes:FindFirstChild(ownerId)
  local team=mine and mine:GetAttribute("Team") or ""
  return ownerId~=myId and (team=="" or not other or other:GetAttribute("Team")~=team)
 end
 local function receive(events)
  for _,event in ipairs(events) do
   if event.kind=="shot" then
    if event.owner==myId and event.weapon=="eraser" then Players.LocalPlayer:SetAttribute("EraserAwayAt",os.clock()) end
    -- The shooter already drew its own shots on the click frame (erasers wait for the server's lock check).
    if event.owner~=myId or event.weapon=="eraser" then drawShot(event.id,event.weapon,event.position,event.direction,event.speed,event.expires,event.time,hostile(event.owner)) end
   elseif event.kind=="end" then
    local shot=active[event.id]
    if shot and event.wall then burst(event.position,2,2,.8) end
    if shot then
     -- A close hit can be received in the same packet as its shot. Give its trail one visible pulse.
     shot.position=event.position;shot.time=workspace:GetServerTimeNow();shot.speed=0;shot.ballistic=nil;shot.expires=shot.time+.08
    end
   elseif event.kind=="update" and active[event.id] then
    local shot=active[event.id];shot.position=event.position;shot.direction=event.direction;shot.flown=event.flown or shot.flown;shot.time=event.time
   else notify(event) end
  end
 end
 Root:WaitForChild("CombatEvents").OnClientEvent:Connect(receive)
 Root:WaitForChild("CombatCosmetics").OnClientEvent:Connect(receive)
 local nearMissAt=0
 Run.RenderStepped:Connect(function()
  local now=workspace:GetServerTimeNow()
  local me=workspace.Planes:FindFirstChild(myId);local body=me and me:GetAttribute("State")=="FLYING" and me:FindFirstChild("Root")
  for id,shot in pairs(active) do
   if now&gt;=shot.expires then release(id)
   else
    local elapsed=math.max(0,now-shot.time)
    local speed=shot.homing and Rules.eraserSpeed(shot.speed,shot.flown,Config) or shot.speed
    local position=shot.follow and shot.follow.CFrame:PointToWorldSpace(shot.offset) or shot.ballistic and shot.position+Rules.shotOffset(shot.ballistic,shot.direction,elapsed) or shot.position+shot.direction*speed*(shot.homing and math.min(elapsed,.5) or elapsed)
    if shot.homing then shot.flown+=(position-shot.position).Magnitude;shot.position=position;shot.time=now end
    -- Near miss: an enemy shot passing within a few studs this frame shakes the camera and whooshes.
    if shot.enemy and body and not shot.passed and shot.last then
     local step=position-shot.last;local rel=body.Position-shot.last
     local along=step.Magnitude&gt;0 and math.clamp(rel:Dot(step.Unit),0,step.Magnitude) or 0
     if (rel-(step.Magnitude&gt;0 and step.Unit*along or Vector3.zero)).Magnitude&lt;12 then
      shot.passed=true
      if os.clock()-nearMissAt&gt;.25 then nearMissAt=os.clock();Players.LocalPlayer:SetAttribute("NearMissAt",nearMissAt) end
     end
    end
    shot.last=position
    if shot.wobble and shot.wobble&gt;0 then position+=CFrame.lookAt(Vector3.zero,shot.direction).RightVector*math.sin(elapsed*40)*shot.wobble end
    shot.part.CFrame=CFrame.lookAt(position,position+shot.direction)*(shot.part:GetAttribute("EffectRotation") or CFrame.identity)
   end
  end
 end)
 local fanClock=0
 Run.Heartbeat:Connect(function(dt)
  fanClock+=dt;if fanClock&lt;.25 then return end;fanClock%=.25
  for _,fan in ipairs(Fans) do
   local center=Vector3.new(table.unpack(fan.center));local half=Vector3.new(table.unpack(fan.halfsize))
   if (center-workspace.CurrentCamera.CFrame.Position).Magnitude&lt;350+half.Magnitude then
    for i=1,3 do
     local part=acquire();if not part then break end
     part.Material=Enum.Material.Neon;part.Color=fan.kind=="upward" and Color3.fromRGB(150,235,245) or Color3.fromRGB(235,245,255);part.Transparency=.55;part.Size=Vector3.new(.12,.12,4);part.Parent=folder
     local direction=Vector3.new(table.unpack(fan.direction)).Unit
     local now=workspace:GetServerTimeNow();local offset=Vector3.new(math.sin(now*3+i*2)*half.X*.7,math.cos(now*2+i)*half.Y*.7,math.cos(now*3+i*2)*half.Z*.7)
     active["wind_"..now.."_"..fan.id..i]={part=part,position=center+offset,direction=direction,speed=35,expires=now+.65,time=now}
    end
   end
  end
 end)
 -- Damaged planes shed paper below half health and trail grey smoke below a quarter, so a weak plane reads at a glance.
 local damageClock=0
 Run.Heartbeat:Connect(function(dt)
  damageClock+=dt;if damageClock&lt;.25 then return end;damageClock=0
  for _,plane in ipairs(workspace.Planes:GetChildren()) do
   local root=plane:FindFirstChild("Root")
   if root then
    local tatters=root:FindFirstChild("Shreds")
    if not tatters then
     tatters=shredEmitter();tatters.Speed=NumberRange.new(3,8);tatters.Parent=root
     local smoke=puffEmitter(Color3.fromRGB(120,118,112));smoke.Name="DamageSmoke";smoke.Lifetime=NumberRange.new(.8,1.4);smoke.Parent=root
    end
    local ratio=(plane:GetAttribute("Health") or 1)/math.max(1,plane:GetAttribute("MaxHealth") or 1)
    local flying=plane:GetAttribute("State")=="FLYING"
    tatters.Rate=flying and (ratio&lt;.25 and 14 or ratio&lt;.5 and 5 or 0) or 0
    root.DamageSmoke.Rate=flying and ratio&lt;.25 and 12 or 0
   end
  end
 end)
 -- Prediction: draw this player's shots, muzzle flashes and sounds on the click frame, using the same
 -- mounts and reload times as the server. The server still decides every hit.
 local room=RaycastParams.new();room.FilterType=Enum.RaycastFilterType.Include
 room.FilterDescendantsInstances={workspace:FindFirstChild("Arena") or workspace:WaitForChild("GreyboxRoom")}
 local held,mounts,mountKey,serial,roundRobin={false,false},{},nil,0,{0,0}
 local mountPlane,mountLife=nil,nil
 local function flying()
  local plane=getPlane()
  if plane and plane.Parent and plane:GetAttribute("State")=="FLYING" and not Root:GetAttribute("OverlayOpen") and plane:FindFirstChild("Root") then return plane end
 end
 local function refresh(plane)
  local key=tostring(plane:GetAttribute("Mounts")).."|"..tostring(plane:GetAttribute("Life"))
  if key==mountKey and plane==mountPlane then return end
  local previous={};local now=workspace:GetServerTimeNow()
  if plane==mountPlane and plane:GetAttribute("Life")==mountLife then for _,mount in ipairs(mounts) do previous[mount.slot]=mount end end
  mountPlane,mountLife=plane,plane:GetAttribute("Life")
  mountKey,mounts=key,{}
  local ids=string.split(plane:GetAttribute("Mounts") or "",",");local groups=assert(Rules.triggerGroups({weapon_mounts=ids}))
  roundRobin={0,0}
  for slot,id in ipairs(ids) do
   local weapon=id~="" and Catalog:get(id)
   if weapon and not weapon.homing then
    local old=previous[slot];local same=old and old.weapon.id==id
    local heat,cooling=plane:GetAttribute("MountHeat"..slot) or 0,(plane:GetAttribute("MountCoolingUntil"..slot) or 0)&gt;0
    heat,cooling=Rules.heatStep(heat,cooling,held[groups[slot]],now-(plane:GetAttribute("HeatUpdatedAt") or now),weapon)
    local ready=old and old.readyAt or 0
    if old and old.cooling and not same then ready=math.max(ready,now+old.heat*old.weapon.cooldown_seconds/old.weapon.shots_before_cooldown) end
    table.insert(mounts,{slot=slot,weapon=weapon,group=groups[slot],readyAt=ready,burstLeft=0,
     heat=same and old.heat or heat,cooling=same and old.cooling or cooling,heatAt=same and old.heatAt or now})
   end
  end
 end
 local function coolMount(plane,mount,firing,now)
  local weapon=mount.weapon
  mount.heat,mount.cooling=Rules.heatStep(mount.heat,mount.cooling,firing,now-mount.heatAt,weapon);mount.heatAt=now
  -- Local heat blocks instant feedback at the limit; the server's deadline also blocks a drifting prediction.
  local untilAt=plane:GetAttribute("MountCoolingUntil"..mount.slot) or 0
  if weapon.shots_before_cooldown and untilAt&gt;now then
   mount.heat=math.max(mount.heat,(untilAt-now)*weapon.shots_before_cooldown/weapon.cooldown_seconds);mount.cooling=true
  end
 end
 local spreadRandom=Random.new()
 local function shoot(plane,mount,now,wound)
  local body,weapon=plane.Root,mount.weapon
  if weapon.windup_seconds&gt;0 and not wound then
   Audio.play("windup")
   task.delay(weapon.windup_seconds,function() if flying()==plane then shoot(plane,mount,workspace:GetServerTimeNow(),true) end end)
   return
  end
  local factor=plane:GetAttribute("MountScale") or 1
  local position=body.CFrame:PointToWorldSpace(Aircraft.muzzleOffset(mount.slot,factor,mount.weapon.id,plane:GetAttribute("WingShift")))
  local direction=Aircraft.converge(body,position,Effects.aim(body,weapon),convergence)
  if weapon.spread_deg&gt;0 then
   local spread=math.rad(weapon.spread_deg)
   direction=(CFrame.lookAt(Vector3.zero,direction)*CFrame.Angles(spreadRandom:NextNumber(-spread,spread),spreadRandom:NextNumber(-spread,spread),0)).LookVector
  end
  local wall=workspace:Raycast(position,direction*Rules.shotRange(weapon),room)
  serial+=1
  -- ponytail: the wall is found along the straight aim line; the drop is a few studs over the shot's life.
  local hitAfter=wall and math.min(weapon.lifetime,Rules.travelTime(weapon,wall.Distance))
  if wall then task.delay(hitAfter,burst,wall.Position,2,2,.8) end
  drawShot("local"..serial,weapon.id,position,direction,weapon.projectile_speed,now+(hitAfter or weapon.lifetime),now)
  local flash=acquire()
  if flash then
   flash.Material=Enum.Material.Neon;flash.Color=Color3.fromRGB(255,240,180);flash.Size=Vector3.new(.7,.7,1.6);flash.Parent=folder
   active["flash"..serial]={part=flash,position=position,direction=direction,speed=0,expires=now+.05,time=now,follow=body,offset=body.CFrame:PointToObjectSpace(position)}
  end
  Audio.play(weapon.id)
 end
 local function step(plane,now,pressed)
  for _,mount in ipairs(mounts) do
   local weapon=mount.weapon
   coolMount(plane,mount,held[mount.group],now)
   if held[mount.group] and mount.readyAt&lt;=now then
    if weapon.fire_mode=="automatic" then
     local heat,cooling,allowed=Rules.heatShot(mount.heat,mount.cooling,weapon)
     if allowed then shoot(plane,mount,now);mount.readyAt=now+weapon.shot_interval;mount.heat,mount.cooling=heat,cooling end
    elseif weapon.fire_mode=="burst" and mount.burstLeft==0 then mount.burstLeft,mount.burstNext,mount.readyAt=weapon.burst_count,now,now+weapon.burst_period end
   end
   while mount.burstLeft&gt;0 and now&gt;=mount.burstNext do shoot(plane,mount,now);mount.burstLeft-=1;mount.burstNext+=weapon.burst_spacing end
  end
  -- Semi-automatic weapons fire once per press, one mount at a time.
  if pressed then
   for offset=1,#mounts do
    local index=(roundRobin[pressed]+offset-1)%#mounts+1;local mount=mounts[index]
    if mount.group==pressed and mount.weapon.fire_mode=="semiautomatic" and mount.readyAt&lt;=now then
     shoot(plane,mount,now);mount.readyAt=now+mount.weapon.shot_interval;roundRobin[pressed]=index;break
    end
   end
  end
 end
 Run.RenderStepped:Connect(function()
  local plane=getPlane();if not plane or not plane.Parent then return end
  refresh(plane);local now=workspace:GetServerTimeNow()
  local activePlane=flying()
  if activePlane then step(plane,now)
  else for _,mount in ipairs(mounts) do coolMount(plane,mount,false,now) end end
 end)
 -- The aim sent for a trigger leads for the first unguided gun on it.
 local function aimFor(body,group)
  for _,mount in ipairs(mounts) do if mount.group==group then return Effects.aim(body,mount.weapon) end end
  return body.CFrame.LookVector
 end
 return {aim=aimFor,press=function(which,down)
  local plane=flying();local now=workspace:GetServerTimeNow()
  if plane then refresh(plane);for _,mount in ipairs(mounts) do if mount.group==which then coolMount(plane,mount,held[which],now) end end end
  held[which]=down
  if down and plane then step(plane,now,which) end
 end}
end
return Effects
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ROJO_300">
          <Properties>
            <string name="Name">DeskHangar</string>
            <string name="Source">-- In-game hangar menu, shown while your plane sits in its desk hangar. Layout B (plane left, service buttons right,
-- saved builds along the bottom) drawn with the main-menu Hangar's own art (Alan, 2026-10-11): the kraft folder, the
-- taped preview paper, construction-paper strips, crayon stat bars and numbered build squares.
-- Picking a build selects it; Full refold (or a fresh plane) flies it.
local Players = game:GetService("Players")
local Root = game.ReplicatedStorage.FlyFightPaper
local Catalog = require(Root.Shared.Catalog).new(require(Root.Generated.Catalog), require(Root.Generated.Gameplay))
local Aircraft = require(Root.Shared.Aircraft)
local Rules = require(Root.Shared.ServiceRules)
local Art = require(Root.Shared.UIAssets).hangar
local BuildStats = {}
for _, entry in require(script.Parent.Hangar).STATS do BuildStats[entry[1]] = entry end
local PaperUI = require(script.Parent.PaperUI)
local DeskHangar = {}

-- A camera framing a model in a ViewportFrame: from its left side, a little above and behind, so the nose points right.
-- room: camera distance as a share of "whole model just fits" (smaller = bigger plane).
local function frame(view, model, room)
	local camera = Instance.new("Camera")
	camera.FieldOfView, camera.Parent, view.CurrentCamera = 40, view, camera
	local cf, size = model:GetBoundingBox()
	local reach = size.Magnitude * 0.5 / math.tan(math.rad(20)) * room
	camera.CFrame = CFrame.lookAt(cf.Position + (cf.RightVector * -0.9 + cf.UpVector * 0.6 + cf.LookVector * -0.2).Unit * reach, cf.Position)
end

local function viewport(parent, name, x, y, w, h)
	local view = Instance.new("ViewportFrame")
	view.Name, view.BackgroundTransparency = name, 1
	view.Position, view.Size = UDim2.fromOffset(x, y), UDim2.fromOffset(w, h)
	view.Ambient, view.LightDirection, view.Parent = Color3.fromRGB(220, 218, 210), Vector3.new(-1, -1, -1), parent
	return view
end

-- api = { flight(action) = FlightAction, round = RoundAction remote }
function DeskHangar.new(playerGui, api)
	-- Just the folder over the live game (Alan: you are still in the match, the quick menu is only pulled up).
	local cover, sheet = PaperUI.screen(playerGui, "DeskHangar", Art.folder, true)
	cover.Parent.DisplayOrder = 5 -- under the Menu button (6) and the menus and overlays (10)
	local image, words, button = PaperUI.image, PaperUI.words, PaperUI.button
	PaperUI.words(sheet, "Title", "Hangar", 60, 196, 285, 46, 42).TextXAlignment = Enum.TextXAlignment.Center

	-- The plane on the taped preview paper (sky-tinted like the main Hangar so the white plane stands out), and beside
	-- it, centred on it, the lined stats sheet: the main Hangar's stat strips and five crayon bar cells. Health, Lift and
	-- Boost show what is left now; Speed, Climb and Swerve show the build (same ranges as the main Hangar).
	image(sheet, "Preview", Art.preview, 60, 245, 750, 545).ImageColor3 = Color3.fromRGB(140, 185, 230)
	local planeView = viewport(sheet, "Plane", 95, 290, 680, 450)
	image(sheet, "StatsSheet", Art.statsSheet, 845, 266, 360, 504, 1).ScaleType = Enum.ScaleType.Stretch
	local rows = {
		{ "Health", "red", "red", function(p) return p:GetAttribute("Health") or 0, p:GetAttribute("MaxHealth") or 1 end },
		{ "Speed" }, { "Climb" }, { "Swerve" },
		{ "Lift", "yellow", "orange", function(p) return p:GetAttribute("Lift") or 0, p:GetAttribute("LiftMax") or 90 end },
		{ "Boost", "blue", "blue", function(p) return p:GetAttribute("Boost") or 0, p:GetAttribute("BoostMax") or 0 end },
	}
	for i, row in rows do
		local build = not row[4] and BuildStats[row[1]] -- Health and Lift stay live (what is left now)
		if build then
			local _, strip, bar, get, lo, hi = table.unpack(build)
			row[2], row[3], row[5], row.least = strip, bar, build[8], 1 -- like the main Hangar, a build stat shows at least one cell
			row[4] = function(p)
				return get({ speed = p:GetAttribute("Speed") or lo, pitch = p:GetAttribute("PitchRate") or lo, yaw = p:GetAttribute("YawRate") or lo }) - lo, hi - lo
			end
		end
		local y = 320 + (i - 1) * 65 -- strips glued inside the sheet, close together (Alan)
		local strip = image(sheet, row[1] .. "Row", Art.statRow[row[2]], 893, y, 290, 70)
		strip.ScaleType = Enum.ScaleType.Stretch
		if row[5] then strip.ImageColor3 = row[5] end
		words(sheet, row[1] .. "Name", row[1], 905, y + 5, 100, 60, 30)
		row.cells = {}
		for k = 1, 5 do row.cells[k] = image(sheet, row[1] .. "Bar" .. k, Art.bar.empty, 1010 + (k - 1) * 34, y + 19, 31, 32) end
	end
	-- The note sits on a torn paper label (the flight HUD's) so its red/orange warnings read on the cardboard.
	local label = image(sheet, "NotePaper", require(Root.Shared.UIAssets).ingame.tapeLabel, 90, 784, 1100, 58)
	label.ScaleType, label.SliceCenter, label.SliceScale = Enum.ScaleType.Slice, Rect.new(90, 30, 894, 104), 0.45
	local note = words(sheet, "Note", "", 110, 792, 1060, 42, 28)
	note.TextXAlignment = Enum.TextXAlignment.Center

	-- Score card.
	image(sheet, "ScoreCard", Art.card, 1240, 255, 620, 130).ScaleType = Enum.ScaleType.Stretch
	local score = words(sheet, "Score", "", 1240, 268, 620, 52, 44)
	local clock = words(sheet, "Clock", "", 1240, 318, 620, 52, 38)
	score.TextXAlignment, clock.TextXAlignment, score.RichText = Enum.TextXAlignment.Center, Enum.TextXAlignment.Center, true

	-- Service buttons on construction-paper strips, LAUNCH on the green taped paper (the main Hangar's Save build).
	local service = function(kind) return function() api.round:FireServer("service", kind) end end
	local buttons = {}
	for i, entry in {
		{ "Refill", "Refill Lift", "blue", service("refill") },
		{ "Repair", "Repair", "green", service("repair") },
		{ "Fresh", "Fresh plane", "yellow", function() api.flight("fresh") end },
		{ "Refold", "Full refold - 120 Paper", "red", function()
			-- Spending Paper asks once: the first click turns the strip into a question for 3 seconds.
			local label = buttons.Refold.Label
			if label.Text ~= "Sure? Click again - 120 Paper" then
				label.Text = "Sure? Click again - 120 Paper"
				task.delay(3, function() label.Text = "Full refold - 120 Paper" end)
				return
			end
			label.Text = "Full refold - 120 Paper"
			service("refold")()
		end },
	} do
		buttons[entry[1]] = button(sheet, entry[1], Art.statRow[entry[3]], entry[2], 1240, 385 + (i - 1) * 112, 620, 130, 0, entry[4], entry[1] == "Refold" and 40 or 48)
	end
	local launch = button(sheet, "Launch", Art.buttonGreen, "LAUNCH!", 1250, 840, 600, 160, -1, function() api.flight("launch") end, 80)

	-- Saved builds along the bottom: the main Hangar's numbered squares, each showing its real model.
	local slots, preset, shownPresets, picked = {}, Players.LocalPlayer:GetAttribute("SelectedPreset") or 1, nil, -9
	for i = 1, 5 do
		local slot = button(sheet, "Build" .. i, Art.slot, "", 70 + (i - 1) * 225, 840, 150, 150, 0, function()
			preset = i; api.round:FireServer("selectPreset", i); picked = os.clock()
			for k, other in slots do other.Image = k == i and Art.slotSelected or Art.slot end
		end)
		words(slot, "Number", tostring(i), 14, 6, 40, 40, 36)
		slots[i] = slot
	end
	PaperUI.popIn(cover, { buttons.Refill, buttons.Repair, buttons.Fresh, buttons.Refold, launch })

	local function showPresets(presets)
		local key = game:GetService("HttpService"):JSONEncode(presets)
		if key == shownPresets then return end
		shownPresets = key
		for i, slot in slots do
			slot.Image = i == preset and Art.slotSelected or Art.slot
			local old = slot:FindFirstChild("Model")
			if old then old:Destroy() end
			local loadout = presets[i] and presets[i].loadout
			if loadout then
				local view = viewport(slot, "Model", 12, 30, 126, 110)
				local world = Instance.new("WorldModel")
				world.Parent = view
				local model = Instance.new("Model")
				model.Parent = world
				if Aircraft.build(model, loadout, Catalog, true) then frame(view, model, 0.85) end
			end
		end
	end
	Root:WaitForChild("ProfileView").OnClientEvent:Connect(function(profile)
		if profile and profile.presets then showPresets(profile.presets) end
	end)
	Root:WaitForChild("RoundView").OnClientEvent:Connect(function(snapshot)
		local remaining = snapshot.endsAt and math.max(0, math.ceil(snapshot.endsAt - snapshot.serverTime)) or 0
		clock.Text = string.format("%d:%02d left", math.floor(remaining / 60), remaining % 60)
		if snapshot.mode ~= "FFA" and snapshot.teams then
			score.Text = string.format('&lt;font color="#D22828"&gt;Red %.0f&lt;/font&gt; - &lt;font color="#2850D2"&gt;Blue %.0f&lt;/font&gt;', snapshot.teams["team:1"], snapshot.teams["team:2"])
		else
			score.Text = snapshot.mode or ""
		end
	end)

	-- The live plane: a copy of what your plane looks like now, rebuilt when its parts change.
	local shownPlane
	local function showPlane(plane)
		local appearance = plane:FindFirstChild("Appearance")
		local body = plane:FindFirstChild("Root")
		if not appearance or not body or appearance == shownPlane then return end
		shownPlane = appearance
		planeView:ClearAllChildren()
		local world = Instance.new("WorldModel")
		world.Parent = planeView
		local model = Instance.new("Model")
		model.Parent = world
		for _, part in appearance:GetChildren() do
			if part:IsA("BasePart") then
				local copy = part:Clone()
				copy:ClearAllChildren()
				for _, look in part:GetChildren() do if look:IsA("SurfaceAppearance") or look:IsA("Decal") then look:Clone().Parent = copy end end
				copy.Anchored, copy.CFrame, copy.Parent = true, body.CFrame:ToObjectSpace(part.CFrame), model
			end
		end
		frame(planeView, model, 0.62)
	end

	local self = {}
	local lastMessage, messageAt = nil, -9 -- service results ("Service complete", "You need 120 Paper") show for 4 s
	-- Called by the HUD every 0.1 s: shown while the plane is in its hangar.
	function self.update(plane, visible)
		cover.Visible = visible
		if not visible then shownPlane = nil; return end
		showPlane(plane)
		for _, row in rows do
			local value, max = row[4](plane)
			local cells = math.max(row.least or 0, max &gt; 0 and math.ceil(math.clamp(value / max, 0, 1) * 5) or 0)
			for k = 1, 5 do row.cells[k].Image = k &lt;= cells and Art.bar[row[3]] or Art.bar.empty end
		end
		local remaining = plane:GetAttribute("ProtectionRemaining") or 120
		local repair = Rules.repair(plane:GetAttribute("OriginalHealth"), plane:GetAttribute("MaxHealth"), plane:GetAttribute("Health"))
		local message = plane:GetAttribute("Message")
		if message ~= lastMessage then lastMessage, messageAt = message, os.clock() end
		note.Text = (plane:GetAttribute("ServiceBusy") or os.clock() - messageAt &lt; 4) and message and message ~= "" and message
			or os.clock() - picked &lt; 4 and string.format("Build %d picked: Full refold (or a fresh plane) flies it.", preset)
			or remaining &lt;= 0 and "Hangar safety used up: it comes back after 2 minutes out of the hangar, or with a kill."
			or string.format("Safe in the hangar: %.0fs. Repair leaves %.0f max health. A fresh plane ends your streak.", remaining, repair and repair.lifeMaxHealth or 0)
		note.TextColor3 = remaining &lt;= 10 and Color3.fromRGB(200, 40, 30) or remaining &lt;= 30 and Color3.fromRGB(200, 110, 20) or PaperUI.INK
	end
	self.sheet = sheet
	return self
end

return DeskHangar
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ROJO_301">
          <Properties>
            <string name="Name">DeskPieces</string>
            <string name="Source">-- Desk landing pieces on this client only (tools/desk_pieces.py places them): the paper-chain rings turn slowly
-- about the runway line while hovering (bob, sway, slight jitter), and the runway light tips blink in a chase from the ring toward the hangar.
local RunService = game:GetService("RunService")

local RING_TURNS_PER_SECOND = 0.05
local HOVER_BOB, HOVER_SWAY, HOVER_JITTER, HOVER_TILT = 1.2, 0.6, 0.15, math.rad(2) -- studs, studs, studs, radians
local CHASE_STUDS_PER_SECOND = 120 -- how fast the blink runs down the runway
local CHASE_GAP = 1.2 -- seconds between chases

local DeskPieces = {}

function DeskPieces.start()
	local rings, tips = {}, {} -- part -&gt; the CFrame it was placed at; tip -&gt; its delay along the chase
	local function track(part)
		if not part:IsA("BasePart") then return end
		if part.Name == "landing-ring" then rings[part] = part.CFrame
		elseif part.Name == "runway-light-tip" then tips[part] = false end
	end
	for _, part in ipairs(workspace:GetDescendants()) do track(part) end
	workspace.DescendantAdded:Connect(track)
	workspace.DescendantRemoving:Connect(function(part) rings[part], tips[part] = nil, nil end)
	-- A tip's delay is its distance from the nearest ring, so each runway's chase starts at its own ring.
	local function delayFor(tip)
		local best = math.huge
		for _, placed in pairs(rings) do best = math.min(best, (placed.Position - tip.Position).Magnitude) end
		return best / CHASE_STUDS_PER_SECOND
	end
	local refresh = 0
	RunService.RenderStepped:Connect(function(dt)
		local now = os.clock()
		local turn = CFrame.Angles(0, 0, now * RING_TURNS_PER_SECOND * math.pi * 2)
		for part, placed in pairs(rings) do
			-- Hovering: a slow bob plus a small uneven sway and tilt, each ring out of step with the others.
			local t = now + placed.Position.X * 0.01 + placed.Position.Z * 0.017
			local drift = Vector3.new(math.sin(t * 1.3) * HOVER_SWAY + math.sin(t * 3.1) * HOVER_JITTER,
				math.sin(t * 0.9) * HOVER_BOB + math.sin(t * 2.7) * HOVER_JITTER, 0)
			local tilt = CFrame.Angles(math.sin(t * 0.7) * HOVER_TILT, math.sin(t * 1.1) * HOVER_TILT, 0)
			part.CFrame = placed * CFrame.new(drift) * tilt * turn
		end
		refresh += dt
		if refresh &lt; 0.05 then return end
		refresh = 0
		for tip, delay in pairs(tips) do
			if not delay then delay = delayFor(tip); tips[tip] = delay end
			-- Lit for a short moment as the chase passes; dim (not gone) the rest of the time.
			local phase = (now - delay) % CHASE_GAP
			tip.Transparency = phase &lt; 0.18 and 0 or 0.65
		end
	end)
end

return DeskPieces
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ROJO_302">
          <Properties>
            <string name="Name">DevTools</string>
            <string name="Source">-- Studio-only checks. F8: photo mode (cycle 8 fixed viewpoints), F6: back to the live camera.
-- F9: performance overlay. F7: test autopilot that flies a loop of the room with no mouse.
local Players = game:GetService("Players")
local Input = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Root = game:GetService("ReplicatedStorage"):WaitForChild("FlyFightPaper")
local FlightState = require(script.Parent.FlightController).state
local DevTools = {}

-- Fixed viewpoints compared against the reference image between changes. No `from` = live chase camera.
-- Screenshots of the latest set live in the git-ignored captures/ folder (overwrite; keep no history).
DevTools.views = {
	{ name = "1-spawn-desk", from = Vector3.new(-160, 175, 640), to = Vector3.new(-225, 125, 880) },
	{ name = "2-city-overview", from = Vector3.new(0, 590, 1080), to = Vector3.new(0, 40, -150) },
	{ name = "3-low-avenue", from = Vector3.new(-20, 45, 620), to = Vector3.new(-20, 60, -350) },
	{ name = "4-fly-through-hole", from = Vector3.new(-120, 180, 560), to = Vector3.new(-120, 180, 250) },
	{ name = "5-window-side", from = Vector3.new(-950, 300, 950), to = Vector3.new(-1404, 330, -250) },
	{ name = "6-chalkboard-wall", from = Vector3.new(120, 380, -640), to = Vector3.new(0, 300, -1097) },
	{ name = "7-chase-dogfight" },
	{ name = "8-hangar", screen = "hangar" },
}
-- Test autopilot routes: a lap above the city, and a lap hugging the walls and ceiling (camera clipping check).
DevTools.routes = {
	loop = { Vector3.new(-1000, 320, -750), Vector3.new(1000, 320, -750), Vector3.new(1000, 320, 650), Vector3.new(-1000, 320, 650) },
	hug = { Vector3.new(-1300, 570, 1000), Vector3.new(-1300, 570, -1000), Vector3.new(1300, 570, -1000), Vector3.new(1300, 250, 1000) },
}

function DevTools.start(menu)
	if not RunService:IsStudio() then return end
	local camera = workspace.CurrentCamera
	local view = 0
	local gui = Instance.new("ScreenGui")
	gui.Name, gui.ResetOnSpawn, gui.IgnoreGuiInset, gui.Enabled, gui.DisplayOrder = "DevPerf", false, true, false, 50
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	local text = Instance.new("TextLabel")
	text.Size, text.Position, text.BackgroundTransparency = UDim2.fromOffset(330, 74), UDim2.new(1, -350, 0, 60), 0.3
	text.BackgroundColor3, text.TextColor3, text.Font, text.TextSize = Color3.new(0, 0, 0), Color3.new(1, 1, 1), Enum.Font.Code, 14
	text.TextXAlignment, text.Parent = Enum.TextXAlignment.Left, gui

	function DevTools.setView(index)
		view = index
		local entry = DevTools.views[index]
		Root:SetAttribute("PhotoMode", entry ~= nil and entry.from ~= nil)
		Root:SetAttribute("PhotoView", entry and entry.name or nil)
		if entry and entry.screen and menu then menu.show(entry.screen) end
	end
	RunService:BindToRenderStep("PhotoMode", Enum.RenderPriority.Camera.Value + 2, function()
		local entry = DevTools.views[view]
		local custom = Players.LocalPlayer:GetAttribute("DevCamera")
		if custom or entry and entry.from then
			camera.CameraType = Enum.CameraType.Scriptable
			camera.CFrame = custom or CFrame.lookAt(entry.from, entry.to)
			camera.FieldOfView = 70
		end
	end)

	-- Rolling 60-second window of client frame times; server frame time comes from the server.
	local frames, window = {}, 60
	function DevTools.perf()
		local now, total, sorted = os.clock(), 0, {}
		while frames[1] and now - frames[1].at &gt; window do table.remove(frames, 1) end
		for _, frame in ipairs(frames) do total += frame.dt; table.insert(sorted, frame.dt) end
		table.sort(sorted)
		local count = #sorted
		return {
			fps = count &gt; 0 and count / total or 0,
			p95Ms = count &gt; 0 and sorted[math.max(1, math.ceil(count * 0.95))] * 1000 or 0,
			seconds = total,
			serverMs = Root:GetAttribute("ServerFrameMs") or 0,
			serverP95Ms = Root:GetAttribute("ServerFrameP95Ms") or 0,
		}
	end
	local refresh, logged = 0, os.clock()
	RunService.RenderStepped:Connect(function(dt)
		table.insert(frames, { at = os.clock(), dt = dt })
		refresh += dt
		if refresh &lt; 0.5 then return end
		refresh = 0
		local p = DevTools.perf()
		Players.LocalPlayer:SetAttribute("DevPerf", string.format("%.1f,%.2f,%.1f,%.2f,%.0f", p.fps, p.p95Ms, p.serverMs, p.serverP95Ms, p.seconds))
		text.Text = string.format(" FPS %.1f   p95 frame %.1f ms\n server frame %.1f ms  p95 %.1f\n window %.0fs   view %s", p.fps, p.p95Ms, p.serverMs, p.serverP95Ms, p.seconds, Root:GetAttribute("PhotoView") or "-")
		if gui.Enabled and os.clock() - logged &gt;= window then
			logged = os.clock()
			print(string.format("[Perf] %ds: %.1f FPS, p95 %.1f ms, server %.1f ms (p95 %.1f)", window, p.fps, p.p95Ms, p.serverMs, p.serverP95Ms))
		end
	end)

	function DevTools.autopilot(route)
		local points, target = DevTools.routes[route], 1
		FlightState.aimOverride = points and function(body)
			if (points[target] - body.Position).Magnitude &lt; 180 then target = target % #points + 1 end
			return (points[target] - body.Position).Unit
		end or nil
	end

	-- Studio MCP commands run in a separate Lua VM, so they drive these tools through player attributes.
	local player = Players.LocalPlayer
	player:GetAttributeChangedSignal("DevView"):Connect(function() DevTools.setView(player:GetAttribute("DevView") or 0) end)
	player:GetAttributeChangedSignal("DevAutopilot"):Connect(function() DevTools.autopilot(player:GetAttribute("DevAutopilot")) end)
	player:GetAttributeChangedSignal("DevAim"):Connect(function()
		local aim = player:GetAttribute("DevAim")
		FlightState.aimOverride = aim and function() return aim end or nil
	end)
	Input.InputBegan:Connect(function(input, processed)
		if processed then return end
		if input.KeyCode == Enum.KeyCode.F8 then DevTools.setView(view % #DevTools.views + 1)
		elseif input.KeyCode == Enum.KeyCode.F6 then DevTools.setView(0)
		elseif input.KeyCode == Enum.KeyCode.F9 then gui.Enabled = not gui.Enabled; logged = os.clock()
		elseif input.KeyCode == Enum.KeyCode.F7 then DevTools.autopilot(FlightState.aimOverride == nil and "loop" or nil)
		elseif input.KeyCode == Enum.KeyCode.F10 then DevTools.spectateNext() end
	end)

	-- F10: follow the next bot from behind and show what its brain is doing. F10 past the last bot, F6, Esc,
	-- Tab or opening the menu stops (Alan got stuck with only F6 as the way out).
	local watched
	local label = text:Clone()
	label.Position, label.Size, label.Visible = UDim2.new(0.5, -230, 0, 170), UDim2.fromOffset(460, 96), false
	label.Parent = gui.Parent:FindFirstChild("DevSpectate") or Instance.new("ScreenGui", gui.Parent)
	label.Parent.Name, label.Parent.ResetOnSpawn = "DevSpectate", false
	function DevTools.spectateNext()
		local bots = {}
		for _, model in ipairs(workspace:GetDescendants()) do
			if model:IsA("Model") and model:GetAttribute("BotIntent") then table.insert(bots, model) end
		end
		table.sort(bots, function(a, b) return a.Name &lt; b.Name end)
		local index = table.find(bots, watched) or 0
		watched = bots[index + 1] -- nil after the last bot: back to your own view
		if not watched then DevTools.stopSpectating() end
	end
	function DevTools.stopSpectating()
		watched = nil
		camera.CameraType = Enum.CameraType.Custom -- your plane's camera takes over again if you are flying
	end
	Input.InputBegan:Connect(function(input)
		if watched and (input.KeyCode == Enum.KeyCode.F6 or input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.Tab) then
			DevTools.stopSpectating()
		end
	end)
	Root:GetAttributeChangedSignal("OverlayOpen"):Connect(function() if watched then DevTools.stopSpectating() end end)
	RunService:BindToRenderStep("DevSpectate", Enum.RenderPriority.Camera.Value + 3, function()
		local root = watched and watched.Parent and watched:FindFirstChild("Root")
		label.Visible = root ~= nil
		if not root then return end
		camera.CameraType = Enum.CameraType.Scriptable
		camera.CFrame = CFrame.lookAt(root.CFrame:PointToWorldSpace(Vector3.new(0, 12, 45)), root.Position + root.CFrame.LookVector * 80)
		label.Text = string.format(" %s  (%s)\n %s  [%s]\n health %d  %s\n F10 next bot   F6 or Esc: stop", watched:GetAttribute("DisplayName") or watched.Name,
			tostring(watched:GetAttribute("Loadout")), tostring(watched:GetAttribute("BotIntent")), tostring(watched:GetAttribute("BotStyle")),
			watched:GetAttribute("Health") or 0, tostring(watched:GetAttribute("State")))
	end)
end
return DevTools
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ROJO_303">
          <Properties>
            <string name="Name">FanSpin</string>
            <string name="Source">-- Turns the floor fans' blades on this client only (no network traffic). The blades are their own mesh
-- (tools/art/split_parts.py); AXIS is where they turn, from the mesh's bounding-box centre
-- (assets/models/toys/floor-fan-blades/checks.json "axis": Blender x, y -&gt; Roblox x, z).
local RunService = game:GetService("RunService")

local AXIS = CFrame.new(0.477, 0, -2.05)
local TURNS_PER_SECOND = 1.5 -- ponytail: slow enough to read as spinning at 60 FPS; a real fan would just blur

local FanSpin = {}

function FanSpin.start()
	local blades = {} -- part -&gt; the CFrame it was placed at
	local function track(part)
		if part.Name == "floor-fan-blades" and part:IsA("BasePart") then blades[part] = part.CFrame end
	end
	for _, part in ipairs(workspace:GetDescendants()) do track(part) end
	workspace.DescendantAdded:Connect(track)
	workspace.DescendantRemoving:Connect(function(part) blades[part] = nil end)
	RunService.RenderStepped:Connect(function()
		local turn = CFrame.Angles(0, os.clock() * TURNS_PER_SECOND * math.pi * 2, 0)
		for part, placed in pairs(blades) do
			local axis = placed * AXIS
			part.CFrame = axis * turn * axis:ToObjectSpace(placed)
		end
	end)
end

return FanSpin
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ROJO_304">
          <Properties>
            <string name="Name">FanWind</string>
            <string name="Source">-- Visible air over the two floor fans, on this client only: white wind swirls and paper bits rising through each
-- updraft column (Alan picked the swirls, assets/references/world-pieces/fan-wind.png). The column sizes come from
-- config; the pictures are drawn by tools/art/wind_sprites.py.
local Root = game:GetService("ReplicatedStorage"):WaitForChild("FlyFightPaper")
local Gameplay = require(Root.Generated.Gameplay)

local SWIRL = "rbxassetid://85637394548007"
local PAPER = "rbxassetid://136515946422329"

local FanWind = {}

local function emitter(texture, rate, speed, size)
	local e = Instance.new("ParticleEmitter")
	e.Texture, e.Rate, e.LightInfluence = texture, rate, 0.1
	e.EmissionDirection = Enum.NormalId.Top
	e.Speed = speed
	e.SpreadAngle = Vector2.new(8, 8)
	e.Size = size
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.15, 0.1), NumberSequenceKeypoint.new(0.8, 0.25), NumberSequenceKeypoint.new(1, 1) })
	return e
end

function FanWind.start()
	local folder = Instance.new("Folder")
	folder.Name = "FanWind"
	for _, fan in ipairs(Gameplay.world.fans) do
		if fan.kind == "upward" then
			local c, h = fan.center, fan.halfsize
			-- An emitter part as wide as the column, at its floor; particles live long enough to reach the top.
			local base = Instance.new("Part")
			base.Name, base.Anchored, base.CanCollide, base.CanQuery, base.CanTouch, base.Transparency = fan.id, true, false, false, false, 1
			base.Size = Vector3.new(h[1] * 1.4, 1, h[3] * 1.4)
			base.Position = Vector3.new(c[1], c[2] - h[2] + 10, c[3])
			local height = h[2] * 2
			local swirl = emitter(SWIRL, 9, NumberRange.new(85, 110), NumberSequence.new({ NumberSequenceKeypoint.new(0, 18), NumberSequenceKeypoint.new(1, 30) }))
			swirl.Lifetime = NumberRange.new(height / 110, height / 85)
			swirl.Rotation = NumberRange.new(-8, 8) -- facing the camera, upright: the line reads as rising air
			swirl.Parent = base
			local paper = emitter(PAPER, 12, NumberRange.new(70, 100), NumberSequence.new(4))
			paper.Lifetime = NumberRange.new(height / 100, height / 70)
			paper.Rotation, paper.RotSpeed = NumberRange.new(0, 360), NumberRange.new(-180, 180)
			paper.Drag = 0.2
			paper.Acceleration = Vector3.new(0, 8, 0)
			paper.Parent = base
			base.Parent = folder
		end
	end
	folder.Parent = workspace
end

return FanWind
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ROJO_305">
          <Properties>
            <string name="Name">FlightController</string>
            <string name="Source">-- Mouse-aim flight: the mouse moves a free aim direction and the shared autopilot flies the nose toward it.
local Input = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Root = game:GetService("ReplicatedStorage"):WaitForChild("FlyFightPaper")
local Rules = require(Root.Shared.FlightRules)
local Gameplay = require(Root.Generated.Gameplay)
local Config = Gameplay.flight
local World = Gameplay.world
local Controller = {}
-- Read by the camera and HUD. `aimOverride` lets dev tools fly the plane without a mouse.
Controller.state = { aim = nil, aimUp = nil, warning = false, aimOverride = nil }

local roomCenter = Vector3.new(0, World.height_studs / 2, 0)
local roomSize = Vector3.new(World.width_studs, World.height_studs, World.depth_studs)
local solid = OverlapParams.new()
solid.FilterType, solid.RespectCanCollide = Enum.RaycastFilterType.Include, true
solid.FilterDescendantsInstances = { workspace:FindFirstChild("Arena") or workspace:WaitForChild("GreyboxRoom") }
local single = RaycastParams.new()
single.FilterType = Enum.RaycastFilterType.Include

function Controller.start(plane)
	local state = Controller.state
	local body = plane:WaitForChild("Root")
	local drive = body:WaitForChild("ForwardVelocity")
	local orientation = body:WaitForChild("NoseOrientation")
	-- The aim is a full rotation, not yaw/pitch angles, so it can go over the top: loops, rolls, inverted.
	local heading, bank, aimFrame, lastSteer = body.CFrame.LookVector, 0, CFrame.identity, 0
	local wasFlying, locked, focused, boostSent = false, false, true, false
	local function setAim(direction)
		local look = aimFrame.LookVector
		local angle = math.acos(math.clamp(look:Dot(direction), -1, 1))
		if angle &lt; 1e-4 then return end
		local axis = look:Cross(direction)
		aimFrame = CFrame.fromAxisAngle(axis.Magnitude &gt; 1e-4 and axis.Unit or aimFrame.UpVector, angle) * aimFrame
	end
	local function lockMouse(lock)
		if lock == locked then return end
		locked = lock
		Input.MouseBehavior = lock and Enum.MouseBehavior.LockCenter or Enum.MouseBehavior.Default
		Input.MouseIconEnabled = not lock
	end
	-- The default camera scripts reset the mouse on right-click; re-lock after them every frame.
	RunService:BindToRenderStep("FlightMouseLock", Enum.RenderPriority.Camera.Value + 2, function()
		if locked then Input.MouseBehavior = Enum.MouseBehavior.LockCenter end
	end)
	local focusLost = Input.WindowFocusReleased:Connect(function() focused = false end)
	local focusGained = Input.WindowFocused:Connect(function() focused = true end)
	local connection = RunService.PreSimulation:Connect(function(dt)
		if not plane.Parent or plane:GetAttribute("State") ~= "FLYING" then
			wasFlying, state.aim, state.aimUp, state.warning = false, nil, nil, false
			lockMouse(false)
			return
		end
		if not wasFlying then
			heading, bank, wasFlying = body.CFrame.LookVector, 0, true
			aimFrame = CFrame.lookAt(Vector3.zero, heading)
		end
		local blocked = not focused or Input:GetFocusedTextBox() ~= nil or Root:GetAttribute("OverlayOpen") == true
		lockMouse(not blocked)
		if not blocked then
			-- Mouse moves turn the aim around its own axes, so "up" on screen is always up for the pilot.
			local delta = Input:GetMouseDelta() * math.rad(Config.aim_degrees_per_pixel) * (Root:GetAttribute("Sensitivity") or 1)
			if delta.Magnitude &gt; 0 then aimFrame = aimFrame * CFrame.Angles(-delta.Y, -delta.X, 0); lastSteer = os.clock() end
		end
		if state.aimOverride then setAim(state.aimOverride(body)); lastSteer = os.clock() end
		if os.clock() - lastSteer &gt; Config.aim_level_delay_s then aimFrame = Rules.levelAim(aimFrame, dt) end
		local nudged, warned = Rules.boundsNudge(body.Position, aimFrame.LookVector, roomCenter, roomSize)
		if warned then setAim(aimFrame.LookVector:Lerp(nudged, math.min(1, dt * 4)).Unit) end
		aimFrame = aimFrame:Orthonormalize()
		state.aim, state.aimUp, state.warning = aimFrame.LookVector, aimFrame.UpVector, warned
		local boost = not blocked and Input:IsKeyDown(Enum.KeyCode.LeftShift)
		if boost ~= boostSent then boostSent = boost; Root.FlightAction:FireServer("boost", boost) end
		local before = heading
		heading, bank, orientation.CFrame = Rules.autopilot(heading, bank, state.aim, plane:GetAttribute("YawRate"), plane:GetAttribute("PitchRate"), dt, state.aimUp)
		local now = workspace:GetServerTimeNow()
		local speed = plane:GetAttribute("Speed") * (plane:GetAttribute("BoostSpeedFactor") or 1) * Rules.turnSpeedFactor(before, heading, dt, plane:GetAttribute("TurnRate"))
		local desired = Rules.velocity(heading, speed,
			plane:GetAttribute("Lift"), plane:GetAttribute("Updraft") or 0)
		-- Touching the room: never sink into it; slide along it. The server decides scrape damage or a crash.
		local part, normal = Rules.contact(plane, heading, solid, single)
		if part then
			drive.VectorVelocity -= normal * math.min(0, drive.VectorVelocity:Dot(normal))
			desired -= normal * math.min(0, desired:Dot(normal))
			desired += normal * Config.graze_slide_push_studs_s
		elseif now &lt; (plane:GetAttribute("DeflectUntil") or 0) then
			-- Graze: drop the push into the surface and slide along it.
			local normal = plane:GetAttribute("CollisionNormal") or Vector3.zero
			desired -= normal * math.min(0, desired:Dot(normal))
			desired += normal * Config.graze_slide_push_studs_s
		end
		drive.VectorVelocity = drive.VectorVelocity:Lerp(desired, 1 - math.exp(-Config.velocity_response * dt))
	end)
	return function()
		connection:Disconnect()
		RunService:UnbindFromRenderStep("FlightMouseLock")
		focusLost:Disconnect()
		focusGained:Disconnect()
		lockMouse(false)
		state.aim, state.aimUp, state.warning = nil, nil, false
	end
end
return Controller
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ROJO_306">
          <Properties>
            <string name="Name">FlightHUD</string>
            <string name="Source">local Players = game:GetService("Players")
local Input = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local HUD = {}

function HUD.start(getPlane, action)
	local gui = Instance.new("ScreenGui")
	gui.Name = "FlightHUD"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	-- Two reticles: the aim circle (where you want to go) and the nose dot (where the plane and its guns point).
	local function reticle(name, size, filled)
		local frame = Instance.new("Frame")
		frame.Name, frame.AnchorPoint, frame.Size = name, Vector2.new(0.5, 0.5), UDim2.fromOffset(size, size)
		frame.BackgroundColor3, frame.BackgroundTransparency, frame.BorderSizePixel = Color3.fromRGB(235, 245, 250), filled and 0 or 1, 0
		Instance.new("UICorner", frame).CornerRadius = UDim.new(0.5, 0)
		-- Filled dots get a dark outline so they stand out against the pale room.
		local ring = Instance.new("UIStroke")
		ring.Color, ring.Thickness, ring.Transparency = filled and Color3.fromRGB(10, 20, 15) or Color3.fromRGB(255, 240, 170), 2, filled and 0.2 or 0.1
		ring.Parent = frame
		frame.Visible = false
		frame.Parent = gui
		return frame
	end
	local aimCircle = reticle("AimCircle", 30, false)
	aimCircle.UIStroke.Thickness = 3
	-- Settings screen: crosshair colour tints the aim circle; size scales both reticles (nose dot keeps green/red).
	local CROSSHAIR_COLORS = { green = Color3.fromRGB(60, 255, 90), red = Color3.fromRGB(255, 60, 70), blue = Color3.fromRGB(0, 235, 255),
		yellow = Color3.fromRGB(255, 225, 40), purple = Color3.fromRGB(190, 110, 255), white = Color3.fromRGB(250, 250, 250) }
	local CROSSHAIR_SIZES = { Small = 0.75, Medium = 1, Large = 1.4 }
	local Settings = game:GetService("ReplicatedStorage"):WaitForChild("FlyFightPaper")
	local crosshairScale = 1
	local function applyCrosshair()
		aimCircle.UIStroke.Color = CROSSHAIR_COLORS[Settings:GetAttribute("CrosshairColor")] or CROSSHAIR_COLORS.blue
		crosshairScale = CROSSHAIR_SIZES[Settings:GetAttribute("CrosshairSize")] or 1
		aimCircle.Size = UDim2.fromOffset(30 * crosshairScale, 30 * crosshairScale)
	end
	Settings:GetAttributeChangedSignal("CrosshairColor"):Connect(applyCrosshair)
	Settings:GetAttributeChangedSignal("CrosshairSize"):Connect(applyCrosshair)
	applyCrosshair()
	-- Bright green; turns red and grows a little when a shot fired now will hit (see willHit).
	local NOSE, NOSE_ON = Color3.fromRGB(60, 255, 90), Color3.fromRGB(255, 40, 60)
	local noseDot = reticle("NoseDot", 10, true)
	noseDot.BackgroundColor3 = NOSE
	-- Eraser seeker: any enemy inside this circle (and in range) starts locking; a box on it shrinks and turns red.
	local seeker = reticle("EraserSeeker", 100, false)
	seeker.UIStroke.Color, seeker.UIStroke.Transparency, seeker.UIStroke.Thickness = Color3.fromRGB(255, 140, 170), 0.55, 1.5
	local lockBox = reticle("LockBox", 60, false)
	lockBox.UICorner:Destroy()
	local FlightState = require(script.Parent.FlightController).state
	-- Aim help: a lead marker for the enemy nearest the nose, with a bracket on that enemy.
	local Root = game:GetService("ReplicatedStorage"):WaitForChild("FlyFightPaper")
	local Gameplay = require(Root.Generated.Gameplay)
	local Catalog = require(Root.Shared.Catalog).new(require(Root.Generated.Catalog), Gameplay)
	local CombatRules = require(Root.Shared.CombatRules)
	-- The lead marker is the "second crosshair": put the nose dot on it and the shots meet the enemy.
	-- One lead marker per weapon type (Alan): left-click weapon = orange ring, right-click weapon = cyan diamond.
	-- Each fills in when its own shots would hit now.
	local LEAD_LOOKS = {
		{ name = "LeadPipper", size = 26, color = Color3.fromRGB(255, 150, 60), round = true },
		{ name = "LeadPipper2", size = 22, color = Color3.fromRGB(70, 225, 255), round = false },
	}
	local pippers, leadLines = {}, {}
	for group, look in ipairs(LEAD_LOOKS) do
		local pipper = reticle(look.name, look.size, false)
		pipper.UIStroke.Color, pipper.UIStroke.Thickness, pipper.BackgroundColor3 = look.color, 3, look.color
		if not look.round then pipper.UICorner:Destroy(); pipper.Rotation = 45 end
		local line = Instance.new("Frame")
		line.Name, line.AnchorPoint, line.BorderSizePixel = "LeadLine" .. group, Vector2.new(0.5, 0.5), 0
		line.BackgroundColor3, line.BackgroundTransparency, line.Visible = look.color, 0.45, false
		line.Parent = gui
		pippers[group], leadLines[group] = pipper, line
	end
	local motion = {}
	local bracket = reticle("TargetBracket", 34, false)
	bracket.UICorner:Destroy()
	bracket.UIStroke.Color, bracket.UIStroke.Transparency = Color3.fromRGB(255, 150, 60), 0.3
	local planes = workspace:WaitForChild("Planes")
	local function enemy(me, other)
		local team = me:GetAttribute("Team") or ""
		return other ~= me and (team == "" or other:GetAttribute("Team") ~= team)
	end
	-- A small diamond over every enemy on screen, at any range, so distant planes can be found.
	-- Low health: a pulsing red border around the screen.
	local danger = Instance.new("Frame")
	danger.Name, danger.Size, danger.Position, danger.BackgroundTransparency, danger.Visible = "LowHealth", UDim2.new(1, -52, 1, -52), UDim2.fromOffset(26, 26), 1, false
	local dangerStroke = Instance.new("UIStroke")
	dangerStroke.Color, dangerStroke.Thickness, dangerStroke.ApplyStrokeMode = Color3.fromRGB(220, 40, 30), 26, Enum.ApplyStrokeMode.Border
	dangerStroke.Parent, danger.Parent = danger, gui
	local markers = {}
	local function markerFor(index)
		local marker = markers[index]
		if not marker then
			marker = Instance.new("Frame")
			marker.Name, marker.AnchorPoint, marker.Size, marker.Rotation = "EnemyMarker", Vector2.new(0.5, 1), UDim2.fromOffset(9, 9), 45
			marker.BackgroundColor3, marker.BackgroundTransparency, marker.BorderSizePixel = Color3.fromRGB(255, 120, 80), 0.15, 0
			marker.Parent = gui
			markers[index] = marker
		end
		return marker
	end
	-- The aimed (non-homing) weapon on each trigger: { [1] = left-click weapon, [2] = right-click weapon }.
	local function gunWeapons(plane)
		local found = {}
		local ids=string.split(plane:GetAttribute("Mounts") or "", ",")
		local groups=assert(CombatRules.triggerGroups({weapon_mounts=ids}))
		for slot, id in ipairs(ids) do
			local weapon = id ~= "" and Catalog:get(id)
			if weapon and not weapon.homing then found[groups[slot]] = found[groups[slot]] or weapon end
		end
		return found
	end
	local Effects = require(script.Parent.CombatEffects)
	local Aircraft = require(Root.Shared.Aircraft)
	local shapeParams = RaycastParams.new()
	shapeParams.FilterType = Enum.RaycastFilterType.Include
	local shapes = {} -- target Root -&gt; the exact-shape parts the server's hits use
	-- True only when a shot fired now really hits: each gun's path (same muzzle, aim and convergence as the shot)
	-- is swept past the target's exact shape around the moment it arrives, with the target following its turn.
	-- ponytail: aims down the middle of spread weapons and ignores walls in between (the target is already in view).
	local function willHit(plane, body, target, m, group)
		local parts = shapes[target]
		if not parts then
			parts = {}
			for _, d in ipairs(target.Parent:GetDescendants()) do
				if d:IsA("MeshPart") and d.CanQuery then table.insert(parts, d) end
			end
			if #parts == 0 then return false end
			shapes[target] = parts
		end
		shapeParams.FilterDescendantsInstances = parts
		local factor, guns = plane:GetAttribute("MountScale") or 1, {}
		local ids=string.split(plane:GetAttribute("Mounts") or "", ",")
		local groups=assert(CombatRules.triggerGroups({weapon_mounts=ids}))
		for slot, id in ipairs(ids) do
			local weapon = id ~= "" and Catalog:get(id)
			if weapon and not weapon.homing then table.insert(guns, {slot = slot, weapon = weapon, group = groups[slot]}) end
		end
		local function moved(s) return m.velocity * s + m.acceleration * (0.5 * s * s) end
		for _, gun in ipairs(guns) do
			local weapon = gun.weapon
			if gun.group == group then
				local muzzle = body.CFrame:PointToWorldSpace(Aircraft.muzzleOffset(gun.slot, factor, gun.weapon.id, plane:GetAttribute("WingShift")))
				local direction = Aircraft.converge(body, muzzle, Effects.aim(body, weapon), Gameplay.combat.gun_convergence_studs)
				local arrive = CombatRules.travelTime(weapon, (FlightState.leadFor(weapon) - muzzle).Magnitude)
				if arrive &lt; math.huge then
					local a, b = math.max(0, arrive - 0.2), arrive + 0.2
					local from = muzzle + CombatRules.shotOffset(weapon, direction, a) - moved(a)
					local to = muzzle + CombatRules.shotOffset(weapon, direction, b) - moved(b)
					-- Roblox caps one shape sweep at 1024 studs; fast weapons sweep further in 0.4 s, so go in pieces.
					local length = (to - from).Magnitude
					local unit = length &gt; 0.001 and (to - from).Unit or Vector3.zero
					for offset = 0, length, 1000 do
						local step = math.min(1000, length - offset)
						if step &gt; 0.001 and workspace:Spherecast(from + unit * offset, weapon.projectile_radius, unit * step, shapeParams) then return true end
					end
				end
			end
		end
		return false
	end
	local liftBar=Instance.new("Frame");liftBar.Name="LiftBar";liftBar.Position=UDim2.new(0,24,1,-76);liftBar.Size=UDim2.fromOffset(310,4);liftBar.BackgroundColor3=Color3.fromRGB(110,220,235);liftBar.BorderSizePixel=0;liftBar.Parent=gui
	local function label(name, size, position, text)
		local item = Instance.new("TextLabel")
		item.Name, item.Size, item.Position, item.Text = name, size, position, text
		item.BackgroundColor3 = Color3.fromRGB(25, 31, 38)
		item.BackgroundTransparency = 0.15
		item.TextColor3 = Color3.fromRGB(240, 245, 248)
		item.Font = Enum.Font.GothamMedium
		item.TextSize = 18
		item.Parent = gui
		return item
	end
	local status = label("Status", UDim2.fromOffset(480, 44), UDim2.new(0.5, -240, 0, 18), "Ready at your desk")
	status.TextWrapped=true;status.TextSize=15
	local holding=label("WaitingApproach",UDim2.fromOffset(130,44),UDim2.fromScale(.5,.5),"");holding.AnchorPoint=Vector2.new(.5,.5);holding.TextSize=14;holding.TextColor3=Color3.fromRGB(155,235,250)
	local meter = label("Lift", UDim2.fromOffset(310, 42), UDim2.new(0, 24, 1, -116), "Lift")
	local health = label("Health", UDim2.fromOffset(310, 32), UDim2.new(0, 24, 1, -70), "")
	local boost=label("Boost",UDim2.fromOffset(310,24),UDim2.new(0,24,1,-146),"");boost.TextSize=14;boost.BackgroundTransparency=1
	local weapons = label("Weapons", UDim2.fromOffset(420, 54), UDim2.new(1,-444,1,-126), "")
	weapons.TextSize = 15;weapons.TextWrapped=true
	local gunHeat,heatBars={},{}
	for group=1,2 do
		local item=label("GunHeat"..group, UDim2.fromOffset(270, 26), UDim2.new(1,-584+(group-1)*290,1,-220), "")
		item.TextSize=13;item.Visible=false;gunHeat[group]=item
		local track = Instance.new("Frame")
		track.Name, track.Position, track.Size = "HeatTrack", UDim2.fromOffset(12, 23), UDim2.new(1, -24, 0, 5)
		track.BackgroundColor3, track.BorderSizePixel, track.ZIndex, track.Parent = Color3.fromRGB(210, 199, 170), 0, 3, item
		local bar = Instance.new("Frame")
		bar.Name, bar.Size, bar.BorderSizePixel, bar.ZIndex, bar.Parent = "HeatBar", UDim2.fromScale(0, 1), 0, 4, track
		heatBars[group]=bar
	end
	local pencilPips={}
	for i=1,2 do
		local pip=label("Pencil"..i,UDim2.fromOffset(145,23),UDim2.new(1,-444+(i-1)*155,1,-153),"")
		pip.TextSize=13;pencilPips[i]=pip
	end
	local warning = label("LockWarning", UDim2.fromOffset(760,34), UDim2.new(0.5,-380,0,64), "")
	local alarm = Instance.new("Frame")
	-- A frame's border stroke is drawn outside it, so screen-edge borders use a frame inset by the stroke width.
	alarm.Name, alarm.Size, alarm.Position, alarm.BackgroundTransparency, alarm.Visible = "LockAlarm", UDim2.new(1, -28, 1, -28), UDim2.fromOffset(14, 14), 1, false
	local alarmStroke = Instance.new("UIStroke")
	alarmStroke.Color, alarmStroke.Thickness, alarmStroke.ApplyStrokeMode = Color3.fromRGB(255, 40, 30), 14, Enum.ApplyStrokeMode.Border
	alarmStroke.Parent, alarm.Parent = alarm, gui
	warning.BackgroundTransparency = 1
	warning.TextColor3 = Color3.fromRGB(255,170,135)
	local feed = label("KillFeed", UDim2.fromOffset(320,100), UDim2.new(1,-344,0,70), "")
	feed.BackgroundTransparency = 1
	feed.TextSize = 14
	feed.TextXAlignment = Enum.TextXAlignment.Right
	local picker = Instance.new("Frame")
	picker.Name="WeaponPicker";picker.Size=UDim2.fromOffset(880,80);picker.Position=UDim2.new(.5,-440,.5,64);picker.BackgroundTransparency=1;picker.Parent=gui
	for index, choice in ipairs({"pellet","staple","rubber","paperclip","eraser","pencil","twin_pencils"}) do
		local button=Instance.new("TextButton");button.Size=UDim2.fromOffset(104,34);button.Position=UDim2.fromOffset((index-1)*110,0)
		button.Name=choice
		button.BackgroundColor3=Color3.fromRGB(45,55,66);button.TextColor3=Color3.new(1,1,1);button.Font=Enum.Font.GothamMedium;button.TextSize=13
		button.Text=choice:gsub("_"," ");button.Parent=picker;button.Activated:Connect(function()action("loadout",choice)end)
	end
	-- Dodge practice: one bot with only an eraser hunts you.
	local eraserBots=picker.pellet:Clone();eraserBots.Name="EraserBots";eraserBots.Text="eraser hunter";eraserBots.Position=UDim2.fromOffset(770,0)
	eraserBots.BackgroundColor3=Color3.fromRGB(120,45,70);eraserBots.Parent=picker;eraserBots.Activated:Connect(function()action("eraserBots")end)
	-- Every bot build, skill, personality and quirk at once (F10 shows which is which).
	local mixedBots=eraserBots:Clone();mixedBots.Name="MixedBots";mixedBots.Text="mixed bots";mixedBots.Position=UDim2.fromOffset(770,-40)
	mixedBots.BackgroundColor3=Color3.fromRGB(45,95,70);mixedBots.Parent=picker;mixedBots.Activated:Connect(function()action("mixedBots")end)
	local round=label("Round",UDim2.fromOffset(450,34),UDim2.new(.5,-225,0,105),"");round.TextSize=16 -- boxed, so the paper skin gives it a tape strip
	game.ReplicatedStorage.FlyFightPaper:WaitForChild("RoundView").OnClientEvent:Connect(function(snapshot)
		local remaining=snapshot.endsAt and math.max(0,math.ceil(snapshot.endsAt-snapshot.serverTime)) or 0
		round.Text=string.format("%s   %d:%02d",snapshot.mode or "",math.floor(remaining/60),remaining%60)
		if snapshot.mode~="FFA" and snapshot.teams then round.Text..=string.format("  [+] %.0f : %.0f [o]",snapshot.teams["team:1"],snapshot.teams["team:2"]) end
	end)
	local help = label("Controls", UDim2.new(1, -48, 0, 32), UDim2.new(0, 24, 1, -36),
		"Mouse: aim (the plane follows)   |   Left/right click: fire   |   Shift: equipped boost   |   Enter: launch   |   R: fresh plane   |   Cyan fan: Lift")
	help.TextSize = 14
	-- The controls line is for learning: it shows during the tutorial only (Stage 6: no help bar in normal play).
	local function showHelp() help.Visible = Root:GetAttribute("TutorialOpen") == true end
	Root:GetAttributeChangedSignal("TutorialOpen"):Connect(showHelp)
	showHelp()
	-- In the hangar: the crayon hangar menu (service, builds, LAUNCH). Studio's dev picker rides on its sheet.
	local desk = require(script.Parent.DeskHangar).new(gui.Parent, { flight = action, round = game.ReplicatedStorage.FlyFightPaper.RoundAction })
	picker.Position, picker.Parent = UDim2.fromOffset(520, 165), desk.sheet
	Input.InputBegan:Connect(function(input, processed)
		if processed then return end
		if input.KeyCode == Enum.KeyCode.Return then action("launch")
		elseif input.KeyCode == Enum.KeyCode.R then action("fresh") end
	end)
	-- Paper skin (Alan's menu look): buttons become pinned construction-paper strips, dark info boxes become
	-- index cards, words use the marker font; words floating over the game get a dark outline to stay readable.
	do
		local PaperUI = require(script.Parent.PaperUI)
		local UIArt = require(Root.Shared.UIAssets)
		local strips = { UIArt.mainmenu.strip.blue, UIArt.mainmenu.strip.green, UIArt.mainmenu.strip.red, UIArt.mainmenu.strip.yellow }
		local DEFAULT_WHITE = { [Color3.new(1, 1, 1):ToHex()] = true, [Color3.fromRGB(240, 245, 248):ToHex()] = true }
		-- Bigger, readable layout (Alan, 2026-10-08): name = { size, position, text size }.
		local LAYOUT = {
			Status = { UDim2.fromOffset(700, 70), UDim2.new(0.5, -350, 0, 14), 32 },
			Round = { UDim2.fromOffset(360, 56), UDim2.new(0.5, -180, 0, 90), 34 },
			LockWarning = { UDim2.fromOffset(860, 44), UDim2.new(0.5, -430, 0, 152), 30 },
			KillFeed = { UDim2.fromOffset(460, 150), UDim2.new(1, -484, 0, 120), 22 },
			Lift = { UDim2.fromOffset(400, 60), UDim2.new(0, 24, 1, -190), 28 },
			Health = { UDim2.fromOffset(400, 60), UDim2.new(0, 24, 1, -124), 28 },
			Boost = { UDim2.fromOffset(400, 30), UDim2.new(0, 24, 1, -224), 22 },
			Weapons = { UDim2.fromOffset(560, 80), UDim2.new(1, -584, 1, -136), 24 },
			Controls = { UDim2.new(1, -48, 0, 50), UDim2.new(0, 24, 1, -56), 21 },
			WaitingApproach = { UDim2.fromOffset(200, 70), UDim2.fromScale(0.5, 0.5), 24 },
		}
		for i = 1, 2 do LAYOUT["Pencil" .. i] = { UDim2.fromOffset(270, 36), UDim2.new(1, -584 + (i - 1) * 290, 1, -178), 20 } end
		for name, place in LAYOUT do
			local item = gui:FindFirstChild(name)
			if item then item.Size, item.Position, item.TextSize = place[1], place[2], place[3] end
		end
		liftBar.Position, liftBar.ZIndex = UDim2.new(0, 44, 1, -142), 3
		local function backing(item, id)
			local paper = Instance.new("ImageLabel")
			paper.Name, paper.Image, paper.BackgroundTransparency, paper.ScaleType = item.Name .. "Paper", id, 1, Enum.ScaleType.Stretch
			if id == UIArt.ingame.tapeLabel then
				-- 9-slice: torn ends stay crisp, only the middle stretches (stretching the whole strip blurred it).
				paper.ScaleType, paper.SliceCenter, paper.SliceScale = Enum.ScaleType.Slice, Rect.new(90, 30, 894, 104), 0.55
			end
			paper.AnchorPoint, paper.Position, paper.Size = item.AnchorPoint, item.Position, item.Size
			paper.ZIndex, paper.Parent = item.ZIndex - 1, item.Parent
			item:GetPropertyChangedSignal("Visible"):Connect(function() paper.Visible = item.Visible end)
			item:GetPropertyChangedSignal("Size"):Connect(function() paper.Size = item.Size end)
			item:GetPropertyChangedSignal("Position"):Connect(function() paper.Position = item.Position end)
			paper.Visible = item.Visible
		end
		local count = 0
		for _, item in gui:GetDescendants() do
			if item:IsA("TextButton") then
				count += 1
				backing(item, strips[count % #strips + 1])
				item.ZIndex, item.BackgroundTransparency, item.AutoButtonColor = 2, 1, false
				item.FontFace, item.TextColor3 = PaperUI.font, PaperUI.INK
				item.TextScaled = true -- fill the strip; the marker font reads small at the old sizes
				local cap = Instance.new("UITextSizeConstraint")
				cap.MaxTextSize, cap.Parent = 30, item
				local pad = Instance.new("UIPadding")
				pad.PaddingTop, pad.PaddingBottom, pad.PaddingLeft, pad.PaddingRight = UDim.new(0.1, 0), UDim.new(0.04, 0), UDim.new(0.06, 0), UDim.new(0.06, 0)
				pad.Parent = item
			elseif item:IsA("TextLabel") then
				item.FontFace, item.TextSize = PaperUI.font, math.round(item.TextSize * 1.3)
				if item.BackgroundTransparency &lt; 0.5 then
					item.ZIndex, item.BackgroundTransparency = 2, 1
					if DEFAULT_WHITE[item.TextColor3:ToHex()] or item.Name == "WaitingApproach" then item.TextColor3 = PaperUI.INK end
					backing(item, UIArt.ingame.tapeLabel)
				else
					local outline = Instance.new("UIStroke")
					outline.Color, outline.Thickness, outline.Transparency, outline.Parent = Color3.fromRGB(30, 22, 14), 1.5, 0.2, item
				end
			end
		end
	end
	local sight = RaycastParams.new()
	sight.FilterType = Enum.RaycastFilterType.Include
	sight.FilterDescendantsInstances = { workspace:FindFirstChild("Arena") or workspace:WaitForChild("GreyboxRoom") }
	-- Reticles move every frame, after the camera.
	RunService:BindToRenderStep("FlightReticles", Enum.RenderPriority.Camera.Value + 3, function()
		local plane = getPlane()
		local body = plane and plane.Parent and plane:FindFirstChild("Root")
		local flying = body and gui.Enabled and plane:GetAttribute("State") == "FLYING"
		local camera = workspace.CurrentCamera
		local function place(frame, world)
			local point, visible = camera:WorldToViewportPoint(world)
			frame.Position, frame.Visible = UDim2.fromOffset(point.X, point.Y), visible
		end
		if flying and FlightState.aim then place(aimCircle, camera.CFrame.Position + FlightState.aim * 1000) else aimCircle.Visible = false end
		-- Only planes the pilot can actually see get markers: nothing shows through books or buildings.
		local sightline = {}
		local function seen(root)
			if sightline[root] == nil then
				local from = camera.CFrame.Position
				local hit = workspace:Raycast(from, root.Position - from, sight)
				sightline[root] = not hit or (hit.Instance.Transparency &gt; 0.5 and not hit.Instance:GetAttribute("Solid"))
			end
			return sightline[root]
		end
		-- Pick the enemy closest to where the pilot is aiming. Track each plane's turning so the lead curves with it.
		local now = os.clock()
		local target, guns, best = nil, flying and gunWeapons(plane) or {}, math.cos(math.rad(35))
		local look = FlightState.aim or (body and body.CFrame.LookVector)
		for _, other in ipairs(planes:GetChildren()) do
			local root = other:FindFirstChild("Root")
			if root and other ~= plane then
				local m = motion[root]
				local velocity = root.AssemblyLinearVelocity
				if not m then m = { velocity = velocity, acceleration = Vector3.zero, at = now }; motion[root] = m end
				local dt = now - m.at
				if dt &gt; 0 then
					local raw = (velocity - m.velocity) / dt
					if raw.Magnitude &gt; 400 then raw = raw.Unit * 400 end
					m.acceleration = m.acceleration:Lerp(raw, 1 - math.exp(-6 * dt))
					m.velocity, m.at = velocity, now
				end
				if next(guns) and other:GetAttribute("State") == "FLYING" and enemy(plane, other) and seen(root) then
					local offset = root.Position - body.Position
					local facing = offset.Magnitude &lt; 1000 and look:Dot(offset.Unit) or -1
					if facing &gt; best then target, best = root, facing end
				end
			end
		end
		for root in pairs(motion) do if not root.Parent then motion[root] = nil end end
		for root in pairs(shapes) do if not root.Parent then shapes[root] = nil end end
		local shown = 0
		for _, other in ipairs(flying and planes:GetChildren() or {}) do
			local root = other:FindFirstChild("Root")
			if root and other:GetAttribute("State") == "FLYING" and enemy(plane, other) then
				local point, visible = camera:WorldToViewportPoint(root.Position)
				if visible and seen(root) then
					shown += 1
					local marker = markerFor(shown)
					marker.Position, marker.Visible = UDim2.fromOffset(point.X, point.Y - 14), true
				end
			end
		end
		for index = shown + 1, #markers do markers[index].Visible = false end
		local noseRange = 300
		if target then
			-- Where the target will be when a shot fired now reaches it, following its current turn.
			local m = motion[target]
			-- Shared with the gun assist, which leads each weapon by its own speed, drag and drop.
			FlightState.leadFor = function(weapon)
				local lead = target.Position
				for _ = 1, 4 do
					local t = CombatRules.travelTime(weapon, (lead - body.Position).Magnitude)
					if t == math.huge then t = weapon.lifetime end
					lead = target.Position + m.velocity * t + m.acceleration * (0.5 * t * t) + Vector3.yAxis * (0.5 * (weapon.drop or 0) * t * t)
				end
				return lead
			end
			place(bracket, target.Position)
			-- The nose dot sits at the left-click lead's range, so dot-on-marker means the guns really point there.
			local anyHit, b = false, bracket.Position
			for group, pipper in ipairs(pippers) do
				local weapon, line = guns[group], leadLines[group]
				if weapon then
					local lead = FlightState.leadFor(weapon)
					place(pipper, lead)
					if group == 1 or not guns[1] then noseRange = (lead - body.Position).Magnitude end
					local onTarget = willHit(plane, body, target, m, group)
					anyHit = anyHit or onTarget
					pipper.BackgroundTransparency = onTarget and 0.35 or 1
					local a = pipper.Position
					local dx, dy = a.X.Offset - b.X.Offset, a.Y.Offset - b.Y.Offset
					line.Position = UDim2.fromOffset((a.X.Offset + b.X.Offset) / 2, (a.Y.Offset + b.Y.Offset) / 2)
					line.Size, line.Rotation = UDim2.fromOffset(math.sqrt(dx * dx + dy * dy), 2), math.deg(math.atan2(dy, dx))
					line.Visible = pipper.Visible and bracket.Visible
				else
					pipper.Visible, line.Visible = false, false
				end
			end
			noseDot.BackgroundColor3, noseDot.Size = anyHit and NOSE_ON or NOSE, UDim2.fromOffset((anyHit and 11 or 10) * crosshairScale, (anyHit and 11 or 10) * crosshairScale)
		else
			FlightState.leadFor = nil
			noseDot.BackgroundColor3, noseDot.Size = NOSE, UDim2.fromOffset(10 * crosshairScale, 10 * crosshairScale)
			bracket.Visible = false
			for group, pipper in ipairs(pippers) do pipper.Visible, leadLines[group].Visible = false, false end
		end
		if flying then place(noseDot, body.Position + body.CFrame.LookVector * noseRange) else noseDot.Visible = false end
		local carriesEraser = flying and string.find(plane:GetAttribute("Mounts") or "", "eraser") ~= nil
		if carriesEraser then
			-- Circle radius on screen for the lock cone around the nose.
			local Combat = Gameplay.combat
			local radius = math.tan(math.rad(Combat.eraser_lock_cone_deg)) / math.tan(math.rad(camera.FieldOfView / 2)) * camera.ViewportSize.Y / 2
			place(seeker, body.Position + body.CFrame.LookVector * 300)
			seeker.Size = UDim2.fromOffset(radius * 2, radius * 2)
		else
			seeker.Visible = false
		end
		local locked = carriesEraser and planes:FindFirstChild(plane:GetAttribute("LockTarget") or "")
		local progress = plane and plane:GetAttribute("LockProgress") or 0
		if locked and locked:FindFirstChild("Root") and progress &gt; 0 then
			place(lockBox, locked.Root.Position)
			local size = 70 - 30 * progress
			lockBox.Size = UDim2.fromOffset(size, size)
			lockBox.UIStroke.Color = progress &gt;= 1 and Color3.fromRGB(255, 50, 50) or Color3.fromRGB(255, 220, 90)
			lockBox.UIStroke.Thickness = progress &gt;= 1 and 3 or 2
		else
			lockBox.Visible = false
		end
	end)
	local update = 0
	RunService.RenderStepped:Connect(function(dt)
		update += dt
		if update &lt; 0.1 then return end
		update = 0
		local plane = getPlane()
		local shown=plane~=nil and plane.Parent~=nil and not Root:GetAttribute("OverlayOpen") and not Root:GetAttribute("PhotoMode")
		-- In the hangar the hangar menu shows Lift, health, score and buttons, so the flight HUD steps aside.
		local inHangar=shown and plane:GetAttribute("State")=="DESK"
		desk.update(plane,inHangar)
		picker.Visible=inHangar and RunService:IsStudio()
		gui.Enabled=shown and not inHangar
		if not gui.Enabled then return end
		-- Outline other planes so they read at range: orange for enemies, blue for teammates.
		for _, other in ipairs(planes:GetChildren()) do
			if other ~= plane then
				local outline = other:FindFirstChild("Outline") or Instance.new("Highlight")
				outline.Name, outline.FillTransparency, outline.OutlineTransparency = "Outline", 1, 0.15
				outline.DepthMode = Enum.HighlightDepthMode.Occluded
				outline.OutlineColor = enemy(plane, other) and Color3.fromRGB(255, 120, 80) or Color3.fromRGB(110, 190, 255)
				outline.Enabled = other:GetAttribute("State") == "FLYING"
				outline.Parent = other
			end
		end
		local state = plane:GetAttribute("State")
		danger.Visible = state == "FLYING" and (plane:GetAttribute("Health") or 0) &lt; (plane:GetAttribute("MaxHealth") or 1) * 0.3
		dangerStroke.Transparency = 0.5 + 0.25 * math.sin(os.clock() * 8)
		local waitPosition=plane:GetAttribute("HoldingPosition")
		holding.Visible=waitPosition~=nil and state=="FLYING"
		if holding.Visible then
			local camera=workspace.CurrentCamera;local point,visible=camera:WorldToViewportPoint(waitPosition);local size=camera.ViewportSize
			if visible then holding.Position=UDim2.fromOffset(math.clamp(point.X,75,math.max(75,size.X-75)),math.clamp(point.Y,165,math.max(165,size.Y-175)))
			else holding.Position=UDim2.new(.5,camera.CFrame:PointToObjectSpace(waitPosition).X&lt;0 and -290 or 290,.5,0) end
			holding.Text=plane:GetAttribute("DeskAvailable") and "PAD OPEN\nApproach ring" or "WAIT HERE\nPosition "..tostring(plane:GetAttribute("DeskQueuePosition") or 1)
		end
		status.Text = FlightState.warning and "Edge of the room - turning you back" or plane:GetAttribute("Message") or state
		local lift = plane:GetAttribute("Lift") or 0
		liftBar.Size=UDim2.fromOffset(360*math.clamp(lift/(plane:GetAttribute("LiftMax") or 90),0,1),7)
		meter.Text = string.format("Lift: %d / %d seconds", math.ceil(lift), math.ceil(plane:GetAttribute("LiftMax") or 90))
		meter.TextColor3 = lift &lt;= 0 and Color3.fromRGB(200, 70, 20) or Color3.fromRGB(28, 26, 30) -- ink on the index card; orange-red when out of Lift
		health.Text = string.format("Health: %d / %d   |   %s", math.max(0,math.ceil(plane:GetAttribute("Health") or 0)), math.ceil(plane:GetAttribute("MaxHealth") or 120), state:lower())
		boost.Visible=(plane:GetAttribute("BoostMax") or 0)&gt;0
		boost.Text=string.format("Boost %.1f / %.1fs  |  Hold Shift",plane:GetAttribute("Boost") or 0,plane:GetAttribute("BoostMax") or 0)
		local function reload(group)
			local seconds=plane:GetAttribute(group.."Reload") or -1
			return seconds&lt;0 and "None" or ((plane:GetAttribute(group.."Name") or group).."  "..(plane:GetAttribute(group.."ReloadDetail") or ""))
		end
		weapons.Text="Left: "..reload("Primary").."\nRight: "..reload("Alternate")
		for group=1,2 do
			local name,button=group==1 and "Primary" or "Alternate",group==1 and "Left" or "Right"
			local item,bar=gunHeat[group],heatBars[group]
			item.Visible=state=="FLYING" and plane:GetAttribute(name.."HasHeat")==true
			local cooling=plane:GetAttribute(name.."Cooling")==true
			item.Text=button..(cooling and ": Cooling" or ": Gun heat")
			item.TextColor3=cooling and Color3.fromRGB(200, 55, 40) or Color3.fromRGB(28, 26, 30)
			bar.BackgroundColor3=cooling and Color3.fromRGB(200, 55, 40) or Color3.fromRGB(220, 150, 45)
			bar.Size=UDim2.fromScale(math.clamp(plane:GetAttribute(name.."Heat") or 0,0,1),1)
		end
		local ids=string.split(plane:GetAttribute("Mounts") or "",",")
		local groups=assert(CombatRules.triggerGroups({weapon_mounts=ids}));local pencilButtons,eraserButton={},"right-click"
		for slot,id in ipairs(ids) do
			local button=groups[slot]==1 and "Left" or "Right"
			if id=="pencil" then table.insert(pencilButtons,button) end
			if id=="eraser" then eraserButton=button:lower().."-click" end
		end
		for i,pip in ipairs(pencilPips) do
			pip.Visible=(plane:GetAttribute("PencilCount") or 0)&gt;=i
			local seconds=plane:GetAttribute("PencilReload"..i) or 0
			pip.Text=(pencilButtons[i] or "Left").." pencil "..i..": "..(seconds&lt;=0 and "READY" or string.format("%.1fs",seconds))
			pip.TextColor3=seconds&lt;=0 and Color3.fromRGB(150,235,185) or Color3.fromRGB(245,200,135)
		end
		local progress=plane:GetAttribute("LockProgress") or 0
		-- Threats to you: quiet amber while someone locks on, loud flashing red once locked or an eraser is coming.
		local serverNow=workspace:GetServerTimeNow()
		local incoming=serverNow&lt;(plane:GetAttribute("EraserIncomingUntil") or 0)
		local lockedOn=serverNow&lt;(plane:GetAttribute("IncomingLockUntil") or 0)
		local locking=serverNow&lt;(plane:GetAttribute("LockingUntil") or 0)
		local loud=incoming or lockedOn
		alarm.Visible=loud and state=="FLYING"
		alarmStroke.Transparency=math.floor(os.clock()*6)%2==0 and .1 or .6
		warning.TextSize=loud and 28 or 18
		warning.TextColor3=loud and Color3.fromRGB(255,70,60) or locking and Color3.fromRGB(255,190,90) or Color3.fromRGB(255,170,135)
		local gap=plane:GetAttribute("EraserDistance") or 0
		warning.Text=incoming and (gap&lt;Gameplay.combat.eraser_break_studs and "BREAK NOW! TURN HARD!" or string.format("ERASER %d STUDS AWAY: break hard when it gets close",gap)) or lockedOn and "ERASER LOCKED ON YOU" or locking and "Someone is locking on to you"
			or os.clock()-(Players.LocalPlayer:GetAttribute("EraserAwayAt") or -9)&lt;1.2 and "ERASER AWAY" or (progress&gt;=1 and "ERASER LOCKED: "..(plane:GetAttribute("LockName") or "").."  ("..eraserButton..")" or progress&gt;0 and string.format("Eraser locking %d%%: %s  (hold %s)",math.floor(progress*100),plane:GetAttribute("LockName") or "",eraserButton) or "")
	end)
end
return HUD
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ROJO_307">
          <Properties>
            <string name="Name">Hangar</string>
            <string name="Source">-- Hangar on a kraft-cardboard folder (Alan's approved concept: assets/references/ui-concepts/hangar.png).
-- Folder tabs pick the part slot, part cards on the left, the 3D plane on taped paper, crayon stat bars on the right,
-- five saved builds along the bottom.
local Root = game.ReplicatedStorage.FlyFightPaper
local Catalog = require(Root.Shared.Catalog).new(require(Root.Generated.Catalog), require(Root.Generated.Gameplay))
local Aircraft = require(Root.Shared.Aircraft)
local Schema = require(Root.Shared.ProfileSchema)
local Builder = require(Root.Shared.BuilderModel)
local CombatRules = require(Root.Shared.CombatRules)
local Art = require(Root.Shared.UIAssets).hangar
local PaperUI = require(script.Parent.PaperUI)
local Hangar = {}

-- Studio dev mode: every part counts as owned at the level cap, and "Fly this build" sends the draft straight
-- to your plane for testing. Nothing here is saved or bought; live servers ignore it.
local dev = game:GetService("RunService"):IsStudio()
local everything = {}
for _, list in { Catalog.weapons, Catalog.utilities } do for _, part in list do everything[part.id] = true end end
for _, list in Catalog.structuresBySlot do for _, part in list do everything[part.id] = true end end

local TABS = { "body", "nose", "wings", "tail", "weapons", "boost" }
-- Bar ranges cover every body/nose/wing/tail swap on the starter build (measured 2026-10-08).
local STATS = {
	{ "Health", "red", "red", function(s) return s.health end, 60, 340, "%.0f" },
	{ "Speed", "blue", "blue", function(s) return s.speed end, 60, 150, "%.0f" },
	-- Turning is two stats (Alan): Climb = nose up/down (tail), Swerve = side to side (wings). Kid words, not pitch/yaw.
	{ "Climb", "green", "green", function(s) return s.pitch end, 70, 200, "%.0f" },
	{ "Swerve", "green", "green", function(s) return s.yaw end, 70, 175, "%.0f", Color3.fromRGB(150, 230, 255) },
	{ "Lift", "yellow", "orange", function(s) return s.lift end, 70, 110, "%.0fs" },
}
Hangar.STATS = STATS -- the in-game hangar menu shows the same rows

-- api = { action = RoundAction remote, back(), fly(loadout) (Studio only) }
function Hangar.new(playerGui, api)
	local cover, sheet = PaperUI.screen(playerGui, "HangarScreen", Art.bg)
	local image, words, button = PaperUI.image, PaperUI.words, PaperUI.button
	local content = Instance.new("Frame")
	content.Name, content.BackgroundTransparency, content.Size, content.Parent = "Content", 1, UDim2.fromOffset(PaperUI.W, PaperUI.H), sheet
	button(sheet, "Back", Art.buttonGreen, "Back", 1390, 30, 230, 95, 2, api.back, 50)
	if dev then button(sheet, "FlyBuild", Art.buttonGreen, "Fly this build", 40, 40, 330, 95, -2, function() api.fly() end, 40) end

	local state = { preset = 1, slot = "body", mount = 1, angle = 0.5, pitch = -0.5 }
	local profile, render

	local function choose(pick, ...)
		state.builder.message = ""
		local ok, reason = pick(state.builder, ...)
		if not ok then
			reason = tostring(reason)
			if reason=="two weapon types per plane" then reason = "Two weapon types per plane: one for left click, one for right click."
			elseif reason:find("capacity exceeds") then reason = "Too much weight for this body. Remove a weapon or pick a bigger body."
			elseif reason:find("incompatible with ordered mount") then reason = "That weapon is too big for that mount." end
			state.builder.message = reason
		end
		render()
	end
	-- Weapons go on the selected mount if they fit, otherwise on the first empty mount that fits.
	local function placeWeapon(id)
		local draft = state.builder.candidate
		local body = Catalog:get(draft.body)
		local selected = math.min(state.mount, body.mount_count)
		local order = { selected }
		for i = 1, body.mount_count do if i ~= selected and not draft.weapon_mounts[i] then table.insert(order, i) end end
		local firstReason
		for _, i in order do
			local ok, reason = state.builder:selectMount(i, id)
			if ok then state.mount = i; return true end
			local old = i == selected and draft.weapon_mounts[selected]
			if reason=="two weapon types per plane" and old then
				-- Replacing one of a pair would make a third type (Alan): swap every mount holding the old weapon,
				-- or empty the ones the new weapon doesn't fit.
				for _, fill in { id, false } do
					local build = Schema.copy(draft)
					for k, w in build.weapon_mounts do if w == old then build.weapon_mounts[k] = k == selected and id or fill end end
					if state.builder:setCandidate(build) then return true end
				end
			end
			if reason=="two weapon types per plane" then return false,reason end
			firstReason = firstReason or reason
		end
		if tostring(firstReason):find("incompatible") then
			local weapon, sizes = Catalog:get(id), {}
			for i = 1, body.mount_count do table.insert(sizes, i .. " " .. body.mount_types[i]) end
			return false, string.format("%s needs a %s mount%s, and none is free. Mounts: %s.", weapon.name, weapon.class,
				weapon.class == "light" and "" or " (or bigger)", table.concat(sizes, ", "))
		end
		return false, firstReason
	end

	-- Six rows on the lined sheet: five crayon bars and the weapon capacity row.
	local ROW = 98
	local function statRow(name, art, y, tint)
		local strip = image(content, name .. "Row", art, 1370, y, 490, 84)
		strip.ScaleType = Enum.ScaleType.Stretch
		if tint then strip.ImageColor3 = tint end
		words(content, name .. "Name", name, 1392, y + 6, 190, 72, 38)
	end
	local function statSheet(stats, compare)
		image(content, "StatsSheet", Art.statsSheet, 1310, 255, 575, 640, 1).ScaleType = Enum.ScaleType.Stretch
		for i, entry in STATS do
			local name, row, bar, get, lo, hi, format, tint = table.unpack(entry)
			local y = 275 + (i - 1) * ROW
			statRow(name, Art.statRow[row], y, tint)
			local value = stats and get(stats) or lo
			local filled = math.clamp(math.ceil((value - lo) / (hi - lo) * 5), 1, 5)
			for k = 1, 5 do image(content, name .. "Bar" .. k, k &lt;= filled and Art.bar[bar] or Art.bar.empty, 1570 + (k - 1) * 50, y + 20, 46, 42) end
			local shown = string.format(format, value)
			if compare then shown ..= string.format(" (%+.0f)", get(compare) - value) end
			words(content, name .. "Value", shown, 1395, y + 64, 445, 26, 24).TextXAlignment = Enum.TextXAlignment.Right
		end
		-- Weapon capacity: how much weapon weight this body can carry (each weapon card shows its weight).
		if stats then
			local y = 275 + #STATS * ROW
			statRow("Capacity", Art.statRow.blue, y, Color3.fromRGB(215, 190, 255))
			local cells = math.max(stats.capacity, 1)
			local w = math.min(50, 250 / cells)
			for k = 1, cells do
				image(content, "Cap" .. k, k &lt;= stats.used_capacity and Art.bar.blue or Art.bar.empty, 1570 + (k - 1) * w, y + 20, w - 3, 42)
			end
			local used = words(content, "CapacityValue", string.format("%d of %d used", stats.used_capacity, stats.capacity), 1395, y + 64, 445, 26, 24)
			used.TextXAlignment = Enum.TextXAlignment.Right
			if stats.used_capacity &gt;= stats.capacity then used.TextColor3 = Color3.fromRGB(170, 30, 30) end
		end
	end

	local function preview(draft)
		-- Tinted sky-blue so the white paper plane stands out (white on white was hard to see).
		image(content, "PreviewPaper", Art.preview, 575, 265, 720, 590, 0).ImageColor3 = Color3.fromRGB(140, 185, 230)
		local view = Instance.new("ViewportFrame")
		view.Name, view.BackgroundTransparency = "PlanePreview", 1
		view.Position, view.Size = UDim2.fromOffset(625, 345), UDim2.fromOffset(620, 430) -- the blue area of the paper
		view.Ambient, view.LightDirection, view.Parent = Color3.fromRGB(220, 218, 210), Vector3.new(-1, -1, -1), content
		local world = Instance.new("WorldModel")
		world.Parent = view
		local model = Instance.new("Model")
		model.Parent = world
		Aircraft.build(model, draft, Catalog, true)
		local camera = Instance.new("Camera")
		camera.Parent, view.CurrentCamera, camera.FieldOfView = view, camera, 45
		-- Every build fills the same frame (Alan): the camera backs off until the plane's longer side (wingspan or
		-- nose to tail) nearly fills the frame's height; the wider frame takes the corners when it turns.
		local box, size = model:GetBoundingBox()
		local distance = math.max(size.X, size.Z) / 2 * 1.05 / math.sin(math.rad(camera.FieldOfView / 2))
		local function aim()
			camera.CFrame = CFrame.new(box.Position) * CFrame.Angles(0, state.angle, 0) * CFrame.Angles(state.pitch, 0, 0) * CFrame.new(0, 0, distance)
		end
		aim()
		-- Drag to turn the plane: sideways spins it, up and down tips it over to see the top or the underside.
		local last
		view.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then last = input.Position end end)
		view.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then last = nil end end)
		view.InputChanged:Connect(function(input)
			if last and input.UserInputType == Enum.UserInputType.MouseMovement then
				state.angle += (input.Position.X - last.X) * 0.015
				state.pitch = math.clamp(state.pitch - (input.Position.Y - last.Y) * 0.015, -1.5, 1.5)
				last = input.Position; aim()
			end
		end)
	end

	render = function()
		for _, child in content:GetChildren() do child:Destroy() end
		if not profile then return end
		local level = dev and 50 or game.Players.LocalPlayer:GetAttribute("Level") or 1
		local ownership = dev and everything or profile.ownership
		local saved = profile.presets[state.preset].loadout
		state.builder = state.builder or Builder.new(Catalog, saved, ownership, level)
		state.builder:update({ selectedLoadout = saved, selectedRevision = state.preset, profile = { ownership = ownership, level = level } })
		local builder = state.builder
		local draft = builder.candidate

		for i, slot in TABS do
			local tab = button(content, "Tab" .. slot, slot == state.slot and Art.tabSelected or Art.tab, slot, 45 + (i - 1) * 305, 150, 290, 110, 0,
				function() state.slot = slot; state.purchase = nil; render() end, 50)
			tab.Label.Position = UDim2.fromOffset(0, -8)
		end

		-- Part cards: a 2-column grid (every slot has at most 6 parts, so they all fit).
		local definitions = Catalog.structuresBySlot[state.slot] or (state.slot == "weapons" and Catalog.weapons) or Catalog.utilities
		for i, part in definitions do
			local owned = dev or profile.ownership[part.id] == true
			local equipped = draft[state.slot] == part.id or draft.utility == part.id and state.slot == "boost"
				or state.slot == "weapons" and table.find(draft.weapon_mounts, part.id) ~= nil
			local x, y = 45 + (i - 1) % 2 * 262, 272 + math.floor((i - 1) / 2) * 200
			local card = button(content, part.id, equipped and Art.cardSelected or Art.card, "", x, y, 252, 190, 0, function()
				if not owned then state.purchase = part; render(); return end
				state.purchase = nil
				if state.slot == "weapons" then choose(function() return placeWeapon(part.id) end)
				elseif state.slot == "boost" then choose(builder.selectUtility, part.id)
				else choose(builder.selectStructure, state.slot, part.id) end
			end)
			local name = words(card, "Name", part.name, 18, 14, 216, 96, 36)
			name.TextWrapped, name.TextYAlignment = true, Enum.TextYAlignment.Top
			local detail = owned and (equipped and "Equipped" or "Owned") or string.format("%d Paper, lvl %d", part.paper_price, part.min_level)
			if state.slot == "weapons" then
				-- Damage (Alan): pips for how hard one shot hits, then damage per second.
				name.Size, name.TextWrapped, name.TextScaled = UDim2.fromOffset(216, 44), false, true -- long names shrink to one line
				local cap = Instance.new("UITextSizeConstraint")
				cap.MaxTextSize, cap.Parent = 34, name
				words(card, "HitLabel", "Hit", 18, 60, 50, 34, 26)
				local hit = Catalog.hitRating(part)
				for k = 1, 5 do image(card, "Hit" .. k, k &lt;= hit and Art.bar.red or Art.bar.empty, 62 + (k - 1) * 30, 64, 27, 26) end
				words(card, "DPS", string.format("%.0f damage per second", Catalog.weaponDPS(part)), 18, 96, 216, 30, 24)
				detail = string.format("%s, weight %d. %s", part.class, part.capacity, detail)
				words(card, "Status", detail, 18, 128, 216, 50, 21).TextWrapped = true
			else
				local info = words(card, "Status", detail, 18, 110, 216, 66, 24)
				info.TextWrapped, info.TextYAlignment = true, Enum.TextYAlignment.Top
			end
		end

		local valid, reason = builder:validate(draft)
		local stats = Catalog:deriveStats(draft)
		preview(draft)

		-- Under the plane: mounts (weapons tab), the no-booster card (boost tab), or the purchase card.
		local note = builder.message ~= "" and builder.message or (not valid and tostring(reason))
			or game.Players.LocalPlayer:GetAttribute("MenuMessage") or ""
		if state.purchase then
			local part = state.purchase
			local candidate = assert(Schema.copy(draft))
			if state.slot == "weapons" then candidate.weapon_mounts[math.min(state.mount, Catalog:get(candidate.body).mount_count)] = part.id
			elseif state.slot == "boost" then candidate.utility = part.id
			else
				candidate[state.slot] = part.id
				if state.slot == "body" then
					local mounts = {}
					for i = 1, part.mount_count do mounts[i] = candidate.weapon_mounts[i] or false end
					candidate.weapon_mounts = mounts
				end
			end
			statSheet(Catalog:deriveStats(candidate) or stats, stats)
			note = string.format("%s: %d Paper, level %d. Bars show the plane with it.", part.name, part.paper_price, part.min_level)
			button(content, "BuyPart", Art.buttonGreen, "Buy", 640, 770, 260, 90, -1, function()
				api.action:FireServer("purchasePart", part.id); state.purchase = nil; render()
			end, 46)
			button(content, "CancelBuy", Art.tab, "Cancel", 930, 770, 260, 90, 1, function() state.purchase = nil; render() end, 40)
		else
			statSheet(stats)
			if state.slot == "weapons" then
				local body = Catalog:get(draft.body)
				local groups=assert(CombatRules.triggerGroups(draft))
				for i = 1, body.mount_count do
					local part = draft.weapon_mounts[i] and Catalog:get(draft.weapon_mounts[i])
					local mount = button(content, "Mount" .. i, i == state.mount and Art.tabSelected or Art.tab,
						string.format("%d %s%s\n%s", i, body.mount_types[i], part and (groups[i]==1 and " / L" or " / R") or "", part and part.name or "empty"),
						600 + (i - 1) % 3 * 228, 690 + math.floor((i - 1) / 3) * 88, 218, 82, 0, function() state.mount = i; render() end, 26)
					mount.Label.TextWrapped = true
				end
				button(content, "ClearMount", Art.buttonGreen, "Clear mount " .. state.mount, 1090, 280, 200, 70, 3, function() choose(builder.selectMount, state.mount, false) end, 28)
			elseif state.slot == "boost" then
				button(content, "NoBoost", Art.tab, "No booster", 840, 775, 240, 80, 0, function() choose(builder.selectUtility, nil) end, 32)
			end
		end
		local message = words(content, "Message", note, 590, 852, 710, 50, 30)
		local problem = builder.message ~= "" or not valid
		message.TextColor3, message.TextWrapped = problem and Color3.fromRGB(170, 30, 30) or Color3.fromRGB(30, 110, 50), true

		-- Saved builds 1-5 and Save.
		for i = 1, 5 do
			button(content, "Preset" .. i, i == state.preset and Art.slotSelected or Art.slot, tostring(i), 600 + (i - 1) * 125, 905, 110, 110, 0, function()
				state.preset = i; state.purchase = nil; builder:reset(profile.presets[i].loadout, i)
				api.action:FireServer("selectPreset", i); render()
			end, 60)
		end
		button(content, "SavePreset", Art.buttonGreen, "Save build", 1320, 900, 560, 125, -1, function()
			api.action:FireServer("savePreset", { slot = state.preset, name = profile.presets[state.preset].name, loadout = draft })
		end, 64)
		state.draft = draft
	end

	local self = { frame = cover }
	-- Redraw only when something the hangar shows changed: redrawing replaces the buttons, and a click that
	-- lands on a replaced button is lost (the menu refreshes the profile every 3 seconds).
	local shown
	function self.update(player, newProfile)
		local key = newProfile and game:GetService("HttpService"):JSONEncode({ newProfile.paper, newProfile.ownership, newProfile.presets,
			player:GetAttribute("MenuMessage") })
		if key == shown and content:FindFirstChild("SavePreset") then return end
		shown, profile = key, newProfile
		render()
	end
	function self.draft() return state.draft end
	return self
end

return Hangar
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ROJO_308">
          <Properties>
            <string name="Name">Loading</string>
            <string name="Source">-- Loading screen on the classroom bulletin board (same art as the main menu): crayon title, a card saying what is
-- loading, a crayon progress bar and the paper plane flying across. Its own pictures load first.
local Players = game:GetService("Players")
local Content = game:GetService("ContentProvider")
local TweenService = game:GetService("TweenService")
local Root = game.ReplicatedStorage:WaitForChild("FlyFightPaper")
local NativeAssets = require(Root:WaitForChild("Shared"):WaitForChild("NativeAssets"))
local UIAssets = require(Root.Shared.UIAssets)
local PaperUI = require(script.Parent.PaperUI)
local Loading = {}

local cover, status, fill, shownAt

-- Called first thing on join so the player never sees the bare room while the game connects.
function Loading.show()
	shownAt = os.clock()
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local menu, results = UIAssets.mainmenu, UIAssets.results
	local sheet
	cover, sheet = PaperUI.screen(playerGui, "LoadingClassroom", menu.bg)
	cover.Parent.DisplayOrder = 100
	local image, words = PaperUI.image, PaperUI.words
	image(sheet, "Title", menu.title, 450, 140, 1010, 340, -1)
	local card = image(sheet, "Card", results.xpCard, 560, 520, 800, 380, 1)
	status = words(card, "Status", "Loading the classroom", 70, 50, 660, 120, 66)
	status.TextXAlignment, status.TextWrapped = Enum.TextXAlignment.Center, true
	fill = image(card, "Fill", results.xpFill, 95, 205, 1, 80)
	fill.AnchorPoint, fill.Position, fill.ScaleType = Vector2.new(0, 0.5), UDim2.fromOffset(95, 245), Enum.ScaleType.Stretch
	image(card, "Frame", results.xpFrame, 80, 190, 640, 110).ScaleType = Enum.ScaleType.Stretch
	local plane = image(sheet, "Plane", menu.plane, -300, 380, 290, 200, 0)
	TweenService:Create(plane, TweenInfo.new(3.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1), {
		Position = UDim2.fromOffset(PaperUI.W + 300, 300), Rotation = 8,
	}):Play()
	cover.Visible = true
end

function Loading.run()
	if not cover then Loading.show() end

	local function progress(text, fraction)
		status.Text = text
		fill.Size = UDim2.fromOffset(610 * math.clamp(fraction, 0.02, 1), 80)
	end
	-- Seconds spent in each step, kept on workspace (LoadTimes) so slow joins can be traced.
	local started, times = shownAt or os.clock(), {}
	local function lap(step) table.insert(times, string.format("%s %.1f", step, os.clock() - started)); workspace:SetAttribute("LoadTimes", table.concat(times, ", ")) end
	lap("server ready")
	local room
	repeat room = workspace:FindFirstChild("Arena") or workspace:FindFirstChild("GreyboxRoom"); if not room then task.wait() end until room
	local assets = Root:WaitForChild("Assets")
	lap("room")
	while not NativeAssets.ready(room) or not NativeAssets.ready(assets) do task.wait(0.1) end
	lap("replicated")
	local list, seen = {}, {}
	local function collect(parent)
		for _, item in parent:GetDescendants() do
			-- Pictures only: PreloadAsync rejects mesh ids (all ~440 failed every join); Roblox streams meshes itself.
			if item:IsA("MeshPart") then
				if item.TextureID ~= "" and not seen[item.TextureID] then seen[item.TextureID] = true; table.insert(list, item.TextureID) end
			elseif item:IsA("Decal") or item:IsA("Texture") then
				if item.Texture ~= "" and not seen[item.Texture] then seen[item.Texture] = true; table.insert(list, item.Texture) end
			end
		end
	end
	collect(room)
	collect(assets)
	local failed, completed, loaded = {}, 0, 0
	-- PreloadAsync can stall for good, and in Studio it reports nearly every asset as failed even though the art
	-- shows. So stop waiting once nothing has answered for 4 s (30 s at most), and only retry when most assets
	-- loaded (if most failed, the check itself is broken and retrying just makes the player wait).
	local stopAt = os.clock() + 30
	local function preload(ids)
		for _, id in ids do failed[id] = true end
		local done, heard = false, os.clock()
		task.spawn(function()
			pcall(function()
				Content:PreloadAsync(ids, function(id, fetch)
					completed += 1
					heard = os.clock()
					progress("Unpacking the classroom", math.min(completed, #list) / math.max(#list, 1))
					if fetch == Enum.AssetFetchStatus.Success then failed[id] = nil; loaded += 1 end
				end)
			end)
			done = true
		end)
		while not done and os.clock() &lt; stopAt and os.clock() - heard &lt; 4 do task.wait(0.1) end
	end
	preload(list)
	lap("preloaded")
	for attempt = 1, 2 do
		local retry = {}
		for id in failed do table.insert(retry, id) end
		-- A handful of misses isn't worth seconds of waiting (one failed picture cost ~5 s): retry only past 5%.
		if #retry &lt;= #list * 0.05 or loaded &lt; #retry or os.clock() + attempt &gt;= stopAt then break end
		progress("Still unpacking a few things...", 1)
		task.wait(attempt)
		preload(retry)
	end
	local failures = 0
	for _ in failed do failures += 1 end
	workspace:SetAttribute("AssetLoadFailures", failures)
	if failures &gt; #list * 0.05 and loaded &gt; 0 then
		progress("A few pictures didn't load. You can still play; rejoin later to retry.", 1)
		task.wait(1.5)
	end
	lap("done")
	cover.Parent:Destroy()
	Root.RoundAction:FireServer("mapReady")
end

return Loading
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ROJO_309">
          <Properties>
            <string name="Name">MenuBoard</string>
            <string name="Source">-- Main menu as a classroom bulletin board (Alan's approved concept: assets/references/ui-concepts/main-menu.png).
local TweenService = game:GetService("TweenService")
local Root = game.ReplicatedStorage:WaitForChild("FlyFightPaper")
local Art = require(Root.Shared.UIAssets).mainmenu
local PaperUI = require(script.Parent.PaperUI)
local Board = {}

-- actions = { play, hangar, settings, tutorial, shop (Studio only, may be nil) }
function Board.new(playerGui, actions)
	local cover, sheet = PaperUI.screen(playerGui, "MenuBoard", Art.bg)
	local image, button = PaperUI.image, PaperUI.button
	local pieces = {
		image(sheet, "Drawing1", Art.drawing1, 105, 180, 390, 400, -4),
		image(sheet, "Drawing2", Art.drawing2, 165, 610, 450, 380, 3),
		image(sheet, "Photo", Art.photo, 1270, 610, 560, 420, 2),
		image(sheet, "Plane", Art.plane, 1230, 440, 290, 200, 0),
		image(sheet, "Title", Art.title, 450, 105, 1010, 340, -1),
	}
	local card = image(sheet, "StatsCard", Art.card, 1480, 110, 370, 470, 3)
	local stats = PaperUI.words(card, "Stats", "", 70, 70, 290, 380, 44)
	stats.TextYAlignment, stats.LineHeight = Enum.TextYAlignment.Top, 1.15
	table.insert(pieces, card)

	local buttons = Instance.new("Frame")
	buttons.Name, buttons.BackgroundTransparency, buttons.Size = "Buttons", 1, UDim2.fromOffset(PaperUI.W, PaperUI.H)
	buttons.Parent = sheet
	table.insert(pieces, button(buttons, "Play", Art.strip.yellow, "Play", 690, 445, 540, 140, -1, actions.play, 100))
	table.insert(pieces, button(buttons, "Hangar", Art.strip.blue, "Hangar", 710, 600, 500, 120, 1, actions.hangar))
	table.insert(pieces, button(buttons, "Settings", Art.strip.green, "Settings", 710, 735, 500, 120, -1, actions.settings))
	table.insert(pieces, button(buttons, "Tutorial", Art.strip.red, "Tutorial", 715, 870, 490, 120, 0.5, actions.tutorial))
	if actions.shop then
		table.insert(pieces, button(buttons, "Shop", Art.strip.yellow, "Shop (dev)", 1580, 560, 250, 70, 4, actions.shop, 34))
	end
	PaperUI.popIn(cover, pieces)
	local plane = sheet.Plane
	TweenService:Create(plane, TweenInfo.new(2.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {
		Position = plane.Position + UDim2.fromOffset(-14, -18), Rotation = -5,
	}):Play()

	local self = { frame = cover }
	function self.update(player, profile)
		local s = profile and profile.statistics or {}
		stats.Text = string.format("Level %d\nPaper %d\nPlanes downed %d\nWins %d\nMatches %d",
			player:GetAttribute("Level") or 1, player:GetAttribute("Paper") or 0, s.eliminations or 0, s.wins or 0, s.matches or 0)
	end
	return self
end

return Board
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ROJO_310">
          <Properties>
            <string name="Name">MenuController</string>
            <string name="Source">local Players=game:GetService("Players")
local Input=game:GetService("UserInputService")
local GuiService=game:GetService("GuiService")
local Root=game.ReplicatedStorage:WaitForChild("FlyFightPaper")
local Hangar=require(script.Parent.Hangar)
local Options=require(script.Parent.Options)
local Tutorial=require(script.Parent.Tutorial)
local Board=require(script.Parent.MenuBoard)
local SettingsScreen=require(script.Parent.SettingsScreen)
local ResultsScreen=require(script.Parent.ResultsScreen)
local PauseScreen=require(script.Parent.PauseScreen)
local ShopScreen=require(script.Parent.ShopScreen)
local WaitScreen=require(script.Parent.WaitScreen)
local PaperUI=require(script.Parent.PaperUI)
local Menu={}
function Menu.start()
 local player=Players.LocalPlayer
 local action=Root:WaitForChild("RoundAction")
 local gui=Instance.new("ScreenGui");gui.Name="GameMenu";gui.DisplayOrder=6;gui.IgnoreGuiInset=true;gui.ResetOnSpawn=false;gui.Parent=player:WaitForChild("PlayerGui")
 local openButton=PaperUI.button(gui,"OpenMenu",require(Root.Shared.UIAssets).mainmenu.strip.yellow,"Menu",16,64,150,52,-2,function()end,30)
 openButton.Label.TextColor3=PaperUI.INK
 local state={screen="home",snapshot=nil,profile=nil,overlay=false,lastPhase=nil}
 local render
 local function overlay(open)
  state.overlay=open
  -- Opening the menu brings the round results back if Stay hid them.
  if open then state.resultsHidden=false end
  Root:SetAttribute("OverlayOpen",open);action:FireServer("overlay",open)
  if render then render() end
 end
 local function home()
  state.screen="home";render()
 end
 local board=Board.new(gui.Parent,{
  play=function()action:FireServer("join")end,
  hangar=function()state.screen="hangar";action:FireServer("profile");render()end,
  settings=function()state.screen="settings";render()end,
  tutorial=function()overlay(false);Tutorial.begin()end,
  -- The mock shop is Studio-only; the server also refuses it on real profiles.
  shop=game:GetService("RunService"):IsStudio() and function()state.screen="shop";render()end or nil,
 })
 local settingsScreen=SettingsScreen.new(gui.Parent,{
  save=function(settings)action:FireServer("settings",settings);Options.apply(settings)end,
  back=function()home()end,
 })
 local hangarScreen
 hangarScreen=Hangar.new(gui.Parent,{
  action=action,
  back=function()home()end,
  fly=function()
   local draft=hangarScreen.draft();home();overlay(false)
   -- From the main menu, join first; the build is fitted once our plane is waiting at a desk.
   if not player:GetAttribute("InMatch") then action:FireServer("join") end
   task.spawn(function()
    for _=1,40 do
     local plane=workspace:FindFirstChild("Planes") and workspace.Planes:FindFirstChild(tostring(player.UserId))
     if plane and plane:GetAttribute("State")=="DESK" then Root.FlightAction:FireServer("loadout",draft);return end
     task.wait(.25)
    end
   end)
  end,
 })
 -- Paper screens drawn full-screen; anything not listed still uses the dark panel.
 local resultsScreen=ResultsScreen.new(gui.Parent,{
  vote=function(mode)action:FireServer("vote",mode)end,
  -- Stay: put the results away and look around the classroom until the next round; Tab or Menu brings them back.
  stay=function()state.resultsHidden=true;overlay(false)end,
  leave=function()action:FireServer("withdraw",true);overlay(false);home()end,
 })
 local pauseScreen=PauseScreen.new(gui.Parent,{
  resume=function()overlay(false)end,
  hangar=function()state.screen="hangar";action:FireServer("profile");render()end,
  settings=function()state.screen="settings";render()end,
  tutorial=function()overlay(false);Tutorial.begin()end,
  leave=function()action:FireServer("withdraw",true);overlay(false);home()end,
 })
 local shopScreen=ShopScreen.new(gui.Parent,{buy=function(key)action:FireServer("mockProduct",key)end,back=function()home()end})
 local waitScreen=WaitScreen.new(gui.Parent,{cancel=function()action:FireServer("withdraw",true)end})
 local paper={home=board,settings=settingsScreen,hangar=hangarScreen,results=resultsScreen,pause=pauseScreen,shop=shopScreen,queued=waitScreen}
 -- Open a menu screen directly (used by Studio photo mode).
 function Menu.show(screen)
  if player:GetAttribute("InMatch") and not state.overlay then overlay(true) end
  state.screen=screen;action:FireServer("profile");render()
 end
-- The gap between rounds: results, then the vote, then the countdown.
local function between(phase)return phase=="RESULTS" or phase=="VOTE" or phase=="COUNTDOWN" end
render=function()
  local inMatch=player:GetAttribute("InMatch")==true
  local snap=state.snapshot
  local results=inMatch and snap and between(snap.phase) and not state.resultsHidden
  local queued=player:GetAttribute("JoinQueued")==true
  local open=not inMatch or state.overlay or results or queued
  openButton.Visible=inMatch and not open
  -- Which paper screen shows: waiting for a desk, round results, the in-match clipboard, or the chosen screen.
  local key=queued and "queued" or state.screen=="home" and (results and "results" or inMatch and "pause") or state.screen
  local current=open and paper[key]
  for _,screen in pairs(paper) do if screen~=current then screen.frame.Visible=false end end
  if current then current.update(player,state.profile,snap);current.frame.Visible=true end
 end
 openButton.Activated:Connect(function()state.screen="home";overlay(true)end)
 Input.InputBegan:Connect(function(input,processed)
  if input.KeyCode==Enum.KeyCode.Tab and not Input:GetFocusedTextBox() and player:GetAttribute("InMatch") then state.screen="home";overlay(not state.overlay)
  elseif input.KeyCode==Enum.KeyCode.Escape and player:GetAttribute("InMatch") then state.screen="home";overlay(true) end
 end)
 GuiService.MenuOpened:Connect(function()if player:GetAttribute("InMatch") then overlay(true) end end)
 Root:WaitForChild("RoundView").OnClientEvent:Connect(function(snap)
  state.snapshot=snap
  local totals=snap.voteTotals or {};local voteKey=tostring(totals.FFA)..":"..tostring(totals.TDM)..":"..tostring(totals.CONTROL)
  if state.lastPhase~=snap.phase then
   local roundStarts=between(state.lastPhase) and not between(snap.phase)
   state.lastPhase=snap.phase;state.screen="home"
   -- Stay lasts until the next round starts, and a new round always starts with the menu put away.
   if not between(snap.phase) then state.resultsHidden=false end
   if roundStarts and state.overlay then overlay(false) else render() end
  elseif state.lastVotes~=voteKey and snap.phase=="VOTE" then render() end
  state.lastVotes=voteKey
 end)
 Root:WaitForChild("ProfileView").OnClientEvent:Connect(function(profile)
  state.profile=profile;Options.apply(profile.settings)
  render() -- screens skip the redraw themselves when nothing they show changed
 end)
 player:GetAttributeChangedSignal("InMatch"):Connect(function()state.screen="home";state.overlay=false;Root:SetAttribute("OverlayOpen",false);render()end)
 player:GetAttributeChangedSignal("ProfileStatus"):Connect(render)
 player:GetAttributeChangedSignal("JoinQueued"):Connect(render)
 player:GetAttributeChangedSignal("MenuMessage"):Connect(render)
 render();action:FireServer("profile")
 task.spawn(function()while gui.Parent do task.wait(3);action:FireServer("profile") end end)
end
return Menu
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ROJO_311">
          <Properties>
            <string name="Name">Options</string>
            <string name="Source">local Root=game.ReplicatedStorage.FlyFightPaper
local Options={}
-- Graphics quality: the game can't move the player's own Roblox graphics slider, so it turns its own heavier
-- lighting off instead (these Lighting changes stay on this player's screen). Effects counts read the attribute.
local Lighting=game:GetService("Lighting")
local function applyQuality(quality)
 Lighting.GlobalShadows=quality~="Low"
 for _,name in ipairs({"SunRays","Bloom"}) do local effect=Lighting:FindFirstChild(name);if effect then effect.Enabled=quality=="High" end end
 local air=Lighting:FindFirstChildOfClass("Atmosphere");if air then air.Density=quality=="Low" and 0 or 0.06 end
end
function Options.apply(settings)
 applyQuality(settings.quality)
 Root:SetAttribute("Sensitivity",settings.sensitivity);Root:SetAttribute("SoundVolume",settings.sound);Root:SetAttribute("MusicVolume",settings.music)
 Root:SetAttribute("ReducedShake",settings.reducedShake);Root:SetAttribute("Quality",settings.quality);Root:SetAttribute("CrosshairColor",settings.crosshairColor);Root:SetAttribute("CrosshairSize",settings.crosshairSize)
end
return Options
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ROJO_312">
          <Properties>
            <string name="Name">PaperUI</string>
            <string name="Source">-- Shared pieces for the paper-and-crayon menu screens (concepts: assets/references/ui-concepts/).
-- Each screen is a fixed 1920x1080 sheet that UIScale stretches to cover the screen; words are live text.
local TweenService = game:GetService("TweenService")
local PaperUI = {}

PaperUI.W, PaperUI.H = 1920, 1080
PaperUI.INK = Color3.fromRGB(28, 26, 30)
PaperUI.font = Font.new("rbxasset://fonts/families/Kalam.json", Enum.FontWeight.Bold)

-- A full-screen layer (own ScreenGui so its pieces stack simply) holding a hidden cover and the scaled sheet.
-- With no background ids the cover is a see-through dim (for overlays on top of the game). floating: the background
-- art has its own see-through edges (the game shows around it), so the cover is clear and the sheet fits inside.
function PaperUI.screen(playerGui, name, backgroundIds, floating)
	local layer = Instance.new("ScreenGui")
	layer.Name, layer.IgnoreGuiInset, layer.ResetOnSpawn, layer.DisplayOrder = name, true, false, 10
	layer.ZIndexBehavior, layer.Parent = Enum.ZIndexBehavior.Sibling, playerGui
	local cover = Instance.new("Frame")
	cover.Name, cover.Size, cover.BackgroundColor3, cover.BorderSizePixel = "Cover", UDim2.fromScale(1, 1), Color3.fromRGB(150, 105, 60), 0
	cover.ClipsDescendants, cover.Visible, cover.Parent = true, false, layer -- hidden until shown (plays the pop-in)
	if #backgroundIds == 0 then cover.BackgroundColor3, cover.BackgroundTransparency = Color3.fromRGB(20, 14, 8), 0.45 end
	if floating then cover.BackgroundTransparency = 1 end
	local sheet = Instance.new("Frame")
	sheet.Name, sheet.AnchorPoint, sheet.Position = "Sheet", Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.5)
	sheet.Size, sheet.BackgroundTransparency, sheet.Parent = UDim2.fromOffset(PaperUI.W, PaperUI.H), 1, cover
	local scale = Instance.new("UIScale")
	scale.Parent = sheet
	local function fit()
		local view = workspace.CurrentCamera.ViewportSize
		-- Backgrounds cover the screen (cropping frame edges on odd shapes); overlays fit inside it.
		scale.Scale = (#backgroundIds &gt; 0 and not floating and math.max or math.min)(view.X / PaperUI.W, view.Y / PaperUI.H)
	end
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fit)
	fit()
	-- Background plates come as a 2x2 grid of tiles (Roblox images max out at 1024 pixels).
	for i, id in backgroundIds do
		local tile = PaperUI.image(sheet, "Background" .. i, id, ((i - 1) % 2) * PaperUI.W / 2, math.floor((i - 1) / 2) * PaperUI.H / 2, PaperUI.W / 2, PaperUI.H / 2)
		tile.ScaleType = Enum.ScaleType.Stretch
	end
	return cover, sheet
end

-- Pieces are centred on their box so they can pop in from the middle.
function PaperUI.image(parent, name, id, x, y, w, h, rotation)
	local label = Instance.new("ImageLabel")
	label.Name, label.Image, label.BackgroundTransparency = name, id, 1
	label.AnchorPoint = Vector2.new(0.5, 0.5)
	label.Position, label.Size, label.Rotation = UDim2.fromOffset(x + w / 2, y + h / 2), UDim2.fromOffset(w, h), rotation or 0
	label.ScaleType = Enum.ScaleType.Fit
	label.Parent = parent
	return label
end

function PaperUI.words(parent, name, value, x, y, w, h, size)
	local label = Instance.new("TextLabel")
	label.Name, label.Text, label.BackgroundTransparency = name, value, 1
	label.Position, label.Size = UDim2.fromOffset(x, y), UDim2.fromOffset(w, h)
	label.FontFace, label.TextSize, label.TextColor3 = PaperUI.font, size, PaperUI.INK
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = parent
	return label
end

-- A paper button with a word on it: grows and tilts under the mouse, squishes when pressed.
function PaperUI.button(parent, name, id, label, x, y, w, h, rotation, callback, size)
	local button = Instance.new("ImageButton")
	button.Name, button.Image, button.BackgroundTransparency = name, id, 1
	button.AnchorPoint = Vector2.new(0.5, 0.5)
	button.Position, button.Size, button.Rotation = UDim2.fromOffset(x + w / 2, y + h / 2), UDim2.fromOffset(w, h), rotation or 0
	button.ScaleType = Enum.ScaleType.Stretch
	button.Parent = parent
	local text = PaperUI.words(button, "Label", label, 0, 0, w, h, size or 80)
	text.Size, text.TextXAlignment = UDim2.fromScale(1, 1), Enum.TextXAlignment.Center
	local info = TweenInfo.new(0.12, Enum.EasingStyle.Quad)
	local function to(sx, sy, turn)
		TweenService:Create(button, info, { Size = UDim2.fromOffset(w * sx, h * sy), Rotation = (rotation or 0) + turn }):Play()
	end
	button.MouseEnter:Connect(function() to(1.05, 1.05, -1.5) end)
	button.MouseLeave:Connect(function() to(1, 1, 0) end)
	button.MouseButton1Down:Connect(function() to(0.95, 0.92, -1.5) end)
	button.MouseButton1Up:Connect(function() to(1.05, 1.05, -1.5) end)
	button.Activated:Connect(callback)
	return button
end

-- Every time the cover is shown, the named pieces pop onto the sheet one after another.
function PaperUI.popIn(cover, pieces)
	local start = {}
	for _, piece in pieces do start[piece] = { size = piece.Size, rotation = piece.Rotation } end
	local pop = TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	cover:GetPropertyChangedSignal("Visible"):Connect(function()
		if not cover.Visible then return end
		for i, piece in pieces do
			local base = start[piece]
			piece.Size = UDim2.fromOffset(base.size.X.Offset * 0.6, base.size.Y.Offset * 0.6)
			piece.Rotation = base.rotation + (i % 2 == 0 and 8 or -8)
			task.delay(0.04 * i, function()
				TweenService:Create(piece, pop, { Size = base.size, Rotation = base.rotation }):Play()
			end)
		end
	end)
end

return PaperUI
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ROJO_313">
          <Properties>
            <string name="Name">PauseScreen</string>
            <string name="Source">-- In-match quick menu: a clipboard over the dimmed game (the match keeps going behind it).
-- Leaving asks first on a sticky note, because it ends this life and streak.
local Root = game.ReplicatedStorage:WaitForChild("FlyFightPaper")
local Art = require(Root.Shared.UIAssets)
local PaperUI = require(script.Parent.PaperUI)
local PauseScreen = {}

-- api = { resume(), hangar(), settings(), tutorial(), leave() }
function PauseScreen.new(playerGui, api)
	local cover, sheet = PaperUI.screen(playerGui, "PauseScreen", {})
	local image, words, button = PaperUI.image, PaperUI.words, PaperUI.button
	local strip = Art.mainmenu.strip
	local board = image(sheet, "Clipboard", Art.ingame.clipboard, 610, 40, 700, 1000, 0)
	local title = words(sheet, "Title", "Still flying!", 700, 215, 520, 90, 70)
	title.TextXAlignment = Enum.TextXAlignment.Center
	local note = words(sheet, "Note", "Your plane keeps flying and can be hit while this is open.", 700, 300, 520, 80, 30)
	note.TextXAlignment, note.TextWrapped = Enum.TextXAlignment.Center, true
	local confirm = Instance.new("Frame")
	confirm.Name, confirm.BackgroundTransparency, confirm.Size, confirm.Visible = "Confirm", 1, UDim2.fromOffset(PaperUI.W, PaperUI.H), false
	confirm.ZIndex, confirm.Parent = 5, sheet
	local pieces = { board, title, note,
		button(sheet, "Resume", strip.yellow, "Keep flying", 700, 400, 520, 120, -1, api.resume, 72),
		button(sheet, "Hangar", strip.blue, "Hangar", 715, 530, 490, 100, 1, api.hangar),
		button(sheet, "Settings", strip.green, "Settings", 715, 640, 490, 100, -1, api.settings),
		button(sheet, "Tutorial", strip.yellow, "Tutorial", 715, 750, 490, 100, 0.5, api.tutorial),
		button(sheet, "Leave", strip.red, "Leave match", 715, 860, 490, 100, -0.5, function() confirm.Visible = true end, 64),
	}
	-- The sticky note sits on top of the clipboard when you press Leave.
	image(confirm, "Sticky", Art.ingame.stickyNote, 660, 260, 600, 540, 3)
	local ask = words(confirm, "Ask", "Leave the match?\nYou keep what you earned, but this life and streak end.", 720, 350, 480, 230, 40)
	ask.TextXAlignment, ask.TextWrapped = Enum.TextXAlignment.Center, true
	button(confirm, "ConfirmLeave", strip.red, "Leave", 720, 610, 220, 100, -2, function() confirm.Visible = false; api.leave() end, 52)
	button(confirm, "CancelLeave", strip.green, "Stay", 980, 610, 220, 100, 2, function() confirm.Visible = false end, 52)
	PaperUI.popIn(cover, pieces)
	cover:GetPropertyChangedSignal("Visible"):Connect(function() if not cover.Visible then confirm.Visible = false end end)

	local self = { frame = cover }
	function self.update() end
	return self
end

return PauseScreen
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ROJO_314">
          <Properties>
            <string name="Name">ResultsScreen</string>
            <string name="Source">-- Round results on lined paper pinned to cork (Alan's approved concept: assets/references/ui-concepts/results.png).
local Root = game.ReplicatedStorage:WaitForChild("FlyFightPaper")
local Art = require(Root.Shared.UIAssets).results
local Economy = require(Root.Shared.EconomyRules)
local Catalog = require(Root.Shared.Catalog).new(require(Root.Generated.Catalog), require(Root.Generated.Gameplay))
local PaperUI = require(script.Parent.PaperUI)
local ResultsScreen = {}

local COLUMNS = { -- header, x, width, value
	{ "#", 70, 60, function(row) return tostring(row.place or "-") end },
	{ "Pilot", 140, 470, function(row) return row.displayName end },
	{ "Downed", 620, 160, function(row) return tostring(row.kills) end },
	{ "Assists", 790, 160, function(row) return tostring(row.assists) end },
	{ "Points", 960, 150, function(row) return tostring(row.contribution) end },
	{ "Paper", 1120, 130, function(row) return tostring(row.paper or 0) end },
	{ "XP", 1260, 120, function(row) return tostring(row.xp or 0) end },
}
local MODES = { { "FFA", "Free-for-all", "blue" }, { "TDM", "Team dogfight", "pink" }, { "CONTROL", "Airspace Control", "green" } }

-- The cheapest part unlocked at the next level above yours, for the "next unlock" card.
local function nextUnlock(level)
	local best
	local function consider(part)
		if part.min_level &gt; level and (not best or part.min_level &lt; best.min_level or part.min_level == best.min_level and part.paper_price &lt; best.paper_price) then best = part end
	end
	for _, list in { Catalog.weapons, Catalog.utilities } do for _, part in list do consider(part) end end
	for _, list in Catalog.structuresBySlot do for _, part in list do consider(part) end end
	return best
end

-- api = { vote(mode), stay(), leave() }
function ResultsScreen.new(playerGui, api)
	local cover, sheet = PaperUI.screen(playerGui, "ResultsScreen", Art.bg)
	local image, words, button = PaperUI.image, PaperUI.words, PaperUI.button
	local content = Instance.new("Frame")
	content.Name, content.BackgroundTransparency, content.Size, content.Parent = "Content", 1, UDim2.fromOffset(PaperUI.W, PaperUI.H), sheet

	local self = { frame = cover }
	function self.update(player, profile, snap)
		for _, child in content:GetChildren() do child:Destroy() end
		-- Scoreboard: header plus one ruled line per pilot (12 fit); the winner gets highlighter and a star, you are in red.
		for _, column in COLUMNS do
			local header = words(content, "Head" .. column[1], column[1], column[2], 205, column[3], 55, 36)
			header.TextColor3 = Color3.fromRGB(30, 60, 140)
		end
		local rows = snap and snap.result and snap.result.participants or {}
		for i, row in rows do
			if i &gt; 12 then break end
			local y = 262 + (i - 1) * 44
			if i == 1 then
				local mark = image(content, "Winner", Art.rowHighlight, 60, y - 4, 1330, 50)
				mark.ScaleType, mark.ImageTransparency = Enum.ScaleType.Stretch, 0.25
				image(content, "Star", Art.goldStar, 1340, y - 10, 60, 60)
			end
			for _, column in COLUMNS do
				local cell = words(content, column[1] .. i, column[4](row), column[2], y, column[3], 44, 32)
				cell.TextTruncate = Enum.TextTruncate.AtEnd
				if row.displayName == player.DisplayName or row.displayName == player.Name then cell.TextColor3 = Color3.fromRGB(180, 40, 40) end
			end
		end

		-- XP card: crayon bar filled to how far you are into this level.
		local xpMilli = (profile and profile.xp or 0) * 1000
		local level, into, need = Economy.levelForXP(xpMilli)
		-- At the level cap there is no next level: show a full bar and "max level".
		if level == require(Root.Generated.Economy).level_cap then need = nil end
		image(content, "XPCard", Art.xpCard, 1430, 195, 460, 270, 2)
		words(content, "XPTitle", "XP", 1475, 215, 120, 70, 60)
		words(content, "Level", "Level " .. tostring(level or 1), 1600, 225, 250, 60, 44).TextXAlignment = Enum.TextXAlignment.Right
		local fraction = need and need &gt; 0 and math.clamp(into / need, 0, 1) or 1
		local fill = image(content, "XPFill", Art.xpFill, 1480, 310, 360 * fraction, 54)
		fill.ScaleType = Enum.ScaleType.Stretch
		image(content, "XPFrame", Art.xpFrame, 1470, 300, 380, 72).ScaleType = Enum.ScaleType.Stretch
		local count = words(content, "XPCount", need and string.format("%d / %d", into // 1000, need // 1000) or "max level", 1470, 385, 380, 50, 40)
		count.TextXAlignment = Enum.TextXAlignment.Center

		-- Next unlock card.
		image(content, "UnlockCard", Art.unlockCard, 1430, 480, 460, 290, -2)
		words(content, "UnlockTitle", "Next unlock", 1480, 495, 360, 60, 46)
		local part = nextUnlock(level or 1)
		local unlock = words(content, "Unlock", part and string.format("%s\nat level %d", part.name, part.min_level) or "Everything unlocked!", 1485, 570, 350, 170, 38)
		unlock.TextWrapped, unlock.TextXAlignment = true, Enum.TextXAlignment.Center

		-- Vote buttons (live only while voting) and the leave/stay choices.
		local voting = snap and snap.phase == "VOTE"
		for i, mode in MODES do
			local votes = snap and snap.voteTotals and snap.voteTotals[mode[1]] or 0
			local b = button(content, "Vote" .. mode[1], Art.strip[mode[3]], string.format("%s (%d)", mode[2], votes), 70 + (i - 1) * 440, 895, 420, 150, (i - 2) * 1.5,
				function() if voting then api.vote(mode[1]) end end, 44)
			if not voting then b.ImageTransparency, b.Label.TextTransparency = 0.45, 0.45 end
		end
		local help = words(content, "VoteHelp", voting and "Pick the next mode!" or snap and snap.phase == "COUNTDOWN" and "Next round: " .. tostring(snap.nextMode) or "Voting opens soon.", 1440, 785, 440, 50, 34)
		help.TextColor3 = Color3.fromRGB(250, 245, 230)
		button(content, "NextRound", Art.strip.green, "Stay", 1440, 835, 210, 95, -2, api.stay, 44)
		button(content, "MainMenu", Art.strip.pink, "Menu", 1665, 835, 210, 95, 2, api.leave, 44)
	end
	return self
end

return ResultsScreen
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ROJO_315">
          <Properties>
            <string name="Name">SettingsScreen</string>
            <string name="Source">-- Settings on a taped sheet of lined paper (Alan's approved concept: assets/references/ui-concepts/settings.png).
-- Sliders are pencils on rulers, crosshair colours are dot stickers, choices are paper tabs.
local Input = game:GetService("UserInputService")
local Root = game.ReplicatedStorage:WaitForChild("FlyFightPaper")
local Art = require(Root.Shared.UIAssets).settings
local PaperUI = require(script.Parent.PaperUI)
local SettingsScreen = {}

local COLORS = { "red", "blue", "green", "yellow", "purple", "white" }
local SWATCH = { green = Color3.fromRGB(60, 255, 90), red = Color3.fromRGB(255, 60, 70), blue = Color3.fromRGB(0, 235, 255),
	yellow = Color3.fromRGB(255, 225, 40), purple = Color3.fromRGB(190, 110, 255), white = Color3.fromRGB(250, 250, 250) }
local SIZES = { "Small", "Medium", "Large" }

-- api = { save(settings), back() }
function SettingsScreen.new(playerGui, api)
	local cover, sheet = PaperUI.screen(playerGui, "SettingsScreen", Art.bg)
	local image, words = PaperUI.image, PaperUI.words
	local settings
	local refresh = {}
	local function save() api.save(settings) end

	local Options = require(script.Parent.Options)
	-- A pencil on a ruler. Drag the pencil (or click the ruler); the value saves when the mouse is released.
	local function slider(key, label, y, lo, hi, step, show, minLabel, maxLabel)
		words(sheet, key .. "Label", label, 285, y - 72, 520, 60, 52)
		local ruler = image(sheet, key .. "Ruler", Art.ruler, 280, y, 510, 72)
		ruler.ScaleType = Enum.ScaleType.Stretch
		local pencil = Instance.new("ImageButton")
		pencil.Name, pencil.Image, pencil.BackgroundTransparency, pencil.AnchorPoint = key .. "Pencil", Art.pencil, 1, Vector2.new(0.5, 0.5)
		pencil.Size, pencil.ScaleType, pencil.ZIndex, pencil.Parent = UDim2.fromOffset(150, 52), Enum.ScaleType.Fit, 3, sheet
		local tag = image(sheet, key .. "Tag", Art.tag, 810, y - 8, 120, 88)
		local value = words(tag, "Value", "", 0, 0, 120, 88, 44)
		value.Size, value.TextXAlignment = UDim2.fromScale(1, 1), Enum.TextXAlignment.Center
		words(sheet, key .. "Min", minLabel, 285, y + 74, 120, 36, 30)
		words(sheet, key .. "Max", maxLabel, 690, y + 74, 100, 36, 30).TextXAlignment = Enum.TextXAlignment.Right
		local left, width = 280 + 40, 510 - 80 -- the pencil's travel inside the ruler's ends
		refresh[key] = function()
			local t = (settings[key] - lo) / (hi - lo)
			pencil.Position = UDim2.fromOffset(left + width * t, y + 36)
			value.Text = show(settings[key])
		end
		local dragging = false
		local function follow(screenX)
			local a, s = ruler.AbsolutePosition.X, ruler.AbsoluteSize.X
			local t = math.clamp((screenX - a - s * 40 / 510) / (s * width / 510), 0, 1)
			settings[key] = math.clamp(math.round((lo + t * (hi - lo)) / step) * step, lo, hi)
			refresh[key]()
			Options.apply(settings) -- heard and felt while dragging; saved on release
		end
		local function grab(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true; follow(input.Position.X) end
		end
		pencil.InputBegan:Connect(grab)
		ruler.InputBegan:Connect(grab)
		Input.InputChanged:Connect(function(input)
			if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then follow(input.Position.X) end
		end)
		Input.InputEnded:Connect(function(input)
			if dragging and input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false; save() end
		end)
	end
	slider("sensitivity", "Mouse sensitivity", 345, 0.2, 3, 0.1, function(v) return string.format("%.1f", v) end, "0.2", "3.0")
	slider("sound", "Sound", 580, 0, 1, 0.05, function(v) return string.format("%d%%", math.round(v * 100)) end, "0%", "100%")
	slider("music", "Music", 805, 0, 1, 0.05, function(v) return string.format("%d%%", math.round(v * 100)) end, "0%", "100%")

	-- Crosshair colour: dot stickers, a check on the chosen one, and a live preview card.
	words(sheet, "ColorLabel", "Crosshair color", 1020, 262, 520, 60, 52)
	local check = image(sheet, "Check", Art.check, 0, 0, 60, 60)
	check.ZIndex = 3 -- above the stickers
	for i, color in COLORS do
		local dot = Instance.new("ImageButton")
		dot.Name, dot.Image, dot.BackgroundTransparency = "Sticker" .. color, Art.sticker[color], 1
		dot.Position, dot.Size, dot.Parent = UDim2.fromOffset(1010 + (i - 1) * 88, 345), UDim2.fromOffset(82, 82), sheet
		dot.Activated:Connect(function() settings.crosshairColor = color; refresh.color(); save() end)
	end
	local card = image(sheet, "CrosshairCard", Art.crosshairCard, 1570, 270, 180, 180, 2)
	local ring = Instance.new("Frame")
	ring.Name, ring.AnchorPoint, ring.Position, ring.BackgroundTransparency = "Ring", Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.5), 1
	Instance.new("UICorner", ring).CornerRadius = UDim.new(0.5, 0)
	local stroke = Instance.new("UIStroke", ring)
	stroke.Thickness = 4
	ring.Parent = card
	local dotPreview = Instance.new("Frame")
	dotPreview.AnchorPoint, dotPreview.Position, dotPreview.BackgroundColor3 = Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.5), SWATCH.green
	Instance.new("UICorner", dotPreview).CornerRadius = UDim.new(0.5, 0)
	dotPreview.Parent = card
	refresh.color = function()
		local i = table.find(COLORS, settings.crosshairColor) or 2
		check.Position = UDim2.fromOffset(1010 + (i - 1) * 88 + 41, 386)
		stroke.Color = SWATCH[settings.crosshairColor] or SWATCH.blue
	end

	-- A row of paper tabs; the chosen one is bright.
	local function tabs(key, label, y, options, names, onImage)
		words(sheet, key .. "Label", label, 1020, y - 72, 600, 60, 52)
		local row = {}
		for i, option in options do
			local tab = PaperUI.button(sheet, key .. tostring(option), Art.tabOff, names[i], 1020 + (i - 1) * 200, y, 185, 82, 0,
				function() settings[key] = option; refresh[key](); save() end, 40)
			row[option] = tab
		end
		refresh[key] = function()
			for option, tab in row do tab.Image = settings[key] == option and onImage or Art.tabOff end
		end
	end
	tabs("crosshairSize", "Crosshair size", 540, SIZES, SIZES, Art.tabOn)
	tabs("reducedShake", "Reduced shake", 720, { true, false }, { "On", "Off" }, Art.tabGreen)
	tabs("quality", "Graphics quality", 895, { "Low", "Medium", "High" }, { "Low", "Medium", "High" }, Art.tabOn)
	refresh.crosshairSize = (function(base)
		return function()
			base()
			local s = ({ Small = 0.75, Medium = 1, Large = 1.4 })[settings.crosshairSize] or 1
			ring.Size, dotPreview.Size = UDim2.fromOffset(60 * s, 60 * s), UDim2.fromOffset(16 * s, 16 * s)
		end
	end)(refresh.crosshairSize)

	PaperUI.button(sheet, "Back", Art.tabGreen, "Back", 1640, 930, 200, 90, 3, api.back, 48)

	local self = { frame = cover }
	function self.update(_, profile)
		-- Take the saved settings only when the screen opens, so a background refresh can't undo a drag.
		if not profile or not profile.settings or (settings and cover.Visible) then return end
		settings = profile.settings
		settings.crosshairColor = settings.crosshairColor or "blue"
		settings.crosshairSize = settings.crosshairSize or "Medium"
		for _, fn in refresh do fn() end
	end
	return self
end

return SettingsScreen
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ROJO_316">
          <Properties>
            <string name="Name">ShopScreen</string>
            <string name="Source">-- Studio-only practice shop on the bulletin board: three index-card columns (2x XP, 2x Paper, Paper packs).
-- Buttons only simulate products; no Robux, and the server refuses it outside Studio.
local Root = game.ReplicatedStorage:WaitForChild("FlyFightPaper")
local Commerce = require(Root.Generated.Commerce)
local Art = require(Root.Shared.UIAssets)
local PaperUI = require(script.Parent.PaperUI)
local ShopScreen = {}

local COLUMNS = {
	{ title = "2x XP", strip = "blue", match = function(p) return p.benefit == "xp_seconds" or p.benefit == "permanent_xp" end, boost = "xp" },
	{ title = "2x Paper", strip = "green", match = function(p) return p.benefit == "paper_seconds" or p.benefit == "permanent_paper" end, boost = "paper" },
	{ title = "Paper packs", strip = "yellow", match = function(p) return p.benefit == "paper_balance" end },
}

-- Placeholder Robux prices (Alan picked the "typical set", 2026-10-08). Display only: real prices must come from
-- Roblox's product info once live sales are approved (docs/ECONOMY_AND_COMMERCE.md).
local PRICE = {
	xp_boost_15m = 25, xp_boost_30m = 45, xp_boost_60m = 75, xp_boost_180m = 179, xp_boost_300m = 249,
	paper_boost_15m = 25, paper_boost_30m = 45, paper_boost_60m = 75, paper_boost_180m = 179, paper_boost_300m = 249,
	paper_pack_1000 = 49, paper_pack_3500 = 149, paper_pack_10000 = 399,
	permanent_2x_xp = 499, permanent_2x_paper = 499,
}
local ROBUX_ICON = "rbxasset://textures/ui/common/robux@3x.png" -- Roblox's own Robux symbol, shipped with the client

local function label(product)
	if product.benefit == "paper_balance" then return string.format("%d Paper", product.amount) end
	if product.kind == "pass" then return "Forever" end
	local minutes = product.amount / 60
	local hours = minutes / 60
	return hours == 1 and "1 hour" or minutes &gt;= 60 and string.format("%g hours", hours) or string.format("%d minutes", minutes)
end

-- api = { buy(key), back() }
function ShopScreen.new(playerGui, api)
	local cover, sheet = PaperUI.screen(playerGui, "ShopScreen", Art.mainmenu.bg)
	local image, words, button = PaperUI.image, PaperUI.words, PaperUI.button
	local content = Instance.new("Frame")
	content.Name, content.BackgroundTransparency, content.Size, content.Parent = "Content", 1, UDim2.fromOffset(PaperUI.W, PaperUI.H), sheet
	local header = image(sheet, "Header", Art.ingame.tapeLabel, 560, 95, 800, 120, -1)
	header.ScaleType, header.SliceCenter, header.SliceScale = Enum.ScaleType.Slice, Rect.new(90, 30, 894, 104), 0.9
	local title = words(header, "Title", "Practice shop", 0, 4, 800, 70, 64)
	title.TextXAlignment = Enum.TextXAlignment.Center
	local warn = words(header, "Note", "Practice only: nothing is really bought.", 0, 66, 800, 44, 34)
	warn.TextXAlignment, warn.TextColor3 = Enum.TextXAlignment.Center, Color3.fromRGB(170, 30, 30)
	button(sheet, "Back", Art.mainmenu.strip.red, "Back", 1560, 120, 240, 90, 3, api.back, 50)

	local self = { frame = cover }
	local shown
	function self.update(player, profile)
		-- Redraw only on a change, so a click never lands on a button that was just replaced.
		local key = game:GetService("HttpService"):JSONEncode({ profile and profile.boosts, player:GetAttribute("MenuMessage") })
		if key == shown then return end
		shown = key
		for _, child in content:GetChildren() do child:Destroy() end
		local boosts = profile and profile.boosts or {}
		for c, column in COLUMNS do
			local x = 165 + (c - 1) * 545
			local card = image(content, "Card" .. c, Art.ingame.indexCard, x, 235, 500, 180, (c - 2) * 1.5)
			card.ScaleType = Enum.ScaleType.Stretch
			words(card, "Title", column.title, 30, 42, 440, 60, 54).TextXAlignment = Enum.TextXAlignment.Center
			local status = ""
			local forever = column.boost and boosts[column.boost == "xp" and "permanentXP" or "permanentPaper"]
			if column.boost then
				local minutes = (boosts[column.boost .. "Seconds"] or 0) / 60
				status = forever and "You have it forever" or string.format("%d minutes left", math.floor(minutes))
			end
			words(card, "Status", status, 30, 102, 440, 44, 34).TextXAlignment = Enum.TextXAlignment.Center
			local row = 0
			for _, product in Commerce.products do
				-- Once a boost is forever, its timed versions are hidden (they would do nothing).
				if column.match(product) and not (forever and product.kind ~= "pass") then
					-- What you get on the left, the price with the Robux symbol on the right, like Roblox's own shops.
					local strip = button(content, product.key, Art.mainmenu.strip[product.kind == "pass" and "red" or column.strip], "",
						x + 20, 432 + row * 78, 460, 72, (row % 2 == 0 and -1 or 1), function() api.buy(product.key) end)
					words(strip, "What", label(product), 34, 6, 250, 60, 38)
					local icon = Instance.new("ImageLabel")
					icon.Name, icon.Image, icon.BackgroundTransparency, icon.ImageColor3 = "Robux", ROBUX_ICON, 1, Color3.fromRGB(28, 26, 30)
					icon.Position, icon.Size, icon.Parent = UDim2.fromOffset(300, 18), UDim2.fromOffset(34, 34), strip
					words(strip, "Price", tostring(PRICE[product.key] or "?"), 338, 6, 100, 60, 40)
					row += 1
				end
			end
		end
		-- Replies ("Purchase simulated...") on a tape strip under the title, dark ink so they read on the cork.
		local reply = game.Players.LocalPlayer:GetAttribute("MenuMessage") or ""
		if reply ~= "" then
			local tape = image(content, "MessageTape", Art.ingame.tapeLabel, 460, 912, 1000, 64, 0)
			tape.ScaleType, tape.SliceCenter, tape.SliceScale = Enum.ScaleType.Slice, Rect.new(90, 30, 894, 104), 0.5
			words(tape, "Message", reply, 40, 8, 920, 48, 32).TextXAlignment = Enum.TextXAlignment.Center
		end
	end
	return self
end

return ShopScreen
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ROJO_317">
          <Properties>
            <string name="Name">SpeedPickups</string>
            <string name="Source">-- Shows the speed power-ups at the fly-throughs on this client only. The server owns pick-up and respawn
-- (FlightService: each marker's "ReadyAt"); here each marker gets a spinning, bobbing folded-paper bolt
-- (Assets.SpeedBolt, assets/models/toys/speed-bolt) that hides while it's taken.
local RunService = game:GetService("RunService")
local Root = game:GetService("ReplicatedStorage"):WaitForChild("FlyFightPaper")

local SPIN_PER_SECOND = 0.6
local BOB_STUDS = 2

local SpeedPickups = {}

local function token(marker)
	local bolt = Root.Assets:WaitForChild("SpeedBolt"):Clone()
	bolt.CastShadow = false
	local sparkle = Instance.new("ParticleEmitter")
	sparkle.Texture, sparkle.Rate, sparkle.Lifetime = "rbxasset://textures/particles/sparkles_main.dds", 4, NumberRange.new(0.6, 1)
	sparkle.Speed, sparkle.SpreadAngle = NumberRange.new(2, 5), Vector2.new(180, 180)
	sparkle.Color, sparkle.LightEmission = ColorSequence.new(Color3.fromRGB(255, 225, 140)), 0.2
	sparkle.Size = NumberSequence.new(0.8, 0)
	sparkle.Name = "Sparkle"
	sparkle.Parent = bolt
	bolt.Parent = marker
	return bolt
end

function SpeedPickups.start()
	local folder = workspace:WaitForChild("SpeedPickups")
	local tokens = {} -- marker -&gt; bolt
	local function track(marker)
		if marker:IsA("BasePart") then tokens[marker] = token(marker) end
	end
	for _, marker in ipairs(folder:GetChildren()) do track(marker) end
	folder.ChildAdded:Connect(track)
	RunService.RenderStepped:Connect(function()
		local clock, now = os.clock(), workspace:GetServerTimeNow()
		for marker, bolt in pairs(tokens) do
			local ready = now &gt;= (marker:GetAttribute("ReadyAt") or 0)
			bolt.Transparency = ready and 0 or 1
			bolt.CFrame = CFrame.new(marker.Position) * CFrame.new(0, math.sin(clock * 2) * BOB_STUDS, 0) * CFrame.Angles(0, clock * SPIN_PER_SECOND * math.pi * 2, 0)
			bolt.Sparkle.Enabled = ready
		end
	end)
end

return SpeedPickups
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ROJO_318">
          <Properties>
            <string name="Name">TowerClock</string>
            <string name="Source">-- Moves the bell tower clocks' hands to the real time on this client only (no network traffic). Each hand is
-- placed pointing at 12; PIVOT is the clock centre measured from the hand's box centre
-- (assets/models/bell-tower/clock/checks.json "pivot_offset_xyz": Blender x, y, z -&gt; Roblox -x, z, y).
local RunService = game:GetService("RunService")

local PIVOT = { ["clock-hour"] = CFrame.new(0, -7.3, 1.42), ["clock-minute"] = CFrame.new(0, -9.3, 1.87) }

local TowerClock = {}

local function angle(name)
	local now = os.date("*t")
	local minutes = now.min + now.sec / 60
	if name == "clock-minute" then return minutes / 60 * math.pi * 2 end
	return ((now.hour % 12) + minutes / 60) / 12 * math.pi * 2
end

function TowerClock.start()
	local hands = {} -- part -&gt; the CFrame it was placed at (pointing at 12)
	local function track(part)
		if PIVOT[part.Name] and part:IsA("BasePart") then hands[part] = part.CFrame end
	end
	for _, part in ipairs(workspace:GetDescendants()) do track(part) end
	workspace.DescendantAdded:Connect(track)
	workspace.DescendantRemoving:Connect(function(part) hands[part] = nil end)
	local shown = -1
	RunService.Heartbeat:Connect(function()
		local second = os.time()
		if second == shown then return end -- ponytail: hands tick once a second, nothing to do in between
		shown = second
		for part, placed in pairs(hands) do
			local pivot = placed * PIVOT[part.Name]
			-- The face looks out along the hand's -Z, so someone in front looks along +Z: a positive turn is clockwise.
			part.CFrame = pivot * CFrame.Angles(0, 0, angle(part.Name)) * pivot:ToObjectSpace(placed)
		end
	end)
end

return TowerClock
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ROJO_319">
          <Properties>
            <string name="Name">Tutorial</string>
            <string name="Source">local Root=game.ReplicatedStorage.FlyFightPaper
local Players=game:GetService("Players")
local Tutorial={active=false,step=1}
local instructions={
 "Launch: press Enter or the Launch button at your desk.",
 "Turn: move the mouse to place the aim circle. Your plane turns toward it; the small dot is where your nose and guns point.",
 "Fire: left click fires primary weapons. Right click fires launchers. Your crosshair follows the nose.",
 "Lift: fly through the cyan upward fan to restore Lift. It needs an exit before another pass counts.",
 "Land: turn toward your desk and fly into its blue approach zone. Free refill and repair are available.",
 "Respawn: choose Free fresh plane at your desk. It returns in four seconds. Equipment and earned Paper stay yours.",
}
function Tutorial.begin()
 Tutorial.active=true;Tutorial.step=1;Tutorial.lastLife=nil;Tutorial.flyingLife=nil;Tutorial.heading=nil
 Root:SetAttribute("TutorialOpen",true)
 Root.RoundAction:FireServer("join")
end
function Tutorial.start(getPlane)
 local gui=Instance.new("ScreenGui");gui.Name="Tutorial";gui.ResetOnSpawn=false;gui.IgnoreGuiInset=true;gui.DisplayOrder=5;gui.Parent=Players.LocalPlayer.PlayerGui
 -- A sticky note near the top of the screen (Alan's paper menu look).
 local PaperUI=require(script.Parent.PaperUI);local Art=require(Root.Shared.UIAssets)
 local panel=Instance.new("ImageLabel");panel.Name="Note";panel.Image=Art.ingame.stickyNote;panel.ScaleType=Enum.ScaleType.Stretch;panel.BackgroundTransparency=1
 panel.AnchorPoint=Vector2.new(.5,0);panel.Position=UDim2.fromScale(.5,.14);panel.Size=UDim2.fromOffset(560,250);panel.Rotation=-1;panel.Parent=gui
 local label=PaperUI.words(panel,"Step","",50,58,460,120,24);label.TextWrapped=true;label.TextYAlignment=Enum.TextYAlignment.Top
 local skip=PaperUI.button(panel,"Skip",Art.mainmenu.strip.red,"Skip tutorial",300,180,220,58,2,function()end,26)
 local function close()Tutorial.active=false;Root:SetAttribute("TutorialOpen",false)end
 skip.Activated:Connect(close)
 local function advance()Tutorial.step+=1;if Tutorial.step&gt;#instructions then close() end end
 Root:WaitForChild("CombatCosmetics").OnClientEvent:Connect(function(events)
  if not Tutorial.active or Tutorial.step~=3 then return end
  for _,e in ipairs(events) do if e.kind=="shot" and e.owner==tostring(Players.LocalPlayer.UserId) then advance();return end end
 end)
 local lastLift,lastLiftLife
 game:GetService("RunService").Heartbeat:Connect(function()
  panel.Visible=Tutorial.active and not Root:GetAttribute("OverlayOpen")
  if not Tutorial.active then return end
  label.Text=string.format("%d / %d   %s",Tutorial.step,#instructions,instructions[Tutorial.step])
  local plane=getPlane();if not plane or not plane.Parent then return end
  local state=plane:GetAttribute("State");local lift=plane:GetAttribute("Lift");local life=plane:GetAttribute("Life")
  if state=="FLYING" then Tutorial.flyingLife=life end
  if Tutorial.step==1 and state=="FLYING" then Tutorial.heading=plane.Root.CFrame.LookVector;advance()
  elseif Tutorial.step==2 and Tutorial.heading and plane.Root.CFrame.LookVector:Dot(Tutorial.heading)&lt;.85 then advance()
  elseif Tutorial.step==4 and state=="FLYING" and lastLiftLife==life and lastLift and lift&gt;lastLift+10 then advance()
  elseif Tutorial.step==5 and Tutorial.flyingLife==life and state=="DESK" then Tutorial.lastLife=life;advance()
  elseif Tutorial.step==6 and Tutorial.lastLife and life&gt;Tutorial.lastLife then advance() end
  lastLift,lastLiftLife=lift,life
 end)
end
return Tutorial
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ROJO_320">
          <Properties>
            <string name="Name">WaitScreen</string>
            <string name="Source">-- "Waiting for a desk" on a sticky note over the dimmed classroom (no desk is free yet when you press Play).
local Root = game.ReplicatedStorage:WaitForChild("FlyFightPaper")
local Art = require(Root.Shared.UIAssets)
local PaperUI = require(script.Parent.PaperUI)
local TweenService = game:GetService("TweenService")
local WaitScreen = {}

-- api = { cancel() }
function WaitScreen.new(playerGui, api)
	-- On the dimmed bulletin board (the camera only sees the floor before you have a desk).
	local cover, sheet = PaperUI.screen(playerGui, "WaitScreen", Art.mainmenu.bg)
	local dim = Instance.new("Frame")
	dim.Name, dim.Size, dim.BackgroundColor3, dim.BackgroundTransparency, dim.Parent = "Dim", UDim2.fromScale(1, 1), Color3.new(0, 0, 0), 0.45, sheet
	local note = PaperUI.image(sheet, "Sticky", Art.ingame.stickyNote, 610, 200, 700, 640, -2)
	local title = PaperUI.words(note, "Title", "Waiting for a desk...", 60, 130, 580, 90, 60)
	title.TextXAlignment = Enum.TextXAlignment.Center
	local body = PaperUI.words(note, "Body", "Every desk is taken right now. Your plane appears as soon as a pilot lands or respawns.", 80, 230, 540, 190, 40)
	body.TextXAlignment, body.TextWrapped = Enum.TextXAlignment.Center, true
	PaperUI.button(note, "Cancel", Art.mainmenu.strip.red, "Back to menu", 160, 450, 380, 100, 2, api.cancel, 46)
	-- The paper plane circles above the note while you wait.
	local plane = PaperUI.image(sheet, "Plane", Art.mainmenu.plane, 820, 90, 280, 190, 0)
	TweenService:Create(plane, TweenInfo.new(1.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {
		Position = plane.Position + UDim2.fromOffset(60, -20), Rotation = 10,
	}):Play()

	local self = { frame = cover }
	function self.update() end
	return self
end

return WaitScreen
</string>
          </Properties>
        </Item>
      </Item>
    </Item>
