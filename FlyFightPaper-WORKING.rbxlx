        <Item class="ModuleScript" referent="ROJO_204">
          <Properties>
            <string name="Name">JSONTypes</string>
            <string name="Source">-- Generated by tools/generate_config.py; do not edit.
local kinds = setmetatable({}, { __mode = "k" })
local Types = {}
Types.Null = table.freeze({})
function Types.array(value)
    kinds[value] = "array"
    return value
end
function Types.map(value)
    kinds[value] = "map"
    return value
end
function Types.kind(value)
    if value == Types.Null then return "null" end
    return kinds[value] or type(value)
end
return table.freeze(Types)
</string>
