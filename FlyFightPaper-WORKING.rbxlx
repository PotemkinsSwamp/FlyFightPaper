        <Item class="ModuleScript" referent="ROJO_271">
          <Properties>
            <string name="Name">BotBuilds.spec</string>
            <string name="Source">local Root=game.ReplicatedStorage.FlyFightPaper
local BotBuilds=require(Root.Shared.BotBuilds)
local Rules=require(Root.Shared.CombatRules)
local Suite=require(script.Parent.Parent.fixtures.Suite)
local Config=require(Root.Generated.Gameplay)
local Spec={}
local function near(actual,expected)
	assert(math.abs(actual-expected)&lt;1e-6,tostring(actual).." ~= "..tostring(expected))
end
-- Time for a dragged shot to cover d studs, from the closed form (not the helper under test).
local function flight(weapon,d)
	return -math.log(1-weapon.drag*d/weapon.projectile_speed)/weapon.drag
end

function Spec.run()
	local result,test=Suite.new()
	local catalog=require(Root.Shared.Catalog).new(require(Root.Generated.Catalog),require(Root.Generated.Gameplay))
	test("weapon presets stay legal after the paperclip and rubber capacity changes",function()
		local Loadouts=require(Root.Shared.WeaponLoadouts)
		assert(catalog:get("paperclip").capacity==2 and catalog:get("rubber").capacity==2)
		for _,choice in ipairs({"pellet","staple","rubber","paperclip","eraser","eraser_only","pencil","twin_pencils"}) do
			assert(catalog:validateLoadout(Loadouts.make(catalog,choice),nil,50),choice)
		end
		local escort=BotBuilds.TIERS.regular[2].loadout
		assert(escort.weapon_mounts[3]=="staple" and escort.weapon_mounts[4]=="staple")
	end)
	test("pellets and staple bursts have the catalog sustained damage",function()
		assert(BotBuilds.weapon(catalog,"pellet",300).dps==20)
		assert(BotBuilds.weapon(catalog,"staple",300).dps==17.5)
		near(BotBuilds.weapon(catalog,"rubber",300).dps,1.6/.06)
		near(BotBuilds.weapon(catalog,"paperclip",300).dps,24/1.5)
		near(BotBuilds.weapon(catalog,"paperclip",300).timeToTarget,flight(catalog:get("paperclip"),300))
		assert(BotBuilds.weapon(catalog,"pencil",300).dps==65)
		assert(BotBuilds.weapon(catalog,"eraser",300).dps==7.5)
	end)
	test("pencil reaction time and lead include its windup",function()
		local gun=BotBuilds.weapon(catalog,"pencil",300)
		near(gun.timeToTarget,.35+flight(catalog:get("pencil"),300))
		near(gun.leadStuds,110*(.35+flight(catalog:get("pencil"),300)))
		near(BotBuilds.weapon(catalog,"pellet",300).timeToTarget,flight(catalog:get("pellet"),300))
	end)
	test("rubber spread includes its angle and wobble",function()
		near(BotBuilds.weapon(catalog,"rubber",300).spreadStuds,300*math.tan(math.rad(2.5))+.8)
		near(BotBuilds.weapon(catalog,"rubber",0).spreadStuds,.8)
		assert(BotBuilds.weapon(catalog,"pellet",300).spreadStuds==0)
	end)
	test("erasers are homing and the other guns are not",function()
		assert(BotBuilds.weapon(catalog,"eraser",300).homing==true)
		for _,id in ipairs({"pellet","staple","rubber","paperclip","pencil"}) do
			assert(BotBuilds.weapon(catalog,id,300).homing==false)
		end
	end)
	test("projectile lifetime includes the reach boundary but nothing beyond it",function()
		for _,weapon in ipairs(catalog.weapons) do
			local reach=Rules.shotRange(weapon)
			near(BotBuilds.weapon(catalog,weapon.id,reach).timeToTarget,weapon.windup_seconds+weapon.lifetime)
			local beyond=BotBuilds.weapon(catalog,weapon.id,reach+.001)
			assert(beyond.timeToTarget==math.huge and beyond.leadStuds==math.huge)
		end
	end)
	test("measure uses derived health and each tier's speed and turn factors",function()
		local loadout=catalog:starterLoadout()
		loadout.wings="wings_2";loadout.tail="tail_1"
		local stats=catalog:deriveStats(loadout)
		for tier,profile in pairs(Config.bots.profiles) do
			local measured=BotBuilds.measure(catalog,loadout,tier)
			assert(measured.health==stats.health)
			near(measured.speed,stats.speed*profile.speed_factor)
			near(measured.pitch,stats.pitch*profile.turn_factor)
			near(measured.yaw,stats.yaw*profile.turn_factor)
			near(measured.turnRadius,measured.speed/math.rad(math.min(measured.pitch,measured.yaw)))
		end
	end)
	test("measure sums duplicate guns and guns after an empty mount",function()
		local loadout=catalog:starterLoadout()
		loadout.weapon_mounts={"staple",false,"pellet","staple"}
		local measured=BotBuilds.measure(catalog,loadout,"regular")
		assert(measured.dps==55 and measured.erasers==0 and measured.pencils==0)
		near(measured.ttk,Config.combat.reference_health/55)
		near(measured.dodge,flight(catalog:get("pellet"),300))
	end)
	test("measure counts erasers and pencils and gives homing zero dodge time",function()
		local loadout=catalog:starterLoadout()
		loadout.body="body_heavy"
		loadout.weapon_mounts={"pencil",false,"eraser",false,false,false}
		local measured=BotBuilds.measure(catalog,loadout,"experienced")
		assert(measured.dps==72.5 and measured.erasers==1 and measured.pencils==1)
		assert(measured.dodge==0)
		near(measured.ttk,Config.combat.reference_health/72.5)
	end)
	test("an unarmed plane has infinite kill and dodge times",function()
		local loadout=catalog:starterLoadout()
		loadout.weapon_mounts={false,false,false,false}
		local measured=BotBuilds.measure(catalog,loadout,"rookie")
		assert(measured.dps==0 and measured.ttk==math.huge and measured.dodge==math.huge)
	end)
	for _,tier in ipairs({"rookie","regular","experienced"}) do
		local builds=BotBuilds.TIERS[tier]
		test(tier.." has three or four named legal level-50 builds",function()
			assert(#builds&gt;=3 and #builds&lt;=4)
			local names={}
			for _,build in ipairs(builds) do
				assert(type(build.name)=="string" and #build.name&gt;0 and not names[build.name])
				names[build.name]=true
				local valid,reason=catalog:validateLoadout(build.loadout,nil,50)
				assert(valid,build.name..": "..tostring(reason))
			end
		end)
		test(tier.." picks cycle in order and return independent loadouts",function()
			for serial=1,#builds*3 do
				local build=builds[((serial-1)%#builds)+1]
				local loadout,name=BotBuilds.pick(tier,serial)
				assert(name==build.name and loadout~=build.loadout)
				for _,slot in ipairs({"body","nose","wings","tail","utility"}) do
					assert(loadout[slot]==build.loadout[slot])
					loadout[slot]="changed"
				end
				assert(loadout.weapon_mounts~=build.loadout.weapon_mounts)
				assert(#loadout.weapon_mounts==#build.loadout.weapon_mounts)
				for index,id in ipairs(build.loadout.weapon_mounts) do
					assert(loadout.weapon_mounts[index]==id)
					loadout.weapon_mounts[index]="changed"
				end
				local again=BotBuilds.pick(tier,serial)
				assert(again.body==build.loadout.body and again.utility==build.loadout.utility)
				assert(again.weapon_mounts[1]~="changed" and build.loadout.weapon_mounts[1]~="changed")
				assert(catalog:validateLoadout(build.loadout,nil,50))
			end
		end)
		test(tier.." kill times stay within 35 percent of their median",function()
			local times={}
			for _,build in ipairs(builds) do table.insert(times,BotBuilds.measure(catalog,build.loadout,tier).ttk) end
			table.sort(times)
			local middle=(#times+1)/2
			local median=(times[math.floor(middle)]+times[math.ceil(middle)])/2
			assert(median&gt;0 and median&lt;math.huge)
			for _,time in ipairs(times) do
				assert(time&gt;=median*.65 and time&lt;=median*1.35,tostring(time).." outside median "..tostring(median))
			end
		end)
	end
	test("rookies use forgiving light guns and take at least three seconds to kill",function()
		for _,build in ipairs(BotBuilds.TIERS.rookie) do
			assert(build.loadout.body=="body_standard" or build.loadout.body=="body_slim")
			for _,id in ipairs(build.loadout.weapon_mounts) do
				if id~=false then
					assert(id~="eraser" and id~="pencil" and catalog:get(id).class=="light")
				end
			end
			assert(BotBuilds.measure(catalog,build.loadout,"rookie").ttk&gt;=3,build.name)
		end
	end)
	test("regulars have at most one paperclip or eraser and experienced have at most one pencil build",function()
		for _,build in ipairs(BotBuilds.TIERS.regular) do
			local medium=0
			for _,id in ipairs(build.loadout.weapon_mounts) do
				assert(id~="pencil")
				if id=="paperclip" or id=="eraser" then medium+=1 end
			end
			assert(medium&lt;=1,build.name)
		end
		local pencils=0
		for _,build in ipairs(BotBuilds.TIERS.experienced) do
			if BotBuilds.measure(catalog,build.loadout,"experienced").pencils&gt;0 then pencils+=1 end
		end
		assert(pencils&lt;=1)
	end)
	test("D8 tier averages increase damage and turn while reducing non-homing dodge time",function()
		local previous
		for _,tier in ipairs({"rookie","regular","experienced"}) do
			local builds=BotBuilds.TIERS[tier]
			local average={dps=0,turn=0,dodge=0,unguided=0}
			for _,build in ipairs(builds) do
				local measured=BotBuilds.measure(catalog,build.loadout,tier)
				local unguided=math.huge
				-- Ignore homing's zero so guided guns cannot hide slower ordinary shots.
				for _,id in ipairs(build.loadout.weapon_mounts) do
					if id~=false then
						local gun=BotBuilds.weapon(catalog,id,300)
						if not gun.homing then unguided=math.min(unguided,gun.timeToTarget) end
					end
				end
				assert(unguided&lt;math.huge,build.name.." needs a non-homing gun")
				average.dps+=measured.dps/#builds
				average.turn+=math.min(measured.pitch,measured.yaw)/#builds
				average.dodge+=measured.dodge/#builds
				average.unguided+=unguided/#builds
			end
			if previous then
				assert(average.dps&gt;previous.dps,tier.." damage must increase")
				assert(average.turn&gt;previous.turn,tier.." turn must increase")
				assert(average.dodge&lt;previous.dodge,tier.." dodge time must decrease")
				assert(average.unguided&lt;previous.unguided,tier.." non-homing dodge time must decrease")
			end
			previous=average
		end
	end)
	return result
end
return Spec
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ROJO_272">
          <Properties>
            <string name="Name">BotRoster.spec</string>
            <string name="Source">local Root = game:GetService("ReplicatedStorage"):WaitForChild("FlyFightPaper")
local Rules = require(Root.Shared.BotRosterRules)
local Suite = require(script.Parent.Parent.fixtures.Suite)
local config = require(Root.Generated.Gameplay)

local Spec = {}
local function human(key, teamId, name)
	return { key = "actor:" .. key, userKey = key, controllerType = "human", teamId = teamId,
		displayName = name or ("Pilot " .. key), state = "FLYING" }
end
local function bot(key, profileName, teamId, state, extra)
	local row = { key = "bot:" .. key, controllerType = "bot", profileName = profileName,
		displayName = "Milo " .. key, avatarPresetId = "paper_pilot_skywright_v1", teamId = teamId,
		state = state or "FLYING" }
	for field, value in pairs(extra or {}) do row[field] = value end
	return row
end
local function input(eligibility, mode, actors, queue, seed, serverClass, serial)
	return { eligibility = eligibility or "rookie", serverClass = serverClass or eligibility or "rookie",
		mode = mode or "FFA", actors = actors or {}, pendingHumanQueue = queue or {}, seed = seed or 17029,
		botIdentitySerial = serial or 1, config = config }
end
local function result(inputValue)
	local value, reason = Rules.plan(inputValue)
	assert(value, reason)
	return value
end
local function countProfiles(rows)
	local counts = { rookie = 0, regular = 0, experienced = 0 }
	for _, row in ipairs(rows) do counts[row.profileName] += 1 end
	return counts
end

function Spec.run()
	local resultSet, test = Suite.new()
	test("Humans may share Roblox display names", function()
		local plan = result(input("rookie", "FFA", {human("h1", nil, "Sam"), human("h2", nil, "Sam")}))
		assert(#plan.botAdds == 10 and plan.actorCount == 12)
		for _, row in ipairs(plan.botAdds) do assert(row.displayName ~= "Sam") end
	end)

	test("BR01 seeded recipes repeat, while independent seeds vary", function()
		local first = result(input("rookie", "FFA", { human("h1") }, {}, 17029))
		local same = result(input("rookie", "FFA", { human("h1") }, {}, 17029))
		local changed = result(input("rookie", "FFA", { human("h1") }, {}, 17030))
		assert(#first.botAdds == 11 and #same.botAdds == 11 and first.actorCount == 12)
		for index, row in ipairs(first.botAdds) do
			assert(row.profileName == same.botAdds[index].profileName)
			assert(row.displayName == same.botAdds[index].displayName)
			assert(row.avatarPresetId == same.botAdds[index].avatarPresetId)
			assert(row.actorKey == same.botAdds[index].actorKey)
		end
		local changedRecipe = false
		for index, row in ipairs(first.botAdds) do
			if row.displayName ~= changed.botAdds[index].displayName or row.profileName ~= changed.botAdds[index].profileName then
				changedRecipe = true
			end
		end
		assert(changedRecipe)
	end)

	test("BR02 configured mix probabilities hold across seeds and small populations", function()
		assert(config.bots.rookie_mix.rookie == 0.85 and config.bots.rookie_mix.regular == 0.15
			and config.bots.rookie_mix.experienced == 0)
		assert(config.bots.regular_mix.regular == 0.85 and config.bots.regular_mix.experienced == 0.15)
		local rookieRegular, regularExperienced = 0, 0
		local fullRookieRegular, fullRegularExperienced = 0, 0
		for seed = 1, 1000 do
			local novice = result(input("rookie", "FFA", { human("h1") }, {}, seed))
			local noviceSmall = result(input("rookie", "FFA", { human("h1"), human("h2") }, {}, seed))
			assert(countProfiles(novice.botAdds).experienced == 0)
			assert(#noviceSmall.botAdds == 10)
			local singleNoviceVacancy = result(input("rookie", "FFA",
				{ human("a"), human("b"), human("c"), human("d"), human("e"), human("f"), human("g"), human("h"), human("i"), human("j"), human("k") }, {}, seed))
			local singleRegularVacancy = result(input("regular", "FFA",
				{ human("a"), human("b"), human("c"), human("d"), human("e"), human("f"), human("g"), human("h"), human("i"), human("j"), human("k") }, {}, seed))
			if singleNoviceVacancy.botAdds[1].profileName == "regular" then rookieRegular += 1 end
			if singleRegularVacancy.botAdds[1].profileName == "experienced" then regularExperienced += 1 end
			if seed &lt;= 200 then
				local rookieFull = result(input("rookie", "FFA", {}, {}, seed))
				local regularFull = result(input("regular", "FFA", {}, {}, seed))
				assert(#rookieFull.botAdds == 12 and #regularFull.botAdds == 12)
				local rookieCounts, regularCounts = countProfiles(rookieFull.botAdds), countProfiles(regularFull.botAdds)
				assert(rookieCounts.experienced == 0 and regularCounts.experienced &lt;= 1)
				fullRookieRegular += rookieCounts.regular
				fullRegularExperienced += regularCounts.experienced
			end
		end
		assert(rookieRegular &gt;= 110 and rookieRegular &lt;= 190, "rookie 15% sample outside tolerance: " .. rookieRegular)
		assert(regularExperienced &gt;= 110 and regularExperienced &lt;= 190,
			"regular 15% sample outside tolerance: " .. regularExperienced)
		assert(fullRookieRegular &gt;= 300 and fullRookieRegular &lt;= 420,
			"full rookie 15% mix outside tolerance: " .. fullRookieRegular)
		assert(fullRegularExperienced &gt;= 130 and fullRegularExperienced &lt;= 200,
			"full regular capped mix outside tolerance: " .. fullRegularExperienced)
	end)

	test("BR03 TDM and CONTROL both balance teams and cap experienced bots per team", function()
		for _, mode in ipairs({ "TDM", "CONTROL" }) do
			local actors = { human("a", "team:1"), human("b", "team:2"), human("c", "team:1"), human("d", "team:2") }
			local planned = result(input("regular", mode, actors, {}, 777))
			local experienced = { ["team:1"] = 0, ["team:2"] = 0 }
			local teams = { ["team:1"] = 0, ["team:2"] = 0 }
			for _, actor in ipairs(actors) do teams[actor.teamId] += 1 end
			for _, row in ipairs(planned.botAdds) do
				teams[row.teamId] += 1
				if row.profileName == "experienced" then experienced[row.teamId] += 1 end
			end
			assert(teams["team:1"] == teams["team:2"] and #planned.botAdds == 8)
			assert(experienced["team:1"] &lt;= 1 and experienced["team:2"] &lt;= 1)
		end
		for _, mode in ipairs({ "TDM", "CONTROL" }) do
			local solo = result(input("regular", mode, { human("solo", "team:1") }, {}, 44))
			assert(solo.botAdds[1].teamId == "team:2")
		end
		local humanJoin = assert(Rules.humanPriority(input("rookie", "CONTROL",
			{ human("one", "team:1"), human("two", "team:1"), human("three", "team:2") },
			{ { userKey = "joining", arrivalOrder = 1 } }, 44)))
		assert(humanJoin.admission.teamId == "team:2")
	end)

	test("BR04 invalid existing novice profile and experienced cap fail closed", function()
		local novice = Rules.plan(input("rookie", "FFA", { human("h"), bot("veteran", "experienced") }, {}, 10))
		assert(novice == nil)
		for _, mode in ipairs({ "TDM", "CONTROL" }) do
			local actors = { human("a", "team:1"), bot("x", "experienced", "team:1"),
				bot("y", "experienced", "team:1") }
			local rejected = Rules.plan(input("regular", mode, actors, {}, 9))
			assert(rejected == nil)
		end
	end)

	test("BR05 refill preserves existing profile and consumes caller monotonic serial", function()
		local actors = { human("h1"), bot("kept", "experienced") }
		for index = 3, 11 do table.insert(actors, human("h" .. index)) end
		local oldProfile = actors[2].profileName
		local planned = result(input("regular", "FFA", actors, {}, 99, nil, 730))
		assert(actors[2].profileName == oldProfile)
		assert(#planned.botAdds == 1 and planned.botAdds[1].identitySerial == 730)
		assert(planned.botAdds[1].actorKey == "bot-roster:730" and planned.nextBotIdentitySerial == 731)
		local retired = result(input("regular", "FFA", { human("h1") }, {}, 99, nil, 741))
		assert(retired.botAdds[1].actorKey == "bot-roster:741")
		assert(retired.botAdds[1].actorKey ~= planned.botAdds[1].actorKey)
	end)

	test("BR06 humans consume vacancies before bot fill in stable queue order", function()
		local actors = {}
		for index = 1, 10 do table.insert(actors, human("h" .. index)) end
		local queue = { { userKey = "later", arrivalOrder = 8 }, { userKey = "first", arrivalOrder = 2 },
			{ userKey = "third", arrivalOrder = 12 } }
		local planned = result(input("rookie", "FFA", actors, queue, 123))
		assert(#planned.admissions == 2 and planned.admissions[1].userKey == "first")
		assert(planned.admissions[2].userKey == "later")
		assert(#planned.botAdds == 0 and planned.waitingHumanKeys[1] == "third")
	end)

	test("BR07 eligibility change routes the server and leaves active bots untouched", function()
		local actors = { human("h1"), bot("active", "rookie") }
		local planned = result(input("regular", "FFA", actors, {}, 17029, "rookie"))
		assert(planned.status == "route_required" and #planned.botAdds == 0)
		assert(actors[2].profileName == "rookie")
	end)

	test("BR08 full flying room queues humans without a release proposal", function()
		local actors = { human("h1") }
		for index = 2, 12 do table.insert(actors, bot(tostring(index), "rookie", nil, "FLYING")) end
		local policy = assert(Rules.humanPriority(input("rookie", "FFA", actors,
			{ { userKey = "waiting", arrivalOrder = 1 } }, 5)))
		assert(policy.status == "wait_menu" and policy.admission == nil and policy.releaseProposal == nil)
	end)

	test("BR09 first queued human uses vacancy without deleting an actor", function()
		local actors = { human("h1"), bot("one", "rookie") }
		local policy = assert(Rules.humanPriority(input("rookie", "FFA", actors,
			{ { userKey = "first", arrivalOrder = 4 }, { userKey = "second", arrivalOrder = 5 } }, 8)))
		assert(policy.status == "admit_vacancy" and policy.admission.userKey == "first")
		assert(policy.releaseProposal == nil and #actors == 2)
	end)

	test("BR10 dead or explicitly safe parked bots may be proposed; flying contradiction may not", function()
		local actors = { human("h1") }
		for index = 2, 11 do table.insert(actors, bot(tostring(index), "regular", nil, "FLYING")) end
		table.insert(actors, bot("flying-flag", "regular", nil, "FLYING",
			{ trustedSafeParkedService = true, recentDamageCredit = false }))
		local queue = { { userKey = "waiting", arrivalOrder = 1 } }
		local contradictory = assert(Rules.humanPriority(input("regular", "FFA", actors, queue, 14)))
		assert(contradictory.status == "wait_menu" and contradictory.releaseProposal == nil)
		actors[12] = bot("parked-credit", "regular", nil, "SERVICING",
			{ trustedSafeParkedService = true, recentDamageCredit = true })
		local credited = assert(Rules.humanPriority(input("regular", "FFA", actors, queue, 14)))
		assert(credited.status == "wait_menu")
		actors[12] = bot("parked-safe", "regular", nil, "SERVICING",
			{ trustedSafeParkedService = true, recentDamageCredit = false })
		local parked = assert(Rules.humanPriority(input("regular", "FFA", actors, queue, 14)))
		assert(parked.status == "release_proposed" and parked.releaseProposal.actorKey == "bot:parked-safe")
		local deadActors = { human("deadcase") }
		for index = 2, 12 do table.insert(deadActors, bot("f" .. index, "regular", nil, "FLYING")) end
		deadActors[12] = bot("dead", "regular", nil, "DESTROYED")
		local dead = assert(Rules.humanPriority(input("regular", "FFA", deadActors, queue, 14)))
		assert(dead.status == "release_proposed" and dead.releaseProposal.actorKey == "bot:dead")
		assert(dead.releaseProposal.damageCreditDisposition == "preserve_round_ledger")
	end)

	test("BR11 boundary rebuild requires trusted boundary and settled cleanup", function()
		local actors = { human("h1") }
		for index = 2, 12 do table.insert(actors, bot("boundary" .. index, "rookie")) end
		local queue = { { userKey = "waiting", arrivalOrder = 1 } }
		local request = input("rookie", "FFA", actors, queue, 19)
		request.trustedRoundBoundary = true
		assert(assert(Rules.humanPriority(request)).status == "wait_menu")
		request.roundLedgerSettled, request.botCleanupReady = true, true
		local policy = assert(Rules.humanPriority(request))
		assert(policy.status == "round_boundary_rebuild" and policy.admission.userKey == "waiting")
		assert(policy.releaseProposal.reason == "round_boundary" and policy.releaseProposal.preserveRoundLedger)
	end)

	test("BR12 fictional recipes are unique, bounded, and have no user identity or inherited life", function()
		local planned = result(input("rookie", "FFA", { human("h1") }, {}, 41))
		local names, keys = {}, {}
		for _, row in ipairs(planned.botAdds) do
			assert(not names[row.displayName] and not keys[row.actorKey])
			names[row.displayName], keys[row.actorKey] = true, true
			-- Roblox username shape: 3-20 letters/digits, at most one underscore, not at either end.
			assert(#row.displayName &gt;= 3 and #row.displayName &lt;= 20 and row.displayName:match("^[%w]+_?[%w]+$"), row.displayName)
			assert(row.avatarPresetId:match("^paper_pilot_[a-z]+_v1$"))
			assert(row.userId == nil and row.nativeUserId == nil and row.userKey == nil)
			assert(row.lifeId == nil and row.streak == nil and row.matchParticipation == nil)
		end
	end)

	test("BR13 payer, age, rank, score, and purchase fields do not affect profile choice", function()
		local plain = input("regular", "FFA", { human("h1") }, {}, 202)
		local decorated = input("regular", "FFA", { human("h1") }, {}, 202)
		decorated.payer, decorated.age, decorated.rank, decorated.score = true, 99, 500, 999999
		decorated.purchasePrompt = "buy"
		local first, second = result(plain), result(decorated)
		for index, row in ipairs(first.botAdds) do
			assert(row.profileName == second.botAdds[index].profileName)
			assert(row.displayName == second.botAdds[index].displayName)
		end
	end)

	test("BR14 public projection exposes only ordinary presentation fields", function()
		local internal = bot("private", "experienced", "team:1", "FLYING", {
			publicId = "pilot-slot-4", userId = 123456, username = "NativeIdentity", bot = true,
			controllerType = "bot", controller = "BotService", tier = "experienced", profileName = "experienced" })
		local projection = assert(Rules.publicProjection(internal))
		assert(projection.id == "pilot-slot-4" and projection.displayName == internal.displayName)
		assert(projection.avatarPresetId == internal.avatarPresetId)
		for _, field in ipairs({ "userId", "username", "bot", "controllerType", "controller", "profileName", "tier", "nativeIdentity", "key" }) do
			assert(projection[field] == nil, "leaked " .. field)
		end
	end)

	test("BR15 rejects invalid bounds, sparse inputs, duplicate humans, and serial collisions", function()
		local full = {}
		for index = 1, 12 do table.insert(full, human("h" .. index)) end
		assert(result(input("rookie", "FFA", full, {}, 1)).actorCount == 12)
		table.insert(full, human("extra"))
		local over = Rules.plan(input("rookie", "FFA", full, {}, 1))
		assert(over == nil)
		local sparse = Rules.plan(input("rookie", "FFA", { [1] = human("a"), [3] = human("c") }, {}, 1))
		assert(sparse == nil)
		local duplicate = Rules.plan(input("rookie", "FFA", {},
			{ { userKey = "same", arrivalOrder = 1 }, { userKey = "same", arrivalOrder = 2 } }, 1))
		assert(duplicate == nil)
		local reused = bot("old", "rookie", nil, "FLYING")
		reused.key = "bot-roster:1"
		local repeatedSerial = Rules.plan(input("rookie", "FFA", { reused }, {}, 1, nil, 1))
		assert(repeatedSerial == nil, "caller must advance the never-reused serial")
	end)

	return resultSet
end

return Spec
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ROJO_273">
          <Properties>
            <string name="Name">Builder.spec</string>
            <string name="Source">-- Pure candidate rules and Catalog parity. Run through tests/unit/TestRunner in Studio.
local Root = game:GetService("ReplicatedStorage"):WaitForChild("FlyFightPaper")
local Catalog = require(Root.Shared.Catalog)
local Config = require(Root.Generated.Catalog)
local BuilderModel = require(Root.Shared.BuilderModel)
local Suite = require(game:GetService("ServerStorage").FlyFightPaperTests.fixtures.Suite)

local function allOwned()
	local ownership = {}
	for _, entry in ipairs(Config.structures) do ownership[entry.id] = true end
	for _, entry in ipairs(Config.weapons) do ownership[entry.id] = true end
	for _, entry in ipairs(Config.utilities) do ownership[entry.id] = true end
	return ownership
end

local Spec = {}

function Spec.run()
	local result, test = Suite.new()
	local catalog = Catalog.new(Config)
	local ownership = allOwned()
	local starter = catalog:starterLoadout()
	test("a third weapon type is refused without changing the local draft",function()
		local model=BuilderModel.new(catalog,starter,ownership,50)
		assert(model:selectMount(2,"staple"))
		local before=model.candidate
		local ok,reason=model:selectMount(3,"rubber")
		assert(not ok and reason=="two weapon types per plane" and model.candidate==before)
		assert(model:selectMount(3,"staple") and model:selectMount(2,"pellet"))
	end)
	test("starter stats exactly match Catalog and legal candidate", function()
		local model = BuilderModel.new(catalog, starter, ownership, 50)
		local stats = assert(model:stats())
		local expected = assert(catalog:deriveStats(starter))
		assert(stats.health == expected.health and stats.speed == expected.speed and stats.turn == expected.turn and stats.lift == expected.lift)
		assert(stats.health == 120 and stats.speed == 107.6 and math.abs(stats.turn - 116.9) &lt; 1e-6 and stats.lift == 90)
	end)
	test("ordered six-mount heavy body pads every empty position with false", function()
		local model = BuilderModel.new(catalog, starter, ownership, 50)
		assert(model:selectStructure("body", "body_heavy"))
		assert(#model.candidate.weapon_mounts == 6)
		for index = 3, 6 do assert(model.candidate.weapon_mounts[index] == false) end
		assert(catalog:validateLoadout(model.candidate, ownership, 50))
	end)
	test("standard-to-heavy and heavy-to-slim normalize ordered mounts and report local clears", function()
		local model = BuilderModel.new(catalog, starter, ownership, 50)
		assert(model:selectStructure("body", "body_heavy"))
		for index = 3, 6 do assert(model:selectMount(index, "pellet")) end
		assert(#model.candidate.weapon_mounts == 6)
		assert(model:selectStructure("body", "body_slim"))
		assert(#model.candidate.weapon_mounts == 3)
		assert(string.find(model.message, "3 incompatible or excess", 1, true))
		assert(model:validate(model.candidate))
	end)
	test("capacity, mount compatibility, unowned and level restrictions reject", function()
		local model = BuilderModel.new(catalog, starter, ownership, 50)
		local lowCapacityConfig = table.clone(Config)
		lowCapacityConfig.structures = table.clone(Config.structures)
		for index, entry in ipairs(lowCapacityConfig.structures) do
			if entry.id == "body_standard" then
				local changed = table.clone(entry); changed.capacity = 1
				lowCapacityConfig.structures[index] = changed
			end
		end
		local lowCapacityCatalog = Catalog.new(lowCapacityConfig)
		local tooHeavy = lowCapacityCatalog:starterLoadout()
		local ok, reason = lowCapacityCatalog:validateLoadout(tooHeavy, ownership, 50)
		assert(not ok and string.find(reason, "capacity", 1, true))
		local incompatible = BuilderModel.clone(starter)
		incompatible.weapon_mounts[3] = "pencil"
		ok, reason = model:setCandidate(incompatible)
		assert(not ok and string.find(reason, "incompatible", 1, true))
		model.level = 1
		ok, reason = model:selectStructure("body", "body_slim")
		assert(not ok and string.find(reason, "requires level", 1, true))
		model.level = 50
		model.ownership.body_slim = nil
		ok, reason = model:selectStructure("body", "body_slim")
		assert(not ok and string.find(reason, "not owned", 1, true))
	end)
	test("unchanged refresh preserves staged edits; revision and preset selection reset explicitly", function()
		local model = BuilderModel.new(catalog, starter, ownership, 50)
		local vm = { selectedLoadout = starter, selectedRevision = 7, profile = { ownership = ownership, level = 50 } }
		model:update(vm)
		local edited = BuilderModel.clone(starter); edited.nose = "nose_1"
		assert(model:setCandidate(edited))
		model:update(vm)
		assert(model.candidate.nose == "nose_1", "snapshot refresh erased draft")
		local reflected = { selectedLoadout = edited, profile = { ownership = ownership, level = 50 } }
		model:update(reflected)
		assert(model.candidate.nose == "nose_1" and model.changed, "onSelect reflection was treated as a committed build")
		vm.selectedRevision = 8
		model:update(vm)
		assert(model.candidate.nose == starter.nose, "explicit selection revision did not reset draft")
		assert(model:selectPreset(edited))
		assert(model.candidate.nose == "nose_1")
	end)
	test("heavy reference stats stay identical to Catalog calculation", function()
		local heavy = { body = "body_heavy_mk2", nose = "nose_0", wings = "wings_0", tail = "tail_0", utility = nil,
			weapon_mounts = { "pencil", "pencil", false, false, false, false } }
		local model = BuilderModel.new(catalog, heavy, ownership, 50)
		local stats = assert(model:stats())
		assert(stats.health == 300 and stats.speed == 62.8 and math.abs(stats.turn - 72.45) &lt; 1e-6 and stats.lift == 61.5)
	end)
	return result
end
return Spec
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ROJO_274">
          <Properties>
            <string name="Name">Catalog.spec</string>
            <string name="Source">-- Studio unit suite for CFG02/CFG03. Fixtures come from generated modules.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local root = ReplicatedStorage:WaitForChild("FlyFightPaper")
local generated = root:WaitForChild("Generated")
local shared = root:WaitForChild("Shared")
local Catalog = require(shared:WaitForChild("Catalog"))
local JSONTypes = require(generated:WaitForChild("JSONTypes"))
local catalogConfig = require(generated:WaitForChild("Catalog"))

local Suite = {}

local function expect(condition, message)
	if not condition then
		error(message or "expectation failed", 2)
	end
end

local function expectRejected(catalog, loadout, ownership, level, messagePart)
	local result, err = catalog:validateLoadout(loadout, ownership, level)
	expect(result == nil and type(err) == "string", "invalid loadout was accepted")
	if messagePart then
		expect(string.find(err, messagePart, 1, true) ~= nil, "unexpected rejection: " .. err)
	end
end

local function cloneLoadout(loadout)
	local mounts = table.clone(loadout.weapon_mounts)
	return {
		body = loadout.body,
		nose = loadout.nose,
		wings = loadout.wings,
		tail = loadout.tail,
		weapon_mounts = mounts,
		utility = loadout.utility,
	}
end

local function cloneTable(value)
	-- JSON null is an identity sentinel, not an ordinary mutable config map.
	if value == JSONTypes.Null or type(value) ~= "table" then
		return value
	end
	local copy = {}
	for key, child in pairs(value) do
		copy[key] = cloneTable(child)
	end
	return copy
end

function Suite.run()
	local catalog = Catalog.new(catalogConfig)
	local output = { passed = 0, failed = 0, results = {} }
	local function check(name, callback)
		local ok, err = pcall(callback)
		table.insert(output.results, { name = name, passed = ok, message = ok and "PASS" or tostring(err) })
		if ok then
			output.passed += 1
		else
			output.failed += 1
		end
	end

	check("CFG02 catalog contains all seeded definitions", function()
		local expectedSlots = { body = 6, nose = 6, wings = 6, tail = 6 }
		for slot, expected in pairs(expectedSlots) do
			local count = 0
			for _, entry in ipairs(catalogConfig.structures) do
				if entry.slot == slot then count += 1 end
			end
			expect(count == expected, slot .. " count mismatch")
		end
		expect(#catalogConfig.structures == 24, "structure count mismatch")
		expect(#catalogConfig.weapons == 6, "weapon count mismatch")
		expect(#catalogConfig.utilities == 3, "utility count mismatch")
		for _, list in ipairs({ catalogConfig.structures, catalogConfig.weapons, catalogConfig.utilities }) do
			for _, definition in ipairs(list) do
				expect(catalog:get(definition.id) == definition, "definition missing from index: " .. definition.id)
			end
		end
		expect(catalog:get("not_a_catalog_id") == nil, "unknown get() ID returned a definition")
	end)

	check("CFG02 starter normalization preserves ordered empty mounts", function()
		local starter = catalog:starterLoadout()
		expect(starter.body == "body_standard" and starter.weapon_mounts[1] == "pellet"
			and starter.weapon_mounts[2] == "pellet", "starter seed IDs changed")
		expect(starter.weapon_mounts[3] == false and starter.weapon_mounts[4] == false,
			"null seed mounts were not normalized to false")
		expect(starter.weapon_mounts[5] == nil and starter.utility == nil, "starter has extra mounts or utility")
		local accepted, err = catalog:validateLoadout(starter, nil, 1)
		expect(accepted == true, err)
		starter.weapon_mounts[3] = "pellet"
		expect(starter.weapon_mounts[4] == false, "filling a mount shifted a later empty slot")
	end)

	check("CFG02 strict shape, holes, excess slots, and unknown fields reject", function()
		local starter = catalog:starterLoadout()
		local hole = cloneLoadout(starter)
		hole.weapon_mounts[2] = nil
		expectRejected(catalog, hole, nil, 1, "ordered")
		local oversized = cloneLoadout(starter)
		table.insert(oversized.weapon_mounts, false)
		expectRejected(catalog, oversized, nil, 1, "ordered")
		local unknown = cloneLoadout(starter)
		unknown.client_price = 0
		expectRejected(catalog, unknown, nil, 1, "unknown loadout field")
		local missing = cloneLoadout(starter)
		missing.tail = nil
		expectRejected(catalog, missing, nil, 1, "tail")
		local arbitraryNull = cloneLoadout(starter)
		arbitraryNull.weapon_mounts[3] = {}
		expectRejected(catalog, arbitraryNull, nil, 1, "false")
		local generatedNull = cloneLoadout(starter)
		generatedNull.weapon_mounts[3] = JSONTypes.Null
		expectRejected(catalog, generatedNull, nil, 1, "false")
		local metatableLoadout = cloneLoadout(starter)
		setmetatable(metatableLoadout, {})
		expectRejected(catalog, metatableLoadout, nil, 1, "plain table")
	end)

	check("CFG02 ordered compatibility and capacity boundaries", function()
		local starter = catalog:starterLoadout()
		local wrongMount = cloneLoadout(starter)
		wrongMount.weapon_mounts[3] = "pencil"
		expectRejected(catalog, wrongMount, nil, 40, "incompatible")
		local full = {
			body = "body_heavy", nose = "nose_0", wings = "wings_0", tail = "tail_0",
			weapon_mounts = { "pencil", "pencil", false, false, false, false }, utility = nil,
		}
		local accepted, err = catalog:validateLoadout(full, nil, 40)
		expect(accepted == true, err)
		local overCapacity = cloneLoadout(full)
		overCapacity.weapon_mounts[4] = "paperclip"
		expectRejected(catalog, overCapacity, nil, 40, "capacity")
		local tooManyHeavy = cloneLoadout(full)
		tooManyHeavy.weapon_mounts[3] = "pencil"
		expectRejected(catalog, tooManyHeavy, nil, 40, "incompatible")
		local unknownWeapon = cloneLoadout(starter)
		unknownWeapon.weapon_mounts[3] = "made_up"
		expectRejected(catalog, unknownWeapon, nil, 40, "unknown weapon")
	end)

	check("CFG02 accepts repeated mounts of two types and refuses a third", function()
		local loadout=catalog:starterLoadout()
		loadout.weapon_mounts={"pellet","staple","staple","pellet"}
		expect(catalog:validateLoadout(loadout,nil,50)==true)
		loadout.weapon_mounts[3]="rubber"
		expectRejected(catalog,loadout,nil,50,"two weapon types per plane")
		loadout.weapon_mounts={"paperclip","paperclip","pellet","staple"}
		expectRejected(catalog,loadout,nil,50,"two weapon types per plane")
		loadout.weapon_mounts={false,false,false,false}
		expect(catalog:validateLoadout(loadout,nil,50)==true)
	end)

	check("CFG02 ownership and level validation", function()
		local starter = catalog:starterLoadout()
		expectRejected(catalog, starter, { body_standard = true, nose_0 = true, wings_0 = true }, 1, "not owned")
		expectRejected(catalog, starter, false, 1, "ownership")
		local locked = cloneLoadout(starter)
		locked.weapon_mounts[1] = "staple"
		expectRejected(catalog, locked, nil, 2, "requires level 3")
		local owned = { body_standard = true, nose_0 = true, wings_0 = true, tail_0 = true, pellet = true }
		local accepted, err = catalog:validateLoadout(starter, owned, 1)
		expect(accepted == true, err)
	end)

	check("CFG03 starter reference stats", function()
		local stats, err = catalog:deriveStats(catalog:starterLoadout())
		expect(stats ~= nil, err)
		expect(stats.health == 120, "starter health mismatch")
		expect(math.abs(stats.speed - 107.6) &lt; 1e-8, "starter speed mismatch")
		expect(math.abs(stats.turn - 116.9) &lt; 1e-6 and stats.lift == 90, "starter turn/lift mismatch")
		expect(stats.mass == 2 and stats.capacity == 6 and stats.used_capacity == 2
			and stats.remaining_capacity == 4, "starter mass/capacity metrics mismatch")
	end)

	check("more turn on a tail or wing always means less health", function()
		for _, slot in ipairs({ "tail", "wings" }) do
			local parts = table.clone(catalog.structuresBySlot[slot])
			table.sort(parts, function(a, b) return a.turn_delta &lt; b.turn_delta end)
			for i = 2, #parts do
				expect(parts[i].health_delta &lt; parts[i - 1].health_delta, slot .. " turn without a health cost: " .. parts[i].id)
			end
		end
		local starter = catalog:starterLoadout()
		local base = assert(catalog:deriveStats(starter))
		starter.tail = "tail_4"
		local fin = assert(catalog:deriveStats(starter))
		expect(fin.pitch &gt; base.pitch * 1.4 and fin.yaw == base.yaw, "best tail must pitch far faster and leave yaw alone")
	end)

	check("CFG03 heavy twin-pencil reference stats", function()
		local heavy = {
			body = "body_heavy_mk2", nose = "nose_0", wings = "wings_0", tail = "tail_0",
			weapon_mounts = { "pencil", "pencil", false, false, false, false }, utility = nil,
		}
		local stats, err = catalog:deriveStats(heavy)
		expect(stats ~= nil, err)
		expect(stats.health == 300, "heavy health mismatch")
		expect(math.abs(stats.speed - 62.8) &lt; 1e-8, "heavy speed mismatch")
		expect(math.abs(stats.turn - 72.45) &lt; 1e-8 and math.abs(stats.lift - 61.5) &lt; 1e-8,
			"heavy turn/lift mismatch")
		expect(stats.mass == 11 and stats.capacity == 10 and stats.used_capacity == 10
			and stats.remaining_capacity == 0, "heavy mass/capacity metrics mismatch")
	end)

	check("equipment mass changes mobility but never health", function()
		local light = catalog:starterLoadout()
		local heavier = cloneLoadout(light)
		heavier.weapon_mounts[3] = "pellet"
		local lightStats = catalog:deriveStats(light)
		local heavyStats = catalog:deriveStats(heavier)
		expect(heavyStats.mass &gt; lightStats.mass, "added weapon mass was not counted")
		expect(heavyStats.health == lightStats.health, "weapon mass changed health")
		expect(heavyStats.speed &lt; lightStats.speed and heavyStats.turn &lt; lightStats.turn
			and heavyStats.lift &lt; lightStats.lift, "weapon mass did not penalize mobility")
		local utilityBuild = cloneLoadout(light)
		utilityBuild.utility = "boost_band"
		local utilityStats = catalog:deriveStats(utilityBuild)
		expect(utilityStats.health == lightStats.health and utilityStats.mass == lightStats.mass + 1.5,
			"utility mass/health accounting mismatch")
	end)

	check("CFG03 mass penalty precedes standard and heavy speed ceilings", function()
		local highSpeedConfig = cloneTable(catalogConfig)
		expect(highSpeedConfig.starter_loadout.weapon_mounts[3] == JSONTypes.Null,
			"config fixture must preserve JSON null identity")
		for _, definition in ipairs(highSpeedConfig.structures) do
			if definition.id == "body_standard" or definition.id == "body_heavy" then
				definition.base_speed = 200
			end
		end
		local highSpeedCatalog = Catalog.new(highSpeedConfig)

		local standard = highSpeedCatalog:starterLoadout()
		local standardStats, standardError = highSpeedCatalog:deriveStats(standard)
		expect(standardStats ~= nil, standardError)
		expect(standardStats.mass &gt; 0, "standard regression build must carry equipment mass")
		expect(standardStats.speed == 135, "standard speed ceiling must apply after mass penalty")

		local heavy = {
			body = "body_heavy", nose = "nose_0", wings = "wings_0", tail = "tail_0",
			weapon_mounts = { "pencil", "pencil", false, false, false, false }, utility = nil,
		}
		local heavyStats, heavyError = highSpeedCatalog:deriveStats(heavy)
		expect(heavyStats ~= nil, heavyError)
		expect(heavyStats.mass &gt; 0, "heavy regression build must carry equipment mass")
		expect(heavyStats.speed == 95, "heavy speed ceiling must apply after mass penalty")
	end)

	check("all 1296 structural combinations keep heavy mobility below lighter chassis with the same parts",function()
		local examined=0
		for _,nose in ipairs(catalog.structuresBySlot.nose) do for _,wings in ipairs(catalog.structuresBySlot.wings) do for _,tail in ipairs(catalog.structuresBySlot.tail) do
			local statsByBody={}
			for _,body in ipairs(catalog.structuresBySlot.body) do
				local mounts={};for i=1,body.mount_count do mounts[i]=false end
				statsByBody[body.id]=assert(catalog:deriveStats({body=body.id,nose=nose.id,wings=wings.id,tail=tail.id,weapon_mounts=mounts}))
				examined+=1
			end
			for _,heavy in ipairs(catalog.structuresBySlot.body) do if heavy.archetype=="heavy" then
				for _,other in ipairs(catalog.structuresBySlot.body) do if other.archetype~="heavy" then
					local a,b=statsByBody[heavy.id],statsByBody[other.id]
					expect(a.speed&lt;b.speed and a.turn&lt;b.turn,"heavy chassis lost its mobility cost")
				end end
			end end
		end end end
		expect(examined==1296,"catalog enumeration missed structural choices")
	end)
	check("every legal weapon arrangement keeps equipment health neutral and charges mass",function()
		local examined=0
		for _,body in ipairs(catalog.structuresBySlot.body) do
			local loadout={body=body.id,nose="nose_0",wings="wings_0",tail="tail_0",weapon_mounts={}}
			for i=1,body.mount_count do loadout.weapon_mounts[i]=false end
			local empty=assert(catalog:deriveStats(loadout))
			local function enumerate(slot)
				if slot&gt;body.mount_count then
					local stats=catalog:deriveStats(loadout)
					if stats then
						examined+=1
						expect(stats.health==empty.health,"weapons added structural durability")
						expect(stats.speed&lt;=empty.speed and stats.turn&lt;=empty.turn and stats.lift&lt;=empty.lift,"equipment escaped its mobility cost")
						expect(stats.used_capacity&lt;=body.capacity,"illegal whole build escaped capacity")
					end
					return
				end
				loadout.weapon_mounts[slot]=false;enumerate(slot+1)
				for _,weapon in ipairs(catalog.weapons) do loadout.weapon_mounts[slot]=weapon.id;enumerate(slot+1) end
			end
			enumerate(1)
		end
		expect(examined&gt;1000,"whole-loadout enumeration missed legal arrangements")
	end)
	check("weapon damage per second and hit rating", function()
		local dps, hit = {}, {}
		for _, weapon in ipairs(catalog.weapons) do dps[weapon.id] = Catalog.weaponDPS(weapon); hit[weapon.id] = Catalog.hitRating(weapon) end
		expect(math.abs(dps.pellet - 20) &lt; 1e-6, "pellet dps " .. tostring(dps.pellet))
		expect(math.abs(dps.staple - 17.5) &lt; 1e-6, "burst dps counts the pause between bursts: " .. tostring(dps.staple))
		expect(math.abs(dps.pencil - 65) &lt; 1e-6, "pencil dps " .. tostring(dps.pencil))
		expect(hit.rubber == 1 and hit.staple == 2 and hit.paperclip == 3 and hit.eraser == 4 and hit.pencil == 5, "hit ratings")
	end)
	return output
end

return Suite
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ROJO_275">
          <Properties>
            <string name="Name">CombatRules.spec</string>
            <string name="Source">local Root=game.ReplicatedStorage.FlyFightPaper
local Server=game.ServerScriptService.FlyFightPaper
local Rules=require(Root.Shared.CombatRules)
local FlightRules=require(Root.Shared.FlightRules)
local Combat=require(Server.CombatService)
local Flight=require(Server.FlightService)
local Suite=require(script.Parent.Parent.fixtures.Suite)
local Spec={}
function Spec.run()
	local result,test=Suite.new()
	local catalog=require(Root.Shared.Catalog).new(require(Root.Generated.Catalog),require(Root.Generated.Gameplay))
	local function near(actual,expected) assert(math.abs(actual-expected)&lt;1e-6,tostring(actual).." ~= "..tostring(expected)) end
	local function firingFixture(weapon)
		local catalog=require(Root.Shared.Catalog).new(require(Root.Generated.Catalog),require(Root.Generated.Gameplay))
		local loadout=catalog:starterLoadout()
		if weapon then loadout.weapon_mounts={weapon,false,false,false} end
		local model=Instance.new("Model");model.Parent=game.ServerStorage;model:SetAttribute("State","FLYING")
		local body=Instance.new("Part");body.Anchored=true;body.CFrame=CFrame.identity;body.Parent=model
		local p={id="tap",kind="human",life=1,model=model,body=body,loadout=loadout,stats=catalog:deriveStats(loadout)}
		local service=setmetatable({shotCount=0,totalFired=0,serial=0,shots={},events={},cosmeticEvents={},info={},random=Random.new(),flight={catalog=catalog,records={}}},Combat)
		service:attach(p)
		return service,p,model
	end
	test("trigger groups follow the lowest filled mount and repeat by weapon type",function()
		for _,ids in ipairs({{"paperclip",false,"rubber","paperclip"},{false,"eraser","pellet","eraser"}}) do
			local loadout={weapon_mounts=ids};local before=table.clone(ids)
			local groups=assert(Rules.triggerGroups(loadout));local first=ids[1] or ids[2]
			for slot,id in ipairs(ids) do assert(groups[slot]==(id and (id==first and 1 or 2) or false) and ids[slot]==before[slot]) end
		end
		local groups=Rules.triggerGroups({weapon_mounts={"rubber",false,"paperclip"}})
		assert(groups[1]==1 and groups[2]==false and groups[3]==2)
	end)
	test("unarmed and single-type groups preserve empty slots including replicated empty strings",function()
		for _,ids in ipairs({{}, {false,false}, {"","",""}, {false,"pencil",false,"pencil"}, {"","eraser","","eraser"}}) do
			local groups=assert(Rules.triggerGroups({weapon_mounts=ids}));assert(#groups==#ids)
			for slot,id in ipairs(ids) do assert(groups[slot]==(id and id~="" and 1 or false)) end
		end
		local groups,reason=Rules.triggerGroups({weapon_mounts={"pellet","staple","rubber"}})
		assert(not groups and reason=="two weapon types per plane")
	end)
	test("paperclips keep their damage and capacity with the 1.5 s reload and fast projectile",function()
		local weapon=catalog:get("paperclip")
		assert(weapon.damage==24 and weapon.capacity==2 and weapon.shot_interval==1.5 and weapon.projectile_speed==1900)
	end)
	test("holding either automatic button does not block clicks on the other precision button",function()
		for _,ids in ipairs({{"paperclip",false,"rubber",false},{"rubber","paperclip",false,false}}) do
			local service,p,model=firingFixture();p.loadout.weapon_mounts=ids;service:attach(p)
			local info=service.info.tap;local precision,automatic
			for _,mount in ipairs(info.mounts) do if mount.weapon.id=="paperclip" then precision=mount else automatic=mount end end
			service:trigger(p,automatic.group,true);service:trigger(p,precision.group,true)
			assert(service.totalFired==2 and info.held[1] and info.held[2])
			service:trigger(p,precision.group,true);assert(service.totalFired==2)
			local ready=precision.readyAt;automatic.readyAt=0
			assert(service:fire(p,automatic,workspace:GetServerTimeNow()) and precision.readyAt==ready)
			service:trigger(p,precision.group,false);precision.readyAt=0;service:trigger(p,precision.group,true)
			assert(service.totalFired==4 and info.held[automatic.group]);model:Destroy()
		end
	end)
	test("simultaneous buttons keep separate aims, message limits and releases",function()
		local service,p,model=firingFixture();p.loadout.weapon_mounts={"paperclip",false,"pellet",false};service:attach(p)
		local now=workspace:GetServerTimeNow();local left=CFrame.Angles(0,math.rad(5),0).LookVector;local right=CFrame.Angles(0,math.rad(-5),0).LookVector
		local seq=0
		local function send(group,down,direction)
			seq+=1;return service:receive(p,{group=group,down=down,direction=direction,at=now,life=1,seq=seq},now)
		end
		for _=1,31 do assert(send(1,true,left) and send(2,true,right)) end
		local info=service.info.tap
		assert(service.totalFired==2 and info.aims[1]==left and info.aims[2]==right)
		assert(info.aimData[1].latency==0 and info.aimData[2].latency==0)
		info.mounts[2].readyAt=0;assert(service:fire(p,info.mounts[2],now))
		assert(service.shots[3].direction:Dot(right)&gt;.999)
		assert(send(1,false) and info.held[2] and info.aims[2]==right)
		for _=32,60 do assert(send(2,true,right)) end
		assert(not send(2,true,right) and send(2,false) and not info.held[2]);model:Destroy()
	end)
	test("both buttons publish heat independently and refits remap retained mounts",function()
		local service,p,model=firingFixture();p.loadout.weapon_mounts={"pellet",false,"rubber",false};service:attach(p)
		local info=service.info.tap;info.mounts[1].heat=15;info.mounts[2].heat=40;info.mounts[2].cooling=true
		service:publishHeat(p,workspace:GetServerTimeNow())
		assert(model:GetAttribute("PrimaryHasHeat") and model:GetAttribute("AlternateHasHeat"))
		assert(model:GetAttribute("PrimaryHeat")==.5 and not model:GetAttribute("PrimaryCooling"))
		assert(model:GetAttribute("AlternateHeat")==1 and model:GetAttribute("AlternateCooling"))
		p.loadout.weapon_mounts[1]=false;service:refit(p)
		assert(info.mounts[1].slot==3 and info.mounts[1].group==1 and info.mounts[1].cooling)
		assert(model:GetAttribute("PrimaryHasHeat") and not model:GetAttribute("AlternateHasHeat"));model:Destroy()
	end)
	test("eraser speed follows distance flown at every slowdown boundary",function()
		local expected={200,200,155,110,110}
		for index,studs in ipairs({0,250,500,750,2000}) do near(Rules.eraserSpeed(200,studs),expected[index]) end
		assert(require(Root.Generated.Gameplay).combat.eraser_lock_seconds==1.5 and catalog:get("eraser").lifetime==8)
	end)
	test("eraser speed uses the supplied base speed and tuning without changing them",function()
		local config={eraser_slow_after_studs=100,eraser_slow_full_studs=300,eraser_min_speed_factor=.25}
		near(Rules.eraserSpeed(80,-10,config),80);near(Rules.eraserSpeed(80,200,config),50);near(Rules.eraserSpeed(80,900,config),20)
		assert(config.eraser_min_speed_factor==.25)
	end)
	for _,id in ipairs({"pellet","rubber"}) do
		local weapon=catalog:get(id)
		test(id.." adds one heat per shot and fires the limit shot before cooling",function()
			local heat,cooling,allowed=0,false,false
			for shot=1,weapon.shots_before_cooldown do
				heat,cooling,allowed=Rules.heatShot(heat,cooling,weapon)
				assert(allowed and heat==shot and cooling==(shot==weapon.shots_before_cooldown))
			end
			local nextHeat,nextCooling,fires=Rules.heatShot(heat,cooling,weapon)
			assert(not fires and nextHeat==heat and nextCooling)
			assert(weapon.shots_before_cooldown==(id=="pellet" and 30 or 40) and weapon.cooldown_seconds==1.5)
		end)
		test(id.." holds heat between shots and drains when released",function()
			local heat,cooling=Rules.heatStep(20,false,true,3,weapon)
			assert(heat==20 and not cooling)
			heat,cooling=Rules.heatStep(heat,cooling,false,.5,weapon)
			near(heat,20-weapon.shots_before_cooldown/weapon.cooldown_seconds*.5);assert(not cooling)
			heat,cooling=Rules.heatStep(heat,cooling,false,5,weapon);assert(heat==0 and not cooling)
		end)
		test(id.." stays blocked until fully cool even with the trigger held",function()
			local heat,cooling=Rules.heatStep(weapon.shots_before_cooldown,true,true,.75,weapon)
			near(heat,weapon.shots_before_cooldown/2);assert(cooling)
			local _,_,allowed=Rules.heatShot(heat,cooling,weapon);assert(not allowed)
			heat,cooling=Rules.heatStep(heat,cooling,true,.75,weapon);assert(heat==0 and not cooling)
			heat,cooling,allowed=Rules.heatShot(heat,cooling,weapon);assert(heat==1 and not cooling and allowed)
		end)
	end
	test("heat ignores negative elapsed time and guns without a cooldown",function()
		local heat,cooling=Rules.heatStep(10,false,false,-1,catalog:get("pellet"));assert(heat==10 and not cooling)
		heat,cooling=Rules.heatStep(30,true,true,0,catalog:get("pellet"));assert(heat==30 and cooling)
		for _,id in ipairs({"staple","paperclip","eraser","pencil"}) do
			local allowed
			heat,cooling,allowed=Rules.heatShot(0,false,catalog:get(id));assert(heat==0 and not cooling and allowed)
			heat,cooling=Rules.heatStep(heat,cooling,true,1,catalog:get(id));assert(heat==0 and not cooling)
		end
	end)
	test("automatic cooling is enforced per mount for human and bot triggers",function()
		for _,id in ipairs({"pellet","rubber"}) do for _,kind in ipairs({"human","bot"}) do
			local service,p,model=firingFixture(id);p.kind=kind
			service:trigger(p,1,true)
			local mount=service.info.tap.mounts[1];local now=mount.heatAt
			for _=2,mount.weapon.shots_before_cooldown do mount.readyAt=now;assert(service:fire(p,mount,now)) end
			assert(mount.cooling and service.totalFired==mount.weapon.shots_before_cooldown)
			mount.readyAt=now;assert(not service:fire(p,mount,now) and mount.readyAt==now)
			service:trigger(p,1,false);service:trigger(p,1,true)
			assert(service.totalFired==mount.weapon.shots_before_cooldown and mount.cooling)
			assert(model:GetAttribute("PrimaryCooling") and model:GetAttribute("PrimaryHeat")==1)
			assert(model:GetAttribute("MountCoolingUntil1")&gt;now)
			service:coolMount(mount,true,mount.heatAt+1.5);assert(mount.heat==0 and not mount.cooling)
			assert(service:fire(p,mount,mount.heatAt) and mount.heat==1)
			model:Destroy()
		end end
	end)
	test("a hot mount does not block another gun and a refused launch adds no heat",function()
		local service,p,model=firingFixture();local info=service.info.tap
		local first,second=info.mounts[1],info.mounts[2];first.heat=30;first.cooling=true;info.held[1]=true
		local now=workspace:GetServerTimeNow();service:coolMount(first,true,now)
		assert(not service:fire(p,first,now) and service:fire(p,second,now) and second.heat==1)
		service.flight.inServiceZone=function()return true end
		second.readyAt=now;assert(not service:fire(p,second,now) and second.heat==1)
		model:Destroy()
	end)
	test("refitting keeps heat and replacing a cooling gun waits for its remaining cooldown",function()
		local service,p,model=firingFixture("pellet");local mount=service.info.tap.mounts[1]
		mount.heat=20;mount.cooling=true;mount.heatAt=workspace:GetServerTimeNow()
		service:refit(p);mount=service.info.tap.mounts[1]
		assert(mount.cooling and mount.heat&gt;19 and mount.heat&lt;=20)
		p.loadout.weapon_mounts[1]="rubber";local now=workspace:GetServerTimeNow();service:refit(p)
		mount=service.info.tap.mounts[1];assert(mount.heat==0 and not mount.cooling and mount.readyAt&gt;=now+.9)
		model:Destroy()
	end)
	test("server erasers use distance flown for speed and send it with guidance updates",function()
		local service,p,model=firingFixture("eraser");assert(service:fire(p,service.info.tap.mounts[1],workspace:GetServerTimeNow()))
		service.clock=0;service.trackClock=0;service.flushClock=-1;service.flight.pilots={};service.flight.byId={[p.id]=p}
		service.worldCast=RaycastParams.new();service.worldCast.FilterType=Enum.RaycastFilterType.Include;service.worldCast.FilterDescendantsInstances={}
		local shot=service.shots[1];local expires=shot.expires
		local expected={20,20,15.5,11,11}
		for index,studs in ipairs({0,250,500,750,2000}) do
			shot.position=Vector3.zero;shot.direction=Vector3.zAxis;shot.flown=studs
			service:step(.1)
			near(shot.position.Z,expected[index]);near(shot.flown,studs+expected[index]);assert(shot.expires==expires)
			local event=service.cosmeticEvents[#service.cosmeticEvents]
			assert(event.kind=="update" and event.flown==shot.flown)
		end
		model:Destroy()
	end)
	test("with 100 ms round-trip lag, aimed pellets hit a straight-flying plane at 150 studs",function()
		local Config=require(Root.Generated.Gameplay).combat
		local function run(lagCompensation)
			local track={}
			local target={id="t",model=Instance.new("Folder"),body={Size=Vector3.new(14,2,15)}};target.model:SetAttribute("State","FLYING")
			local shooter={id="s"}
			local service=setmetatable({info={t={track=track}},flight={pilots={t=target,s=shooter},byId={t=target,s=shooter}}},Combat)
			local velocity=Vector3.new(107,0,0)
			local function at(time) return Vector3.new(-150,0,-150)+velocity*time end
			local oneWay,smoothing,speed=.05,Config.view_delay_seconds,900
			local random=Random.new(7);local hits,shots=0,0
			for clock=0,3,1/30 do table.insert(track,{at=clock,cf=CFrame.new(at(clock))}) end
			for click=.5,2.3,.1 do
				-- The shooter sees the target one trip plus smoothing late and leads it like the pipper does.
				local seen=at(click-oneWay-smoothing);local lead=seen
				for _=1,3 do lead=seen+velocity*(lead.Magnitude/speed) end
				local aim=(CFrame.lookAt(Vector3.zero,lead)*CFrame.Angles(math.rad(random:NextNumber(-.5,.5)),math.rad(random:NextNumber(-.5,.5)),0)).LookVector
				local shot={owner="s",weapon={},position=Vector3.zero,radius=.3,rewind=lagCompensation and math.min(Config.max_rewind_seconds,2*oneWay+smoothing) or 0}
				shots+=1
				for now=click+oneWay,click+oneWay+1,1/60 do
					local delta=aim*speed/60
					if service:planeHit(shot,delta,now) then hits+=1;break end
					shot.position+=delta
				end
			end
			target.model:Destroy()
			return hits/shots
		end
		local compensated,raw=run(true),run(false)
		assert(compensated&gt;=.6,"hit rate "..compensated)
		assert(compensated&gt;raw,"lag compensation should beat no compensation ("..compensated.." vs "..raw..")")
	end)
	test("an eraser only hits a pilot where they are on their own screen, not where the server last saw them",function()
		local function hits(x,kind)
			local target={id="t",kind=kind,model=Instance.new("Folder"),body={Size=Vector3.new(14,2,15),AssemblyLinearVelocity=Vector3.new(110,0,0)}}
			target.model:SetAttribute("State","FLYING")
			local shooter={id="s"}
			local service=setmetatable({info={t={track={{at=0,cf=CFrame.identity},{at=1,cf=CFrame.identity}}}},flight={pilots={t=target,s=shooter},byId={t=target,s=shooter}}},Combat)
			local shot={owner="s",weapon={homing=true},position=Vector3.new(x,0,-20),radius=.6,rewind=0}
			local hit=service:planeHit(shot,Vector3.new(0,0,40),.5)
			target.model:Destroy()
			return hit~=nil
		end
		assert(not hits(-2,"human"),"an eraser passing just behind a moving pilot must miss")
		assert(hits(5,"human"),"an eraser through where the pilot really is must hit")
		assert(hits(-2,"bot"),"bots have no screen to favour")
	end)
	test("hits follow the real model: through the wing hits, the empty corner beside it misses",function()
		local HitShapes=require(Server.HitShapes)
		local wings=Root.Assets.AircraftParts.wings_0
		local model=Instance.new("Model");local appearance=Instance.new("Model");appearance.Name="Appearance";appearance.Parent=model
		local part=wings:Clone();part.CFrame=CFrame.identity;part.Parent=appearance
		local p={id="shape-test",model=model,body={CFrame=CFrame.identity}}
		HitShapes.preload({Root.Assets.AircraftParts})
		local function down(x,z)
			HitShapes.forget(p)
			return HitShapes.cast(p,CFrame.identity,Vector3.new(x,10,z),Vector3.new(0,-20,0),Vector3.one*.2,CFrame.identity)
		end
		-- The precise shape loads in the background; until then the wing's own box stands in.
		for _=1,50 do if not down(wings.Size.X*.45,wings.Size.Z*.45) then break end;task.wait(.1) end
		assert(not down(wings.Size.X*.45,wings.Size.Z*.45),"a shot through the empty corner of the wing's box must miss")
		assert(down(wings.Size.X*.25,0),"a shot through the wing must hit")
		HitShapes.forget(p);model:Destroy()
	end)
	test("a quick pellet click fires even when released before the next server step",function()
		local service,p,model=firingFixture()
		service:trigger(p,1,true);service:trigger(p,1,false)
		assert(service.totalFired==2 and service.shotCount==2 and not service.info.tap.held[1])
		service:trigger(p,1,true);service:trigger(p,1,false)
		assert(service.totalFired==2,"another click cannot bypass reload")
		model:Destroy()
	end)
	test("a short staple press starts its burst immediately and preserves the remainder",function()
		local service,p,model=firingFixture("staple")
		service:trigger(p,1,true);service:trigger(p,1,false)
		local mount=service.info.tap.mounts[1]
		assert(service.totalFired==1 and mount.burstLeft==2 and mount.burstNext&lt;mount.readyAt)
		model:Destroy()
	end)
	test("normal delayed turning input fires from a server mount; stale and backwards input fails",function()
		local service,p,model=firingFixture();local now=workspace:GetServerTimeNow()
		local direction=CFrame.Angles(0,math.rad(25),0).LookVector -- about what a starter turns in a delayed packet
		assert(service:receive(p,{group=1,down=true,life=1,seq=1,at=now-.25,direction=direction,muzzle=Vector3.new(9000,9000,9000)},now))
		assert(service.totalFired==2 and (service.shots[1].position-p.body.Position).Magnitude&lt;20)
		assert(service.shots[1].direction:Dot(direction)&gt;.999)
		assert(not service:receive(p,{group=1,down=true,life=1,seq=2,at=now-1,direction=direction},now))
		assert(not service:receive(p,{group=1,down=true,life=1,seq=3,at=now,direction=Vector3.zAxis},now))
		assert(not service:receive(p,{group=1,down=false,life=0,seq=4},now))
		assert(service:receive(p,{group=1,down=false,life=1,seq=5},now) and not service.info.tap.held[1])
		model:Destroy()
	end)
	test("expired desk protection permits targeting but never grounded firing",function()
		local model=Instance.new("Folder");model.Parent=game.ServerStorage;model:SetAttribute("State","DESK")
		local p={model=model};local protected=false
		local service=setmetatable({flight={protected=function()return protected end}},Combat)
		assert(service:targetable(p,1) and not service:eligible(p))
		protected=true;assert(not service:targetable(p,1))
		protected=false;model:SetAttribute("State","DESTROYED");assert(not service:targetable(p,1));model:Destroy()
	end)
	test("a flying plane cannot fire from any service zone or spend a reload",function()
		local model=Instance.new("Folder");model.Parent=game.ServerStorage;model:SetAttribute("State","FLYING")
		local body=Instance.new("Part");body.Anchored=true;body.Parent=model
		local p={id="test",model=model,body=body,loadout={body="body_standard"},spawnProtectionUntil=100}
		local service=setmetatable({shotCount=0,info={test={aim=Vector3.new(0,0,-1)}},flight={catalog={get=function()return {visual_scale=2}end},inServiceZone=function()return true end}},Combat)
		local mount={slot=1,readyAt=0,weapon={id="pellet",fire_mode="automatic",windup_seconds=0,spread_deg=0,projectile_radius=.3}}
		assert(not service:fire(p,mount,1) and mount.readyAt==0 and p.spawnProtectionUntil==100)
		model:Destroy()
	end)
	test("refit retains hit history, eraser cap and later existing reloads",function()
		local now=workspace:GetServerTimeNow();local history={{attacker="other",at=now,damage=20}}
		local old={slot=1,weapon={id="pencil"},readyAt=now+6}
		local service=setmetatable({info={test={mounts={old},held={true,true},history=history,activeErasers=2}},flight={catalog={get=function(_,id)return {id=id,shot_interval=4,visual_scale=2}end}}},Combat)
		local model=Instance.new("Folder")
		service:refit({id="test",model=model,loadout={body="body_heavy",weapon_mounts={"pencil","pencil",false,false,false,false}}})
		assert(model:GetAttribute("Mounts")=="pencil,pencil,,,,","the shooter's client needs the new mounts")
		local info=service.info.test
		assert(info.history==history and info.activeErasers==2 and info.held[1]==false)
		assert(info.mounts[1].readyAt==now+6 and info.mounts[2].readyAt&gt;=now+4)
		model:Destroy()
	end)
	test("last eligible weapon hit receives kill; other qualifying damage receives assist",function()
		local killer,assists=Rules.credit({{attacker="a",at=1,damage=12},{attacker="b",at=2,damage=1}},3,120,"victim")
		assert(killer=="b" and #assists==1 and assists[1]=="a")
	end)
	test("old, self and insufficient assist damage cannot earn credit",function()
		local killer,assists=Rules.credit({{attacker="old",at=1,damage=100},{attacker="tiny",at=12,damage=11},{attacker="victim",at=13,damage=200},{attacker="last",at=14,damage=1}},15,120,"victim")
		assert(killer=="last" and #assists==0)
		assert(Rules.credit({},15,120,"victim")==nil)
	end)
	test("authoritative order settles simultaneous last hits",function()
		local killer=Rules.credit({{attacker="a",at=1,damage=10},{attacker="b",at=1,damage=10}},1,120,"victim")
		assert(killer=="b")
	end)
	test("one pencil press selects one barrel; reloads stay independent",function()
		local weapon={fire_mode="semiautomatic",shot_interval=4}
		local mounts={{group=2,readyAt=0,weapon=weapon},{group=2,readyAt=0,weapon=weapon}}
		local index=Rules.readyMount(mounts,2,0,0);assert(index==1);Rules.consume(mounts[index],0)
		assert(mounts[1].readyAt==4 and mounts[2].readyAt==0)
		index=Rules.readyMount(mounts,2,2,index);assert(index==2);Rules.consume(mounts[index],2)
		assert(mounts[1].readyAt==4 and mounts[2].readyAt==6)
		assert(Rules.readyMount(mounts,2,3,index)==nil and Rules.readyMount(mounts,2,4,index)==1)
	end)
	test("an automatic button cannot swallow the other button's precision shot",function()
		local mounts={{group=1,readyAt=0,weapon={fire_mode="automatic"}},{group=2,readyAt=0,weapon={fire_mode="semiautomatic"}}}
		local fired={}
		local service=setmetatable({info={pilot={mounts=mounts,held={false,false},roundRobin={0,0}}}},Combat)
		function service:eligible() return true end
		function service:fire(_,mount) table.insert(fired,mount);return true end
		service:trigger({id="pilot",body={CFrame=CFrame.identity}},1,true)
		service:trigger({id="pilot",body={CFrame=CFrame.identity}},2,true)
  assert(#fired==2 and fired[1]==mounts[1] and fired[2]==mounts[2])
  service:trigger({id="pilot",body={CFrame=CFrame.identity}},2,true);assert(#fired==2)
		service:trigger({id="pilot",body={CFrame=CFrame.identity}},2,false)
  service:trigger({id="pilot",body={CFrame=CFrame.identity}},2,true);assert(#fired==3 and fired[3]==mounts[2])
		assert(service.info.pilot.held[1] and service.info.pilot.held[2])
	end)
	test("full eraser cap blocks without spending reload",function()
		local model=Instance.new("Folder");model.Parent=game.ServerStorage;model:SetAttribute("State","FLYING")
		local p={id="test",model=model}
		local service=setmetatable({shotCount=0,info={test={activeErasers=2}}},Combat)
		local mount={readyAt=0,weapon={id="eraser",homing=true,fire_mode="semiautomatic",shot_interval=4,windup_seconds=0}}
		assert(not service:fire(p,mount,1));assert(mount.readyAt==0)
		model:Destroy()
	end)
	test("an eraser hits a plane flying straight; a hard turn timed as it closes in dodges it",function()
		local catalog=require(Root.Shared.Catalog).new(require(Root.Generated.Catalog),require(Root.Generated.Gameplay))
		local eraser=catalog:get("eraser")
		local function chase(breakAt,range)
			local dt,plane,heading=1/60,Vector3.zero,Vector3.new(0,0,-1)
			local at=Vector3.new(30,0,range or 250);local direction,tracking,flown=(plane-at).Unit,true,0
			for _=1,eraser.lifetime*60 do
				local gap=(at-plane).Magnitude
				if gap&lt;9 then return true end
				local speed=110
				if breakAt and gap&lt;breakAt then heading=CFrame.fromAxisAngle(Vector3.yAxis,-math.rad(117)*dt):VectorToWorldSpace(heading);speed*=.75 end
				plane+=heading*speed*dt
				if tracking then
					local steered=Rules.eraserSteer(direction,(plane-at).Unit,dt)
					tracking=steered~=nil;direction=steered or direction
				end
				local travel=Rules.eraserSpeed(eraser.projectile_speed,flown)*dt
				at+=direction*travel;flown+=travel
			end
			return false
		end
		assert(chase(nil),"straight flight should be hit")
		assert(not chase(150),"a break turn at 150 studs should dodge")
		assert(chase(400),"breaking far too early should still be caught")
		assert(chase(50),"breaking too late should still be caught")
		assert(not chase(nil,500),"a long chase should lose closing speed before catching straight flight")
	end)
	test("eraser release is exactly once",function()
		local shot={id=1,owner="test",weapon={id="eraser",homing=true},position=Vector3.zero}
		local service=setmetatable({shots={[1]=shot},shotCount=1,info={test={activeErasers=2}},events={},cosmeticEvents={}},Combat)
		service:finish(shot);service:finish(shot)
		assert(service.shotCount==0 and service.info.test.activeErasers==1 and #service.cosmeticEvents==1 and #service.events==0)
	end)
	test("destruction ends a life only once",function()
		local model=Instance.new("Folder");model.Parent=game.ServerStorage;model:SetAttribute("State","FLYING")
		local body=Instance.new("Part");body.Anchored=true;body.Parent=model
		local deaths=0
		local service=setmetatable({records={test={deaths=0,weaponDeaths=0,collisionDeaths=0}},onDeath=function()deaths+=1 end},Flight)
		local p={id="test",model=model,body=body,drive={},orientation={}}
		service:destroy(p,"test","weapon");service:destroy(p,"duplicate","weapon")
		assert(service.records.test.deaths==1 and service.records.test.weaponDeaths==1 and deaths==1)
		model:Destroy()
	end)
	test("removed pilots release their shots and combat state without affecting others",function()
		local own={id=1,owner="leaving",weapon={id="eraser",homing=true},position=Vector3.zero}
		local other={id=2,owner="staying",weapon={id="eraser",homing=true},position=Vector3.zero}
		local service=setmetatable({shots={[1]=own,[2]=other},shotCount=2,info={leaving={activeErasers=1},staying={activeErasers=1}},events={},cosmeticEvents={}},Combat)
		service:detach({id="leaving"});service:detach({id="leaving"})
		assert(service.info.leaving==nil and service.info.staying.activeErasers==1)
		assert(service.shots[2]==other and service.shots[1]==nil and service.shotCount==1 and #service.cosmeticEvents==1)
	end)
	return result
end
return Spec
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ROJO_276">
          <Properties>
            <string name="Name">Commerce.spec</string>
            <string name="Source">local Root=game:GetService("ReplicatedStorage"):WaitForChild("FlyFightPaper")
local Rules=require(Root.Shared.CommerceRules)
local JSON=require(Root.Generated.JSONTypes)
local Config=require(Root.Generated.Commerce)
local Suite=require(script.Parent.Parent.fixtures.Suite)
local Spec={}
local function copy(v)
    if v==JSON.Null or type(v)~="table" then return v end
    local t={}; for k,x in pairs(v) do t[k]=copy(x) end; return t
end
local function boosts() return {xpSeconds=1800,paperSeconds=900,permanentXP=false,permanentPaper=false} end
function Spec.run()
    local result,test=Suite.new()
    test("all fifteen immutable configured offers and generated null sentinel",function()
        local c=assert(Rules.catalog(Config)); assert(#c.offers==15)
        for _,p in ipairs(Config.products) do assert(p.roblox_product_id==JSON.Null and p.approved_robux_price==JSON.Null) end
        for _,r in ipairs({"xp","paper"}) do
            for _,m in ipairs({15,30,60,180,300}) do assert(c.byKey[r.."_boost_"..m.."m"].amount==m*60) end
        end
        for _,n in ipairs({1000,3500,10000}) do assert(c.byKey["paper_pack_"..n].amount==n) end
        assert(c.byKey.permanent_2x_xp.kind=="pass" and c.byKey.permanent_2x_paper.amount==2)
    end)
    test("mock disabled offers preview without a real price or fabricated entitlement",function()
        local dto=Rules.preview(assert(Rules.catalog(Config)),boosts())
        assert(dto.label=="DEVELOPMENT ONLY - no real purchase" and dto.remainingTimeBasis=="last_durable")
        for _,p in ipairs(dto.offers) do assert(p.available and p.robuxPrice==nil and p.productID==nil and p.label==dto.label) end
        assert(dto.xp.remainingSeconds==1800 and dto.paper.remainingSeconds==900)
    end)
    test("permanent disables redundant resource offers while preserving dormant indicators and two cap",function()
        local b=boosts(); b.permanentXP=true
        local dto=Rules.preview(assert(Rules.catalog(Config)),b)
        assert(dto.xp.multiplier==2 and dto.paper.multiplier==2 and dto.xp.remainingSeconds==1800)
        for _,p in ipairs(dto.offers) do
            if p.benefit=="xp_seconds" or p.benefit=="permanent_xp" then assert(not p.available and p.reason=="permanent_owned")
            else assert(p.available) end
        end
    end)
    test("nil and arbitrary empty tables do not impersonate generated JSON null",function()
        for _,field in ipairs({"roblox_product_id","approved_robux_price"}) do
            local c=copy(Config); c.products[1][field]=nil; assert(Rules.catalog(c)==nil)
            c=copy(Config); c.products[1][field]={}; assert(Rules.catalog(c)==nil)
        end
    end)
    test("unknown malformed duplicate keys and immutable changes fail closed",function()
        local changes={function(c) c.products[1].key="unknown" end,
            function(c) c.products[1].amount=901 end,function(c) c.products[1].kind="pass" end,
            function(c) c.products[1].benefit="paper_seconds" end,function(c) c.products[1].enabled="false" end,
            function(c) c.products[2]=copy(c.products[1]) end,function(c) c.products[1].extra=true end,
            function(c) c.products[16]=copy(c.products[1]) end,function(c) c.products[1]=false end,
            function(c) c.unknown=true end,function(c) c.multiplier_cap_per_resource=4 end}
        for _,change in ipairs(changes) do local c=copy(Config); change(c); assert(Rules.catalog(c)==nil) end
    end)
    test("bad partial enabled and duplicate platform mappings fail closed",function()
        for _,id in ipairs({0,-1,1.5,math.huge,0/0,"12",{}}) do
            local c=copy(Config); c.products[1].roblox_product_id=id; c.products[1].approved_robux_price=10
            assert(Rules.catalog(c)==nil)
        end
        local c=copy(Config); c.products[1].enabled=true; assert(Rules.catalog(c)==nil)
        c=copy(Config); c.products[1].roblox_product_id=12; assert(Rules.catalog(c)==nil)
        c=copy(Config)
        for i=1,2 do c.products[i].roblox_product_id=12; c.products[i].approved_robux_price=10 end
        assert(Rules.catalog(c)==nil)
    end)
    test("catalog detaches mutable configuration and freezes identities",function()
        local raw=copy(Config); local c=assert(Rules.catalog(raw)); raw.products[1].amount=1
        assert(c.offers[1].amount==900 and table.isfrozen(c) and table.isfrozen(c.offers[1]))
        assert(not pcall(function() c.offers[1].amount=1 end))
    end)
    test("typed semantic operations contain no XP for purchased Paper and no client CAS or amount path",function()
        local c=assert(Rules.catalog(Config))
        local paper=Rules.operation(c.byKey.paper_pack_3500,"mock-purchase:abc",7)
        assert(paper.kind=="purchasedPaper" and paper.wholePaper==3500 and paper.points==nil and paper.multipliers==nil)
        local duration=Rules.operation(c.byKey.xp_boost_300m,"mock-purchase:def",8)
        assert(duration.kind=="boostIntent" and duration.resource=="xp" and duration.seconds==18000)
        local pass=Rules.operation(c.byKey.permanent_2x_paper,"mock-purchase:ghi",9)
        assert(pass.action=="permanent" and pass.seconds==nil and table.isfrozen(pass))
    end)
    test("live DTO cannot initiate checkout or display fixture prices",function()
        local c=copy(Config); c.mode="live"; c.live_sales_authorized=true
        for i,p in ipairs(c.products) do p.roblox_product_id=100+i; p.approved_robux_price=10; p.enabled=true end
        local dto=Rules.preview(assert(Rules.catalog(c)),boosts())
        for _,p in ipairs(dto.offers) do assert(not p.available and p.robuxPrice==nil) end
    end)
    return result
end
return Spec
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ROJO_277">
          <Properties>
            <string name="Name">Economy.spec</string>
            <string name="Source">local Root = game:GetService("ReplicatedStorage"):WaitForChild("FlyFightPaper")
local Rules = require(Root.Shared.EconomyRules)
local Catalog = require(Root.Shared.Catalog)
local CatalogConfig = require(Root.Generated.Catalog)
local EconomyConfig = require(Root.Generated.Economy)
local Suite = require(script.Parent.Parent.fixtures.Suite)

local function profile(paper, xp, ownership)
	return { paperMilli = paper or 0, earnedPaperMilli = 0, purchasedPaperMilli = 0,
		xpMilli = xp or 0, ownership = ownership or {} }
end

local function rejected(result, err, code)
	assert(result == nil and type(err) == "table" and err.type == "EconomyRejected", "expected typed rejection")
	if code then assert(err.code == code, tostring(err.code) .. " != " .. code) end
end

local Spec = {}
function Spec.run()
	local result, test = Suite.new()
	local catalog = Catalog.new(CatalogConfig, require(Root.Generated.Gameplay))
	test("EC01 780 contribution points convert to312 Paper and585 XP;432 remains a bonus illustration", function()
		local amount = assert(Rules.contributionMilli(780, 1, 1))
		assert(amount.paperMilli == 312000 and amount.xpMilli == 585000)
		local referenceBonuses = assert(Rules.applyFinalBonuses(profile(), { finalPaper = 120, finalXP = 170 }, { paper = 1, xp = 1 }, "illustration"))
		assert(referenceBonuses.profile.paperMilli == 120000)
		assert(amount.paperMilli / 1000 + referenceBonuses.profile.paperMilli / 1000 == 432)
	end)
	test("fractional resource earnings retain exact milli residual regardless of partition or order", function()
		local function fold(events)
			local p = profile()
			for i, points in ipairs(events) do p = assert(Rules.applyContribution(p, points, { paper = 1, xp = 1 }, "evt:" .. i)).profile end
			return p
		end
		local a, b = fold({ 1, 2, 3, 4 }), fold({ 4, 3, 2, 1 })
		assert(a.paperMilli == b.paperMilli and a.xpMilli == b.xpMilli)
		assert(a.paperMilli == 4000 and a.xpMilli == 7500)
		local paper = assert(Rules.wholeAndResidual(400))
		local xp = assert(Rules.wholeAndResidual(750))
		assert(paper.whole == 0 and paper.residualMilli == 400)
		assert(xp.whole == 0 and xp.residualMilli == 750)
	end)
	test("independent event-time multipliers double only the selected resource and cap at2", function()
		local base = assert(Rules.contributionMilli(1, 1, 1))
		local xp2 = assert(Rules.contributionMilli(1, 1, 2))
		local paper2 = assert(Rules.contributionMilli(1, 2, 1))
		local both = assert(Rules.contributionMilli(1, 2, 2))
		assert(base.paperMilli == 400 and base.xpMilli == 750)
		assert(xp2.paperMilli == 400 and xp2.xpMilli == 1500)
		assert(paper2.paperMilli == 800 and paper2.xpMilli == 750)
		assert(both.paperMilli == 800 and both.xpMilli == 1500)
		local invalid, invalidError = Rules.contributionMilli(1, 3, 1)
		rejected(invalid, invalidError, "invalid_multiplier")
	end)
	test("generated and explicitly supplied conversion rates drive arithmetic; unsupported precision rejects", function()
		local tuned = table.clone(EconomyConfig)
		tuned.paper_per_point, tuned.xp_per_point = 0.125, 1.25
		local amount = assert(Rules.contributionMilli(8, 1, 1, tuned))
		assert(amount.paperMilli == 1000 and amount.xpMilli == 10000)
		tuned.paper_per_point = 0.1255
		local invalid, err = Rules.contributionMilli(8, 1, 1, tuned)
		rejected(invalid, err, "invalid_economy_rate")
		local baseline = assert(Rules.contributionMilli(1, 1, 1))
		assert(baseline.paperMilli == 400 and baseline.xpMilli == 750)
		assert(getmetatable(EconomyConfig) == nil)
		local generated = assert(Rules.contributionMilli(1, 1, 1, EconomyConfig))
		assert(generated.paperMilli == baseline.paperMilli and generated.xpMilli == baseline.xpMilli)
	end)
	test("final contribution totals stay informational; final row bonuses are applied once per caller operation", function()
		local initial = profile()
		local afterContribution = assert(Rules.applyContribution(initial, 780, { paper = 1, xp = 1 }, "contrib"))
		local settled = assert(Rules.applyFinalBonuses(afterContribution.profile,
			{ contribution = 780, finalPaper = 120, finalXP = 170 }, { paper = 1, xp = 1 }, "settlement"))
		assert(settled.profile.paperMilli == 432000 and settled.profile.xpMilli == 755000)
		assert(initial.paperMilli == 0 and afterContribution.profile.paperMilli == 312000)
		assert(settled.operation.type == "FinalBonusesApplied" and settled.operation.operationID == "settlement")
		assert(settled.operation.contributionPoints == nil)
	end)
	test("XP exact boundaries, jumps, cap50 and continued cumulative XP", function()
		local lvl, rem = Rules.levelForXP(199999, EconomyConfig); assert(lvl == 1 and rem == 199999)
		lvl, rem = Rules.levelForXP(200000, EconomyConfig); assert(lvl == 2 and rem == 0)
		lvl, rem = Rules.levelForXP(439999, EconomyConfig); assert(lvl == 2 and rem == 239999)
		lvl, rem = Rules.levelForXP(440000, EconomyConfig); assert(lvl == 3 and rem == 0)
		local totalTo50 = 0
		for level = 1, 49 do totalTo50 += (200 + 40 * (level - 1)) * 1000 end
		lvl, rem = Rules.levelForXP(totalTo50, EconomyConfig); assert(lvl == 50 and rem == 0)
		lvl, rem = Rules.levelForXP(totalTo50 + 1234567, EconomyConfig); assert(lvl == 50 and rem == 1234567)
		lvl = Rules.levelForXP(totalTo50 * 100, EconomyConfig); assert(lvl == 50)
		local tuned = table.clone(EconomyConfig)
		tuned.xp_next_level_base, tuned.xp_next_level_step = 100, 25
		lvl, rem = Rules.levelForXP(225000, tuned); assert(lvl == 3 and rem == 0)
		tuned.xp_next_level_base = 0
		local bad, err = Rules.levelForXP(0, tuned); rejected(bad, err, "invalid_level_config")
		tuned.xp_next_level_base, tuned.level_cap = 100, 51
		bad, err = Rules.levelForXP(0, tuned); rejected(bad, err, "invalid_level_config")
		tuned.level_cap = 50
		tuned.xp_next_level_base, tuned.xp_next_level_step = Rules.MAX_SAFE_INTEGER, Rules.MAX_SAFE_INTEGER
		bad, err = Rules.levelForXP(Rules.MAX_SAFE_INTEGER, tuned); rejected(bad, err, "overflow")
	end)
	test("catalog starter ownership comes from actual starter loadout, including repeated pellet as one type", function()
		local own = assert(Rules.starterOwnership(catalog))
		for _, id in ipairs({ "body_standard", "nose_0", "wings_0", "tail_0", "pellet" }) do assert(own[id] == true, id) end
		assert(own.staple == nil and own.pencil == nil)
		local fresh = profile(0, 0, own)
		local starter = assert(Rules.validateEquipmentPurchase(fresh, catalog, "pellet", "starter-owned"))
		assert(starter.operation.alreadyOwned and starter.operation.chargedMilli == 0 and starter.profile.paperMilli == 0)
	end)
	test("rich level1 profile stays level gated; level40 low-paper profile stays price gated", function()
		local richLow = profile(100000000, 0, {})
		local result, err = Rules.validateEquipmentPurchase(richLow, catalog, "pencil", "blocked-level")
		rejected(result, err, "level_locked")
		local poorHigh = profile(4999999, 37440000, {})
		result, err = Rules.validateEquipmentPurchase(poorHigh, catalog, "pencil", "blocked-price")
		rejected(result, err, "insufficient_paper")
	end)
	test("owned item repeats return unchanged immutable profile and no charge", function()
		local own = { staple = true }
		local before = profile(900000, 1200000, own)
		local bought = assert(Rules.validateEquipmentPurchase(before, catalog, "staple", "retry-operation"))
		assert(bought.operation.alreadyOwned and bought.operation.priceMilli == 0)
		assert(bought.profile.paperMilli == before.paperMilli and bought.profile.xpMilli == before.xpMilli)
		assert(before.ownership.staple == true and before.paperMilli == 900000)
		assert(table.isfrozen(bought) and table.isfrozen(bought.profile) and table.isfrozen(bought.operation))
	end)
	test("repeated different catalog items use their own bounded catalog price", function()
		local p = profile(10000000, 5000000, {})
		local first = assert(Rules.validateEquipmentPurchase(p, catalog, "staple", "buy-staple"))
		local second = assert(Rules.validateEquipmentPurchase(first.profile, catalog, "rubber", "buy-rubber"))
		assert(first.operation.chargedMilli == 500000 and second.operation.chargedMilli == 900000)
		assert(second.profile.paperMilli == 8600000 and second.profile.ownership.staple and second.profile.ownership.rubber)
		assert(first.profile.ownership.rubber == nil and p.ownership.staple == nil)
	end)
	test("purchased Paper never becomes earned Paper, receives no multiplier and grants no XP or level", function()
		local before = profile(0, 0, {})
		local bought = assert(Rules.addPurchasedPaper(before, 500, "pack"))
		assert(bought.profile.paperMilli == 500000 and bought.profile.purchasedPaperMilli == 500000)
		assert(bought.profile.earnedPaperMilli == 0 and bought.profile.xpMilli == 0)
		local level = assert(Rules.levelForXP(bought.profile.xpMilli))
		assert(level == 1 and before.paperMilli == 0)
	end)
	test("humanity/controller source cannot alter pure reward arithmetic", function()
		local sameHuman = assert(Rules.contributionMilli(100, 2, 1))
		local sameBot = assert(Rules.contributionMilli(100, 2, 1))
		assert(sameHuman.paperMilli == sameBot.paperMilli and sameHuman.xpMilli == sameBot.xpMilli)
	end)
	test("reject NaN infinity negative unsafe integer invalid profiles and overflow", function()
		for _, value in ipairs({ 0 / 0, math.huge, -1, Rules.MAX_SAFE_INTEGER + 1 }) do
			local amount, err = Rules.contributionMilli(value, 1, 1); rejected(amount, err)
		end
		local result, err = Rules.applyContribution(profile(), 1, { paper = 1, xp = 0 }, "bad-multiplier")
		rejected(result, err, "invalid_multiplier")
		result, err = Rules.applyContribution(profile(Rules.MAX_SAFE_INTEGER - 100, 0, {}), 1, { paper = 1, xp = 1 }, "overflow")
		rejected(result, err, "overflow")
		result, err = Rules.applyFinalBonuses(profile(), { finalPaper = math.huge, finalXP = 0 }, { paper = 1, xp = 1 }, "bad-final")
		rejected(result, err, "invalid_result")
		result, err = Rules.contributionMilli(math.floor(Rules.MAX_SAFE_INTEGER / 750) + 1, 1, 1)
		rejected(result, err, "overflow")
		result, err = Rules.applyFinalBonuses(profile(),
			{ finalPaper = math.floor(Rules.MAX_SAFE_INTEGER / 1000) + 1, finalXP = 0 },
			{ paper = 1, xp = 1 }, "final-overflow")
		rejected(result, err, "overflow")
		result, err = Rules.addPurchasedPaper(profile(), 9007199254741, "buy-overflow")
		rejected(result, err, "overflow")
		local incomplete = { ownership = {} }
		local snapshot = table.clone(incomplete)
		result, err = Rules.applyContribution(incomplete, 1, { paper = 1, xp = 1 }, "missing-ledger")
		rejected(result, err, "invalid_profile")
		assert(incomplete.paperMilli == snapshot.paperMilli and incomplete.ownership == snapshot.ownership)
		local function deepChain(depth)
			local root, cursor = {}, nil
			cursor = root
			for _ = 1, depth do cursor.next = {}; cursor = cursor.next end
			root.paperMilli, root.earnedPaperMilli, root.purchasedPaperMilli, root.xpMilli, root.ownership = 0, 0, 0, 0, {}
			return root
		end
		result, err = Rules.addPurchasedPaper(deepChain(Rules.MAX_PROFILE_DEPTH + 1), 1, "deep-profile")
		rejected(result, err, "invalid_profile")
	end)
	return result
end

return Spec
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ROJO_278">
          <Properties>
            <string name="Name">FlightRules.spec</string>
            <string name="Source">local Root = game:GetService("ReplicatedStorage").FlyFightPaper
local Rules = require(Root.Shared.FlightRules)
local Suite = require(script.Parent.Parent.fixtures.Suite)
local Spec = {}
function Spec.run()
	local result, test = Suite.new()
	local function fly(turn,aim,seconds,heading)
		local dt,bank,angles=1/60,0,{}
		heading=heading or Vector3.new(0,0,-1)
		for _=1,math.floor(seconds*60) do
			local before=heading
			heading,bank=Rules.autopilot(heading,bank,aim,turn,turn,dt)
			assert(math.acos(math.clamp(before:Dot(heading),-1,1))&lt;=math.rad(turn)*dt+1e-4,"turned faster than the loadout allows")
			table.insert(angles,math.deg(math.acos(math.clamp(heading:Dot(aim),-1,1))))
		end
		return angles,bank
	end
	local function settle(angles,within)
		for i,angle in ipairs(angles) do if angle&lt;within then return i/60 end end
		return math.huge
	end
	local behind=Vector3.new(.02,0,1).Unit
	test("starter reverses in under two seconds and heavy is clearly slower",function()
		local starter=settle(fly(116.9,behind,5),3)
		local heavy=settle(fly(72.45,behind,6),3)
		-- Alan asked for faster turn-arounds than the plan's 2-2.5 s (2026-10-07).
		assert(starter&gt;=1.5 and starter&lt;=1.9,"starter reversal "..starter)
		assert(heavy&gt;=starter*1.4,"heavy reversal "..heavy)
	end)
	test("the nose eases onto the aim without overshoot or wobble",function()
		local aim=Vector3.new(1,.3,-1).Unit
		local angles=fly(116.9,aim,4)
		for i=2,#angles do assert(angles[i]&lt;=angles[i-1]+1e-3,"angle grew at frame "..i) end
		assert(angles[#angles]&lt;.1)
	end)
	test("big turns bank hard; aim near the nose levels the wings",function()
		local _,hard=fly(116.9,Vector3.new(1,0,-.2).Unit,.3)
		assert(hard&lt;-math.rad(40),"right turn should bank right")
		local _,level=fly(116.9,Vector3.new(.03,0,-1).Unit,2)
		assert(math.abs(level)&lt;math.rad(2),"near-nose aim should be wings level")
	end)
	test("near a wall the aim bends back inside and warns; mid-room aim is untouched",function()
		local center,size=Vector3.new(0,310,0),Vector3.new(2800,620,2200)
		local aim,warned=Rules.boundsNudge(Vector3.new(1380,300,0),Vector3.xAxis,center,size)
		assert(warned and aim.X&lt;.6)
		local same,quiet=Rules.boundsNudge(Vector3.new(0,300,0),Vector3.xAxis,center,size)
		assert(not quiet and same==Vector3.xAxis)
		local away,calm=Rules.boundsNudge(Vector3.new(1380,300,0),-Vector3.xAxis,center,size)
		assert(not calm and away==-Vector3.xAxis,"flying away from the wall needs no nudge")
	end)
	test("server turn and empty-Lift climb checks allow honest flight only",function()
		assert(Rules.turnAllowed(Vector3.zAxis,Vector3.xAxis,1,116.9))
		assert(not Rules.turnAllowed(Vector3.zAxis,-Vector3.zAxis,.25,116.9))
		assert(Rules.climbAllowed(100,97,.25,0) and not Rules.climbAllowed(100,130,.25,0))
		assert(Rules.climbAllowed(100,103,.25,18))
	end)
	test("a player can loop: pulling up goes over the top, inverted, and back to level",function()
		local dt,heading,bank,aim=1/60,Vector3.new(0,0,-1),0,CFrame.identity
		local top,backward=-1,-1
		for _=1,math.floor(4.2*60) do
			if _&lt;=3.6*60 then aim=aim*CFrame.Angles(math.rad(100)*dt,0,0) end
			heading,bank=Rules.autopilot(heading,bank,aim.LookVector,116.9,116.9,dt,aim.UpVector)
			top=math.max(top,heading.Y);backward=math.max(backward,heading.Z)
		end
		assert(top&gt;.99,"never pointed straight up "..top)
		assert(backward&gt;.95,"never flew back over the top "..backward)
		assert(heading:Dot(Vector3.new(0,0,-1))&gt;.99,"did not finish the loop")
	end)
	test("the aim rolls back toward the sky after the pilot lets go",function()
		local tilted=CFrame.lookAt(Vector3.zero,Vector3.new(0,0,-1))*CFrame.Angles(0,0,math.rad(60))
		for _=1,60 do tilted=Rules.levelAim(tilted,1/60) end
		assert(tilted.UpVector.Y&gt;.999)
		local vertical=CFrame.lookAt(Vector3.zero,Vector3.yAxis,Vector3.zAxis)
		assert(Rules.levelAim(vertical,1/60)==vertical,"straight up has no sky to level toward")
	end)
	test("scripted pilots without a sky direction keep the eighty-degree pitch limit",function()
		local heading,bank=Vector3.new(0,0,-1),0
		for _=1,180 do heading,bank=Rules.autopilot(heading,bank,Vector3.yAxis,116.9,116.9,1/60) end
		assert(heading.Y&lt;=math.sin(math.rad(80))+1e-6)
	end)
	test("tail sets up/down turning, wings left/right; hard turns cost speed",function()
		local function seconds(aim)
			local heading,bank=Vector3.new(0,0,-1),0
			for frame=1,600 do
				heading,bank=Rules.autopilot(heading,bank,aim,80,200,1/60,Vector3.yAxis)
				if heading:Dot(aim)&gt;math.cos(math.rad(3)) then return frame/60 end
			end
			return math.huge
		end
		local up,side=seconds(Vector3.new(0,1,-.2).Unit),seconds(Vector3.new(1,0,-.2).Unit)
		assert(up*1.8&lt;side,"fast tail should pitch much quicker than slow wings yaw: "..up.." vs "..side)
		local forward=Vector3.new(0,0,-1)
		assert(Rules.turnSpeedFactor(forward,forward,1/60,120)==1)
		local full=Rules.turnDirection(forward,Vector3.xAxis,math.rad(120)/60)
		assert(math.abs(Rules.turnSpeedFactor(forward,full,1/60,120)-.75)&lt;1e-3)
	end)
	test("the pitch limit keeps a forward direction",function()
		for _,vertical in ipairs({Vector3.yAxis,-Vector3.yAxis}) do
			local direction=Rules.limitPitch(vertical)
			assert(math.abs(direction.Magnitude-1)&lt;1e-6 and math.abs(direction.Y)&lt;=math.sin(math.rad(80))+1e-6)
			assert(Vector3.new(direction.X,0,direction.Z).Magnitude&gt;.17)
		end
		assert(Rules.limitPitch(Vector3.zAxis)==Vector3.zAxis)
	end)
	test("Lift drains in elapsed seconds and clamps at empty", function()
		assert(Rules.lift(90, 90, 1.5) == 88.5)
		assert(Rules.lift(0.1, 90, 1) == 0)
		assert(Rules.lift(90, 90, -1) == 90)
	end)
	test("empty Lift retains steering and descends even when aiming up", function()
		local velocity = Rules.velocity(Vector3.new(1, 1, 0).Unit, 100, 0, 0)
		assert(math.abs(velocity.X - 70) &lt; 1e-5 and velocity.Y == -12 and velocity.Z == 0)
	end)
	test("fan can rescue an empty plane without exceeding full Lift", function()
		assert(Rules.refill(0, 90) == 25 and Rules.refill(80, 90) == 90)
		assert(Rules.velocity(Vector3.zAxis, 100, 0, 18).Y == 6)
	end)
	test("upward aim at empty Lift never produces invalid velocity", function()
		assert(Rules.vector(Rules.velocity(Vector3.yAxis, 100, 0, 0)))
	end)
	test("fan needs exit, re-entry and cooldown; lingering cannot refill repeatedly", function()
		assert(Rules.fanEntry(false, true, 0, 8))
		assert(not Rules.fanEntry(true, true, 0, 20))
		assert(not Rules.fanEntry(false, true, 0, 7))
		assert(not Rules.fanEntry(true, false, 0, 20))
	end)
	test("speed power-ups catch a plane passing between checks", function()
		local centre, size = Vector3.new(0, 0, 0), Vector3.new(10, 60, 60)
		assert(Rules.segmentHitsBox(centre, size, Vector3.new(-30, 25, 0), Vector3.new(30, 25, 0)), "off-centre pass inside the hole")
		assert(not Rules.segmentHitsBox(centre, size, Vector3.new(-30, 35, 0), Vector3.new(30, 35, 0)), "pass above the hole")
		assert(not Rules.segmentHitsBox(centre, size, Vector3.new(-30, 0, 0), Vector3.new(-10, 0, 0)), "stopped short")
		assert(Rules.segmentHitsBox(centre, size, Vector3.new(0, 0, 0), Vector3.new(0, 0, 0)), "sitting inside")
	end)
	test("speed power-ups add up and restart the timer, capped", function()
		local cfg = { speed_bonus = 0.25, max_bonus = 1, seconds = 5 }
		local bonus, untilTime = Rules.stackPickup(0, 0, 10, cfg)
		assert(bonus == 0.25 and untilTime == 15)
		bonus, untilTime = Rules.stackPickup(bonus, untilTime, 12, cfg)
		assert(bonus == 0.5 and untilTime == 17, "second bolt adds and restarts, time does not add")
		for _ = 1, 5 do bonus, untilTime = Rules.stackPickup(bonus, untilTime, 13, cfg) end
		assert(bonus == 1, "capped")
		bonus = Rules.stackPickup(bonus, untilTime, 30, cfg)
		assert(bonus == 0.25, "expired stack starts over")
	end)
	test("server accepts normal travel with replication slack", function()
		assert(Rules.movementAllowed(Vector3.new(0, 100, 0), Vector3.new(0, 100, -25), Vector3.new(0, 0, -100), 0.25, 100))
	end)
	test("server rejects teleports, impossible speed and invalid positions", function()
		local origin = Vector3.new(0, 100, 0)
		assert(not Rules.movementAllowed(origin, Vector3.new(400, 100, 0), Vector3.zero, 0.25, 100))
		assert(not Rules.movementAllowed(origin, origin, Vector3.new(900, 0, 0), 0.25, 100))
		assert(not Rules.movementAllowed(origin, Vector3.new(0, math.huge, 0), Vector3.zero, 0.25, 100))
		assert(not Rules.movementAllowed(origin, Vector3.new(0, 100, 700), Vector3.zero, 0.25, 100))
		assert(not Rules.vector(Vector3.new(0/0, 0, 0)))
	end)
	test("slamming a surface destroys; a scrape costs health for as long as it lasts", function()
		local crash = require(Root.Generated.Gameplay).combat.collision_crash_speed
		assert(Rules.collisionDamage(110, false, 120, 1/60) == 120, "nose-dive into the floor")
		assert(Rules.collisionDamage(crash, false, 300, 1/60) == 300, "side-on into a wall")
		local function slide(seconds)
			local total = 0
			for t = 0, seconds - 1e-9, 1/60 do total += Rules.collisionDamage(8, false, 120, 1/60, t) end
			return total
		end
		assert(slide(0.1) &gt; 0 and slide(0.1) &lt; 6, "a brief wing clip costs a little: "..slide(0.1))
		assert(slide(1) &lt; 120, "a one-second belly slide is survivable: "..slide(1))
		assert(slide(2.5) &gt;= 120, "a long slide destroys the plane: "..slide(2.5))
		assert(Rules.collisionDamage(0, true, 120, 1/60) == 120, "empty Lift on the floor")
	end)
	return result
end
return Spec
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ROJO_279">
          <Properties>
            <string name="Name">FlightService.spec</string>
            <string name="Source">local Flight=require(game.ServerScriptService.FlyFightPaper.FlightService)
local Suite=require(script.Parent.Parent.fixtures.Suite)
local Spec={}
function Spec.run()
 local result,test=Suite.new()
 local function fixture()
  local f=setmetatable({padReservations={pad="owner",other="owner"},landingQueues={},byId={}},Flight)
  local home=CFrame.new(0,100,0)
  local function pilot(id)
   local m=Instance.new("Folder");m.Parent=game.ServerStorage;m:SetAttribute("State","FLYING")
   local p={id=id,model=m,home=home};f.byId[id]=p;return p
  end
  return f,home,pilot
 end
 test("occupied pads queue approaches in arrival order without stacking",function()
  local f,home,pilot=fixture();local a,b=pilot("a"),pilot("b")
  assert(not f:land(a,home,"pad") and not f:land(b,home,"pad"))
  assert(#f.landingQueues.pad==2 and a.model:GetAttribute("DeskQueuePosition")==1 and b.model:GetAttribute("DeskQueuePosition")==2)
  assert((a.model:GetAttribute("HoldingPosition")-b.model:GetAttribute("HoldingPosition")).Magnitude&gt;=50)
  assert(a.model:GetAttribute("State")=="FLYING" and not f:padAvailable("pad","a"))
  f.padReservations.pad=nil
  assert(f:padAvailable("pad","a") and not f:padAvailable("pad","b"))
  f:clearLandingQueue(a);assert(f:padAvailable("pad","b"));a.model:Destroy();b.model:Destroy()
 end)
 test("changing approach releases the old queue and clears obsolete marker",function()
  local f,home,pilot=fixture();local a=pilot("a")
  f:land(a,home,"pad");f:land(a,home,"other")
  assert(#f.landingQueues.pad==0 and #f.landingQueues.other==1 and a.waitingPad=="other")
  f:clearLandingQueue(a)
  assert(a.waitingPad==nil and a.model:GetAttribute("HoldingPosition")==nil and #f.landingQueues.other==0);a.model:Destroy()
 end)
 test("dead or removed waiting pilots cannot block later arrivals",function()
  local f,home,pilot=fixture();local a,b=pilot("a"),pilot("b")
  f:land(a,home,"pad");f:land(b,home,"pad");f.padReservations.pad=nil
  a.model:SetAttribute("State","DESTROYED");assert(f:padAvailable("pad","b"))
  b.model:Destroy();assert(f:padAvailable("pad","new"));a.model:Destroy()
 end)
 test("a ram destroys the plane with less health and costs the other that much; a brush costs both a little",function()
  local function run(ha,hb,speed)
   local taken={}
   local f=setmetatable({damage=function(_,p,amount) taken[p.id]=(taken[p.id] or 0)+amount end},Flight)
   local function pilot(id,health,z,vz)
    local m=Instance.new("Folder");m:SetAttribute("Health",health)
    return {id=id,model=m,stats={health=120},body={Position=Vector3.new(0,0,z)},previousVelocity=Vector3.new(0,0,vz),lastContact=0}
   end
   f:ram(pilot("a",ha,0,-speed),pilot("b",hb,-10,speed),1)
   return taken.a or 0,taken.b or 0
  end
  local a,b=run(50,80,100);assert(a==50 and b==50,"weaker plane must be destroyed, stronger loses 50: "..a..","..b)
  a,b=run(70,70,100);assert(a==70 and b==70,"equal health: both destroyed")
  a,b=run(50,80,5);assert(a==12 and b==12,"slow brush: both lose a little: "..a..","..b)
 end)
 return result
end
return Spec
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ROJO_280">
          <Properties>
            <string name="Name">HangarService.spec</string>
            <string name="Source">local Root=game.ReplicatedStorage.FlyFightPaper
local Hangar=require(game.ServerScriptService.FlyFightPaper.HangarService)
local Catalog=require(Root.Shared.Catalog)
local Schema=require(Root.Shared.ProfileSchema)
local Suite=require(script.Parent.Parent.fixtures.Suite)
local Spec={}
function Spec.run()
	local result,test=Suite.new()
	local function fixture()
		local catalog=Catalog.new(require(Root.Generated.Catalog))
		local profile=Schema.defaults(catalog);profile.xpMilli=60000000;profile.ownership.staple=true;profile.ownership.rubber=true
		local profiles={calls={}}
		function profiles:view() return profile end
		function profiles:enqueue(_,input,_,callback) table.insert(self.calls,input);callback(true);return true end
		local player={attributes={}}
		function player:SetAttribute(key,value) self.attributes[key]=value end
		return Hangar.new({catalog=catalog,pilots={}},profiles),player,profiles,catalog
	end
	test("saving a third type returns the hangar's button rule and never queues a save",function()
		local service,player,profiles,catalog=fixture();local loadout=catalog:starterLoadout()
		loadout.weapon_mounts={"pellet","staple","rubber",false}
		service:handle(player,"savePreset",{slot=1,name="Too many types",loadout=loadout})
		assert(player.attributes.MenuMessage=="Two weapon types per plane: one for left click, one for right click." and #profiles.calls==0)
	end)
	test("saving repeated mounts of two types still queues the normal preset operation",function()
		local service,player,profiles,catalog=fixture();local loadout=catalog:starterLoadout()
		loadout.weapon_mounts={"staple","pellet","staple","pellet"}
		service:handle(player,"savePreset",{slot=1,name="Two types",loadout=loadout})
		assert(#profiles.calls==1 and profiles.calls[1].kind=="preset")
		assert(Schema.canonical(profiles.calls[1].loadout)==Schema.canonical(loadout))
	end)
	return result
end
return Spec
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ROJO_281">
          <Properties>
            <string name="Name">Match.spec</string>
            <string name="Source">local Root = game:GetService("ReplicatedStorage"):WaitForChild("FlyFightPaper")
local Server = game:GetService("ServerScriptService"):WaitForChild("FlyFightPaper")
local Match, Rules = require(Server.MatchService), require(Root.Shared.MatchRules)
local Suite = require(script.Parent.Parent.fixtures.Suite)
local Clock = require(script.Parent.Parent.fixtures.FakeClock)
local gameplay, economy = require(Root.Generated.Gameplay), require(Root.Generated.Economy)
local Spec = {}
local zoneCenter = Vector3.new(table.unpack(gameplay.rounds.control_center))
local function near(a, b) assert(math.abs(a-b) &lt; 1e-6, tostring(a) .. " != " .. tostring(b)) end
Spec.near = near
function Spec.fixture(mode)
    local clock = Clock.new(0)
    local gate = { through = nil }
    local m = Match.new({ config = gameplay, economy = economy, clock = clock, sessionId = "unit", seed = 17029,
        combatDrainState = function() return { through = gate.through or clock:now(), blocked = gate.through ~= nil } end })
    local _, matchId = m:startRound(mode or "FFA")
    local f = { m = m, clock = clock, matchId = matchId, sequence = 0, life = 0, humans = 0, gate = gate }
    function f:identity(key)
        local p = self.m:snapshot().participants[key]
        return { actorId = p.actorId, lifeId = p.lifeId, participationId = p.participationId,
            matchId = self.matchId, teamId = p.teamId }
    end
    function f:newLife(key)
        local p = self.m:snapshot().participants[key]
        self.life += 1
        assert(self.m:lifeStarted({ actorId = p.actorId, lifeId = "life:" .. self.life,
            participationId = "participant:" .. p.actorId, matchId = self.matchId }))
        assert(self.m:observe(key, { state = "FLYING", protected = false, eligible = true, position = zoneCenter + Vector3.new(100,0,0) }))
    end
    function f:join(key, bot, prior, actorId)
        self.humans += 1
        local ok, facts = self.m:join({ key = key, actorId = actorId or "actor:" .. key, controllerType = bot and "bot" or "human",
            userId = not bot and self.humans or nil, priorQualifyingMatches = prior or 0 })
        assert(ok, facts); self:newLife(key)
        return self:identity(key)
    end
    function f:sample(key, position, state, protected, overlay, practice)
        assert(self.m:observe(key, { position = position or zoneCenter, state = state or "FLYING",
            protected = protected == true, overlay = overlay == true, practice = practice == true, eligible = true }))
    end
    function f:event(kind, owner, victim, extra)
        self.sequence += 1
        local e = { eventId = "combat:" .. self.sequence, serverSequence = self.sequence, at = self.clock:now(),
            kind = kind, victim = self:identity(victim) }
        if kind == "weaponDamage" then e.attacker, e.amount = self:identity(owner), 2
        else e.killer, e.assists, e.reason = owner and self:identity(owner), {}, "weapon" end
        for key, value in pairs(extra or {}) do e[key] = value end
        assert(self.m:consumeCombat(e))
        return e
    end
    function f:advance(seconds) self.clock:advance(seconds); self.m:tick() end
    function f:seal() assert(self.m:sealCombatDrain(self.matchId, self.m.round.lastSequence)) end
    function f:timer() self:advance(480-self.clock:now()); self:seal() end
    return f
end
local function row(f, key)
    for _, p in ipairs(f.m:snapshot().result.participants) do if p.key == key then return p end end
    error("missing row")
end
Spec.row = row
function Spec.run()
    local result, test = Suite.new()
    test("Control uses the configured cylinder including its boundary", function()
        local c=gameplay.rounds
        assert(Rules.inZone(zoneCenter+Vector3.new(c.control_radius,c.control_half_height,0),c))
        assert(not Rules.inZone(zoneCenter+Vector3.new(c.control_radius+.01,0,0),c))
        assert(not Rules.inZone(zoneCenter+Vector3.new(0,c.control_half_height+.01,0),c))
        assert(not Rules.inZone(zoneCenter+Vector3.new(c.control_radius,0,c.control_radius),c))
    end)
    test("MT01 timer cutoff excludes exact480 hit and closes before snapshot", function()
        local f = Spec.fixture(); f:join("a"); f:join("b")
        f:advance(479); f:event("weaponDamage", "a", "b")
        f:advance(1)
        assert(f.m:snapshot().phase == "ENDING" and f.m:snapshot().result == nil)
        f:event("lifeEnded", "a", "b"); f:seal()
        assert(row(f,"a").kills == 0 and row(f,"a").damage == 2)
        local before = f.m:snapshot().result
        f:event("lifeEnded", "a", "b")
        assert(row(f,"a").kills == 0 and before.endedAt == 480)
        assert(f.m.round.result and f.m.round.settlementId==f.matchId..":final")
    end)
    test("MT01 target20 exact once event and end, target event includes assists", function()
        local f = Spec.fixture(); f:join("a"); f:join("b"); f:join("c",true)
        for i = 1,20 do
            if i &gt; 1 then f:newLife("b") end
            local e = f:event("lifeEnded","a","b", { assists = { f:identity("c") } })
            assert(f.m:consumeCombat(e))
        end
        assert(f.m:snapshot().phase == "ENDING")
        f:seal(); f:seal()
        assert(row(f,"a").kills == 20 and row(f,"c").assists == 20 and row(f,"b").deaths == 20)
        assert(row(f,"a").contribution == 2000 and row(f,"c").contribution == 800)
        assert(f.m.round.result and f.m.round.settlementId==f.matchId..":final")
    end)
    test("MT02 TDM60 and history team stability, no friendly damage", function()
        local f = Spec.fixture("TDM"); f:join("a"); f:join("b",true)
        local team = f:identity("a").teamId
        for i = 1,60 do if i&gt;1 then f:newLife("b") end; f:event("lifeEnded","a","b") end
        f:seal(); assert(f.m:snapshot().result.teams[team] == 60 and f.m:snapshot().result.winningTeam == team)
        local g = Spec.fixture("TDM"); g:join("x"); g:join("y"); g:join("z")
        assert(g:identity("x").teamId == g:identity("z").teamId)
        local e = { eventId="bad",serverSequence=1,at=0,kind="weaponDamage",amount=4,attacker=g:identity("x"),victim=g:identity("z") }
        assert(not g.m:consumeCombat(e)); assert(g.m:snapshot().participants.x.damage == 0)
    end)
    test("MT03 Control rate1 despite teammate count and240 target", function()
        local f = Spec.fixture("CONTROL"); f:join("a"); f:join("enemy"); f:join("mate",true)
        f:sample("a"); f:sample("mate")
        f:advance(10); near(f.m:snapshot().teams[f:identity("a").teamId],10)
        near(f.m:snapshot().participants.a.contribution,4); near(f.m:snapshot().participants.mate.contribution,4)
        f:advance(230); assert(f.m:snapshot().phase == "ENDING"); f:seal()
        assert(f.m:snapshot().result.endedAt == 240)
        near(row(f,"a").objectiveSeconds,240); near(row(f,"a").activeSeconds,240)
        assert(row(f,"a").qualified and not row(f,"mate").qualified)
    end)
    test("MT03 contested protected grounded practice absent; overlay still captures", function()
        local f = Spec.fixture("CONTROL"); f:join("a"); f:join("b")
        f:sample("a"); f:sample("b"); f:advance(10)
        near(f.m:snapshot().teams[f:identity("a").teamId],0)
        f:sample("b",nil,"FLYING",true); f:advance(10)
        near(f.m:snapshot().teams[f:identity("a").teamId],10)
        f:sample("a",nil,"SERVICING"); f:advance(10)
        near(f.m:snapshot().teams[f:identity("a").teamId],10)
        f:sample("a",nil,"FLYING",false,true); assert(not f.m:controlActivity("a")); f:advance(10)
        near(f.m:snapshot().teams[f:identity("a").teamId],20)
        f:sample("a",nil,"FLYING",false,false,true); f:advance(10)
        near(f.m:snapshot().teams[f:identity("a").teamId],20)
    end)
    test("MT03 Control timer480 draw with alternating eligible occupancy", function()
        local f = Spec.fixture("CONTROL"); f:join("a"); f:join("b")
        f:sample("a"); f:advance(220)
        f:sample("a",zoneCenter + Vector3.new(100,0,0)); f:sample("b"); f:advance(220)
        f:sample("a"); f:advance(40); f:seal()
        assert(f.m:snapshot().result.draw and f.m:snapshot().result.endedAt == 480)
        assert(row(f,"a").contribution == 88)
    end)
    test("MT05 timer shared FFA leaders; team draw completion only", function()
        local f = Spec.fixture(); f:join("a"); f:join("b",true); f:join("victim",true)
        f:event("lifeEnded","a","victim"); f:newLife("victim"); f:event("lifeEnded","b","victim"); f:timer()
        assert(row(f,"a").victory and row(f,"b").victory and not row(f,"victim").victory)
        local g = Spec.fixture("CONTROL"); g:join("a"); g:join("b")
        g:sample("a"); g:advance(120); g:sample("a",zoneCenter + Vector3.new(100,0,0)); g:sample("b"); g:advance(120)
        g:sample("b",zoneCenter + Vector3.new(100,0,0)); g:timer()
        assert(g.m:snapshot().result.draw)
        assert(row(g,"a").completion and row(g,"a").finalPaper == 90 and row(g,"a").finalXP == 120)
        assert(not row(g,"a").victory and row(g,"a").place == nil)
    end)
    test("MT02 MT05 TDM480 tied teams finalize once with completion and no podium", function()
        local f=Spec.fixture("TDM"); f:join("a"); f:join("b")
        for i=1,12 do
            assert(f.m:controlActivity("a"))
            if i&lt;=3 then f:event("weaponDamage","a","b",{amount=30}); if i&lt;3 then f:advance(5) end end
            f:advance(10)
        end
        assert(f.m:snapshot().participants.a.qualified)
        local team=f:identity("a").teamId
        local bad={eventId="friendly:lethal",serverSequence=f.sequence+1,at=f.clock:now(),kind="lifeEnded",
            killer=f:identity("a"),victim=f:identity("a"),assists={},reason="weapon"}
        assert(not f.m:consumeCombat(bad)); assert(f.m:snapshot().teams[team]==0)
        f:timer(); f:seal()
        local result=f.m:snapshot().result
        assert(result.endedAt==480 and result.reason=="timer" and result.draw and result.winningTeam==nil)
        assert(result.teams["team:1"]==0 and result.teams["team:2"]==0)
        local a=row(f,"a")
        assert(a.completion and not a.victory and a.place==nil and a.finalPaper==90 and a.finalXP==120)
        assert(f.m.round.settlementId==f.matchId..":final")
    end)
    test("MT04 all modes seed tie no-vote least recent; current human vote only", function()
        local last = { FFA=3,TDM=1,CONTROL=2 }
        assert(Rules.chooseMode({},last,12)=="TDM")
        assert(Rules.chooseMode({a="FFA",b="CONTROL"},last,12)=="CONTROL")
        local choices, firsts = {}, {}
        local tied = { a={key="participant:1",contribution=0,kills=0,assists=0,deaths=0},
            b={key="participant:2",contribution=0,kills=0,assists=0,deaths=0} }
        for seed = 1,100 do
            local choice=Rules.chooseMode({}, {}, seed)
            assert(choice==Rules.chooseMode({}, {}, seed)); choices[choice]=true
            local order=Rules.podium(tied,seed); firsts[order[1].key]=true
            assert(order[1].key==Rules.podium(tied,seed)[1].key)
        end
        assert(choices.FFA and choices.TDM and choices.CONTROL and firsts["participant:1"] and firsts["participant:2"])
        local f=Spec.fixture(); f:join("a"); f:join("bot",true); f:timer(); f:advance(8)
        assert(f.m:snapshot().phase=="VOTE")
        assert(f.m:vote("a","FFA")); assert(f.m:vote("a","CONTROL")); assert(not f.m:vote("bot","TDM"))
        f:advance(12); assert(f.m:snapshot().nextMode=="CONTROL" and f.m:snapshot().phase=="COUNTDOWN")
        f:advance(3); assert(f.m:snapshot().phase=="READY")
    end)
    test("MT lifecycle catchup crossing8/12/3 no fabricated next round", function()
        local f=Spec.fixture(); f:join("a"); f:timer(); f:advance(23)
        assert(f.m:snapshot().phase=="READY" and f.m.serial==1)
        local old=f.matchId
        local ok, newId=f.m:startRound(); assert(ok and old~=newId and f.m:snapshot().phase=="ACTIVE")
        assert(next(f.m:snapshot().participants)==nil)
    end)
    test("qualification AFK props menu overlay and practice never manufacture activity", function()
        local f=Spec.fixture(); f:join("a"); f:join("b",true)
        for i=1,30 do assert(f.m:propContribution("prop:"..i,"a")) end
        f:advance(120); assert(f.m:snapshot().participants.a.activeSeconds==0)
        assert(f.m:snapshot().participants.a.propPoints==20 and not f.m:snapshot().participants.a.qualified)
        f:sample("a",nil,"MENU"); f:event("weaponDamage","a","b"); f:advance(20)
        near(f.m:snapshot().participants.a.activeSeconds,0)
        f:sample("a",nil,"FLYING",false,false,true); assert(not f.m:controlActivity("a")); f:advance(20)
        near(f.m:snapshot().participants.a.activeSeconds,0)
        f:sample("a",nil,"FLYING",false,true); assert(not f.m:controlActivity("a")); f:advance(20)
        near(f.m:snapshot().participants.a.activeSeconds,0)
    end)
    test("qualification genuine control expires10; overlay keeps combat and existing window", function()
        local f=Spec.fixture(); f:join("a"); f:join("b",true)
        assert(f.m:controlActivity("a")); f:advance(2); f:sample("a",nil,"FLYING",false,true); f:advance(18)
        near(f.m:snapshot().participants.a.activeSeconds,10)
        f:event("weaponDamage","a","b"); f:advance(20)
        near(f.m:snapshot().participants.a.activeSeconds,20)
    end)
    test("qualification once at120 and3 real events, prior4 emits graduation, withdraw retains fact", function()
        local f=Spec.fixture(); f:join("a",false,4); f:join("b",true)
        for i=1,12 do
            assert(f.m:controlActivity("a"))
            if i&lt;=3 then f:event("weaponDamage","a","b",{amount=30}) end
            f:advance(10)
        end
        local p=f.m:snapshot().participants.a
        near(p.activeSeconds,120); assert(p.qualified and p.qualifyingEvents==3)
        assert(f.m.round.participants.a.qualified and f.m.round.participants.a.priorQualifyingMatches==4)
        assert(f.m:withdraw("a")); assert(f.m.round.participants.a.qualified)
        f:timer(); assert(row(f,"a").qualified and row(f,"a").finalPaper==0 and row(f,"a").damage==90)
    end)
    test("withdraw rejoin same and new actor retains history and permanent forfeiture, never bot history", function()
        local f=Spec.fixture(); f:join("a"); f:join("b",true)
        f:event("lifeEnded","a","b"); f:newLife("b")
        assert(f.m:withdraw("a"))
        assert(f.m:join({key="a",actorId="actor:a",controllerType="human",userId=1}))
        f:newLife("a"); assert(f.m:snapshot().participants.a.kills==1 and f.m:snapshot().participants.a.forfeited)
        assert(f.m:disconnect("a"))
        assert(f.m:join({key="a",actorId="actor:new",controllerType="human",userId=1})); f:newLife("a")
        assert(f.m:snapshot().participants.a.kills==1 and f.m:snapshot().participants.a.streak==0)
        assert(not f.m:join({key="b",actorId="actor:swap",controllerType="human",userId=3}))
        f:timer(); assert(not row(f,"a").victory and row(f,"a").finalPaper==0)
    end)
    test("true fresh life resets streak while the continuing life preserves it", function()
        local f=Spec.fixture("TDM"); f:join("a"); f:join("b")
        f:event("lifeEnded","a","b")
        f:advance(1); assert(f.m:snapshot().participants.a.streak==1)
        f:newLife("a"); assert(f.m:snapshot().participants.a.streak==0 and f.m:snapshot().participants.a.kills==1)
    end)
    test("fresh life and rejoin cannot make parked time inherit prior control window", function()
        local f=Spec.fixture(); f:join("a"); f:join("b",true)
        assert(f.m:controlActivity("a")); f:advance(2); f:newLife("a"); f:advance(8)
        near(f.m:snapshot().participants.a.activeSeconds,2)
        assert(f.m:controlActivity("a")); f:advance(2); assert(f.m:withdraw("a"))
        assert(f.m:join({key="a",actorId="actor:new",controllerType="human",userId=1})); f:newLife("a"); f:advance(8)
        near(f.m:snapshot().participants.a.activeSeconds,4)
    end)
    test("fresh plane is not a combat death; recent credit cannot revive a dead life streak", function()
        local f=Spec.fixture(); f:join("a"); f:join("b",true)
        f:event("lifeEnded",nil,"a",{reason="fresh_plane"})
        assert(f.m:snapshot().participants.a.deaths==0)
        f:newLife("a"); f:event("lifeEnded",nil,"a",{reason="world_collision"})
        f:event("lifeEnded","a","b",{reason="world_collision"})
        local p=f.m:snapshot().participants.a
        assert(p.deaths==1 and p.kills==1 and p.streak==0)
    end)
    test("MT06 max12 and stable balanced team boundaries without controller preference", function()
        local f=Spec.fixture("TDM"); local counts={}
        for i=1,12 do f:join("p"..i,i%2==0); local t=f:identity("p"..i).teamId; counts[t]=(counts[t] or 0)+1 end
        assert(counts["team:1"]==6 and counts["team:2"]==6)
        assert(not f.m:join({key="extra",actorId="actor:extra",controllerType="bot"}))
        local team=f:identity("p1").teamId; assert(f.m:withdraw("p1"))
        assert(f.m:join({key="p1",actorId="actor:again",controllerType="human",userId=1}))
        assert(f.m:snapshot().participants.p1.teamId==team)
    end)
    test("MT05 bot podium position is real; humans do not shift up", function()
        local records={ bot={key="bot",contribution=100,kills=1,assists=0,deaths=0},
            human={key="human",contribution=40,kills=0,assists=1,deaths=0},
            other={key="other",contribution=40,kills=0,assists=1,deaths=1} }
        local order=Rules.podium(records,17)
        assert(order[1].key=="bot" and order[2].key=="human" and order[3].key=="other")
        local f=Spec.fixture("CONTROL"); f:join("bot",true); f:join("enemy",true); f:join("human")
        f:sample("bot"); f:advance(10); f:sample("human"); f:advance(230); f:seal()
        assert(row(f,"bot").place==1 and row(f,"human").place==2)
        assert(row(f,"human").finalPaper==90+40+20)
    end)
    test("settlement handoff is required before round cleanup", function()
        local f=Spec.fixture();f:join("a");f:timer();f:advance(23)
        assert(not f.m:cleanup(f.matchId,{upstreamDrained=true,livesEnded=true,replayBarrier=true}))
        assert(not f.m:acknowledgeSettlement(f.matchId,"wrong"))
        assert(f.m:acknowledgeSettlement(f.matchId,f.m.round.settlementId))
        assert(not f.m:cleanup(f.matchId,{}))
        assert(f.m:cleanup(f.matchId,{upstreamDrained=true,livesEnded=true,replayBarrier=true}))
        assert(f.m.retainedCount==0 and f.m:snapshot().matchId==nil)
    end)
    test("bounded pending rounds backpressure never evicts settlement or creates tombstones", function()
        local f=Spec.fixture()
        for i=1,Match.MAX_RETAINED_ROUNDS do
            f.matchId=f.m:snapshot().matchId
            f:advance(480); f:seal(); f:advance(23)
            if i&lt;Match.MAX_RETAINED_ROUNDS then assert(f.m:startRound("FFA")) end
        end
        assert(not f.m:startRound("FFA") and f.m.retainedCount==Match.MAX_RETAINED_ROUNDS)
        for matchId,r in pairs(f.m.retained) do
            assert(f.m:acknowledgeSettlement(matchId,r.settlementId))
            assert(f.m:cleanup(matchId,{upstreamDrained=true,livesEnded=true,replayBarrier=true}))
        end
        assert(f.m.retainedCount==0 and f.m:startRound("FFA"))
    end)
    test("mock Studio identities explicit gate, never forge positive ID", function()
        local f=Spec.fixture()
        assert(not f.m:join({key="studio",actorId="actor:studio",controllerType="human",userId=-1}))
        f.m.context.allowStudioTestUsers=true
        local ok=f.m:join({key="studio",actorId="actor:studio",controllerType="human",userId=-1})
        assert(ok==game:GetService("RunService"):IsStudio())
        if ok then assert(f.m:snapshot().participants.studio.userId==-1 and f.m:snapshot().participants.studio.mockOnly) end
    end)
    test("public snapshot allowlist excludes controller account qualification and departed history", function()
        local f=Spec.fixture(); f:join("a"); f:join("bot",true); f:join("gone")
        assert(f.m:withdraw("gone"))
        local public=f.m:publicSnapshot()
        assert(#public.pilots==2 and public.participants==nil and public.votes==nil)
        for _,p in ipairs(public.pilots) do
            assert(p.controllerType==nil and p.userId==nil and p.key==nil and p.qualified==nil
                and p.activityIntervals==nil and p.mockOnly==nil)
        end
        f:timer(); assert(#f.m:publicSnapshot().result.participants==2)
    end)
    test("advancing clock reads with empty outbox allow start join vote; blocked flag rejects", function()
        local time, blocked = 0, false
        local clock = {now=function() time+=0.0001; return time end}
        local m=Match.new({clock=clock,config=gameplay,economy=economy,sessionId="moving-clock",seed=7,
            combatDrainState=function() return {through=clock:now(),blocked=blocked} end})
        local ok,matchId=m:startRound("FFA"); assert(ok)
        assert(m:join({key="a",actorId="actor:a",controllerType="human",userId=1}))
        time+=480; m:tick(); assert(m:snapshot().phase=="ENDING")
        assert(m:sealCombatDrain(matchId,0))
        time+=8; m:tick(); assert(m:snapshot().phase=="VOTE")
        assert(m:vote("a","TDM"))
        blocked=true; assert(not m:vote("a","FFA"))
    end)
    return result
end
return Spec
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ROJO_282">
          <Properties>
            <string name="Name">Matchmaking.spec</string>
            <string name="Source">local Matching=require(game.ServerScriptService.FlyFightPaper.Matchmaking)
local Suite=require(script.Parent.Parent.fixtures.Suite)
local Spec={}
function Spec.run()
 local result,test=Suite.new()
 local function player(count)
  local p=Instance.new("Folder");p.Parent=game.ServerStorage
  return p,{qualification={count=count}}
 end
 test("only five qualifying matches graduate; XP and client flags do not",function()
  assert(Matching.classFor({qualification={count=4},xpMilli=999999999})=="rookie")
  assert(Matching.classFor({qualification={count=5}})=="regular")
 end)
 test("Studio isolates a trusted beginner room from graduated profiles",function()
  local a,pa=player(0);local b,pb=player(5)
  b:SetAttribute("Graduated",false)
  local profiles={view=function(_,p)return p==a and pa or pb end}
  local rooms=Matching.new(profiles,{mock=true})
  assert(rooms:admit(a) and rooms.class=="rookie")
  assert(not rooms:admit(b) and rooms.class=="rookie")
  a:Destroy();b:Destroy()
 end)
 test("graduated solo players get a regular room",function()
  local p,profile=player(5)
  local rooms=Matching.new({view=function()return profile end},{mock=true})
  assert(rooms:admit(p) and rooms.class=="regular");p:Destroy()
 end)
 test("unloaded profiles cannot choose a room",function()
  local p=player(0);p:SetAttribute("Graduated",true)
  local rooms=Matching.new({view=function()return nil end},{mock=true})
  assert(not rooms:admit(p) and rooms.class==nil);p:Destroy()
 end)
 test("live transfer releases the profile before sending and blocks repeat joins",function()
  local p,profile=player(5);local disconnected=false;local sent=false;local order={}
  local entry={account="test"};local profiles={entries={[p]=entry},view=function()return profile end,
   release=function(_,who)assert(who==p);entry.leaving=true;entry.releaseAt=0;disconnected=true;table.insert(order,"pause")end}
  local platform={destination=function()return {class="regular"}end,send=function()
   assert(profiles.entries[p]==nil and disconnected);sent=true;table.insert(order,"send")
  end}
  local rooms=setmetatable({profiles=profiles,platform=platform,mock=false,class="rookie",transfers={}},Matching)
  assert(not rooms:admit(p));assert(not rooms:admit(p))
  task.wait(.05);assert(entry.leaving and entry.releaseAt==0 and disconnected and not sent)
  profiles.entries[p]=nil;task.wait(.15)
  assert(sent and order[1]=="pause" and order[2]=="send");p:Destroy()
 end)
 test("a failed destination keeps the loaded profile and permits retry",function()
  local p,profile=player(5);local entry={account="test"}
  local profiles={entries={[p]=entry},view=function()return profile end}
  local rooms=setmetatable({profiles=profiles,mock=false,class="rookie",transfers={},platform={destination=function()error("unavailable")end}},Matching)
  assert(not rooms:admit(p));task.wait()
  assert(not rooms.transfers[p] and not entry.leaving and profiles.entries[p]==entry and not p:GetAttribute("Routing"));p:Destroy()
 end)
 test("a failed send reloads the released profile instead of creating defaults",function()
  local p=player(5);local reloaded=false
  local profiles={entries={},load=function(_,who)assert(who==p);reloaded=true end}
  local rooms=setmetatable({profiles=profiles,transfers={[p]=true}},Matching)
  rooms:failed(p);assert(reloaded and not p:GetAttribute("Routing"));p:Destroy()
 end)
 return result
end
return Spec
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ROJO_283">
          <Properties>
            <string name="Name">MockShop.spec</string>
            <string name="Source">local Root=game.ReplicatedStorage.FlyFightPaper
local Hangar=require(game.ServerScriptService.FlyFightPaper.HangarService)
local Catalog=require(Root.Shared.Catalog)
local Schema=require(Root.Shared.ProfileSchema)
local Suite=require(script.Parent.Parent.fixtures.Suite)
local Spec={}
function Spec.run()
 local result,test=Suite.new()
 local function fixture(mock)
  local f={calls=0};local catalog=Catalog.new(require(Root.Generated.Catalog))
  f.player=Instance.new("Folder");f.player.Parent=game.ServerStorage
  local profiles={mock=mock,view=function()return Schema.defaults(catalog)end,enqueue=function(_,player,input)
   assert(player==f.player);f.calls+=1;f.input=input;return true
  end}
  f.hangar=Hangar.new({catalog=catalog},profiles)
  return f
 end
 local product
 for _,p in ipairs(require(Root.Generated.Commerce).products) do if p.benefit=="paper_balance" then product=p;break end end
 test("mock shop refuses a real profile even inside Studio",function()
  local f=fixture(false);f.hangar:handle(f.player,"mockProduct",product.key)
  assert(f.calls==0);f.player:Destroy()
 end)
 test("Studio mock profiles can use simulated Paper products",function()
  local f=fixture(true);f.hangar:handle(f.player,"mockProduct",product.key)
  assert(f.calls==1 and f.input.kind=="purchasedPaper" and f.input.wholePaper==product.amount)
  f.player:Destroy()
 end)
 test("unknown or malformed mock products grant nothing",function()
  local f=fixture(true)
  f.hangar:handle(f.player,"mockProduct",{key=product.key})
  f.hangar:handle(f.player,"mockProduct","invented")
  assert(f.calls==0);f.player:Destroy()
 end)
 return result
end
return Spec
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ROJO_284">
          <Properties>
            <string name="Name">NativeAssets.spec</string>
            <string name="Source">local Assets=require(game.ReplicatedStorage.FlyFightPaper.Shared.NativeAssets)
local Suite=require(script.Parent.Parent.fixtures.Suite)
local Spec={}
function Spec.run()
 local result,test=Suite.new()
 test("runtime avatars cannot make a partly replicated map ready",function()
  local room=Instance.new("Folder");room.Parent=game.ServerStorage
  local part=Instance.new("Part");part.Parent=room
  local decal=Instance.new("Decal");decal.Parent=part
  assert(not Assets.ready(room));Assets.mark(room);assert(Assets.ready(room))
  decal.Parent=nil
  local avatar=Instance.new("Model");avatar.Parent=room
  for _=1,20 do Instance.new("Part",avatar) end
  assert(not Assets.ready(room))
  decal.Parent=part;assert(Assets.ready(room))
  room:Destroy()
 end)
 test("native aircraft library waits for all tagged source parts",function()
  local assets=Instance.new("Folder");assets.Parent=game.ServerStorage
  local body=Instance.new("MeshPart");body.Parent=assets
  local wings=Instance.new("MeshPart");wings.Parent=assets
  Assets.mark(assets);wings.Parent=nil
  Instance.new("Folder",assets)
  assert(not Assets.ready(assets))
  wings.Parent=assets;assert(Assets.ready(assets))
  assets:Destroy()
 end)
 return result
end
return Spec
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ROJO_285">
          <Properties>
            <string name="Name">ProfileRuntime.spec</string>
            <string name="Source">local Root=game.ReplicatedStorage.FlyFightPaper
local Server=game.ServerScriptService.FlyFightPaper
local Runtime=require(Server.ProfileRuntime)
local Service=require(Server.ProfileService)
local Schema=require(Root.Shared.ProfileSchema)
local Catalog=require(Root.Shared.Catalog)
local Fake=require(script.Parent.Parent.fixtures.FakeProfiles)
local Suite=require(script.Parent.Parent.fixtures.Suite)
local Spec={}
local function fixture()
 local catalog=Catalog.new(require(Root.Generated.Catalog))
 local runtime=setmetatable({mock=true,entries={},service=Service.new({catalog=catalog,mock=true,monotonic=function()return 100 end})},Runtime)
 local players={}
 for i=1,2 do
  local player={UserId=i,attributes={}}
  function player:SetAttribute(key,value)self.attributes[key]=value end
  local account=tostring(i);local profile=Fake.new(Schema.defaults(catalog))
  assert(runtime.service:attach(account,profile,{connected=true,mapLoaded=true}).status=="ok")
  runtime.entries[player]={player=player,account=account,queue={},seen={},callbacks={},loaded=true,lastSavedVersion=0}
  players[i]=player
 end
 return runtime,players
end
function Spec.run()
 local result,test=Suite.new()
 test("joining recovers over-capacity or three-type presets and pending refolds without losing Paper",function()
  local catalog=Catalog.new(require(Root.Generated.Catalog))
  for _,mounts in ipairs({{"eraser",false,"rubber","rubber"},{"pellet","staple","rubber",false}}) do
  for _,state in ipairs({"reserved","delivered","applied","cancelled"}) do
   local data=Schema.defaults(catalog);data.xpMilli=60000000;data.paperMilli=1234567;data.ownership.eraser=true;data.ownership.rubber=true;data.ownership.staple=true
   data.presets[1].name="Saved guided build";data.presets[1].loadout.weapon_mounts=table.clone(mounts)
   local cost=require(Root.Generated.Gameplay).service.full_refold_paper*1000
   data.refolds={pending={state=state,costMilli=cost,loadout=assert(Schema.copy(data.presets[1].loadout)),
    fence={nonce="old",generation=1,sessionGeneration=1,actorId="pilot",lifeId="1",matchId="match",participationId="pilot",padId="desk"}}}
   local profile=Fake.new(data);local service=Service.new({catalog=catalog,monotonic=function()return 100 end})
   assert(service:attach("saved",profile,{connected=true,mapLoaded=true}).status=="ok")
   local view=service:view("saved").value
   assert(view.paperMilli==1234567+((state=="reserved" or state=="delivered") and cost or 0))
   assert(view.xpMilli==60000000 and view.ownership.eraser and view.ownership.rubber and view.presets[1].name=="Saved guided build")
   assert(Schema.canonical(view.presets[1].loadout)==Schema.canonical(catalog:starterLoadout()) and next(view.refolds)==nil)
   local balance=view.paperMilli;service:detach("saved")
   assert(service:attach("saved",profile,{connected=true,mapLoaded=true}).status=="ok" and service:view("saved").value.paperMilli==balance)
  end end
 end)
 test("one failing profile worker does not stop a healthy worker",function()
  local runtime,players=fixture()
  for _,p in ipairs(players)do assert(runtime:enqueue(p,{kind="contribution",points=10},"reward"))end
  local original=runtime.service.apply
  runtime.service.apply=function(self,account,input)if account=="1"then error("injected worker failure")end;return original(self,account,input)end
  assert(not runtime:process(runtime.entries[players[1]]))
  assert(runtime:process(runtime.entries[players[2]]) and players[2].attributes.Paper==4)
  assert(#runtime.entries[players[1]].queue==1)
  runtime.service.apply=original
  assert(runtime:flush(runtime.entries[players[1]]) and players[1].attributes.Paper==4)
 end)
 test("source retries enqueue once and a closing session rejects new work",function()
  local runtime,players=fixture();local p=players[1];local e=runtime.entries[p]
  assert(runtime:enqueue(p,{kind="contribution",points=10},"same"))
  assert(runtime:enqueue(p,{kind="contribution",points=10},"same") and #e.queue==1)
  assert(runtime:flush(e) and p.attributes.Paper==4)
  e.closing=true;assert(not runtime:enqueue(p,{kind="contribution",points=10},"late"))
 end)
 test("save handoff drains pending operations in order without storage writes",function()
  local runtime,players=fixture();local p=players[1];local e=runtime.entries[p]
  for i=1,10 do assert(runtime:enqueue(p,{kind="contribution",points=i},"reward"..i))end
  assert(runtime:flush(e) and #e.queue==0 and p.attributes.Paper==22)
  local profile=runtime.service.sessions[e.account].profile
  assert(profile.writes==0 and profile.Data.operationIds[runtime.service.sessions[e.account].token]==10)
 end)
 return result
end
return Spec
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ROJO_286">
          <Properties>
            <string name="Name">ProfileSchema.spec</string>
            <string name="Source">local Root=game:GetService("ReplicatedStorage"):WaitForChild("FlyFightPaper")
local Schema=require(Root.Shared.ProfileSchema)
local Economy=require(Root.Shared.EconomyRules)
local Catalog=require(Root.Shared.Catalog)
local Suite=require(script.Parent.Parent.fixtures.Suite)
local Spec={}
function Spec.run()
	local result,test=Suite.new()
	local catalog=Catalog.new(require(Root.Generated.Catalog),require(Root.Generated.Gameplay))
	local function fresh() return Schema.defaults(catalog) end
	test("explicit defaults grant only catalog starter ownership and five legal presets",function()
		local p=assert(Schema.validate(fresh(),catalog)); local starter=assert(Economy.starterOwnership(catalog))
		assert(Schema.canonical(p.ownership)==Schema.canonical(starter) and #p.presets==5)
		assert(p.paperMilli==require(Root.Generated.Economy).initial_paper*1000)
		assert(p.xpMilli==require(Root.Generated.Economy).initial_total_xp*1000)
	end)
	test("new profiles have valid default crosshair settings",function()
		local p=fresh()
		assert(p.settings.crosshairColor=="blue" and p.settings.crosshairSize=="Medium")
		assert(Schema.validate(p,catalog))
	end)
	test("every allowed crosshair color and size validates",function()
		for _,color in ipairs({"green","red","blue","yellow","purple","white"}) do
			local p=fresh(); p.settings.crosshairColor=color; assert(Schema.validate(p,catalog))
		end
		for _,size in ipairs({"Small","Medium","Large"}) do
			local p=fresh(); p.settings.crosshairSize=size; assert(Schema.validate(p,catalog))
		end
	end)
	test("invalid or missing crosshair settings reject",function()
		for _,color in ipairs({"orange",1}) do
			local p=fresh(); p.settings.crosshairColor=color
			local valid,err=Schema.validate(p,catalog); assert(not valid and err:find("invalid_crosshair_color",1,true))
		end
		for _,size in ipairs({"Huge",1}) do
			local p=fresh(); p.settings.crosshairSize=size
			local valid,err=Schema.validate(p,catalog); assert(not valid and err:find("invalid_crosshair_size",1,true))
		end
		local p=fresh(); p.settings.crosshairColor=nil; assert(not Schema.validate(p,catalog))
		p=fresh(); p.settings.crosshairSize=nil; assert(not Schema.validate(p,catalog))
	end)
	test("previous schema migration adds only crosshair defaults without mutating input",function()
		local p=fresh(); p.schemaVersion=Schema.VERSION-1; p.settings.crosshairColor=nil; p.settings.crosshairSize=nil
		p.paperMilli=1234567; p.settings.music=0.25; p.settings.quality="Low"; p.extensions={custom={kept=true}}
		local original=Schema.canonical(p)
		local migrated=assert(Schema.migrate(p,catalog))
		assert(migrated.schemaVersion==Schema.VERSION and migrated.settings.crosshairColor=="blue" and migrated.settings.crosshairSize=="Medium")
		assert(Schema.validate(migrated,catalog))
		assert(Schema.canonical(p)==original,"migration mutated input")
		local expected=assert(Schema.copy(p)); expected.schemaVersion=Schema.VERSION
		expected.settings.crosshairColor="blue"; expected.settings.crosshairSize="Medium"
		assert(Schema.canonical(migrated)==Schema.canonical(expected),"migration changed unrelated fields")
	end)
	test("v1 migration preserves exact value and unrelated fields",function()
		local p=fresh(); p.schemaVersion=1; p.streams=nil; p.journal={}; p.operationIds=nil; p.operationSessions=nil; p.receiptIds=nil; p.paperMilli=1234567; p.xpMilli=98765
		p.settings.crosshairColor=nil; p.settings.crosshairSize=nil
		p.boosts.xpSeconds=10.25; p.extensions={custom={kept=true}}
		assert(catalog:get("pencil") and not p.ownership.pencil); p.ownership.pencil=true
		local ownership=Schema.canonical(p.ownership)
		local migrated=assert(Schema.migrate(p,catalog))
		assert(migrated.schemaVersion==Schema.VERSION and migrated.paperMilli==1234567 and migrated.xpMilli==98765)
		assert(migrated.boosts.xpSeconds==10.25 and migrated.extensions.custom.kept and p.schemaVersion==1)
		assert(migrated.ownership.pencil and Schema.canonical(migrated.ownership)==ownership)
		assert(Schema.canonical(p.ownership)==ownership,"migration mutated input ownership")
		assert(migrated.settings.crosshairColor=="blue" and migrated.settings.crosshairSize=="Medium" and Schema.validate(migrated,catalog))
		p.ownership=nil; assert(not Schema.migrate(p,catalog))
	end)
	test("v2 migration continues through crosshair defaults",function()
		local p=fresh(); p.schemaVersion=2; p.journal={}; p.streams={}; p.operationIds=nil; p.operationSessions=nil; p.receiptIds=nil
		p.settings.crosshairColor=nil; p.settings.crosshairSize=nil
		local migrated=assert(Schema.migrate(p,catalog))
		assert(migrated.schemaVersion==Schema.VERSION and migrated.settings.crosshairColor=="blue" and migrated.settings.crosshairSize=="Medium")
		assert(migrated.journal==nil and migrated.streams==nil and Schema.validate(migrated,catalog))
	end)
	test("malformed and future versions fail closed",function()
		local p=fresh(); p.schemaVersion=Schema.VERSION+1; assert(not Schema.migrate(p,catalog))
		p=fresh(); p.schemaVersion=Schema.VERSION-1; p.settings=nil; assert(not Schema.migrate(p,catalog))
		p=fresh(); p.paperMilli=-1; assert(not Schema.validate(p,catalog))
		p=fresh(); p.presets[5]=nil; assert(not Schema.validate(p,catalog))
		p=fresh(); p.injected=true; assert(not Schema.validate(p,catalog))
	end)
	test("nonfinite money, unsafe integers, keys, cycles, functions, Instances and metatables reject",function()
		for _,n in ipairs({0/0,math.huge,-math.huge,9007199254740992}) do local p=fresh(); p.xpMilli=n; assert(not Schema.validate(p,catalog)) end
		local cycle={}; cycle.self=cycle; assert(not Schema.copy(cycle))
		assert(not Schema.copy({[false]=true})); assert(not Schema.copy({[1.5]=true}))
		assert(not Schema.copy({[1]="x",[3]="z"})); assert(not Schema.copy({[1]="x",name="z"}))
		assert(not Schema.copy({callback=function() end})); assert(not Schema.copy(setmetatable({},{__index={}})))
		local object=Instance.new("Folder"); local copied=Schema.copy({object=object}); object:Destroy(); assert(not copied)
	end)
	test("depth, entries, bytes, strings and operation IDs are bounded",function()
		local root={}; local p=root; for _=1,Schema.MAX_DEPTH do p.next={}; p=p.next end; assert(not Schema.copy(root))
		local entries={}; for i=1,Schema.MAX_ENTRIES+1 do entries[i]=true end; assert(not Schema.copy(entries))
		local bytes={}; for i=1,30 do bytes[i]=string.rep("x",4000) end; assert(not Schema.copy(bytes))
		assert(not Schema.copy({value=string.rep("x",4097)}))
		p=fresh(); for i=1,require(Root.Generated.Server).profiles.session_id_history+1 do local token="session"..i;table.insert(p.operationSessions,token);p.operationIds[token]=1 end; assert(not Schema.validate(p,catalog))
	end)
	test("ownership and level gates validate every saved loadout with exact mount order",function()
		local p=fresh(); p.presets[1].loadout.weapon_mounts[1]="pencil"; assert(not Schema.validate(p,catalog))
		p=fresh(); table.insert(p.presets[1].loadout.weapon_mounts,false); assert(not Schema.validate(p,catalog))
		p=fresh(); p.ownership.invented=true; assert(not Schema.validate(p,catalog))
		local expensive
		for _,item in ipairs(catalog.weapons) do if item.min_level&gt;1 then expensive=item; break end end
		assert(expensive); p=fresh(); p.ownership[expensive.id]=true; p.presets[1].loadout.weapon_mounts[1]=expensive.id
		assert(not Schema.validate(p,catalog))
	end)
	test("capacity tuning recovers only the affected preset and preserves the account",function()
		local p=fresh();p.xpMilli=60000000;p.paperMilli=1234567;p.ownership.eraser=true;p.ownership.rubber=true
		p.presets[2].name="Guided build";p.presets[2].loadout.weapon_mounts={"eraser",false,"rubber","rubber"}
		p.settings.music=.25;p.extensions={custom={kept=true}}
		local original=Schema.canonical(p)
		assert(not Schema.validate(p,catalog),"ordinary validation must still reject an over-capacity build")
		local recovered=assert(Schema.migrate(p,catalog));local expected=assert(Schema.copy(p))
		expected.presets[2].loadout=catalog:starterLoadout()
		assert(Schema.canonical(recovered)==Schema.canonical(expected),"recovery changed unrelated progress")
		assert(Schema.canonical(p)==original,"recovery mutated the saved input")
		assert(Schema.canonical(assert(Schema.migrate(recovered,catalog)))==Schema.canonical(recovered),"recovery must be idempotent")
	end)
	test("a saved third weapon type recovers only its preset and pending refold",function()
		local p=fresh();p.xpMilli=60000000;p.paperMilli=1234567;p.ownership.staple=true;p.ownership.rubber=true
		p.presets[2].name="Three old guns";p.presets[2].loadout.weapon_mounts={"pellet","staple","rubber",false}
		p.presets[3].loadout.weapon_mounts={"staple","pellet",false,false}
		p.qualification.count=2;p.qualification.history={first=true,second=true};p.statistics.matches=3;p.settings.music=.25;p.extensions={custom={kept=true}}
		p.refolds={pending={state="reserved",costMilli=require(Root.Generated.Gameplay).service.full_refold_paper*1000,
			loadout=assert(Schema.copy(p.presets[2].loadout)),fence={nonce="old",generation=1,sessionGeneration=1,actorId="pilot",lifeId="1",matchId="match",participationId="pilot",padId="desk"}}}
		local original=Schema.canonical(p);assert(not Schema.validate(p,catalog))
		local migrated=assert(Schema.migrate(p,catalog));local expected=assert(Schema.copy(p))
		expected.presets[2].loadout=catalog:starterLoadout();expected.refolds.pending.loadout=catalog:starterLoadout()
		assert(Schema.canonical(migrated)==Schema.canonical(expected) and Schema.canonical(p)==original)
		assert(Schema.canonical(Schema.migrate(migrated,catalog))==Schema.canonical(migrated))
	end)
	test("capacity recovery still rejects unknown parts, wrong mounts and unowned or locked presets",function()
		local p=fresh();p.presets[1].loadout.weapon_mounts[1]="invented";assert(not Schema.migrate(p,catalog))
		p=fresh();p.presets[1].loadout.weapon_mounts[3]="pencil";assert(not Schema.migrate(p,catalog))
		p=fresh();p.xpMilli=60000000;p.presets[1].loadout.weapon_mounts[1]="rubber";assert(not Schema.migrate(p,catalog))
		p=fresh();p.ownership.rubber=true;p.presets[1].loadout.weapon_mounts[1]="rubber";assert(not Schema.migrate(p,catalog))
	end)
	test("settings agree with SessionProtocol and names reject invalid UTF8/control bytes",function()
		local p=fresh(); p.settings={sensitivity=0.2,sound=0,music=0.5,reducedShake=true,quality="Low",crosshairColor="blue",crosshairSize="Medium"}; assert(Schema.validate(p,catalog))
		p.settings.sensitivity=0.1; assert(not Schema.validate(p,catalog))
		p=fresh(); p.presets[1].name="bad\nname"; assert(not Schema.validate(p,catalog))
		p.presets[1].name=string.char(255); assert(not Schema.validate(p,catalog))
	end)
	test("economic view is narrow immutable and merges without changing unrelated state",function()
		local p=fresh(); p.extensions={nested={journal={inner={value=true}}}}
		p.version=1; p.operationIds.old=1;p.operationSessions={"old"}
		local view=Schema.economicView(p); assert(view.journal==nil and view.boosts==nil)
		assert(not pcall(function() view.ownership.fake=true end))
		local earned=assert(Economy.applyContribution(view,1,{paper=1,xp=2},"immutable"))
		Schema.mergeEconomic(p,earned.profile)
		assert(p.paperMilli==400 and p.xpMilli==1500 and p.operationIds.old==1 and p.extensions.nested.journal.inner.value)
	end)
	test("canonical identities distinguish types, payloads and delimiter-containing strings",function()
		assert(Schema.canonical({a="1"})~=Schema.canonical({a=1}))
		assert(Schema.canonical({a="b:c",d="e"})~=Schema.canonical({a="b",c="d:e"}))
		assert(Schema.canonical({a=1,b=2})==Schema.canonical({b=2,a=1}))
	end)
	return result
end
return Spec
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ROJO_287">
          <Properties>
            <string name="Name">RewardQueue.spec</string>
            <string name="Source">local Queue=require(game.ServerScriptService.FlyFightPaper.RewardQueue)
local Suite=require(script.Parent.Parent.fixtures.Suite)
local Spec={}
local function fixture()
 local f={now=100,fail={},awards={},warnings={},players={}}
 for i=1,2 do f.players[i]={UserId=i} end
 local profiles={entries={},service={}}
 for i,p in ipairs(f.players) do profiles.entries[p]={account=i} end
 function profiles:playerForUserId(id) return f.players[id] end
 function profiles.service:producerCapture(account,at)
  if f.fail[account]=="capture" then error("injected capture failure") end
  return {status="ok",value={paper=f.multiplier or 1,xp=1,at=at or f.now}}
 end
 function profiles:enqueue(player,input,source)
  if f.fail[player.UserId]=="throw" then error("injected profile failure") end
  if f.fail[player.UserId] then return false end
  f.awards[source]={player=player.UserId,input=input};return true
 end
 f.queue=Queue.new(profiles,function()return f.now end,function(message)table.insert(f.warnings,message)end)
 function f:add(id,source) self.queue:add(id,source,{kind="contribution",points=10},99) end
 return f
end
function Spec.run()
 local result,test=Suite.new()
 test("one rejecting player cannot block another player's rewards",function()
  local f=fixture();f.fail[1]=true;f:add(1,"first");f:add(2,"second");f.queue:step()
  assert(f.awards.first==nil and f.awards.second.player==2 and f.queue.players[1] and #f.warnings==1)
  f.fail[1]=nil;f.now+=2;f.queue:step()
  assert(f.awards.first.player==1 and next(f.queue.players)==nil)
 end)
 test("thrown profile and multiplier errors stay isolated",function()
  for _,failure in ipairs({"throw","capture"}) do
   local f=fixture();f.fail[1]=failure;f:add(1,"broken");f:add(2,"healthy");f.queue:step()
   assert(f.awards.healthy and not f.awards.broken and f.queue.players[1])
   f.fail[1]=nil;f.now+=2;f.queue:step();assert(f.awards.broken)
  end
 end)
 test("a retry freezes the multiplier from the first delivery attempt",function()
  local f=fixture();f.fail[1]=true;f.multiplier=2;f:add(1,"boosted");f.queue:step()
  f.fail[1]=nil;f.multiplier=1;f.now+=2;f.queue:step()
  assert(f.awards.boosted.input.multipliers.paper==2)
 end)
 test("a queued reward keeps its original payload across duplicate submissions",function()
  local f=fixture();f.fail[1]=true;f:add(1,"same")
  f.queue:add(1,"same",{kind="contribution",points=9999});f.queue:step()
  f.fail[1]=nil;f.now+=2;f.queue:step();assert(f.awards.same.input.points==10)
 end)
 test("retry and warning limits avoid busy loops and log spam",function()
  local f=fixture();f.fail[1]=true;f:add(1,"retry");f.queue:step()
  for _=1,100 do f.queue:step() end
  assert(#f.warnings==1)
  f.now+=2;f.queue:step();assert(#f.warnings==1)
  f.now+=16;f.queue:step();assert(#f.warnings==2)
 end)
 test("display callback errors cannot block reward delivery",function()
  local f=fixture();f.queue:add(1,"callback",{kind="statistics",deltas={matches=1}},nil,function()error("display failed")end)
  f:add(2,"other");f.queue:step()
  assert(f.awards.callback and f.awards.other and next(f.queue.players)==nil)
 end)
 return result
end
return Spec
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ROJO_288">
          <Properties>
            <string name="Name">RoundRuntime.spec</string>
            <string name="Source">local Server=game.ServerScriptService.FlyFightPaper
local Runtime=require(Server.RoundRuntime)
local MatchSpec=require(script.Parent["Match.spec"])
local Suite=require(script.Parent.Parent.fixtures.Suite)
local Spec={}
function Spec.run()
 local result,test=Suite.new()
 test("withdraw and rejoin creates a new damage-eligible life for the same account",function()
  local f=MatchSpec.fixture()
  local Catalog=require(game.ReplicatedStorage.FlyFightPaper.Shared.Catalog)
  local Flight=require(Server.FlightService)
  local catalog=Catalog.new(require(game.ReplicatedStorage.FlyFightPaper.Generated.Catalog))
  local planes=Instance.new("Folder");planes.Parent=game.ServerStorage
  local flight=setmetatable({catalog=catalog,template=game.ServerStorage.Assets.PaperPlane,planes=planes,records={["1"]={kills=0}},padReservations={}},Flight)
  local runtime=setmetatable({engine=f.m,profiles={view=function()return nil end}},Runtime)
  local player={UserId=1}
  local function newPilot()
   return {id="1",player=player,kind="human",name="Pilot",seat=1,home=CFrame.new(0,120,0),loadout=catalog:starterLoadout()}
  end
  local first=newPilot();flight:build(first);runtime:bind(first)
  assert(f.m:withdraw("1"));f:advance(1)
  local nextPilot=newPilot();flight:build(nextPilot);runtime:bind(nextPilot)
  assert(first.identity.lifeId~=nextPilot.identity.lifeId)
  f:join("target",true);f:event("weaponDamage","1","target")
  assert(f.m.round.participants["1"].damage==2 and f.m.round.participants["1"].forfeited)
  planes:Destroy()
 end)
 test("Timer results drain combat before reading the finalized result",function()
  local f=MatchSpec.fixture();f:join("pilot",true);f:advance(480)
  assert(f.m.phase=="ENDING" and f.m.round.result==nil and f.m.round.endedAt==nil)
  local removed=0
  local pilot={id="pilot"}
  local runtime=setmetatable({engine=f.m,finished=false,earningCursor=0,earnedTotals={},settledRows={},
   flight={active=true,records={{cause="weapon"}},pilots={pilot},remove=function(_,p,cause)
    assert(p==pilot and cause=="round_end");removed+=1
   end},combat={enabled=true,shots={},totalFired=17,totalHits=3},bots={enabled=true}},Runtime)
  runtime:finish()
  assert(f.m.phase=="RESULTS" and f.m.round.result~=nil)
  assert(runtime.lastRound.seconds==480 and runtime.lastRound.shots==17 and runtime.lastRound.hits==3)
  assert(runtime.finished and runtime.settled and removed==1)
  assert(not runtime.flight.active and not runtime.combat.enabled and not runtime.bots.enabled)
  runtime:finish();assert(removed==1)
 end)
 test("a failed player reward cannot hold the server in results",function()
  local f=MatchSpec.fixture();f:join("a");f:join("b");f:timer()
  local failed=true;local paid={};local p1={UserId=1};local p2={UserId=2}
  local profiles={entries={[p1]={account=1},[p2]={account=2}},service={producerCapture=function()return {status="ok",value={paper=1,xp=1}}end}}
  function profiles:playerForUserId(id)return id==1 and p1 or p2 end
  function profiles:enqueue(p,input,source)if p==p1 and failed then error("save unavailable")end;paid[source]=p.UserId;return true end
  local runtime=setmetatable({engine=f.m,profiles=profiles,earningCursor=0,earnedTotals={},finalRewards={},settledRows={}},Runtime)
  runtime:earnings();runtime:queueSettlement()
  assert(runtime.settled and runtime.rewardQueue.players[1] and paid[f.matchId..":stats:b"]==2)
  f:advance(23);assert(f.m.phase=="READY")
  -- Cleanup is allowed after the handoff, even while one player's retries remain.
  assert(f.m:acknowledgeSettlement(f.matchId,f.m.round.settlementId))
  assert(f.m:cleanup(f.matchId,{upstreamDrained=true,livesEnded=true,replayBarrier=true}))
  assert(f.m:startRound("FFA"))
  failed=false
  for _,item in pairs(runtime.rewardQueue.players[1].items)do item.nextTry=0 end
  runtime.rewardQueue:step();assert(next(runtime.rewardQueue.players)==nil)
 end)
 return result
end
return Spec
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ROJO_289">
          <Properties>
            <string name="Name">Service.spec</string>
            <string name="Source">local Root = game:GetService("ReplicatedStorage"):WaitForChild("FlyFightPaper")
local Rules = require(Root.Shared.ServiceRules)
local Suite = require(script.Parent.Parent.fixtures.Suite)
local Spec = {}
local function near(a, b) assert(math.abs(a - b) &lt; 1e-7, tostring(a) .. " != " .. tostring(b)) end
function Spec.run()
    local result, test = Suite.new()
    test("hangar safety runs down inside, refills after 120 s out in a row", function()
        local r, out = Rules.hangarSafety(120, 0, true, 120, 120, 120)
        assert(r == 0 and out == 0)
        r, out = Rules.hangarSafety(r, out, false, 60, 120, 120); assert(r == 0 and out == 60)
        r, out = Rules.hangarSafety(r, out, true, 1, 120, 120); assert(r == 0 and out == 0) -- darting back resets the wait
        r, out = Rules.hangarSafety(r, out, false, 119, 120, 120); assert(r == 0)
        r, out = Rules.hangarSafety(r, out, false, 1, 120, 120); assert(r == 120)
    end)
    test("SV04 exact proportional repair and repeated floor", function()
        local p = assert(Rules.repair(120, 120, 30))
        near(p.health, 105); near(p.lifeMaxHealth, 105); near(p.wear, 15); near(p.restored, 75)
        local M = 120
        for _ = 1, 20 do
            p = assert(Rules.repair(120, M, 0)); M = p.lifeMaxHealth
            assert(p.health &lt;= M and M &gt;= 72 and M &lt;= 120)
        end
        near(M, 72)
        p = assert(Rules.repair(120, 72, 20)); near(p.health, 72); near(p.wear, 0)
    end)
    test("SV04 tiny scratch no forced harmful repair and finite bounds", function()
        local p = assert(Rules.repair(120, 120, 119.999))
        near(p.wear, 0.001 / 6)
        assert(p.health &gt; 119.999 and p.lifeMaxHealth &lt;= 120)
        p = assert(Rules.repair(120, 120, 120)); assert(p.health == 120 and p.wear == 0)
        p = assert(Rules.repair(120, 72, 72)); assert(p.health == 72 and p.wear == 0)
        for _, values in ipairs({ { 0, 0, 0 }, { 120, 71, 30 }, { 120, 121, 30 },
            { 120, 120, -1 }, { 120, 120, 121 }, { math.huge, 120, 1 }, { 120, 0/0, 1 } }) do
            assert(Rules.repair(table.unpack(values)) == nil)
        end
    end)
    test("landing needs the ring box and a runway-aligned heading", function()
        local cfg = { approach_out_studs = 145, approach_up_studs = 15, approach_box_studs = { 70, 50, 60 },
            approach_max_angle_degrees = 35, hangar_back_studs = 69 }
        local home = CFrame.new(0, 110, -850) * CFrame.Angles(0, math.pi, 0) -- north desk: faces the room (+Z)
        local ring = Rules.approach(home, cfg).Position
        assert((ring - Vector3.new(0, 125, -705)).Magnitude &lt; 1e-3, tostring(ring))
        assert((Rules.hangar(home, cfg).Position - Vector3.new(0, 110, -919)).Magnitude &lt; 1e-3)
        local inbound = Vector3.new(0, 0, -1)
        assert(Rules.linedUp(home, ring, inbound, cfg))
        assert(Rules.linedUp(home, ring, (inbound + Vector3.new(0.5, -0.2, 0)), cfg)) -- ~27 degrees off: assisted
        assert(not Rules.linedUp(home, ring, Vector3.new(1, 0, 0), cfg))             -- from the side
        assert(not Rules.linedUp(home, ring, -inbound, cfg))                         -- flying away
        assert(not Rules.linedUp(home, ring + Vector3.new(40, 0, 0), inbound, cfg))  -- beside the ring
        assert(not Rules.linedUp(home, ring + Vector3.new(0, 0, 40), inbound, cfg))  -- before it
    end)
    test("menu click budget lets a burst land, then refills", function()
        local tokens, last, landed = nil, nil, 0
        for i = 1, 8 do
            local ok, left = Rules.clickBudget(tokens, last, i * 0.05, 6, 0.25)
            if ok then landed += 1; tokens, last = left, i * 0.05 end
        end
        assert(landed == 7, "quick burst landed " .. landed)
        assert(not Rules.clickBudget(tokens, last, last + 0.1, 6, 0.25), "empty budget should refuse")
        assert(Rules.clickBudget(tokens, last, last + 0.3, 6, 0.25), "a quarter second refills one click")
    end)
    return result
end
return Spec
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ROJO_290">
          <Properties>
            <string name="Name">ShotBallistics.spec</string>
            <string name="Source">local Root=game.ReplicatedStorage.FlyFightPaper
local Rules=require(Root.Shared.CombatRules)
local Suite=require(script.Parent.Parent.fixtures.Suite)
local Spec={}
local RANGES={pellet=750,staple=900,rubber=1050,paperclip=1400,pencil=1800}
local ORDER={"pellet","staple","rubber","paperclip","pencil"}
function Spec.run()
	local result,test=Suite.new()
	local catalog=require(Root.Shared.Catalog).new(require(Root.Generated.Catalog),require(Root.Generated.Gameplay))
	test("each gun reaches its design range and ranges grow from pellet to pencil",function()
		local previous=0
		for _,id in ipairs(ORDER) do
			local weapon=catalog:get(id);local range=Rules.shotRange(weapon)
			assert(math.abs(range-RANGES[id])&lt;=RANGES[id]*.02,id.." range "..range)
			assert(range&gt;previous,id.." must out-range the one before");previous=range
		end
	end)
	test("travel time inverts distance and is infinite beyond range",function()
		for _,id in ipairs(ORDER) do
			local weapon=catalog:get(id)
			for _,t in ipairs({.1,.5}) do assert(math.abs(Rules.travelTime(weapon,Rules.shotDistance(weapon,t))-t)&lt;1e-6,id) end
			assert(Rules.travelTime(weapon,Rules.shotRange(weapon)+1)==math.huge,id)
		end
		local eraser=catalog:get("eraser") -- no drag: plain distance over speed
		assert(math.abs(Rules.travelTime(eraser,400)-2)&lt;1e-9 and Rules.travelTime(eraser,eraser.projectile_speed*eraser.lifetime+1)==math.huge)
	end)
	test("shots keep between half and three quarters of their speed at the end of flight",function()
		for _,id in ipairs(ORDER) do
			local weapon=catalog:get(id)
			local ratio=Rules.shotSpeed(weapon,weapon.lifetime)/weapon.projectile_speed
			assert(ratio&gt;.5 and ratio&lt;.75,id.." ratio "..ratio)
			assert(Rules.shotSpeed(weapon,0)==weapon.projectile_speed)
		end
	end)
	test("a shot falls by exactly half g t squared below its straight line",function()
		local direction=Vector3.new(0,0,-1)
		for _,id in ipairs(ORDER) do
			local weapon=catalog:get(id);local t=.4
			local offset=Rules.shotOffset(weapon,direction,t)
			local line=direction*Rules.shotDistance(weapon,t)
			-- Vector3 holds 32-bit floats, so compare to a thousandth of a stud.
			assert(math.abs((line-offset).Y-.5*weapon.drop*t*t)&lt;1e-3 and (offset-Vector3.new(0,offset.Y,0)-line).Magnitude&lt;1e-3,id)
		end
	end)
	return result
end
return Spec
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ROJO_291">
          <Properties>
            <string name="Name">TestRunner</string>
            <string name="Source">-- Run manually in a Studio server. Nothing runs automatically in the game.
local Runner = {}
function Runner.run()
 local total = { passed = 0, failed = 0, suites = 0, failures = {} }
 local modules = {}
 for _, module in ipairs(script.Parent.Parent:GetDescendants()) do
  if module:IsA("ModuleScript") and module.Name:match("%.spec$") then table.insert(modules, module) end
 end
 table.sort(modules, function(a, b) return a:GetFullName() &lt; b:GetFullName() end)
 for _, module in ipairs(modules) do
  total.suites += 1
  local ok, result = pcall(function() return require(module).run() end)
  if not ok then
   total.failed += 1
   table.insert(total.failures, module.Name .. ": " .. tostring(result))
  else
   total.passed += result.passed
   total.failed += result.failed
   for _, case in ipairs(result.results) do
    if not case.passed then table.insert(total.failures, module.Name .. "/" .. case.name .. ": " .. tostring(case.message)) end
   end
  end
 end
 return total
end
return Runner
</string>
          </Properties>
        </Item>
      </Item>
    </Item>
