      <Item class="ModuleScript" referent="ROJO_227">
        <Properties>
          <string name="Name">AirRoutes</string>
          <string name="Source">-- Navigation nodes are gameplay data, derived from the native room. They do not build geometry.
local Routes={};Routes.__index=Routes
function Routes.new(flight)
	local self=setmetatable({flight=flight,nodes={},edges={}},Routes)
	local box=OverlapParams.new();box.FilterType=Enum.RaycastFilterType.Include;box.FilterDescendantsInstances={flight.room};box.RespectCanCollide=true
	local size=flight.boundsSize
	local config=require(game.ReplicatedStorage.FlyFightPaper.Generated.Gameplay).world
	for _,y in ipairs(config.route_y_positions) do
		local height=y*math.min(1,size.Y/config.height_studs)
		for _,column in ipairs(config.route_x_positions) do
			local x=column*math.min(1,size.X/config.width_studs)
			for _,row in ipairs(config.route_z_positions) do
				local z=row*math.min(1,size.Z/config.depth_studs)
				local position=Vector3.new(x,height,z)
				if #workspace:GetPartBoundsInBox(CFrame.new(position),Vector3.new(36,36,36),box)==0 then table.insert(self.nodes,position) end
			end
		end
	end
	for i,a in ipairs(self.nodes) do
		self.edges[i]={}
		for j,b in ipairs(self.nodes) do
			local delta=b-a
			if i~=j and delta.Magnitude&lt;510 and self:clear(a,b,18) then self.edges[i][j]=delta.Magnitude end
		end
	end
	return self
end
function Routes:clear(a,b,radius)
	local d=b-a
	local length=d.Magnitude
	if length&lt;.01 then return true end
	local direction=d.Unit
	-- Roblox limits each shape sweep to 1024 studs.
	for offset=0,length,1000 do
		local remaining=math.min(1000,length-offset)
		if remaining&gt;.001 and workspace:Spherecast(a+direction*offset,radius or 8,direction*remaining,self.flight.cast) then return false end
	end
	return true
end
function Routes:nearest(position)
	local best,index=math.huge,nil
 for i,p in ipairs(self.nodes) do local distance=(p-position).Magnitude;if distance&lt;best and self:clear(position,p,18) and self:clear(p,position,18) then best,index=distance,i end end
	return index
end
function Routes:escape(from,forward)
 local best,index=-math.huge,nil
 for i,node in ipairs(self.nodes) do
  local delta=node-from
  if delta.Magnitude&gt;75 and self:clear(from,node,18) then
   local score=forward:Dot(delta.Unit)*2-math.abs(delta.Magnitude-250)/1000
   if score&gt;best then best,index=score,i end
  end
 end
 return index and {self.nodes[index]} or {}
end
function Routes:path(from,to,forward)
 local delta=to-from
 forward=forward or (delta.Magnitude&gt;.01 and delta.Unit or Vector3.zAxis)
 local start,goal=self:nearest(from),self:nearest(to)
 if not start or not goal then return self:escape(from,forward) end
	local distance,previous,open={[start]=0},{},{[start]=true}
	while next(open) do
		local current,best=nil,math.huge
		for i in pairs(open) do if distance[i]&lt;best then current,best=i,distance[i] end end
		if current==goal then break end
		open[current]=nil
		for neighbor,cost in pairs(self.edges[current]) do
			local d=best+cost
			if d&lt;(distance[neighbor] or math.huge) then distance[neighbor]=d;previous[neighbor]=current;open[neighbor]=true end
		end
	end
 if not distance[goal] then return self:escape(from,forward) end
	local result={};local i=goal
	while i do table.insert(result,1,self.nodes[i]);if i==start then break end;i=previous[i] end
	table.insert(result,to)
	-- Skip visible intermediate nodes. Replanning must not repeatedly turn a moving
	-- plane back toward the nearest node it has already flown past.
	return self:compact(result,from)
end
function Routes:compact(path,from)
	local result={};local cursor=from;local index=1
	while index&lt;=#path do
		local nextIndex=index
		for j=#path,index+1,-1 do if self:clear(cursor,path[j],18) then nextIndex=j;break end end
		table.insert(result,path[nextIndex]);cursor=path[nextIndex];index=nextIndex+1
	end
	return result
end
return Routes
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ROJO_228">
        <Properties>
          <string name="Name">AvatarService</string>
          <string name="Source">local Players=game:GetService("Players")
local Run=game:GetService("RunService")
local Config=require(game.ReplicatedStorage.FlyFightPaper.Generated.Gameplay).avatar_display
local Service={};Service.__index=Service
function Service.new(flight)
 return setmetatable({flight=flight,models={},requests={}},Service)
end
-- A bot dresses like a player: hair, shirt, pants, skin tone and sometimes a cap, shades or a backpack, all free
-- Roblox-made catalog items (config avatar_display.bot_outfits). The same name always gets the same outfit.
function Service.outfit(name)
 local outfits=Config.bot_outfits
 local seed=0
 for i=1,#name do seed=(seed*31+string.byte(name,i))%2147483647 end
 local rng=Random.new(seed)
 local function any(list) return list[rng:NextInteger(1,#list)] end
 local description=Instance.new("HumanoidDescription")
 local skin=Color3.fromRGB(table.unpack(any(outfits.skin_tones)))
 for _,part in ipairs({"Head","Torso","LeftArm","RightArm","LeftLeg","RightLeg"}) do description[part.."Color"]=skin end
 description.HairAccessory=tostring(any(outfits.hair))
 description.Shirt,description.Pants=any(outfits.shirts),any(outfits.pants)
 if rng:NextNumber()&lt;outfits.hat_chance then description.HatAccessory=tostring(any(outfits.hats)) end
 if rng:NextNumber()&lt;outfits.glasses_chance then description.FaceAccessory=tostring(any(outfits.glasses)) end
 if rng:NextNumber()&lt;outfits.backpack_chance then description.BackAccessory=tostring(any(outfits.backpacks)) end
 return description
end
function Service:remove(p)
 self.requests[p.id]=nil
 local model=self.models[p.id];if model then model:Destroy();self.models[p.id]=nil end
end
function Service:assign(p)
 if self.models[p.id] or self.requests[p.id] or self.flight.room.Name~="Arena" then return end
 local token={};self.requests[p.id]=token
 task.spawn(function()
  local ok,model=pcall(function()
   if p.player then return Players:CreateHumanoidModelFromUserIdAsync(p.player.UserId) end
   return Players:CreateHumanoidModelFromDescriptionAsync(Service.outfit(p.name),Enum.HumanoidRigType.R15)
  end)
  if self.requests[p.id]~=token or self.flight.byId[p.id]~=p then if ok then model:Destroy() end;return end
  if not ok then
   self.requests[p.id]=nil
   if p.player then
    p.player:SetAttribute("AvatarStatus","Appearance unavailable. Your equipped avatar will retry next round.")
    local label=Instance.new("BillboardGui");label.Name="AppearanceUnavailable";label.Size=UDim2.fromOffset(250,44);label.StudsOffset=Vector3.new(0,65,0);label.Adornee=self.flight.desks[p.seat];label.Parent=self.flight.room
    local text=Instance.new("TextLabel");text.Size=UDim2.fromScale(1,1);text.BackgroundTransparency=.25;text.Text=p.name.."\nAppearance unavailable";text.TextColor3=Color3.fromRGB(245,235,215);text.TextSize=14;text.Parent=label;self.models[p.id]=label
   end
   return
  end
  self.requests[p.id]=nil
  model.Name=p.name.." at desk";model:SetAttribute("SeatedAvatar",true)
  for _,item in ipairs(model:GetDescendants()) do
   if item:IsA("LuaSourceContainer") then item:Destroy()
   elseif item:IsA("BasePart") then item.CanCollide=false;item.CanQuery=false;item.CanTouch=false;item.Massless=true end
   if item:IsA("AnimationConstraint") then item.IsKinematic=true end
  end
  local humanoid=model:FindFirstChildOfClass("Humanoid");local root=model:FindFirstChild("HumanoidRootPart")
  if not humanoid or not root then model:Destroy();return end
  humanoid.DisplayDistanceType=Enum.HumanoidDisplayDistanceType.None;humanoid.AutoRotate=false;humanoid.EvaluateStateMachine=false
  local top,bottom=-math.huge,math.huge
  for _,part in ipairs(model:GetChildren()) do
   if part:IsA("BasePart") and part~=root then top=math.max(top,part.Position.Y+part.Size.Y/2);bottom=math.min(bottom,part.Position.Y-part.Size.Y/2) end
  end
  model:ScaleTo(model:GetScale()*Config.standing_height_studs/math.max(1,top-bottom))
  root.Anchored=true
  local offset=p.home.LookVector*-115+Vector3.new(0,8,0)
  model:PivotTo(CFrame.new(p.home.Position+offset)*p.home.Rotation)
  model.Parent=self.flight.room;self.models[p.id]=model
  -- Roblox's own sitting animation supports supplied R6/R15 joints, including AnimationConstraint.
  local seated=pcall(function()
   local animation=Instance.new("Animation");animation.Name="SeatedPose"
   animation.AnimationId=humanoid.RigType==Enum.HumanoidRigType.R15 and "rbxassetid://2506281703" or "rbxassetid://178130996"
   animation.Parent=model
   local animator=humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator",humanoid)
   local track=animator:LoadAnimation(animation);track.Priority=Enum.AnimationPriority.Action;track:Play(0,1,1)
   humanoid.Sit=true
   local deadline=os.clock()+5
   repeat Run.Heartbeat:Wait() until track.Length&gt;0 or os.clock()&gt;=deadline or not model.Parent
   assert(model.Parent and track.Length&gt;0,"Seated animation unavailable")
   track.TimePosition=math.min(.2,track.Length*.5);track:AdjustSpeed(0)
   Run.Heartbeat:Wait();Run.Heartbeat:Wait()
   local chair=self.flight.room:FindFirstChild("Chair"..self.flight.desks[p.seat].Name:sub(5))
   local torso=model:FindFirstChild("LowerTorso") or model:FindFirstChild("Torso")
   if chair and torso then
    -- Hips on the seat, a little toward the backrest, so knees stay clear of the desk (Alan, 2026-10-11).
    local back=(chair.Position-self.flight.desks[p.seat].Position)*Vector3.new(1,0,1)
    local hips=chair.Position+back.Unit*10+Vector3.new(0,chair.Size.Y/2+1,0)
    model:PivotTo(model:GetPivot()+hips-Vector3.new(torso.Position.X,torso.Position.Y-torso.Size.Y/2,torso.Position.Z))
   end
  end)
  model:SetAttribute("SeatedPoseLoaded",seated)
  if not seated and p.player then p.player:SetAttribute("AvatarStatus","Your avatar loaded, but its seated pose is unavailable.") end
  if not model.Parent then return end
  local proxies=Instance.new("Folder");proxies.Name="Collision";proxies.Parent=model
  for _,part in ipairs(model:GetChildren()) do
   if part:IsA("BasePart") and part~=root then
    local proxy=Instance.new("Part");proxy.Name="AvatarSurface";proxy.Size=part.Size;proxy.CFrame=part.CFrame;proxy.Transparency=1
    proxy.Anchored=true;proxy.CanTouch=false;proxy.CanQuery=true;proxy.CanCollide=true;proxy.Parent=proxies
   end
  end
 end)
end
return Service
</string>
        </Properties>
      </Item>
      <Item class="Script" referent="ROJO_229">
        <Properties>
          <string name="Name">Bootstrap</string>
          <token name="RunContext">0</token>
          <string name="Source">-- Synced from src/server by default.project.json.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
Players.CharacterAutoLoads = false
-- Keep unused saved art out of the replicated game.
local archive = ServerStorage:FindFirstChild("DormantArt") or Instance.new("Folder")
archive.Name = "DormantArt"
archive.Parent = ServerStorage
local root = ReplicatedStorage:WaitForChild("FlyFightPaper")
for _, child in ipairs(root:GetChildren()) do
 if child.Name ~= "Shared" and child.Name ~= "Generated" and child.Name ~= "Assets" then child.Parent = archive end
end
for _, child in ipairs(workspace:GetChildren()) do
 if child.Name ~= (workspace:FindFirstChild("Arena") and "Arena" or "GreyboxRoom") and child.Name ~= "CityRug" and child.Name ~= "Camera" and child.Name ~= "Terrain" then
  if child:IsA("Model") or child:IsA("Folder") or child:IsA("BasePart") then child:Destroy() end
 end
end
workspace.Gravity = 196.2
workspace:SetAttribute("Milestone", "M4")
local flight = require(script.Parent.FlightService).new()
flight.active=false
local combat = require(script.Parent.CombatService).new(flight)
local bots=require(script.Parent.BotService).new(flight, combat)
local profiles=require(script.Parent.ProfileRuntime).new(flight.catalog)
local desks=require(script.Parent.DeskService).new(flight,profiles)
local rounds=require(script.Parent.RoundRuntime).new(flight,combat,bots,profiles)
local props=require(script.Parent.PropsService).new(flight.room)
rounds.onBegin=function()props:reset()end
combat.onProp=function(p,part)
 if rounds.engine.phase=="ACTIVE" and props:breakPart(part) then
  rounds.engine:propContribution("prop:"..part.Name,p.id);rounds:earnings()
  combat:emit({kind="prop",position=part.Position})
 end
end
local avatars=require(script.Parent.AvatarService).new(flight)
-- Life changes are synchronous. A deferred signal must not reuse a newer plane's identity.
flight.onSpawn=function(p) combat:attach(p);if p.kind=="bot" then bots:reset(p) end;rounds:bind(p);avatars:assign(p) end
flight.onDeath=function(p,cause) combat:death(p,cause) end
flight.onRefold=function(p) combat:refit(p) end
flight.onLand=function(p) desks:perform(p,"refill") end
local removed=flight.onRemoved
flight.onRemoved=function(p) combat:detach(p);avatars:remove(p);if removed then removed(p) end end
-- Studio perf readout: server frame times over the last second, shown by the client dev overlay.
if game:GetService("RunService"):IsStudio() then
 local times,clock={},0
 game:GetService("RunService").Heartbeat:Connect(function(dt)
  table.insert(times,dt);clock+=dt
  if clock&lt;1 then return end
  table.sort(times);local total=0;for _,t in ipairs(times) do total+=t end
  root:SetAttribute("ServerFrameMs",total/#times*1000);root:SetAttribute("ServerFrameP95Ms",times[math.ceil(#times*.95)]*1000)
  times,clock={},0
 end)
end
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ROJO_230">
        <Properties>
          <string name="Name">BotService</string>
          <string name="Source">local RS=game:GetService("ReplicatedStorage")
local Run=game:GetService("RunService")
local Players=game:GetService("Players")
local Root=RS.FlyFightPaper
local FlightRules=require(Root.Shared.FlightRules)
local CombatRules=require(Root.Shared.CombatRules)
local Builds=require(Root.Shared.BotBuilds)
local Roster=require(Root.Shared.BotRosterRules)
local Config=require(Root.Generated.Gameplay)
local Routes=require(script.Parent.AirRoutes)
local Landing=require(Root.Shared.ServiceRules)
local Service={};Service.__index=Service
local MIXED_SKILLS={"rookie","regular","experienced"}
local function aimError(direction,b,now)
 local drift=math.sin(now*.8+b.seed)*b.error
 return (CFrame.lookAt(Vector3.zero,direction)*CFrame.fromOrientation(drift*math.sin(now*.29+b.seed)*.4,drift,0)).LookVector
end
-- Maneuvers are flown, not aimed at: each segment holds a turn for `t` seconds. `roll` says which way the lift
-- pulls around the nose (0 right, 90 up, -90 down, 180 left), `pull` how hard (1 = full turn rate), `spin` rolls
-- the pull around the nose while turning (a barrel roll). Mirrored for left-hand versions.
local MOVES={
 break_turn={{t=2.2,roll=10,pull=1.1}},
 snake={{t=.9,roll=0,pull=1},{t=.9,roll=180,pull=1},{t=.9,roll=0,pull=1}},
 barrel_roll={{t=2.4,roll=0,pull=.75,spin=160}},
 split_s={{t=.8,roll=-75,pull=1.1},{t=1.4,roll=-10,pull=1.1},{t=.8,roll=90,pull=.8}},
 wingover={{t=1,roll=75,pull=1},{t=1.4,roll=15,pull=1.1}},
 flat_reverse={{t=2.4,roll=5,pull=1.1}},
 extend={{t=2,roll=-12,pull=.12}},
 orbit={{t=5,roll=8,pull=.4}},
}
function Service:pickMove(b,weights,position)
 local names={};for name in pairs(weights) do table.insert(names,name) end;table.sort(names)
 local top=self.flight.boundsSize.Y
 local total,pool=0,{}
 for _,name in ipairs(names) do
  local w=weights[name]
  -- Dive moves need room under the plane, climbing ones room above.
  if name=="split_s" and position.Y&lt;230 or name=="wingover" and position.Y&gt;top-180 then w=0 end
  if name=="split_s" and b.quirks.split_s then w*=4 end
  if w&gt;0 then total+=w;table.insert(pool,{name,total}) end
 end
 local roll=b.random:NextNumber()*total
 for _,entry in ipairs(pool) do if roll&lt;entry[2] then return entry[1] end end
 return "break_turn"
end
function Service:startMove(b,now,mode,names,side)
 local segments,length={},0
 for _,name in ipairs(names) do for _,segment in ipairs(MOVES[name]) do table.insert(segments,segment);length+=segment.t end end
 -- Variety: no two moves are flown quite alike.
 b.move={mode=mode,start=now,side=side,segments=segments,scale=b.random:NextNumber(.8,1.25),tilt=b.random:NextNumber(-20,20)}
 return now+length*b.move.scale
end
function Service:moveDirection(p,b,now,turn)
 local move=b.move
 local t=(now-move.start)/move.scale
 for _,s in ipairs(move.segments) do
  if t&lt;s.t then
   local roll=math.rad(s.roll+move.tilt+(s.spin or 0)*t)
   if move.side&lt;0 then roll=math.pi-roll end
   local look=b.heading
   local right=look:Cross(Vector3.yAxis);right=right.Magnitude&gt;.01 and right.Unit or p.body.CFrame.RightVector
   local up=right:Cross(look)
   -- The autopilot turns at settle*angle for small angles, so this offset asks for exactly `pull` of full rate.
   local angle=math.min(math.rad(60),s.pull*b.profile.pull*math.rad(turn)/Config.flight.autopilot_settle_per_s*1.15)
   return look*math.cos(angle)+(right*math.cos(roll)+up*math.sin(roll))*math.sin(angle)
  end
  t-=s.t
 end
 b.move=nil
 return nil
end
function Service:weaponFor(p)
 local mounts=self.combat.info[p.id].mounts
 for _,mount in ipairs(mounts) do if mount.group==1 then return mount.weapon end end
 return mounts[1] and mounts[1].weapon or self.flight.catalog:get("pellet")
end
function Service.new(flight,combat)
 local self=setmetatable({flight=flight,combat=combat,routes=Routes.new(flight),brains={},serial=0,mixed={}},Service)
 Players.PlayerAdded:Connect(function() self:fill() end);Players.PlayerRemoving:Connect(function() task.defer(function() self:fill() end) end)
 self:fill()
 Run.PreSimulation:Connect(function(dt)local start=os.clock();self:step(dt);self.lastWorkMs=(os.clock()-start)*1000 end)
 Service.active=self;return self
end
function Service:fill()
 if self.flight.active==false or self.flight.eraserDuel then return end
 local count=0;for _ in pairs(self.flight.pilots) do count+=1 end
 -- Studio "mixed bots" test mode skips the roster rules: every build, skill, personality and quirk in turn.
 if self.flight.mixedBots then
  while count&lt;12 do
   local k=self.mixedCount;self.mixedCount+=1
   local tier=MIXED_SKILLS[k%3+1];local loadout,build=Builds.pick(tier,k//3+1)
   self.mixed["bot-mix:"..k]=k
   if not self.flight:add(nil,{id="bot-mix:"..k,name="Mix "..(k+1),tier=tier,loadout=loadout,loadoutName=build}) then break end
   count+=1
  end
  return
 end
 while count&gt;12 do
  local victim;for _,p in pairs(self.flight.pilots) do if p.kind=="bot" then victim=p;break end end
  if not victim then break end
  self.flight:remove(victim,"vacancy");self.brains[victim.id]=nil;count-=1
 end
 local actors=self.flight:rosterActors()
 local eligibility=self.eligibility or "rookie"
 local plan=assert(Roster.plan({eligibility=eligibility,serverClass=eligibility,seed=Config.world.seed,mode=self.mode or "FFA",config=Config,actors=actors,pendingHumanQueue={},botIdentitySerial=self.serial+1}))
 for _,row in ipairs(plan.botAdds) do
  self.serial=row.identitySerial;local loadout,build=Builds.pick(row.profileName,self.serial)
  local p=self.flight:add(nil,{id=row.actorKey,name=row.displayName,tier=row.profileName,loadout=loadout,loadoutName=build})
  if not p then break end
  if p.tier=="experienced" and p.team then
   local experienced=0;for _,other in pairs(self.flight.pilots) do if other.team==p.team and other.tier=="experienced" then experienced+=1 end end
   if experienced&gt;1 then p.tier="regular";self:reset(p) end
  end
  count+=1
 end
end
function Service:reset(p)
 local random=Random.new(1709+p.seat*37+self.serial*101)
 local k=self.mixed[p.id]
 local tier=p.tier
 local profile=Config.bots.profiles[tier]
 self.brains[p.id]={mode="launch",nextDecision=0,launchAt=workspace:GetServerTimeNow()+1+p.seat*.22,
  reaction=random:NextNumber(profile.reaction_seconds[1],profile.reaction_seconds[2]),error=math.rad(random:NextNumber(profile.aim_error_deg[1],profile.aim_error_deg[2])),
  seed=p.seat*2.37,random=random,route={},routeAt=0,avoidAt=0,lastCheck=workspace:GetServerTimeNow(),lastPosition=p.body.Position,
  goal=Vector3.new(p.home.Position.X*.5,210,p.home.Position.Z*.4),heading=p.body.CFrame.LookVector,bank=0,profile=profile}
 local b=self.brains[p.id]
 b.lag=random:NextNumber(profile.hand_delay_seconds[1],profile.hand_delay_seconds[2]);b.tier=tier
 -- Personality is independent of skill. Quirks make bots feel like people: veterans get more and bolder ones,
 -- some rookies get one too.
 local names={"aggressive","cautious","opportunist","objective"}
 b.personality=names[random:NextInteger(1,#names)];b.style=Config.bots.personalities[b.personality]
 b.quirks={}
 local pool=table.clone(Config.bots.quirks)
 for _,chance in ipairs({Config.bots.quirk_chance[tier],Config.bots.second_quirk_chance[tier]}) do
  if random:NextNumber()&lt;chance then b.quirks[table.remove(pool,random:NextInteger(1,#pool))]=true end
 end
 if k then
  b.personality=names[k%4+1];b.style=Config.bots.personalities[b.personality]
  local quirk=Config.bots.quirks[(k//3)%4+1];b.quirks=quirk and {[quirk]=true} or {}
 end
 if Run:IsStudio() then
  local list={};for quirk in pairs(b.quirks) do table.insert(list,quirk) end;table.sort(list)
  p.model:SetAttribute("BotStyle",tier.." "..b.personality..(#list&gt;0 and ", "..table.concat(list,"+") or ""))
 end
end
-- Bots notice planes like people do: in front of them (a 120 degree view) or close enough to hear, never
-- through walls. Veterans keep track of a target only while it is in view: hearing a plane close by says it is
-- there, not where (Alan: up close a player loses sight of a plane that whips past; veterans followed it all the way
-- round). Rookies and regulars keep the old all-round sense up close (Alan liked their aim as it was).
function Service:sees(p,other,tracking)
 local delta=other.body.Position-p.body.Position
 local distance=delta.Magnitude
 if distance&gt;900 and not self.flight.eraserDuel then return false end
 if (tracking or distance&gt;150) and p.body.CFrame.LookVector:Dot(delta.Unit)&lt;.5 then return false end
 return self.combat:visible(p.body.Position,other.body.Position)
end
-- Spread out: each bot already chasing a plane makes it a worse pick, so bots don't all swarm one pilot.
function Service:chooseTarget(p,b,now)
 local chasers={}
 for id,other in pairs(self.brains) do if id~=p.id and other.target then chasers[other.target]=(chasers[other.target] or 0)+1 end end
 local best,target=math.huge,nil
 for _,other in pairs(self.flight.pilots) do
  if self.combat:enemy(p,other) and self.combat:targetable(other,now) and other.model:GetAttribute("State")=="FLYING" and self:sees(p,other) then
   local delta=other.body.Position-p.body.Position
   local score=delta.Magnitude+(chasers[other] or 0)*300*b.style.crowd_penalty_factor+(1-p.body.CFrame.LookVector:Dot(delta.Unit))*150
    -b.style.wounded_bonus*(1-other.model:GetAttribute("Health")/other.stats.health)
   if score&lt;best then best,target=score,other end
  end
 end
 b.target=target;b.pursueUntil=now+b.random:NextNumber(b.profile.pursuit_seconds[1],b.profile.pursuit_seconds[2])*b.style.pursuit_factor
end
-- An enemy within 30 degrees of our tail and pointing at us is the threat a pilot breaks away from.
function Service:threat(p,now)
 for _,other in pairs(self.flight.pilots) do
  if self.combat:enemy(p,other) and self.combat:targetable(other,now) and other.model:GetAttribute("State")=="FLYING" then
   local delta=other.body.Position-p.body.Position
   if delta.Magnitude&lt;400 and p.body.CFrame.LookVector:Dot(-delta.Unit)&gt;math.cos(math.rad(30))
    and other.body.CFrame.LookVector:Dot(-delta.Unit)&gt;math.cos(math.rad(30)) and self.combat:visible(p.body.Position,other.body.Position) then return other end
  end
 end
 return nil
end
-- Priority state machine, run at the bot's reaction rate. Steering (every frame) adds the avoid override.
function Service:decide(p,b,now)
 local position=p.body.Position
 local forward=p.body.CFrame.LookVector
 local lift=p.model:GetAttribute("Lift")
 local nearestFan,fanDistance=nil,math.huge
 for _,fan in ipairs(self.flight.updrafts) do local d=(fan.Position-position).Magnitude;if d&lt;fanDistance then nearestFan,fanDistance=fan,d end end
 local reserveNeeded=math.max(p.stats.lift*b.profile.seek_lift_at_fraction,math.min(p.stats.lift*.7,fanDistance/p.stats.speed*1.4+15))
 if now-b.lastCheck&gt;2 then
  -- Truly stuck is slow too: a sharp plane can circle back to the same spot in 2 s at full speed.
  if (position-b.lastPosition).Magnitude&lt;25 and p.body.AssemblyLinearVelocity.Magnitude&lt;40 then b.recoverUntil=now+2;b.recoverGoal=position-forward*140+Vector3.new(0,65,0) end
  b.lastPosition=position;b.lastCheck=now
 end
 -- Break away when hit or when someone sits on our tail, but not on every pellet: a bot that dodges each hit
 -- can never be caught. The break is a flown maneuver (hard turn, snake, barrel roll, split-S, wingover).
 local threat=now&gt;=(b.nextEvade or 0) and self:threat(p,now)
 local wasHit=(p.lastHitAt or 0)&gt;(b.lastEvadedHit or 0)
 if now&gt;=(b.nextEvade or 0) and (wasHit or threat) then
  b.lastEvadedHit=p.lastHitAt
  -- Good pilots turn into the attacker, which forces it to overshoot; rookies pick a side at random.
  local attacker=threat or wasHit and p.lastHitBy
  local side=b.random:NextNumber()&lt;.5 and -1 or 1
  if attacker and attacker.body and b.random:NextNumber()&lt;b.profile.read_attacker then
   side=forward:Cross(Vector3.yAxis):Dot(attacker.body.Position-position)&gt;=0 and 1 or -1
  end
  b.evadeUntil=self:startMove(b,now,"evade",{self:pickMove(b,b.profile.evade_moves,position)},side)
  -- The rest starts once the move is flown, so long moves don't chain into one endless dodge.
  b.nextEvade=b.evadeUntil+b.profile.evade_cooldown_seconds*b.style.evade_cooldown_factor
 end
 local kills=self.flight.records[p.id] and self.flight.records[p.id].kills or 0
 if kills&gt;(b.kills or kills) and b.quirks.waggle then b.celebrateUntil=now+2;b.celebrateForward=forward end
 b.kills=kills
 if b.target and not (self.combat:targetable(b.target,now) and b.target.model:GetAttribute("State")=="FLYING") then b.target=nil end
 local seen=b.target and self:sees(p,b.target,b.profile.tracks_in_view)
 if seen then b.lastSeen=now;b.lastKnown=b.target.body.Position;b.lastVelocity=b.target.body.AssemblyLinearVelocity end
 if p.waitingPad and not (lift&lt;reserveNeeded) then
  b.mode="waiting";b.target=nil;b.goal=p.model:GetAttribute("HoldingPosition") or b.goal
  if not p.model:GetAttribute("DeskAvailable") and (b.goal-position).Magnitude&lt;75 then b.goal+=p.home.RightVector*(p.seat%2==0 and 140 or -140) end
 elseif b.recoverUntil and now&lt;b.recoverUntil then
  b.mode="unstuck";b.goal=b.recoverGoal
 elseif lift&lt;reserveNeeded or b.mode=="fan" and lift&lt;p.stats.lift*.45 then
  if p.waitingPad then self.flight:clearLandingQueue(p) end
  b.mode="fan";b.target=nil
  if nearestFan then
   b.goal=nearestFan.Position
   if p.fanInside[nearestFan.Name] then b.goal=nearestFan.Position+Vector3.new(nearestFan.Size.X/2+80,0,0) end
  end
 elseif p.model:GetAttribute("Health")&lt;p.stats.health*b.style.repair_at_fraction then
  -- Land like a pilot: line up out in the room first, then fly straight down the runway through the ring.
  local ring=Landing.approach(p.home,Config.service);local rel=ring:PointToObjectSpace(position)
  local lined=rel.Z&lt; -80 and math.abs(rel.X)&lt;30 and math.abs(rel.Y)&lt;40
  b.mode="repair";b.goal=lined and (ring*CFrame.new(0,-5,60)).Position or (ring*CFrame.new(0,10,-260)).Position;b.target=nil
 elseif b.evadeUntil and now&lt;b.evadeUntil then
  b.mode="evade";b.goal=position+forward*200
 elseif b.celebrateUntil and now&lt;b.celebrateUntil then
  b.mode="celebrate";b.goal=position+forward*200
 elseif b.extendUntil and now&lt;b.extendUntil then
  b.mode="extend";b.goal=position+forward*200+Vector3.new(0,25,0)
 elseif self.mode=="CONTROL" and b.personality=="objective" then
  local center=Config.rounds.control_center
  b.mode="objective";b.goal=Vector3.new(center[1]+math.cos(now*.2+b.seed)*30,center[2],center[3]+math.sin(now*.2+b.seed)*30)
 else
  -- Keep chasing a hurt target a little longer; otherwise re-pick when the pursuit time runs out.
  if seen and now&gt;(b.pursueUntil or 0) and b.target.model:GetAttribute("Health")&lt;b.target.stats.health*.65 then b.pursueUntil=now+4 end
  if not seen or now&gt;(b.pursueUntil or 0) then
   local previous=b.target;self:chooseTarget(p,b,now)
   if not b.target and previous and now-(b.lastSeen or 0)&lt;5 then b.target=previous end
   seen=b.target and self:sees(p,b.target,b.profile.tracks_in_view)
   if seen then b.lastSeen=now;b.lastKnown=b.target.body.Position;b.lastVelocity=b.target.body.AssemblyLinearVelocity end
  end
  if seen then
   b.mode="chase";b.goal=b.target.body.Position
   -- Rammers fly straight into a weaker plane on purpose: the plane with less health loses a ram.
   local health=p.model:GetAttribute("Health")
   if b.quirks.rammer and (b.target.body.Position-position).Magnitude&lt;160
    and health&gt;=b.target.model:GetAttribute("Health")*Config.bots.ram_health_ratio[b.tier] then b.mode="ram" end
   -- Overshot: the target slipped behind us at close range. Extend away, then reverse back toward it
   -- (flat turn, wingover or split-S) instead of knife-fighting in a circle nobody wins.
   local delta=b.target.body.Position-position
   if delta.Magnitude&lt;150 and forward:Dot(delta.Unit)&lt;-.2 then
    local side=forward:Cross(Vector3.yAxis):Dot(delta)&gt;=0 and 1 or -1
    b.extendUntil=self:startMove(b,now,"extend",{"extend",self:pickMove(b,b.profile.reverse_moves,position)},side)
   end
  elseif b.target and b.lastKnown and now-(b.lastSeen or 0)&lt;5 then
   b.mode="search";b.goal=b.lastKnown+b.lastVelocity*math.min(2,now-b.lastSeen)
   if (position-b.goal).Magnitude&lt;90 then b.target=nil end
  else
   b.target=nil;b.mode="patrol"
   if not b.patrol or (position-b.patrol).Magnitude&lt;90 then
    -- Sometimes circle for a look around before heading to the next spot.
    if b.patrol and b.random:NextNumber()&lt;.35 then self:startMove(b,now,"patrol",{"orbit"},b.random:NextNumber()&lt;.5 and -1 or 1) end
    b.patrol=self.routes.nodes[b.random:NextInteger(1,#self.routes.nodes)]
   end
   b.goal=b.patrol
   -- Studio eraser practice: the hunter always knows where you are.
   if self.flight.eraserDuel then for _,other in pairs(self.flight.pilots) do if other.kind=="human" and self.combat:targetable(other,now) then b.goal=other.body.Position end end end
  end
 end
 -- Studio spectator camera (F10) shows each bot's intent.
 if Run:IsStudio() then p.model:SetAttribute("BotIntent",b.mode..(b.target and " -&gt; "..b.target.name or "")) end
 if now-b.routeAt&gt;1 then
  b.routeAt=now
  b.direct=self.routes:clear(position,b.goal,18)
  if b.direct then b.route={b.goal} else b.route=self.routes:path(position,b.goal,p.body.CFrame.LookVector) end
 end
end
function Service:steer(p,b,dt,now)
 local position=p.body.Position
 -- Following a waypoint is control work, not a reaction-time decision. Fast planes can pass
 -- through a small waypoint between brain ticks and otherwise circle it until Lift runs out.
 -- Bots fly a little slower and turn a little wider than players of the same build, so a chasing player can catch up.
 local turn=p.stats.turn*b.profile.turn_factor
 local arrival=math.clamp(p.stats.speed/math.rad(turn)*1.25,45,100)
 while #b.route&gt;1 and (position-b.route[1]).Magnitude&lt;arrival and self.routes:clear(position,b.route[2],18) do table.remove(b.route,1) end
 local goal=b.route[1] or b.goal
 local lead=self:lead(p,b,now)
 if b.mode=="chase" and b.direct and lead then
  -- Veterans steer by what they last saw, carried forward, like a pilot does; not by where the target really is.
  local view=b.profile.tracks_in_view and b.view or {position=b.target.body.Position,velocity=b.target.body.AssemblyLinearVelocity,at=now}
  local spot,drift=view.position+view.velocity*(now-view.at),view.velocity
  local delta=spot-position
  goal=(lead-position).Magnitude&lt;450 and lead or spot
  -- Some slack between entering and leaving so the nose doesn't flick between the two aim points.
  b.lagging=delta.Magnitude&lt;350 and b.heading:Dot(delta.Unit)&lt;(b.lagging and .94 or .82)
  if b.lagging then
   -- Target well off the nose. Good pilots aim at its tail (lag pursuit) and turn with it, which is what
   -- makes two planes circle; rookies point straight at it and overshoot.
   goal=b.profile.lag_pursuit and spot-drift*.4 or spot
   -- High yo-yo: closing too fast to make the turn, climb out of the circle and drop back onto the tail.
   if b.profile.yo_yo and (p.body.AssemblyLinearVelocity-drift):Dot(delta.Unit)&gt;40 then goal+=Vector3.yAxis*delta.Magnitude*.6 end
  end
 end
 if b.mode=="ram" and b.target and (lead or not b.profile.tracks_in_view) then
  local view=b.profile.tracks_in_view and b.view or {position=b.target.body.Position,velocity=b.target.body.AssemblyLinearVelocity,at=now}
  goal=view.position+view.velocity*(now-view.at+.3)
 end
 if b.mode=="celebrate" and b.celebrateForward then
  goal=position+(CFrame.lookAt(Vector3.zero,b.celebrateForward)*CFrame.fromOrientation(.25,math.sin((b.celebrateUntil-now)*math.pi*3)*.7,0)).LookVector*100
 end
 if b.move and b.move.mode~=b.mode then b.move=nil end
 local flown=b.move and self:moveDirection(p,b,now,turn)
 if flown then goal=position+flown*300
 elseif b.mode=="patrol" or b.mode=="search" then
  -- People don't fly ruler lines: drift side to side and up and down while cruising.
  goal+=(p.body.CFrame.RightVector*math.sin(now*.6+b.seed)*.45+Vector3.yAxis*math.sin(now*.37+b.seed*1.7)*.15)*(goal-position).Magnitude
 end
 local delta=goal-position
 local direction=delta.Magnitude&gt;.1 and delta.Unit or p.body.CFrame.LookVector
 local localPos=self.flight.boundsCF:PointToObjectSpace(position)
 local half=self.flight.boundsSize*.5
 if math.abs(localPos.X)&gt;half.X-155 or math.abs(localPos.Z)&gt;half.Z-155 then
  local inside=Vector3.new(-localPos.X,0,-localPos.Z)
  if inside.Magnitude&gt;.1 then direction=(direction+inside.Unit*2).Unit end
 end
 if position.Y&lt;75 then direction=(direction+Vector3.yAxis*1.8).Unit end
 if position.Y&gt;half.Y*2-80 then direction=(direction-Vector3.yAxis*1.8).Unit end
 -- Planes are hard to see coming head-on at 200+ studs/s closing, so look 1.5 s ahead: if another plane's
 -- closest approach would touch, swerve away from that point now, harder the sooner it comes.
 local velocity=p.body.AssemblyLinearVelocity
 for _,other in pairs(self.flight.pilots) do
  if other~=p and other.model:GetAttribute("State")=="FLYING" and not (b.mode=="ram" and other==b.target) then
   local offset=other.body.Position-position
   local closing=other.body.AssemblyLinearVelocity-velocity
   local t=closing:Dot(closing)&gt;1 and math.clamp(-offset:Dot(closing)/closing:Dot(closing),0,1.5) or 0
   local miss=offset+closing*t
   local safe=(p.body.Size.Magnitude+other.body.Size.Magnitude)*.5+20
   if miss.Magnitude&lt;safe and offset.Magnitude&lt;400 then
    local away=miss.Magnitude&gt;1 and -miss.Unit or p.body.CFrame.RightVector*(p.seat%2==0 and 1 or -1)
    direction=(direction+away*(1+3*(1-t/1.5))).Unit
   end
  end
 end
 direction=FlightRules.limitPitch(direction)
 if now&gt;=b.avoidAt then
  b.avoidAt=now+.1
  local forward=p.body.CFrame.LookVector
  local reach=math.max(150,p.stats.speed*2.1)
  local speed=math.max(p.stats.speed,p.body.AssemblyLinearVelocity.Magnitude)
  local radius=math.max(12,p.body.Size.Magnitude*.5)+3
  local function clearance(candidate)
   local at=position;local heading=forward;local distance=0
   local step=reach/speed/4
   for _=1,4 do
    heading=CombatRules.turnDirection(heading,candidate,math.rad(turn)*step)
    local travel=heading*speed*step
    local obstruction=workspace:Spherecast(at,radius,travel,self.flight.cast)
    if obstruction then return distance+obstruction.Distance end
    at+=travel;distance+=travel.Magnitude
   end
   return distance
  end
  local hit=clearance(direction)&lt;reach-.1 or clearance(forward)&lt;reach-.1
  b.avoid=nil
  if hit then
   -- Choose open air beside the obstacle. Turning into its normal can demand an impossible U-turn.
   local frame=CFrame.lookAt(Vector3.zero,forward)
   local best=-math.huge
   for _,yaw in ipairs({-85,-55,-30,0,30,55,85}) do
    for _,pitch in ipairs({-30,0,30}) do
     local candidate=FlightRules.limitPitch((frame*CFrame.fromOrientation(math.rad(pitch),math.rad(yaw),0)).LookVector)
     local room=clearance(candidate)
     local score=room/reach*4+candidate:Dot(direction)*.7+candidate:Dot(forward)*.25
     if score&gt;best then best=score;b.avoid=candidate end
    end
   end
  end
 end
 if b.avoid then direction=b.avoid end
 -- Same autopilot as human pilots: the bot only chooses where to aim.
 local desired
 desired,b.bank,p.orientation.CFrame=FlightRules.autopilot(b.heading,b.bank,direction,p.stats.yaw*b.profile.turn_factor,p.stats.pitch*b.profile.turn_factor,dt)
 local bleed=FlightRules.turnSpeedFactor(b.heading,desired,dt,turn)
 b.heading=desired
 p.boostHeld=(b.mode=="evade" or b.mode=="extend") and b.profile.evade_boost
 local velocity=FlightRules.velocity(desired,p.stats.speed*bleed*b.profile.speed_factor*(p.model:GetAttribute("BoostSpeedFactor") or 1),p.model:GetAttribute("Lift"),p.model:GetAttribute("Updraft") or 0)
 if now&lt;(p.model:GetAttribute("DeflectUntil") or 0) then local normal=p.model:GetAttribute("CollisionNormal") or Vector3.zero;velocity-=normal*math.min(0,velocity:Dot(normal));velocity+=normal*Config.flight.graze_slide_push_studs_s end
 p.drive.VectorVelocity=p.drive.VectorVelocity:Lerp(velocity,1-math.exp(-Config.flight.velocity_response*dt))
 if lead and (lead-position).Magnitude&gt;.1 then self.combat.info[p.id].aim=aimError((lead-position).Unit,b,now) end
 -- Triggers are hand work too: checked every frame against the live lead, not held between decisions.
 local aim=self.combat.info[p.id].aim or p.body.CFrame.LookVector
 local aligned=lead~=nil and p.body.CFrame.LookVector:Dot((lead-position).Unit)&gt;math.cos(math.rad(12)) and (b.target.body.Position-position).Magnitude&lt;450
 for group=1,2 do
  local semi,eraser=false,false
  for _,mount in ipairs(self.combat.info[p.id].mounts) do if mount.group==group then
   eraser=eraser or mount.weapon.homing
   semi=semi or (mount.weapon.fire_mode=="semiautomatic" and not mount.weapon.homing)
  end end
  if semi then self.combat:trigger(p,group,false,aim) end
  -- Erasers keep holding through the lock on either button; guns and pencils need alignment.
  self.combat:trigger(p,group,aligned or eraser and (p.model:GetAttribute("LockProgress") or 0)&gt;0,aim)
 end
end
-- Aim tracks the target every frame like a human's hand, but from what the bot saw `lag` seconds ago (a short
-- hand-eye delay, not the slower decision reaction), then solves where the shot and the target meet. The bot only
-- learns something new while the target is in front of it (its 120 degree view).
function Service:lead(p,b,now)
 local target=b.target
 if not target or now-(b.lastSeen or 0)&gt;=1.1 or target.model:GetAttribute("State")~="FLYING" then b.samples=nil;return nil end
 if not b.samples or b.samples.target~=target then b.samples={target=target} end
 local samples=b.samples
 if not b.profile.tracks_in_view or p.body.CFrame.LookVector:Dot((target.body.Position-p.body.Position).Unit)&gt;.5 then
  table.insert(samples,{at=now,position=target.body.Position,velocity=target.body.AssemblyLinearVelocity})
 end
 if #samples==0 then return nil end
 -- Keep a quarter second more than the hand-eye delay, so the bot also sees how the target is turning.
 while #samples&gt;1 and samples[2].at&lt;=now-b.lag-.25 do table.remove(samples,1) end
 local seen,old=samples[1],samples[1]
 for _,sample in ipairs(samples) do if sample.at&lt;=now-b.lag then seen=sample else break end end
 b.view=seen
 local turning=seen.at-old.at&gt;.05 and (seen.velocity-old.velocity)/(seen.at-old.at) or Vector3.zero
 -- Skill sets lead accuracy: experts follow the whole turn, rookies lead short and shoot behind.
 local accuracy=b.profile.lead_accuracy
 local origin,weapon,age=p.body.Position,self:weaponFor(p),now-seen.at
 local predicted=seen.position
 for _=1,3 do
  local flight=CombatRules.travelTime(weapon,(predicted-origin).Magnitude)
  local t=age+math.min(2,flight==math.huge and weapon.lifetime or flight)
  predicted=seen.position+(seen.velocity*t+turning*(.5*t*t)+Vector3.yAxis*(.5*(weapon.drop or 0)*t*t))*accuracy
 end
 return predicted
end
function Service:step(dt)
 if self.enabled==false then return end
 if self.flight.mixedBots and self.mixedOn~=self.flight.mixedBots then self.mixedOn=self.flight.mixedBots;self.mixedCount=0;self:fill() end
 local now=workspace:GetServerTimeNow()
 for id,b in pairs(self.brains) do
  local p=self.flight.byId[id]
  if not p then self.brains[id]=nil;continue end
  local state=p.model:GetAttribute("State")
  if state=="DESK" and now&gt;=b.launchAt then
   if not p.serviceBusy then
    if p.model:GetAttribute("Health")&lt;p.model:GetAttribute("MaxHealth") and self.flight.onService then self.flight.onService(p,"repair")
    else
     self.flight:launch(p)
     b.heading=p.body.CFrame.LookVector;b.bank=0;b.route={};b.routeAt=-math.huge;b.avoid=nil;b.target=nil;b.mode="patrol";b.nextDecision=0
    end
   end
  elseif state=="FLYING" then
   if now&gt;=b.nextDecision then b.nextDecision=now+b.reaction;self:decide(p,b,now) end
   self:steer(p,b,dt,now)
  end
 end
end
return Service
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ROJO_231">
        <Properties>
          <string name="Name">CombatService</string>
          <string name="Source">local RS=game:GetService("ReplicatedStorage")
local Run=game:GetService("RunService")
local Root=RS.FlyFightPaper
local Rules=require(Root.Shared.CombatRules)
local FlightRules=require(Root.Shared.FlightRules)
local Config=require(Root.Generated.Gameplay).combat
local Aircraft=require(Root.Shared.Aircraft)
local HitShapes=require(script.Parent.HitShapes)
local Service={};Service.__index=Service
function Service.new(flight)
 local self=setmetatable({flight=flight,info={},shots={},serial=0,events={},clock=0,shotCount=0,totalFired=0,totalHits=0,random=Random.new()},Service)
 self.remote=Instance.new("RemoteEvent");self.remote.Name="CombatEvents";self.remote.Parent=Root
 -- Tracer news can be lost without harm, so it goes unreliable; hits, kills and deaths stay reliable.
 self.cosmetics=Instance.new("UnreliableRemoteEvent");self.cosmetics.Name="CombatCosmetics";self.cosmetics.Parent=Root;self.cosmeticEvents={}
 self.input=Instance.new("RemoteEvent");self.input.Name="CombatInput";self.input.Parent=Root
 -- Shots test the room (and anything else solid) here; planes are tested separately at rewound positions.
 self.worldCast=RaycastParams.new();self.worldCast.FilterType=Enum.RaycastFilterType.Exclude
 self.worldCast.FilterDescendantsInstances={flight.planes};self.worldCast.RespectCanCollide=false
 self.trackClock=0
 self.input.OnServerEvent:Connect(function(player,packet)
  local p=flight.pilots[player];if p then self:receive(p,packet,workspace:GetServerTimeNow()) end
 end)
 for _,p in pairs(flight.pilots) do self:attach(p) end
 Run.Heartbeat:Connect(function(dt)local start=os.clock();self:step(dt);self.lastWorkMs=(os.clock()-start)*1000 end)
 HitShapes.preload({Root.Assets.AircraftParts,Root.Assets.EquipmentParts,Root.Assets:FindFirstChild("AircraftPieces")}) -- last: ipairs stops at a missing folder
 Service.active=self;return self
end
function Service:attach(p)
 local previous=self.info[p.id]
 local now=workspace:GetServerTimeNow()
 local info={mounts={},held={false,false},roundRobin={0,0},history={},track={},activeErasers=previous and previous.activeErasers or 0,seq=0,window=0,messages={0,0},aim=p.body.CFrame.LookVector,aims={},aimData={}}
 local groups=assert(Rules.triggerGroups(p.loadout))
 for index,weaponId in ipairs(p.loadout.weapon_mounts) do
  if weaponId then local weapon=self.flight.catalog.byId[weaponId];table.insert(info.mounts,{slot=index,weapon=weapon,group=groups[index],readyAt=0,burstLeft=0,heat=0,cooling=false,heatAt=now}) end
 end
 self.info[p.id]=info
 self:publishMounts(p)
 self:publishHeat(p,now)
end
function Service:coolMount(mount,firing,now)
 mount.heat,mount.cooling=Rules.heatStep(mount.heat or 0,mount.cooling==true,firing,now-(mount.heatAt or now),mount.weapon)
 mount.heatAt=now
end
function Service:publishHeat(p,now)
 local info=self.info[p.id];local heat,cooling,count={0,0},{false,false},{0,0};local slots={}
 for _,mount in ipairs(info.mounts) do slots[mount.slot]=mount end
 for slot in ipairs(p.loadout.weapon_mounts) do
  local mount=slots[slot];local weapon=mount and mount.weapon
  local amount=mount and mount.heat or 0
  local untilAt=weapon and weapon.shots_before_cooldown and mount.cooling and now+amount*weapon.cooldown_seconds/weapon.shots_before_cooldown or 0
  p.model:SetAttribute("MountHeat"..slot,amount)
  p.model:SetAttribute("MountCoolingUntil"..slot,untilAt)
  if weapon and weapon.shots_before_cooldown then
   local group=mount.group
   count[group]+=1;heat[group]=math.max(heat[group],amount/weapon.shots_before_cooldown);cooling[group]=cooling[group] or mount.cooling
  end
 end
 for group=1,2 do
  local name=group==1 and "Primary" or "Alternate"
  p.model:SetAttribute(name.."Heat",heat[group]);p.model:SetAttribute(name.."Cooling",cooling[group]);p.model:SetAttribute(name.."HasHeat",count[group]&gt;0)
 end
 p.model:SetAttribute("HeatUpdatedAt",now)
end
-- The shooter's client draws its own shots instantly; it needs each mount's weapon and the plane's scale.
function Service:publishMounts(p)
 local ids={}
 for slot,id in ipairs(p.loadout.weapon_mounts) do ids[slot]=id or "" end
 p.model:SetAttribute("Mounts",table.concat(ids,","))
 p.model:SetAttribute("MountScale",self.flight.catalog:get(p.loadout.body).visual_scale/2)
 p.model:SetAttribute("WingShift",self.flight.catalog:get(p.loadout.body).wing_shift or 0)
end
local cosmetic={shot=true,update=true,["end"]=true}
function Service:emit(event) table.insert(cosmetic[event.kind] and self.cosmeticEvents or self.events,event) end
function Service:detach(p)
 HitShapes.forget(p)
 for _,shot in pairs(self.shots) do if shot.owner==p.id then self:finish(shot) end end
 self.info[p.id]=nil
end
function Service:receive(p,packet,now)
 if type(packet)~="table" then return false end
 local info=self.info[p.id]
 if not info or packet.life~=p.life or not FlightRules.finite(packet.seq) or packet.seq%1~=0 or packet.seq&lt;=info.seq or packet.seq&gt;info.seq+2000 then return false end
 if packet.group~=1 and packet.group~=2 or type(packet.down)~="boolean" then return false end
 if now-info.window&gt;=1 then info.window=now;info.messages={0,0} end
 -- Releases never depend on a stale aiming transform. Origins always come from the server's mount.
 if packet.down then
  info.messages[packet.group]+=1;if info.messages[packet.group]&gt;60 then return false end
  if not FlightRules.finite(packet.at) or packet.at&gt;now+.1 or now-packet.at&gt;Config.input_delay_allowance_seconds then return false end
  if not FlightRules.vector(packet.direction) or math.abs(packet.direction.Magnitude-1)&gt;.01 then return false end
  local age=math.clamp(now-packet.at,0,Config.input_delay_allowance_seconds)
  local arc=math.rad(math.min(Config.input_max_aim_deg,Config.input_aim_slack_deg+(p.stats.turn)*(age+.1)))
  if p.body.CFrame.LookVector:Dot(packet.direction)&lt;math.cos(arc) then return false end
  info.aimData[packet.group]={arc=arc,at=now,latency=age};info.latency=age
 end
 info.seq=packet.seq;self:trigger(p,packet.group,packet.down,packet.down and packet.direction or nil)
 return true
end
function Service:refit(p)
 local info=self.info[p.id];if not info then return end
 local now=workspace:GetServerTimeNow()
 for _,mount in ipairs(info.mounts) do self:coolMount(mount,info.held[mount.group] and self:eligible(p) and not p.overlay,now) end
 local previous={};for _,m in ipairs(info.mounts) do previous[m.slot]=m end
 info.mounts={};info.held={false,false};info.aims={};info.aimData={};info.roundRobin={0,0};info.lockPilot=nil;self:publishMounts(p)
 local groups=assert(Rules.triggerGroups(p.loadout))
 for slot,id in ipairs(p.loadout.weapon_mounts) do
  if id then
   local weapon=self.flight.catalog:get(id);local old=previous[slot]
   local ready=old and old.weapon.id==id and old.readyAt or now+(weapon.burst_period or weapon.shot_interval)
   local same=old and old.weapon.id==id
   if old and old.cooling and not same then ready=math.max(ready,now+old.heat*old.weapon.cooldown_seconds/old.weapon.shots_before_cooldown) end
   table.insert(info.mounts,{slot=slot,weapon=weapon,group=groups[slot],readyAt=math.max(old and old.readyAt or 0,ready),burstLeft=0,
    heat=same and old.heat or 0,cooling=same and old.cooling or false,heatAt=now})
  end
 end
 self:publishHeat(p,now)
end
function Service:visible(from,to)
 local delta=to-from
 if delta.Magnitude&lt;.01 then return true end
 return workspace:Raycast(from,delta,self.flight.cast)==nil
end
function Service:eligible(p)
 return self.enabled~=false and p and p.model.Parent and p.model:GetAttribute("State")=="FLYING"
end
function Service:targetable(p,now)
 return self.enabled~=false and p and p.model.Parent and p.model:GetAttribute("State")~="DESTROYED" and not self.flight:protected(p,now or workspace:GetServerTimeNow())
end
function Service:enemy(a,b)
 return a~=b and (not a.team or not b.team or a.team~=b.team)
end
function Service:trigger(p,which,down,aim)
 local info=self.info[p.id];if not info then return end
 local now=workspace:GetServerTimeNow();local old=info.held[which]
 for _,mount in ipairs(info.mounts) do if mount.group==which then self:coolMount(mount,old and self:eligible(p) and not p.overlay,now) end end
 info.held[which]=down;info.aim=aim or p.body.CFrame.LookVector
 info.aims=info.aims or {};info.aims[which]=info.aim
 if not down or not self:eligible(p) or p.overlay then return end
 if not old then
  -- A short click may arrive and release between server frames. Fire its first round here.
  for _,mount in ipairs(info.mounts) do if mount.group==which and mount.readyAt&lt;=now then
   if mount.weapon.fire_mode=="automatic" then self:fire(p,mount,now)
   elseif mount.weapon.fire_mode=="burst" and mount.burstLeft==0 and self:fire(p,mount,now) then
    mount.readyAt=now+mount.weapon.burst_period;mount.burstLeft=mount.weapon.burst_count-1;mount.burstNext=now+mount.weapon.burst_spacing
   end
  end end
  local index=Rules.readyMount(info.mounts,which,now,info.roundRobin[which],"semiautomatic")
  if index and info.mounts[index].weapon.fire_mode=="semiautomatic" then
   if self:fire(p,info.mounts[index],workspace:GetServerTimeNow()) then info.roundRobin[which]=index end
  end
 end
end
function Service:lock(p,info,now)
 local hasEraser=false
 for _,m in ipairs(info.mounts) do if m.weapon.homing then hasEraser=true end end
 if not hasEraser or not self:eligible(p) then p.model:SetAttribute("LockProgress",0);return end
 -- Lock the enemy nearest the nose, then stay on it while it remains in a slightly wider cone. Without the
 -- stickiness the lock jumps between planes flying close together and the timer never finishes.
 local function cone(target,degrees)
  if not self:enemy(p,target) or not self:targetable(target,now) then return nil end
  local d=target.body.Position-p.body.Position;local distance=d.Magnitude
  if distance&lt;=.1 or distance&gt;Config.eraser_lock_range then return nil end
  local dot=p.body.CFrame.LookVector:Dot(d.Unit)
  return dot&gt;math.cos(math.rad(degrees)) and self:visible(p.body.Position,target.body.Position) and dot or nil
 end
 local candidate=info.lockPilot and cone(info.lockPilot,Config.eraser_lock_keep_deg) and info.lockPilot or nil
 if not candidate then
  local best=-1
  for _,target in pairs(self.flight.pilots) do
   local dot=cone(target,Config.eraser_lock_cone_deg)
   if dot and dot&gt;best then candidate,best=target,dot end
  end
 end
 if info.lockPilot~=candidate then info.lockPilot=candidate;info.lockAt=now end
 local progress=candidate and math.clamp((now-info.lockAt)/Config.eraser_lock_seconds,0,1) or 0
 p.model:SetAttribute("LockProgress",progress);p.model:SetAttribute("LockName",candidate and candidate.name or "")
 p.model:SetAttribute("LockTarget",candidate and candidate.id or "")
 -- The target is told while it is being locked (quiet warning) and once the lock is complete (loud warning).
 if candidate then candidate.model:SetAttribute(progress&gt;=1 and "IncomingLockUntil" or "LockingUntil",now+.25) end
end
function Service:fire(p,mount,now)
 if self.shotCount&gt;=768 or not self:eligible(p) or p.overlay or (mount.readyAt&gt;now and mount.weapon.fire_mode~="burst") then return false end
 local info=self.info[p.id];local weapon=mount.weapon
 self:coolMount(mount,info.held and info.held[mount.group] and self:eligible(p) and not p.overlay,now)
 local heat,cooling,allowed=Rules.heatShot(mount.heat,mount.cooling,weapon)
 if not allowed then return false end
 local target
 if weapon.homing then
  -- Locked: the eraser seeks. Locking in progress: hold and it launches when the lock completes.
  -- Nothing in the circle: it flies straight like a pencil.
  if not Rules.canEraser(info.activeErasers) then return false end
  if info.lockPilot and now-info.lockAt&gt;=Config.eraser_lock_seconds then
   target=info.lockPilot
   if not self:targetable(target,now) or not self:visible(p.body.Position,target.body.Position) then return false end
  elseif info.lockPilot then return false end
 end
 -- Pencils wind up: the reload starts now, the shot leaves a moment later from wherever the plane is then.
 if weapon.windup_seconds&gt;0 then
  Rules.consume(mount,now)
  local life=p.life
  task.delay(weapon.windup_seconds,function()
   if self.info[p.id]==info and p.life==life then self:launch(p,mount,workspace:GetServerTimeNow(),target) end
  end)
  return true
 end
 if not self:launch(p,mount,now,target) then return false end
 Rules.consume(mount,now)
 mount.heat,mount.cooling=heat,cooling
 if cooling then self:publishHeat(p,now) end
 return true
end
function Service:launch(p,mount,now,target)
 if not self:eligible(p) then return false end
 local info=self.info[p.id];local weapon=mount.weapon
 local direction=info.aims and info.aims[mount.group] or info.aim or p.body.CFrame.LookVector
 local aimData=info.aimData and info.aimData[mount.group]
 local arc=p.kind=="human" and aimData and now-aimData.at&lt;.3 and aimData.arc or math.rad(25)
 if p.body.CFrame.LookVector:Dot(direction)&lt;math.cos(arc) then direction=p.body.CFrame.LookVector end
 local factor=self.flight.catalog:get(p.loadout.body).visual_scale/2
 local position=p.body.CFrame:PointToWorldSpace(Aircraft.muzzleOffset(mount.slot,factor,mount.weapon.id,self.flight.catalog:get(p.loadout.body).wing_shift))
 direction=Aircraft.converge(p.body,position,direction,Config.gun_convergence_studs)
 if weapon.spread_deg&gt;0 then
  local spread=math.rad(weapon.spread_deg)
  direction=(CFrame.lookAt(Vector3.zero,direction)*CFrame.Angles(self.random:NextNumber(-spread,spread),self.random:NextNumber(-spread,spread),0)).LookVector
 end
 if self.flight.inServiceZone and self.flight:inServiceZone(p,position) then return false end
 p.spawnProtectionUntil=0
 self.serial+=1
 -- Humans aim at where they saw targets. Their view is one trip old (positions reaching them) plus Roblox's
 -- display smoothing, and their shot took another trip to get here, so rewind two trips plus smoothing, capped.
 local latency=aimData and aimData.latency or 0
 local rewind=p.kind=="human" and math.min(Config.max_rewind_seconds,2*latency+Config.view_delay_seconds) or 0
 local shot={id=self.serial,owner=p.id,life=p.life,weapon=weapon,position=position,origin=position,direction=direction,direction0=direction,born=now,expires=now+weapon.lifetime,rewind=rewind,flown=0,
  target=target,targetLife=target and target.life,radius=weapon.projectile_radius}
 self.shots[shot.id]=shot;self.shotCount+=1;self.totalFired+=1
 local record=self.flight.records[p.id];if record then record.shots+=1 end
 if weapon.homing then info.activeErasers+=1 end
 self:emit({kind="shot",id=shot.id,owner=p.id,weapon=weapon.id,position=position,direction=direction,speed=weapon.projectile_speed,expires=shot.expires,time=now})
 return true
end
function Service:finish(shot,position,wall)
 if not self.shots[shot.id] then return end
 self.shots[shot.id]=nil;self.shotCount-=1
 if shot.weapon.homing and self.info[shot.owner] then self.info[shot.owner].activeErasers=math.max(0,self.info[shot.owner].activeErasers-1) end
 self:emit({kind="end",id=shot.id,position=position or shot.position,wall=wall})
end
function Service:hit(attacker,target,amount,now,position)
 if not attacker or not self:enemy(attacker,target) or target.model:GetAttribute("State")=="DESTROYED" or self.flight:protected(target,now) then return end
 local actual=math.min(amount,target.model:GetAttribute("Health"));if actual&lt;=0 then return end
 local history=self.info[target.id].history
 for i=#history,1,-1 do if now-history[i].at&gt;Config.assist_window_seconds then table.remove(history,i) end end
 table.insert(history,{attacker=attacker.id,at=now,damage=actual,identity=attacker.identity})
 local record=self.flight.records[attacker.id];record.damage+=actual;record.hits+=1;self.totalHits+=1
 target.lastHitAt=now;target.lastHitBy=attacker
 if self.onDamage then self.onDamage(attacker,target,actual,os.clock()) end
 self.flight:damage(target,actual,"weapon")
 self:emit({kind="hit",owner=attacker.id,target=target.id,damage=actual,position=position or target.body.Position})
end
function Service:death(p,cause)
 local now=workspace:GetServerTimeNow();local info=self.info[p.id]
 local killer,assists=Rules.credit(info and info.history or {},now,p.stats.health,p.id)
 if cause=="vacancy" or cause=="round_end" then killer=nil;assists={} end
 if killer and self.flight.records[killer] then
  local record=self.flight.records[killer];record.kills+=1;record.points+=100
  local actor=self.flight.byId[killer];if actor then actor.model:SetAttribute("Kills",record.kills) end
  if actor then actor.protectionRemaining=require(Root.Generated.Gameplay).service.protected_seconds_per_life end -- a kill earns hangar safety back
 end
 for _,id in ipairs(assists) do local record=self.flight.records[id];if record then record.assists+=1;record.points+=40 end end
 if self.onDeath then self.onDeath(p,cause,killer,assists,info and info.history or {}) end
 for _,shot in pairs(self.shots) do if shot.owner==p.id then self:finish(shot) end end
 if info then info.held={false,false};info.history={} end
 self:emit({kind="death",victim=p.name,victimId=p.id,killer=killer and self.flight.records[killer].name or nil,killerId=killer,cause=cause,position=p.body.Position})
end
-- Earliest plane on a shot's path this step, tested where each target was when the shooter saw it.
function Service:planeHit(shot,delta,now)
 local shooter=self.flight.byId[shot.owner];if not shooter then return nil end
 local best,bestT=nil,math.huge
 local reach=delta.Magnitude/2+30
 -- Strict hits: the projectile's drawn box against the target plane's exact model shape.
 local size,rotation=Aircraft.projectile(shot.weapon.id,shot.weapon.homing)
 size,rotation=size or Vector3.one*shot.radius*2,rotation or CFrame.identity
 for _,target in pairs(self.flight.pilots) do
  local info=self.info[target.id]
  if info and self:enemy(shooter,target) and target.model:GetAttribute("State")=="FLYING" then
   local cf=Rules.sample(info.track,now-shot.rewind) or target.body.CFrame
   if (cf.Position-(shot.position+delta/2)).Magnitude&lt;reach then
    local function at(pose)
     local t=HitShapes.cast(target,pose,shot.position,delta,size,rotation)
     -- No plane model to test (unit fixtures): its body box.
     if t==false then t=Rules.segmentBox(shot.position,delta,pose,target.body.Size/2+Vector3.one*shot.radius) end
     return t
    end
    local t=at(cf)
    -- Erasers are slow and dodged on sight: a human pilot is only hit if the eraser also reaches where they
    -- already are on their own screen (the server sees their plane a moment late).
    if t and shot.weapon.homing and target.kind=="human" then
     local t2=at(cf+target.body.AssemblyLinearVelocity*(Config.view_delay_seconds+(info.latency or 0)));t=t2 and math.max(t,t2)
    end
    if t and t&lt;bestT then best,bestT=target,t end
   end
  end
 end
 return best,bestT
end
function Service:step(dt)
 local now=workspace:GetServerTimeNow();self.clock+=dt;self.trackClock+=dt
 if self.trackClock&gt;=1/Config.track_hz then
  self.trackClock=0
  for _,p in pairs(self.flight.pilots) do
   local info=self.info[p.id]
   if info then
    table.insert(info.track,{at=now,cf=p.body.CFrame})
    while info.track[1] and now-info.track[1].at&gt;Config.max_rewind_seconds+.75 do table.remove(info.track,1) end
   end
  end
 end
 for _,p in pairs(self.flight.pilots) do
  local info=self.info[p.id]
  if info then
   for _,mount in ipairs(info.mounts) do self:coolMount(mount,info.held[mount.group] and self:eligible(p) and not p.overlay,now) end
  end
  if info and self:eligible(p) and not p.overlay then
   if self.clock&gt;=.1 then self:lock(p,info,now) end
   for _,mount in ipairs(info.mounts) do
    local weapon=mount.weapon
    if info.held[mount.group] and mount.readyAt&lt;=now then
     -- Holding the trigger on an eraser launches it the moment the lock completes.
     if weapon.homing then
      if info.lockPilot and now-info.lockAt&gt;=Config.eraser_lock_seconds then self:fire(p,mount,now) end
     elseif weapon.fire_mode=="automatic" then self:fire(p,mount,now)
     elseif weapon.fire_mode=="burst" and mount.burstLeft==0 then mount.burstLeft=weapon.burst_count;mount.burstNext=now;mount.readyAt=now+weapon.burst_period end
    end
    if mount.burstLeft&gt;0 then
     for _=1,3 do
      if mount.burstLeft==0 or now&lt;mount.burstNext then break end
      self:fire(p,mount,now);mount.burstLeft-=1;mount.burstNext+=weapon.burst_spacing
     end
    end
   end
  end
  if info and self.clock&gt;=.1 then
   self:publishHeat(p,now)
   local pencils=0
   for _,mount in ipairs(info.mounts) do if mount.weapon.id=="pencil" then
    pencils+=1;p.model:SetAttribute("PencilReload"..pencils,math.max(0,mount.readyAt-now))
   end end
   p.model:SetAttribute("PencilCount",pencils)
   for which=1,2 do
    local ready=math.huge;local label="None";local details={}
    for _,m in ipairs(info.mounts) do if m.group==which then
     local remaining=math.max(0,m.readyAt-now)
     ready=math.min(ready,remaining);label=m.weapon.name
     table.insert(details,string.format("%d: %s",m.slot,remaining&lt;=0 and "Ready" or string.format("%.1fs",remaining)))
    end end
    p.model:SetAttribute(which==1 and "PrimaryReload" or "AlternateReload",ready==math.huge and -1 or math.max(0,ready))
    p.model:SetAttribute(which==1 and "PrimaryName" or "AlternateName",label)
    p.model:SetAttribute(which==1 and "PrimaryReloadDetail" or "AlternateReloadDetail",table.concat(details," | "))
   end
  end
 end
 for _,shot in pairs(self.shots) do
  if now&gt;=shot.expires then self:finish(shot);continue end
  if shot.target then
   if not self:targetable(shot.target,now) or shot.target.life~=shot.targetLife then shot.target=nil
   elseif self:visible(shot.position,shot.target.body.Position) then
    shot.lostAt=nil;local d=shot.target.body.Position-shot.position
    local steered=d.Magnitude&gt;.01 and Rules.eraserSteer(shot.direction,d.Unit,dt)
    if steered then
     shot.direction=steered
     shot.target.model:SetAttribute("EraserIncomingUntil",now+.25);shot.target.model:SetAttribute("EraserDistance",d.Magnitude)
    else shot.target=nil end
   else
    shot.lostAt=shot.lostAt or now
    if now-shot.lostAt&gt;.4 then shot.target=nil end
   end
  end
  local delta -- ponytail: a server hitch slows shots instead of breaking the 1024-stud cast limit
  if shot.weapon.homing then delta=shot.direction*Rules.eraserSpeed(shot.weapon.projectile_speed,shot.flown,Config)*math.min(dt,.5)
  else
   if dt&gt;.5 then shot.born+=dt-.5 end
   delta=shot.origin+Rules.shotOffset(shot.weapon,shot.direction0,now-shot.born)-shot.position
  end
  if delta.Magnitude&gt;.001 then
   local result=workspace:Spherecast(shot.position,shot.radius,delta,self.worldCast)
   local target,t=self:planeHit(shot,delta,now)
   local attacker=self.flight.byId[shot.owner]
   if target and (not result or t*delta.Magnitude&lt;=result.Distance) then
    local at=shot.position+delta*t
    self:hit(attacker,target,shot.weapon.damage,now,at);self:finish(shot,at)
   elseif result then
    if attacker and self.onProp then self.onProp(attacker,result.Instance) end
    self:finish(shot,result.Position,true)
   else shot.position+=delta;shot.flown+=delta.Magnitude end
  end
  if self.clock&gt;=.1 and shot.weapon.homing then self:emit({kind="update",id=shot.id,position=shot.position,direction=shot.direction,flown=shot.flown,time=now}) end
 end
 if self.clock&gt;=.1 then self.clock%=.1 end
 -- Send shot and hit news 20 times a second; the shooter's own tracers are already drawn locally.
 self.flushClock=(self.flushClock or 0)+dt
 if self.flushClock&gt;=.05 then
  self.flushClock=0
  if #self.events&gt;0 then self.remote:FireAllClients(self.events);self.events={} end
  -- Unreliable messages are capped near 1 KB, so send tracer news a few events at a time.
  local list=self.cosmeticEvents
  for i=1,#list,5 do self.cosmetics:FireAllClients(table.move(list,i,math.min(i+4,#list),1,{})) end
  self.cosmeticEvents={}
 end
end
return Service
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ROJO_232">
        <Properties>
          <string name="Name">DeskService</string>
          <string name="Source">local Root=game.ReplicatedStorage.FlyFightPaper
local Rules=require(Root.Shared.ServiceRules)
local Config=require(Root.Generated.Gameplay).service
local Service={};Service.__index=Service
function Service.new(flight,profiles)
 local self=setmetatable({flight=flight,profiles=profiles},Service)
 flight.onService=function(p,action) self:perform(p,action) end
 return self
end
function Service:valid(p,life)
 return self.flight.byId[p.id]==p and p.life==life and p.model:GetAttribute("State")=="DESK"
end
function Service:enqueue(p,input,callback)
 if self.profiles:enqueue(p.player,input,nil,callback) then return end
 task.spawn(function()
  while self.profiles.entries[p.player] do
   if self.profiles:enqueue(p.player,input,nil,callback) then return end
   task.wait(.25)
  end
  if callback then callback(false,"profile_unavailable") end
 end)
end
function Service:settle(p,intent,kind)
 self:enqueue(p,{kind=kind,intentId=intent},function(ok)
  if ok then self:enqueue(p,{kind="refoldRetire",intentId=intent}) end
 end)
end
function Service:perform(p,action)
 if p.serviceBusy or p.model:GetAttribute("State")~="DESK" then return end
 local life=p.life
 if action=="fresh" then self.flight:destroy(p,"Folding a fresh plane","fresh");return end
 if action=="refill" or action=="repair" then
  p.serviceBusy=true;p.model:SetAttribute("ServiceBusy",true)
  p.model:SetAttribute("Message",action=="refill" and "Refilling Lift" or "Repairing. This adds wear")
  task.delay(action=="refill" and Config.refill_seconds or Config.repair_seconds,function()
   if self:valid(p,life) then
    if action=="refill" then p.model:SetAttribute("Lift",p.stats.lift);p.model:SetAttribute("Boost",p.model:GetAttribute("BoostMax") or 0)
    else
     local repaired=assert(Rules.repair(p.stats.health,p.model:GetAttribute("MaxHealth"),p.model:GetAttribute("Health")))
     p.model:SetAttribute("Health",repaired.health);p.model:SetAttribute("MaxHealth",repaired.lifeMaxHealth)
    end
    p.model:SetAttribute("Message","Service complete. Ready to launch");p.model:SetAttribute("ServiceBusy",false)
   end
   p.serviceBusy=false
  end)
 elseif action=="refold" and p.player then
  local profile=self.profiles:view(p.player)
  if not profile then return end
  local intent=self.profiles.service:operationID()
  local loadout=self.flight.selectedLoadout and self.flight.selectedLoadout(p.player) or p.loadout
  p.serviceBusy=true;p.model:SetAttribute("ServiceBusy",true);p.model:SetAttribute("Message","Reserving 120 Paper for full refold")
  local fence={nonce=profile.lease.nonce,generation=profile.generation,actorId=p.id,lifeId=tostring(life),matchId=p.identity.matchId,
   participationId=p.id,padId=p.padKey or tostring(p.seat),sessionGeneration=profile.generation}
  local accepted=self.profiles:enqueue(p.player,{kind="refoldIntent",intentId=intent,fence=fence,loadout=loadout},nil,function(ok,reason)
   if not ok then
    if self:valid(p,life) then p.model:SetAttribute("Message",reason=="insufficient_paper" and "You need 120 Paper. Repair and fresh planes are free." or "Refold unavailable");p.model:SetAttribute("ServiceBusy",false) end
    p.serviceBusy=false;return
   end
   task.delay(Config.refold_seconds,function()
    if not self:valid(p,life) then
     self:settle(p,intent,"refoldCancel");p.serviceBusy=false;return
    end
    self:enqueue(p,{kind="refoldDeliver",intentId=intent},function(delivered)
     local applied=false
     if delivered and self:valid(p,life) then
      self.flight:refold(p,loadout)
      applied=true
      p.model:SetAttribute("Message","Full refold complete. Streak kept.")
     end
     if self:valid(p,life) then p.model:SetAttribute("ServiceBusy",false) end
     p.serviceBusy=false
     if delivered then
      self:settle(p,intent,applied and "refoldApplied" or "refoldRefund")
     end
    end)
   end)
  end)
  if not accepted then p.serviceBusy=false;p.model:SetAttribute("ServiceBusy",false);p.model:SetAttribute("Message","Saving is busy. Try refold again shortly; nothing was charged.") end
 end
end
return Service
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ROJO_233">
        <Properties>
          <string name="Name">FlightService</string>
          <string name="Source">-- Native assemblies; human physics on their client, scripted pilots on the server.
local Players=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage")
local SS=game:GetService("ServerStorage")
local Run=game:GetService("RunService")
local Tween=game:GetService("TweenService")
local Physics=game:GetService("PhysicsService")
local Root=RS:WaitForChild("FlyFightPaper")
local Rules=require(Root.Shared.FlightRules)
local Landing=require(Root.Shared.ServiceRules)
local Catalog=require(Root.Shared.Catalog)
local Gameplay=require(Root.Generated.Gameplay)
local Desk=Gameplay.service
local Loadouts=require(Root.Shared.WeaponLoadouts)
local Aircraft=require(Root.Shared.Aircraft)
local Roster=require(Root.Shared.BotRosterRules)
local HitShapes=require(script.Parent.HitShapes)
local Service={};Service.__index=Service

function Service.new()
 local self=setmetatable({},Service)
 self.room=workspace:FindFirstChild("Arena") or workspace:WaitForChild("GreyboxRoom")
 -- The room collides by what is drawn: every visible solid mesh in it has an exact collision shape, worked out once
 -- in Studio and saved in the place (tools/save_place.py keeps it through rebuilds), so the server builds none at start.
 local NativeAssets=require(Root.Shared.NativeAssets)
 NativeAssets.mark(self.room);NativeAssets.mark(Root:WaitForChild("Assets"))
 self.planes=Instance.new("Folder");self.planes.Name="Planes";self.planes.Parent=workspace
 self.template=SS:WaitForChild("Assets"):WaitForChild("PaperPlane")
 self.catalog=Catalog.new(require(Root.Generated.Catalog),Gameplay)
 self.pilots={};self.byId={};self.records={};self.seats={};self.padReservations={};self.landingQueues={};self.lifeSerial=0
 pcall(function() Physics:RegisterCollisionGroup("Planes") end)
 Physics:CollisionGroupSetCollidable("Planes","Planes",false)
 self.cast=RaycastParams.new();self.cast.FilterType=Enum.RaycastFilterType.Include;self.cast.FilterDescendantsInstances={self.room};self.cast.RespectCanCollide=true
 self.overlap=OverlapParams.new();self.overlap.FilterType=Enum.RaycastFilterType.Include;self.overlap.FilterDescendantsInstances={self.room};self.overlap.RespectCanCollide=true
 self.single=RaycastParams.new();self.single.FilterType=Enum.RaycastFilterType.Include
 self.other=OverlapParams.new();self.other.FilterType=Enum.RaycastFilterType.Include
 self.regions=OverlapParams.new();self.regions.FilterType=Enum.RaycastFilterType.Include;self.regions.FilterDescendantsInstances={self.planes}
 self.boundsCF,self.boundsSize=self.room:GetBoundingBox()
 if self.room.Name=="Arena" then self.boundsSize=Vector3.new(Gameplay.world.width_studs,Gameplay.world.height_studs,Gameplay.world.depth_studs);self.boundsCF=CFrame.new(0,Gameplay.world.height_studs/2,0) end
 -- Fan volumes come from config; the room's fan models are only their visuals.
 self.fans={};self.updrafts={}
 for _,fan in ipairs(Gameplay.world.fans) do
  local center,half,dir=fan.center,fan.halfsize,fan.direction
  local entry={Name=fan.id,upward=fan.kind=="upward",Position=Vector3.new(center[1],center[2],center[3]),Size=Vector3.new(half[1],half[2],half[3])*2,Direction=Vector3.new(dir[1],dir[2],dir[3]).Unit}
  table.insert(self.fans,entry);if entry.upward then table.insert(self.updrafts,entry) end
 end
 -- Speed power-ups at the fly-throughs: the server owns pick-up and respawn; clients spin the markers.
 local Pickups=Gameplay.world.speed_pickups
 self.pickups={};local pickupFolder=Instance.new("Folder");pickupFolder.Name="SpeedPickups"
 for i,spot in ipairs(Pickups.spots) do
  local marker=Instance.new("Part");marker.Name="SpeedPickup"..i;marker.Anchored=true;marker.CanCollide=false;marker.CanQuery=false;marker.CanTouch=false
  marker.Size=Vector3.new(table.unpack(spot.box));marker.Transparency=1;marker.Position=Vector3.new(table.unpack(spot.at));marker:SetAttribute("ReadyAt",0);marker.Parent=pickupFolder
  table.insert(self.pickups,marker)
 end
 pickupFolder.Parent=workspace
 self.desks={self.room.DeskSouth3}
 for _,side in ipairs({"South","North"}) do for i=1,6 do local desk=self.room["Desk"..side..i];if desk~=self.desks[1] then table.insert(self.desks,desk) end end end
 self.neutralDesks={}
 for _,part in ipairs(self.room:GetChildren()) do if part:IsA("BasePart") and part.Name:match("^NeutralDesk%d+$") then table.insert(self.neutralDesks,part) end end
 self.remote=Instance.new("RemoteEvent");self.remote.Name="FlightAction";self.remote.Parent=Root
 self.remote.OnServerEvent:Connect(function(player,action,value)
  local p=self.pilots[player];if not p then return end
  if action=="boost" then
   if type(value)=="boolean" then p.boostHeld=value end
   return
  end
  local now=workspace:GetServerTimeNow();if now-p.lastAction&lt;0.35 then return end;p.lastAction=now
  if action=="launch" and p.model:GetAttribute("State")=="DESK" and not p.serviceBusy then self:launch(p)
  elseif action=="fresh" and p.model:GetAttribute("State")=="DESK" and not p.serviceBusy then self:destroy(p,"New plane in 4 seconds","fresh")
  elseif action=="loadout" and Run:IsStudio() and p.model:GetAttribute("State")=="DESK" and not p.serviceBusy then
   -- Studio test flights: a desk picker name or a whole hangar build, with every part unlocked.
   -- It lasts until the player picks a hangar preset and is never saved to the profile.
   local loadout=type(value)=="string" and Loadouts.make(self.catalog,value) or type(value)=="table" and self.catalog:validateLoadout(value,nil,50) and value
   if loadout then p.testLoadout=loadout;p.loadoutName=type(value)=="string" and value or "test build";self:replace(p) end
  elseif action=="mixedBots" and Run:IsStudio() then
   -- Studio test: replace every bot with an even mix of all builds, skills, personalities and quirks.
   self.eraserDuel=false;self.mixedBots=(self.mixedBots or 0)+1
   for _,bot in pairs(self.pilots) do if bot.kind=="bot" then self:remove(bot,"vacancy") end end
  elseif action=="eraserBots" and Run:IsStudio() then
   -- Studio dodge practice: one enemy bot with only an eraser hunts you; the other bots leave (until Play stops).
   self.eraserDuel=true
   local hunter
   for _,bot in pairs(self.pilots) do if bot.kind=="bot" then
    if hunter then self:remove(bot,"vacancy") else hunter=bot end
   end end
   if hunter then
    hunter.team=nil;hunter.testLoadout=Loadouts.make(self.catalog,"eraser_only");hunter.loadoutName="eraser_only"
    if hunter.model:GetAttribute("State")=="DESK" then self:replace(hunter) else self:destroy(hunter,"Rearming with an eraser","fresh") end
   end
  end
 end)
 Players.PlayerRemoving:Connect(function(player) local p=self.pilots[player];if p then self:remove(p,"departure") end end)
 Run.Heartbeat:Connect(function(dt) local start=os.clock();self:step(dt);self.lastWorkMs=(os.clock()-start)*1000 end)
 Service.active=self
 return self
end
function Service:seat()
 for index=1,#self.desks do if not self.seats[index] and not self.padReservations["desk:"..index] then self.seats[index]=true;return index end end
 return nil
end
function Service:rosterActors()
 local actors={};local now=workspace:GetServerTimeNow()
 for _,p in pairs(self.pilots) do
  local state=p.model:GetAttribute("State")
  table.insert(actors,{key=p.id,userKey=p.player and p.id,controllerType=p.kind,displayName=p.name,profileName=p.kind=="bot" and p.tier or nil,
   teamId=p.team,state=state=="DESK" and "SPAWN_READY" or state,trustedSafeParkedService=state=="DESK" and self:protected(p,now),recentDamageCredit=now-(p.lastHitAt or -math.huge)&lt;=10})
 end
 return actors
end
function Service:add(player,options)
 options=options or {}
 local key=player or options.id;local id=player and tostring(player.UserId) or options.id
 local seat=options.seat or self:seat()
 if not seat and player then
  local plan=Roster.humanPriority({eligibility=self.eligibility or "rookie",serverClass=self.eligibility or "rookie",mode=self.mode or "FFA",seed=Gameplay.world.seed,config=Gameplay,
   actors=self:rosterActors(),pendingHumanQueue={{userKey=id,arrivalOrder=0}},botIdentitySerial=1})
  local other=plan and plan.releaseProposal and self.byId[plan.releaseProposal.actorKey]
  -- Studio test modes skip the roster rules: any bot gives up its desk.
  if not other and (self.mixedBots or self.eraserDuel) then for _,bot in pairs(self.pilots) do if bot.kind=="bot" then other=bot;break end end end
  if other then self:remove(other,"vacancy");seat=self:seat() end
 end
 if not seat then return nil end
 self.seats[seat]=true
 local desk=self.desks[seat]
 local home=CFrame.new(desk.Position+Vector3.new(0,desk.Size.Y/2+2.8,0))*CFrame.Angles(0,desk.Name:find("North") and math.pi or 0,0)
 local p={key=key,id=id,player=player,kind=player and "human" or "bot",name=player and player.DisplayName or options.name,
  seat=seat,home=home,loadout=options.loadout or self.catalog:starterLoadout(),loadoutName=options.loadoutName or "pellet",tier=options.tier or "regular",life=0}
 self.records[id]=self.records[id] or {name=p.name,kind=p.kind,tier=p.kind=="bot" and p.tier or nil,shots=0,hits=0,kills=0,assists=0,deaths=0,weaponDeaths=0,collisionDeaths=0,damage=0,points=0}
 self.pilots[key]=p;self.byId[id]=p;self:build(p)
 return p
end
function Service:build(p)
 -- A returning account gets a new identity even when its previous pilot was removed.
 self.lifeSerial=(self.lifeSerial or 0)+1;p.life=self.lifeSerial;p.stats=assert(self.catalog:deriveStats(p.loadout))
 local model=self.template:Clone();model.Name=p.id
 -- Root is only the flight body; it never collides. The exact-shape Colliders below decide what the plane touches.
 local body=model:WaitForChild("Root");model.PrimaryPart=body;body.Anchored=true;body.CanCollide=false;body.CanQuery=true;body.CollisionGroup="Planes"
 body.CustomPhysicalProperties=PhysicalProperties.new(0.3,0.15,0.1)
 for key,value in pairs({OwnerId=p.player and p.player.UserId or 0,Life=p.life,State="DESK",LiftMax=p.stats.lift,Lift=p.stats.lift,Speed=p.stats.speed,
  TurnRate=p.stats.turn,PitchRate=p.stats.pitch,YawRate=p.stats.yaw,Health=p.stats.health,MaxHealth=p.stats.health,OriginalHealth=p.stats.health,DisplayName=p.name,ControllerType=p.kind,
  Message="Ready at your desk",Loadout=p.loadoutName,Protected=true,Kills=self.records[p.id].kills}) do model:SetAttribute(key,value) end
 local color=Color3.fromHSV((p.seat*.133)%1,0.65,0.9)
 if Aircraft.build(model,p.loadout,self.catalog,false) then
  for _,part in ipairs(model:GetChildren()) do if part:IsA("BasePart") and part~=body then part:Destroy() end end
  -- Invisible exact copies of every part (body, nose, wings, tail, mounts, booster), welded on.
  local colliders=Instance.new("Folder");colliders.Name="Colliders";colliders.Parent=model
  for _,part in ipairs(model.Appearance:GetChildren()) do if part:IsA("MeshPart") then
   local piece=HitShapes.solid(part);piece.Name=part.Name;piece.CFrame=part.CFrame;piece.Transparency=1;piece.Massless=true
   piece.Anchored=false;piece.CanQuery=true;piece.CastShadow=false;piece.Parent=colliders
   local weld=Instance.new("WeldConstraint");weld.Part0=body;weld.Part1=piece;weld.Parent=piece
  end end
 end
 local attachment=Instance.new("Attachment");attachment.Name="FlightAttachment";attachment.Parent=body
 local drive=Instance.new("LinearVelocity");drive.Name="ForwardVelocity";drive.Attachment0=attachment;drive.RelativeTo=Enum.ActuatorRelativeTo.World
 drive.VelocityConstraintMode=Enum.VelocityConstraintMode.Vector;drive.ForceLimitsEnabled=true;drive.Enabled=false;drive.Parent=body
 local orientation=Instance.new("AlignOrientation");orientation.Name="NoseOrientation";orientation.Attachment0=attachment;orientation.Mode=Enum.OrientationAlignmentMode.OneAttachment
 orientation.Responsiveness=Gameplay.flight.orientation_response;orientation.MaxTorque=1e6;orientation.MaxAngularVelocity=math.rad(p.stats.turn)*Gameplay.flight.orientation_angular_headroom;orientation.Enabled=false;orientation.Parent=body
 local label=Instance.new("BillboardGui");label.Name="PilotName";label.Size=UDim2.fromOffset(180,26);label.StudsOffset=Vector3.new(0,5,0);label.MaxDistance=800;label.AlwaysOnTop=false;label.Parent=body
 local text=Instance.new("TextLabel");text.Size=UDim2.fromScale(1,1);text.BackgroundTransparency=1;text.Text=p.name;text.TextColor3=color;text.TextStrokeTransparency=.3;text.Font=Enum.Font.GothamMedium;text.TextSize=14;text.Parent=label
 p.hangar=Landing.hangar(p.home,Desk)
 model.Parent=self.planes;model:PivotTo(p.hangar)
 p.model,p.body,p.drive,p.orientation=model,body,drive,orientation
 p.lastAction,p.lastImpact,p.lastContact=0,0,0;p.fanInside={};p.fanLast={};p.lastPosition=body.Position;p.checkCFrame=body.CFrame
 p.checkAt=workspace:GetServerTimeNow();p.regionClock=0;p.protectionRemaining=Desk.protected_seconds_per_life;p.outOfHangar=0;p.spawnProtectionUntil=0;p.outSince=nil;p.lastCFrame=body.CFrame
 p.launchAt=nil;p.respawnAt=nil;p.hasLaunched=false;p.serviceBusy=false;p.serviceHome=p.hangar
 local utility=p.loadout.utility and self.catalog:get(p.loadout.utility)
 p.boostHeld=false;model:SetAttribute("BoostMax",utility and utility.boost_seconds or 0);model:SetAttribute("Boost",utility and utility.boost_seconds or 0);model:SetAttribute("BoostSpeedFactor",1)
 p.padKey="desk:"..p.seat;self.padReservations[p.padKey]=p.id
 if self.onSpawn then self.onSpawn(p) end
end
function Service:replace(p)
 if p.testLoadout then p.loadout=p.testLoadout
 elseif p.player and self.selectedLoadout then p.loadout=self.selectedLoadout(p.player) or p.loadout end
 if p.model then p.model:Destroy() end
 self:build(p)
end
function Service:remove(p,cause)
 if p.model:GetAttribute("State")~="DESTROYED" then self:destroy(p,"Left the round",cause) end
 p.model:Destroy();self.pilots[p.key]=nil;self.byId[p.id]=nil;self.seats[p.seat]=nil
 if self.onRemoved then self.onRemoved(p) end
end
function Service:launch(p)
 if not self.active or p.serviceBusy then return end
 self:clearLandingQueue(p)
 local launchHome=p.serviceHome or p.home
 local _,yaw=launchHome:ToOrientation()
 p.model:PivotTo(CFrame.new(launchHome.Position)*CFrame.fromOrientation(math.rad(9),yaw,0))
 p.body.Anchored=false;p.body:SetNetworkOwner(p.player)
 if p.padKey then self.padReservations[p.padKey]=nil;p.padKey=nil end
 p.drive.VectorVelocity=p.body.CFrame.LookVector*p.stats.speed;p.orientation.CFrame=p.body.CFrame.Rotation
 -- Finite force: walls push back and the plane slides instead of being driven through them.
 p.drive.MaxForce=p.body.AssemblyMass*workspace.Gravity*Gameplay.flight.drive_force_g
 p.drive.Enabled=true;p.orientation.Enabled=true;p.body.AssemblyLinearVelocity=p.drive.VectorVelocity
 p.launchAt=workspace:GetServerTimeNow();p.checkAt=p.launchAt;p.checkCFrame=p.body.CFrame;p.emptySince=nil;p.lastPosition=p.body.Position;p.lastCFrame=p.body.CFrame;p.fanInside={}
 if not p.hasLaunched then p.spawnProtectionUntil=p.launchAt+Gameplay.combat.spawn_protection_seconds;p.hasLaunched=true end
 p.model:SetAttribute("State","FLYING");p.model:SetAttribute("Message","Move the mouse to aim - the plane follows. Left/right click: fire")
end
function Service:protected(p,now)
 local state=p.model:GetAttribute("State")
 return (state=="DESK" or state=="LANDING") and self:atDesk(p) and p.protectionRemaining&gt;0 or now&lt;(p.spawnProtectionUntil or 0)
end
function Service:refold(p,loadout)
 p.loadout=loadout;p.stats=assert(self.catalog:deriveStats(loadout))
 Aircraft.build(p.model,loadout,self.catalog,false)
 for key,value in pairs({Speed=p.stats.speed,TurnRate=p.stats.turn,PitchRate=p.stats.pitch,YawRate=p.stats.yaw,OriginalHealth=p.stats.health,MaxHealth=p.stats.health,Health=p.stats.health,LiftMax=p.stats.lift,Lift=p.stats.lift}) do p.model:SetAttribute(key,value) end
 p.orientation.MaxAngularVelocity=math.rad(p.stats.turn)*Gameplay.flight.orientation_angular_headroom
 local utility=loadout.utility and self.catalog:get(loadout.utility)
 p.model:SetAttribute("BoostMax",utility and utility.boost_seconds or 0);p.model:SetAttribute("Boost",utility and utility.boost_seconds or 0)
 if self.onRefold then self.onRefold(p) end
end
function Service:atDesk(p)
 local position=(p.serviceHome or p.home):PointToObjectSpace(p.body.Position)
 return math.abs(position.X)&lt;=48 and math.abs(position.Z)&lt;=48 and math.abs(position.Y)&lt;=16
end
function Service:damage(p,amount,cause)
 if p.model:GetAttribute("State")=="DESTROYED" or self:protected(p,workspace:GetServerTimeNow()) then return 0 end
 local actual=math.min(p.model:GetAttribute("Health"),math.max(0,amount))
 p.model:SetAttribute("Health",p.model:GetAttribute("Health")-actual)
 if p.model:GetAttribute("Health")&lt;=0 then self:destroy(p,"Destroyed. New plane in 4 seconds",cause) end
 return actual
end
function Service:destroy(p,message,cause)
 if p.model:GetAttribute("State")=="DESTROYED" then return end
 self:clearLandingQueue(p)
 p.model:SetAttribute("State","DESTROYED");p.model:SetAttribute("Health",0);p.model:SetAttribute("Message",message)
 p.drive.Enabled=false;p.orientation.Enabled=false
 if not p.body.Anchored then p.body:SetNetworkOwner(nil) end
 p.body.Anchored=true;p.body.CanCollide=false;p.body.CanQuery=false;p.respawnAt=workspace:GetServerTimeNow()+Gameplay.combat.respawn_seconds
 if p.padKey then self.padReservations[p.padKey]=nil;p.padKey=nil end
 local record=self.records[p.id];record.deaths+=1
 if cause=="weapon" then record.weaponDeaths+=1 elseif cause=="collision" then record.collisionDeaths+=1 end
 if self.onDeath then self.onDeath(p,cause or "collision") end
end
function Service:clearLandingQueue(p)
 if self.landingQueues then
  for _,queue in pairs(self.landingQueues) do for i=#queue,1,-1 do if queue[i]==p.id then table.remove(queue,i) end end end
 end
 p.waitingPad=nil;p.waitingHome=nil;p.queuedAt=nil
 p.model:SetAttribute("HoldingPosition",nil);p.model:SetAttribute("DeskAvailable",nil);p.model:SetAttribute("DeskQueuePosition",nil)
end
function Service:padAvailable(key,id)
 local queue=self.landingQueues[key]
 while queue and queue[1] do
  local first=self.byId[queue[1]]
  if first and first.model.Parent and first.model:GetAttribute("State")=="FLYING" and first.waitingPad==key then break end
  table.remove(queue,1)
 end
 return (not self.padReservations[key] or self.padReservations[key]==id) and (not queue or not queue[1] or queue[1]==id)
end
function Service:queueLanding(p,home,key)
 if p.waitingPad~=key then self:clearLandingQueue(p) end
 local queue=self.landingQueues[key] or {};self.landingQueues[key]=queue
 local index=table.find(queue,p.id)
 if not index then table.insert(queue,p.id);index=#queue end
 p.waitingPad=key;p.waitingHome=home;p.queuedAt=p.queuedAt or workspace:GetServerTimeNow()
 p.model:SetAttribute("HoldingPosition",Landing.approach(home,Desk).Position+home.LookVector*120+home.RightVector*(index-1)*55+Vector3.new(0,70,0))
 p.model:SetAttribute("DeskQueuePosition",index)
 p.model:SetAttribute("DeskAvailable",false);p.model:SetAttribute("Message","Desk occupied. Follow the waiting marker; your approach opens in order.")
end
function Service:land(p,home,padKey)
 padKey=padKey or "desk:"..p.seat
 home=home or p.home
 if not self:padAvailable(padKey,p.id) then self:queueLanding(p,home,padKey);return false end
 self:clearLandingQueue(p)
 self.padReservations[padKey]=p.id;p.padKey=padKey
 local hangar=Landing.hangar(home,Desk)
 p.serviceHome=hangar
 p.model:SetAttribute("State","LANDING");p.model:SetAttribute("Message","Landing for service")
 p.body:SetNetworkOwner(nil);p.drive.Enabled=false;p.orientation.Enabled=false;p.body.Anchored=true
 -- Inbound = facing the wall. Touch down where the runway tape starts (just inside the desk's room-side edge).
 local inbound=CFrame.Angles(0,math.pi,0)
 local touchdown=home*CFrame.new(0,0,-Desk.touchdown_out_studs)*inbound
 local stages={{touchdown,Desk.touchdown_seconds,Enum.EasingStyle.Sine},{hangar*inbound,Desk.taxi_seconds,Enum.EasingStyle.Quad}}
 local function stage(i)
  if not p.model.Parent or self.pilots[p.key]~=p or p.model:GetAttribute("State")~="LANDING" then return end
  if not stages[i] then
   p.body.CFrame=hangar   -- turned to face out while the hangar menu covers the view
   p.model:SetAttribute("State","DESK");p.model:SetAttribute("Message","Landed. Lift refill takes two seconds")
   if self.onLand then self.onLand(p) end
   return
  end
  local goal,seconds,style=table.unpack(stages[i])
  local tween=Tween:Create(p.body,TweenInfo.new(seconds,style,Enum.EasingDirection.Out),{CFrame=goal})
  tween.Completed:Once(function() stage(i+1) end);tween:Play()
 end
 stage(1);return true
end
-- The plane's exact shape touching the room: steep hits destroy it, scrapes cost health while they last.
function Service:impact(p,normal,part,now,dt)
 local incoming=p.previousVelocity or p.body.AssemblyLinearVelocity
 -- The pilot's own client already stops the plane at the surface, so judge by where the nose points too.
 local into=math.max(0,-incoming:Dot(normal),-p.body.CFrame.LookVector:Dot(normal)*p.stats.speed)
 -- Contact counts as continuous while touches are less than a quarter second apart.
 if not p.scrapeSince or now-(p.lastScrape or 0)&gt;.25 then p.scrapeSince=now end
 p.lastScrape=now
 local amount=Rules.collisionDamage(into,part.Name=="Floor" and p.model:GetAttribute("Lift")&lt;=0,p.stats.health,dt,now-p.scrapeSince)
 if Run:IsStudio() then self.records[p.id].lastImpact={part=part:GetFullName(),speed=into,at=now,position=tostring(p.body.Position)} end
 if amount&gt;=p.stats.health then
  if not self:protected(p,now) then self:destroy(p,"Crashed. New plane in 4 seconds","collision") end
  return
 end
 self:damage(p,amount,"collision")
 p.model:SetAttribute("CollisionNormal",normal);p.model:SetAttribute("DeflectUntil",now+.35)
 p.model:SetAttribute("Message","Scraping! Turn away from the surface")
end
function Service:contact(p)
 local travel=(p.previousVelocity and p.previousVelocity.Magnitude&gt;1) and p.previousVelocity.Unit or p.body.CFrame.LookVector
 return Rules.contact(p.model,travel,self.overlap,self.single)
end
function Service:touching(a,b)
 local colliders=b.model:FindFirstChild("Colliders");local mine=a.model:FindFirstChild("Colliders")
 if not colliders or not mine then return false end
 self.other.FilterDescendantsInstances={colliders}
 for _,piece in ipairs(mine:GetChildren()) do if #workspace:GetPartsInPart(piece,self.other)&gt;0 then return true end end
 return false
end
-- Two planes' exact shapes meet. A brush costs both a little; a real ram destroys the plane with less health
-- and costs the other that much health (equal health: both go).
function Service:ram(a,b,now)
 a.lastContact,b.lastContact=now,now
 local closing=((a.previousVelocity or Vector3.zero)-(b.previousVelocity or Vector3.zero)):Dot((b.body.Position-a.body.Position).Unit)
 if closing&lt;Gameplay.combat.ram_closing_speed then
  for _,p in ipairs({a,b}) do self:damage(p,p.stats.health*Gameplay.combat.plane_contact_health_fraction,"contact") end
  return
 end
 local ha,hb=a.model:GetAttribute("Health"),b.model:GetAttribute("Health")
 if ha&lt;=hb then self:damage(b,ha,"collision");self:damage(a,ha,"collision") end
 if hb&lt;ha then self:damage(a,hb,"collision");self:damage(b,hb,"collision") end
end
function Service:inServiceZone(p,origin)
 local homes={}
 for _,desk in ipairs(self.desks) do table.insert(homes,desk.CFrame*CFrame.new(0,desk.Size.Y/2+2.8,0)) end
 for _,desk in ipairs(self.neutralDesks) do for _,x in ipairs({-48,48}) do table.insert(homes,desk.CFrame*CFrame.new(x,desk.Size.Y/2+2.8,0)) end end
 for _,home in ipairs(homes) do
  for _,spot in ipairs({home,Landing.hangar(home,Desk)}) do
   local position=spot:PointToObjectSpace(origin or p.body.Position)
   if math.abs(position.X)&lt;=48 and math.abs(position.Z)&lt;=48 and math.abs(position.Y)&lt;=16 then return true end
  end
 end
 return false
end
function Service:regionsFor(p,now)
 local updraft=0
 for _,fan in ipairs(self.fans) do
  local name=fan.Name;local upward=fan.upward
  local inside=false
  for _,part in ipairs(workspace:GetPartBoundsInBox(CFrame.new(fan.Position),fan.Size,self.regions)) do if part==p.body then inside=true;break end end
  if Rules.fanEntry(p.fanInside[name],inside,p.fanLast[name] or -math.huge,now) then
   p.fanLast[name]=now
   if upward then p.model:SetAttribute("Lift",Rules.refill(p.model:GetAttribute("Lift"),p.stats.lift));p.model:SetAttribute("Message","Updraft: Lift refilled") end
  end
  p.fanInside[name]=inside;if inside and upward then updraft=18 end
 end
 p.model:SetAttribute("Updraft",updraft)
 -- Checked 10 times a second along the path flown since the last check, so a fast plane can't skip one.
 local Pickups=Gameplay.world.speed_pickups
 local from,to=p.pickupFrom or p.body.Position,p.body.Position;p.pickupFrom=to
 if p.model:GetAttribute("State")=="FLYING" then
  for _,marker in ipairs(self.pickups) do
   if now&gt;=marker:GetAttribute("ReadyAt") and Rules.segmentHitsBox(marker.Position,marker.Size,from,to) then
    marker:SetAttribute("ReadyAt",now+Pickups.respawn_seconds);p.pickupBonus,p.pickupUntil=Rules.stackPickup(p.pickupBonus or 0,p.pickupUntil or 0,now,Pickups)
    p.model:SetAttribute("PickupUntil",p.pickupUntil);p.model:SetAttribute("Message","Speed up!")
   end
  end
 end
 if p.waitingPad then
  if (p.body.Position-p.waitingHome.Position).Magnitude&gt;450 or now-p.queuedAt&gt;25 then self:clearLandingQueue(p)
  elseif self:padAvailable(p.waitingPad,p.id) then
   p.model:SetAttribute("HoldingPosition",Landing.approach(p.waitingHome,Desk).Position)
   p.model:SetAttribute("DeskAvailable",true);p.model:SetAttribute("Message","Your pad is free. Fly through its approach ring.")
  end
 end
 if now-p.launchAt&lt;3 then return end
 local homes={{home=p.home,key="desk:"..p.seat}}
 for index,desk in ipairs(self.neutralDesks) do
  for slot=1,2 do table.insert(homes,{home=desk.CFrame*CFrame.new(slot==1 and -48 or 48,desk.Size.Y/2+2.8,0),key="neutral:"..index..":"..slot}) end
 end
 if p.team then
  for _,other in pairs(self.pilots) do if other~=p and other.team==p.team then table.insert(homes,{home=other.home,key="desk:"..other.seat}) end end
 end
 for _,slot in ipairs(homes) do
  if Landing.linedUp(slot.home,p.body.Position,p.body.CFrame.LookVector,Desk) and self:land(p,slot.home,slot.key) then return end
 end
end
function Service:step(dt)
 local now=workspace:GetServerTimeNow()
 if not self.active then return end
 for _,p in pairs(self.pilots) do
  local state=p.model:GetAttribute("State")
  p.model:SetAttribute("Protected",self:protected(p,now))
  p.model:SetAttribute("ProtectionRemaining",p.protectionRemaining)
  p.protectionRemaining,p.outOfHangar=Landing.hangarSafety(p.protectionRemaining,p.outOfHangar or 0,(state=="DESK" or state=="LANDING") and self:atDesk(p),dt,Desk.protected_seconds_per_life,Desk.protection_refill_out_seconds)
  if state=="DESTROYED" and now&gt;=p.respawnAt then
   if not self.padReservations["desk:"..p.seat] then self:replace(p) else p.model:SetAttribute("Message","Waiting for your desk pad to clear") end
  elseif state=="FLYING" then
   local utility=p.loadout.utility and self.catalog:get(p.loadout.utility)
   local boosting=utility and p.boostHeld and (p.model:GetAttribute("Boost") or 0)&gt;0
   p.model:SetAttribute("BoostSpeedFactor",(boosting and utility.speed_factor or 1)*(1+(now&lt;(p.pickupUntil or 0) and p.pickupBonus or 0)))
   -- Drain in 0.2 s steps so these attributes replicate at 5 Hz, not every frame.
   p.liftDrain=(p.liftDrain or 0)+dt;p.boostDrain=(p.boostDrain or 0)+(boosting and dt or 0)
   if p.liftDrain&gt;=.2 then
    p.model:SetAttribute("Lift",Rules.lift(p.model:GetAttribute("Lift"),p.stats.lift,p.liftDrain));p.liftDrain=0
    if p.boostDrain&gt;0 then p.model:SetAttribute("Boost",math.max(0,p.model:GetAttribute("Boost")-p.boostDrain));p.boostDrain=0 end
   end
   local localPos=self.boundsCF:PointToObjectSpace(p.body.Position)
   local outside=math.abs(localPos.X)&gt;self.boundsSize.X/2+12 or math.abs(localPos.Y)&gt;self.boundsSize.Y/2+12 or math.abs(localPos.Z)&gt;self.boundsSize.Z/2+12
   if outside then p.outSince=p.outSince or now;p.model:SetAttribute("Message","Return to the room now") else p.outSince=nil end
   if p.outSince and now-p.outSince&gt;Gameplay.combat.bounds_grace_seconds then self:destroy(p,"Left the room","bounds");continue end
   if p.player and now-p.checkAt&gt;=.25 then
    local elapsed=now-p.checkAt;local cf=p.body.CFrame
    local empty=p.model:GetAttribute("Lift")&lt;=0;p.emptySince=empty and (p.emptySince or now) or nil
    local allowed=Rules.movementAllowed(p.checkCFrame.Position,cf.Position,p.body.AssemblyLinearVelocity,elapsed,p.stats.speed*(utility and utility.speed_factor or 1)*(1+(now&lt;(p.pickupUntil or 0)+1 and p.pickupBonus or 0)))
     and Rules.turnAllowed(p.checkCFrame.LookVector,cf.LookVector,elapsed,p.stats.turn)
     and (not empty or now-p.emptySince&lt;.6 or Rules.climbAllowed(p.checkCFrame.Y,cf.Y,elapsed,p.model:GetAttribute("Updraft") or 0))
    p.checkAt=now
    if allowed then p.checkCFrame=cf
    else
     -- Lag or a bad client: put the plane back where it last flew legally instead of killing it.
     p.body.CFrame=p.checkCFrame;p.body.AssemblyLinearVelocity=p.checkCFrame.LookVector*p.stats.speed
     p.lastPosition,p.lastCFrame=p.checkCFrame.Position,p.checkCFrame
     p.model:SetAttribute("Message","Flight corrected")
     continue
    end
   end
   p.regionClock+=dt
   if p.regionClock&gt;=.1 then p.regionClock%=.1;self:regionsFor(p,now) end
   if p.model:GetAttribute("State")~="FLYING" then continue end
   -- ponytail: overlap each frame, no sweep. A plane is ~15 studs long and moves under 10 per update, so it
   -- cannot skip through the room's solid parts; add a swept check if thin, fast-crossed parts appear.
   local part,normal=self:contact(p)
   if part then self:impact(p,normal,part,now,dt) end
   if p.model:GetAttribute("State")~="FLYING" then continue end
   if now-p.lastContact&gt;.6 then
    for _,other in ipairs(workspace:GetPartsInPart(p.body,self.regions)) do
     local q=other~=p.body and other.Name=="Root" and self.byId[other.Parent.Name]
     if q and q.model:GetAttribute("State")=="FLYING" and now-q.lastContact&gt;.6 and self:touching(p,q) then self:ram(p,q,now);break end
    end
   end
   p.lastPosition,p.lastCFrame=p.body.Position,p.body.CFrame;p.previousVelocity=p.body.AssemblyLinearVelocity
  end
 end
end
return Service
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ROJO_234">
        <Properties>
          <string name="Name">HangarService</string>
          <string name="Source">local Run=game:GetService("RunService")
local Root=game.ReplicatedStorage.FlyFightPaper
local Schema=require(Root.Shared.ProfileSchema)
local Economy=require(Root.Shared.EconomyRules)
local Commerce=require(Root.Generated.Commerce)
local PresetCount=require(Root.Generated.Gameplay).menus.saved_loadouts
local Service={};Service.__index=Service
function Service.new(flight,profiles)
 return setmetatable({flight=flight,profiles=profiles,catalog=flight.catalog},Service)
end
function Service:message(player,text) player:SetAttribute("MenuMessage",text) end
function Service:enqueue(player,input,callback)
 if not self.profiles:enqueue(player,input,nil,callback) then self:message(player,"Saving is busy. Try again shortly.") end
end
function Service:handle(player,action,value)
 local profile=self.profiles:view(player);if not profile then return end
 if action=="selectPreset" then
  if type(value)~="number" or value%1~=0 or value&lt;1 or value&gt;PresetCount then return end
  player:SetAttribute("SelectedPreset",value)
  local p=self.flight.pilots[player]
  if p then p.testLoadout=nil end
  self:message(player,p and "Preset selected. Use a fresh plane or full refold to apply it." or "Preset selected for your next launch.")
 elseif action=="savePreset" then
  if type(value)~="table" or type(value.slot)~="number" or value.slot%1~=0 or value.slot&lt;1 or value.slot&gt;PresetCount then return end
  local candidate=Schema.copy(profile);local preset=Schema.copy({name=value.name,loadout=value.loadout})
  if not candidate or not preset then return end
  candidate.presets[value.slot]=preset
  local _,reason=self.catalog:validateLoadout(preset.loadout,profile.ownership,Economy.levelForXP(profile.xpMilli))
  if reason=="two weapon types per plane" then self:message(player,"Two weapon types per plane: one for left click, one for right click.");return end
  if not Schema.validate(candidate,self.catalog) then self:message(player,Run:IsStudio() and "Not saved: saving keeps only parts you own at your level. Use Fly this build to test any parts." or "Build refused. Check ownership, level, capacity and mount types.");return end
  self:enqueue(player,{kind="preset",slot=value.slot,name=preset.name,loadout=preset.loadout},function(ok)
   self:message(player,ok and "Preset saved. Apply it with a fresh plane or full refold." or "Preset could not be saved.")
  end)
 elseif action=="purchasePart" then
  if type(value)~="string" or not self.catalog:get(value) then return end
  local legal,reason=Economy.validateEquipmentPurchase(Schema.economicView(profile),self.catalog,value,"preview")
  if not legal then self:message(player,reason.code=="level_locked" and "Reach the required level first." or "You need more Paper.");return end
  self:enqueue(player,{kind="equipmentPurchase",catalogID=value},function(ok)
   self:message(player,ok and "Part unlocked. You can use it on every legal mount." or "Part purchase was not completed.")
  end)
 elseif action=="settings" then
  local settings=Schema.copy(value);local candidate=Schema.copy(profile)
  if not settings or not candidate then return end
  candidate.settings=settings
  if not Schema.validate(candidate,self.catalog) then return end
  self:enqueue(player,{kind="settings",settings=settings})
 elseif action=="mockProduct" and Run:IsStudio() and self.profiles.mock==true and Commerce.mode=="mock" and Commerce.live_sales_authorized==false then
  if type(value)~="string" then return end
  local product
  for _,item in ipairs(Commerce.products) do if item.key==value then product=item;break end end
  if not product then return end
  local input
  if product.benefit=="paper_balance" then input={kind="purchasedPaper",wholePaper=product.amount}
  else
   local resource=product.benefit:find("xp") and "xp" or "paper"
   local permanent=product.benefit:find("permanent")~=nil
   local view=self.profiles.service:liveBoostView(self.profiles.entries[player].account)
   local boosts=view.status=="ok" and view.value.boosts or profile.boosts
   if not permanent and boosts[resource=="xp" and "permanentXP" or "permanentPaper"] then self:message(player,"Permanent 2x already covers this resource. Remaining temporary time is preserved.");return end
   input={kind="boostIntent",resource=resource,action=permanent and "permanent" or "duration"}
   if not permanent then input.seconds=product.amount end
  end
  self:enqueue(player,input,function(ok)self:message(player,ok and "Development simulation complete. No real purchase." or "Development simulation failed.")end)
 end
end
return Service
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ROJO_235">
        <Properties>
          <string name="Name">HitShapes</string>
          <string name="Source">-- Exact hitboxes. Roblox builds a precise collision shape from every plane part's mesh (body, nose, wings,
-- tail, mounted weapons, booster). Each pilot gets a private copy of their plane in a server-only WorldModel,
-- and a shot is tested by sweeping the projectile's own box through that copy, posed where the target was.
local AssetService=game:GetService("AssetService")
local Shapes={}
local world=Instance.new("WorldModel");world.Name="HitShapes";world.Parent=game:GetService("ServerStorage")
local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Include
local precise={} -- mesh id -&gt; precise MeshPart, false while loading, nil before asked
local copies={} -- pilot id -&gt; {model=plane model it mirrors, folder=Model, complete=bool}

local function shape(mesh)
	if precise[mesh]==nil then
		precise[mesh]=false
		task.spawn(function()
			local ok,part=pcall(AssetService.CreateMeshPartAsync,AssetService,Content.fromUri(mesh),
				{CollisionFidelity=Enum.CollisionFidelity.PreciseConvexDecomposition})
			if ok then precise[mesh]=part else warn("Hit shape failed for "..mesh..": "..tostring(part)) end
		end)
	end
	return precise[mesh] or nil
end
-- Start building every shape at server start so the first fights already use them.
function Shapes.preload(folders)
	for _,folder in ipairs(folders) do for _,part in ipairs(folder:GetDescendants()) do
		if part:IsA("MeshPart") and part.MeshId~="" then shape(part.MeshId) end
	end end
end

-- An exact-shape stand-in for one of a plane's parts (its plain box until the precise shape has loaded).
function Shapes.solid(part)
	local source=shape(part.MeshId)
	local piece=source and source:Clone() or Instance.new("Part")
	piece.Size=part.Size;piece.CanCollide=false;piece.CanTouch=false
	return piece,source~=nil
end

-- The copy sits at the origin in the plane's own frame; rebuilt when the plane is rebuilt or shapes finish loading.
local function copyOf(p)
	local copy=copies[p.id]
	local appearance=p.model:FindFirstChild("Appearance")
	if not appearance then return nil end
	if copy and copy.model==p.model and copy.complete then return copy end
	if copy then copy.folder:Destroy() end
	copy={model=p.model,folder=Instance.new("Model"),complete=true}
	for _,part in ipairs(appearance:GetChildren()) do
		if part:IsA("MeshPart") and part.Transparency&lt;1 then -- hidden placeholder stickers are not hit shapes
			-- ponytail: until the precise shape arrives (well under a second) the part's own box stands in.
			local piece,exact=Shapes.solid(part)
			if not exact then copy.complete=false end
			piece.CFrame=p.body.CFrame:ToObjectSpace(part.CFrame);piece.Anchored=true;piece.CanQuery=true;piece.Parent=copy.folder
		end
	end
	copy.folder.Parent=world;copies[p.id]=copy
	return copy
end
function Shapes.forget(p)
	if copies[p.id] then copies[p.id].folder:Destroy();copies[p.id]=nil end
end

-- Sweep a projectile box (size, drawn with `rotation` around its travel direction) from origin along delta,
-- against target p posed at `pose`. Returns the fraction of delta travelled before touching, or nil.
-- Returns false when the target has no plane model to test (callers fall back to its body box).
function Shapes.cast(p,pose,origin,delta,size,rotation)
	local copy=copyOf(p)
	if not copy then return false end
	local from=pose:PointToObjectSpace(origin);local step=pose:VectorToObjectSpace(delta)
	if step.Magnitude&lt;1e-6 then return nil end
	params.FilterDescendantsInstances={copy.folder}
	local up=pose:VectorToObjectSpace(Vector3.yAxis)
	if math.abs(step.Unit:Dot(up))&gt;.99 then up=pose:VectorToObjectSpace(Vector3.zAxis) end
	local result=world:Blockcast(CFrame.lookAt(from,from+step,up)*rotation,size,step,params)
	return result and result.Distance/step.Magnitude
end
return Shapes
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ROJO_236">
        <Properties>
          <string name="Name">MatchService</string>
          <string name="Source">local Shared = game:GetService("ReplicatedStorage"):WaitForChild("FlyFightPaper").Shared
local Rules = require(Shared.MatchRules)
local MathUtil = require(Shared.MathUtil)
local Limits = require(Shared.Parent.Generated.Server).match_limits
local Match = {}
Match.__index = Match
-- Backpressure limits, not gameplay tuning. Never evict unacknowledged value.
Match.MAX_RETAINED_ROUNDS = Limits.retained_rounds
Match.MAX_PARTICIPANTS = Limits.participants
Match.MAX_BINDINGS = Limits.bindings
Match.MAX_EVENTS = Limits.events
Match.MAX_ACTIVITY_INTERVALS = Limits.activity_intervals
local function id(value) return type(value) == "string" and #value &gt; 0 and #value &lt;= 160 end
local function binding(identity)
    return #identity.actorId .. ":" .. identity.actorId .. #identity.participationId .. ":"
        .. identity.participationId .. #identity.lifeId .. ":" .. identity.lifeId
end
local function freeze(value)
    if type(value) == "table" and not table.isfrozen(value) then
        for _, child in pairs(value) do freeze(child) end
        table.freeze(value)
    end
    return value
end
local function detached(value) return freeze(MathUtil.copy(value)) end
function Match.new(context)
    assert(context.clock and context.config and context.economy and id(context.sessionId)
        and #context.sessionId &lt;= 96, "match context missing or session namespace too long")
    assert(type(context.combatDrainState) == "function", "trusted atomic combat drain state required")
    assert(Rules.finite(context.seed or 0) and (context.seed or 0) % 1 == 0, "invalid seed")
    assert(Rules.finite(context.economy.damage_engagement_min_actual_damage)
        and context.economy.damage_engagement_min_actual_damage &gt; 0, "invalid damage engagement threshold")
    assert(Rules.finite(context.economy.damage_engagement_idle_seconds)
        and context.economy.damage_engagement_idle_seconds &gt; 0, "invalid damage engagement idle time")
    local now = context.clock:now()
    assert(Rules.finite(now) and now &gt;= 0, "invalid clock")
    return setmetatable({ context = context, seed = context.seed or 0, serial = 0, now = now,
        phase = "READY", round = nil, retained = {}, retainedCount = 0, lastPlayed = {},
        diagnostics = { ignoredEvents = 0 } }, Match)
end
function Match:_safeNow()
    local drain = self.context.combatDrainState()
    assert(type(drain) == "table" and type(drain.blocked) == "boolean", "invalid combat drain state")
    local wall = self:_clock()
    local watermark = drain.through
    self.deliveryBlocked = drain.blocked
    assert(Rules.finite(watermark) and watermark &gt;= (self.lastWatermark or 0) and watermark &lt;= wall,
        "combat drain watermark must be monotonic and no later than clock")
    self.lastWatermark = watermark
    return math.max(self.now, watermark)
end
function Match:_clock()
    local now = self.context.clock:now()
    assert(Rules.finite(now) and now &gt;= self.now, "match clock must be monotonic")
    return now
end
function Match:startRound(mode)
    self:tick()
    if self.deliveryBlocked then return false, "combat_backlog" end
    if self.phase ~= "READY" then return false, "not_ready" end
    mode = mode or self.nextMode or "FFA"
    if not Rules.mode(mode) then return false, "invalid_mode" end
    if self.retainedCount &gt;= Match.MAX_RETAINED_ROUNDS then return false, "cleanup_required" end
    self.serial += 1
    local matchId = "match:" .. self.context.sessionId .. ":" .. self.serial
    local r = { id = matchId, mode = mode, startedAt = self.now,
        endsAt = self.now + self.context.config.rounds.duration_seconds, participants = {}, bindings = {}, lifeBounds = {},
        actorKeys = {}, participantsCount = 0, bindingsCount = 0, events = {}, eventCount = 0,
        lastSequence = 0, lastEventAt = self.now, teams = { ["team:1"] = 0, ["team:2"] = 0 },
        votes = {}, earnings = {}, damageEngagements = {}, ended = false, acknowledged = false }
    self.round, self.phase, self.nextMode = r, "ACTIVE", nil
    self.retained[matchId], self.retainedCount = r, self.retainedCount + 1
    self.lastPlayed[mode] = self.serial
    return true, matchId
end
function Match:_earned(p, points, kind, sourceId, at, identity)
    if points &lt;= 0 then return end
    table.insert(self.round.earnings, detached({ factId = self.round.id .. ":earned:" .. sourceId .. ":" .. p.key,
        matchId = self.round.id, participantKey = p.key, actorId = identity and identity.actorId or p.actorId,
        lifeId = identity and identity.lifeId or p.lifeId,
        participationId = identity and identity.participationId or p.participationId, userId = p.userId,
        controllerType = p.controllerType, mockOnly = p.mockOnly, kind = kind, points = points, at = at }))
end
function Match:_qualify(p)
    local r, bots = self.round, self.context.config.bots
    if p.controllerType ~= "human" or p.qualified then return end
    if Rules.qualified(p, bots.qualification_active_seconds, bots.qualification_combat_or_objective_events) then
        p.qualified = true

    end
end
function Match:_team()
    local counts = { ["team:1"] = 0, ["team:2"] = 0 }
    for _, p in pairs(self.round.participants) do if p.present and p.teamId then counts[p.teamId] += 1 end end
    if counts["team:1"] == counts["team:2"] then
        return Rules.seedOrder(self.seed + self.serial, "team") % 2 == 0 and "team:1" or "team:2"
    end
    return counts["team:1"] &lt; counts["team:2"] and "team:1" or "team:2"
end
-- Trusted parent only. key is persistent human identity, NOT ActorService participationId.
-- Bot keys must be distinct and never become human keys. No safe bot replacement is performed here.
function Match:join(options)
    self:tick()
    if self.deliveryBlocked then return false, "combat_backlog" end
    local r = self.round
    if self.phase ~= "ACTIVE" or not r then return false, "not_active" end
    if type(options) ~= "table" or not id(options.key) or not id(options.actorId)
        or (options.controllerType ~= "human" and options.controllerType ~= "bot") then return false, "invalid_identity" end
    if options.displayName ~= nil and (type(options.displayName) ~= "string" or #options.displayName &gt; 48) then return false, "invalid_display_name" end
    local studioMock = self.context.allowStudioTestUsers == true and game:GetService("RunService"):IsStudio()
        and Rules.finite(options.userId) and options.userId &gt;= -10000 and options.userId &lt;= 0 and options.userId % 1 == 0
    if options.controllerType == "human" and (not Rules.finite(options.userId) or options.userId % 1 ~= 0
        or options.userId &lt;= 0 and not studioMock)
        or options.controllerType == "bot" and options.userId ~= nil then return false, "invalid_account" end
    local prior = options.priorQualifyingMatches or 0
    if not Rules.finite(prior) or prior &lt; 0 or prior % 1 ~= 0 then return false, "invalid_qualification_baseline" end
    local p, count = r.participants[options.key], 0
    for _, other in pairs(r.participants) do
        if other.present then count += 1 end
        if options.controllerType == "human" and other.userId == options.userId and other.key ~= options.key then
            return false, "account_key_changed"
        end
    end
    if p and (p.controllerType ~= options.controllerType or p.userId ~= options.userId) then return false, "key_identity_changed" end
    if p and p.present then return false, "already_present" end
    if count &gt;= self.context.config.world.maximum_actors then return false, "roster_full" end
    if r.actorKeys[options.actorId] and r.actorKeys[options.actorId] ~= options.key then return false, "actor_already_bound" end
    if not p then
        if r.participantsCount &gt;= Match.MAX_PARTICIPANTS then return false, "history_full" end
        p = { key = options.key, userId = options.userId, controllerType = options.controllerType, mockOnly = studioMock,
            displayName = options.displayName or "Pilot",
            priorQualifyingMatches = prior, kills = 0, assists = 0, deaths = 0, streak = 0, bestStreak = 0,
            damage = 0, contribution = 0, propPoints = 0, objectiveSeconds = 0, objectiveEvents = 0,
            activeSeconds = 0, qualifyingEvents = 0, qualified = false, forfeited = false,
            eligibleIntervals = {}, activityIntervals = {},
            teamId = r.mode ~= "FFA" and self:_team() or nil }
        r.participants[options.key], r.participantsCount = p, r.participantsCount + 1
    end
    p.actorId, p.present, p.connected, p.sample, p.activityUntil = options.actorId, true, true, nil, self.now
    r.actorKeys[options.actorId] = p.key
    return true, detached({ matchId = r.id, participantKey = p.key, teamId = p.teamId })
end
-- Maps immutable damage identities, including prior actors/lives, back to retained participant history.
-- Composition-only synchronous reservation. Validation runs on a private admission draft,
-- never on the real participant. The integrator holds exclusive nonyielding ownership
-- between reserve and commit/rollback; arbitrary external callbacks are not transactional.
function Match:lifeStarted(facts)
    self:tick()
    if self.deliveryBlocked then return false, "combat_backlog" end
    local r = self.round
    if self.phase ~= "ACTIVE" or type(facts) ~= "table" or facts.matchId ~= r.id then return false, "wrong_match" end
    local p = r.participants[r.actorKeys[facts.actorId]]
    if not p or not p.present or p.actorId ~= facts.actorId or not id(facts.lifeId) or not id(facts.participationId) then return false, "unknown_identity" end
    local bindingKey = binding(facts)
    if r.bindings[bindingKey] then return true end
    if r.bindingsCount &gt;= Match.MAX_BINDINGS then return false, "bindings_full" end
    r.bindings[bindingKey], r.bindingsCount = p.key, r.bindingsCount + 1
    r.lifeBounds[bindingKey] = { startedAt = self.now }
    if p.lifeId ~= facts.lifeId then
        self:_stopActivity(p)
        p.streak, p.activityUntil, p.sample = 0, self.now, nil
    end
    p.lifeId, p.participationId = facts.lifeId, facts.participationId
    return true
end
function Match:_identity(identity)
    local r = self.round
    if type(identity) ~= "table" or identity.matchId ~= r.id or not id(identity.actorId)
        or not id(identity.participationId) or not id(identity.lifeId) then return nil end
    local key = r.bindings[binding(identity)]
    local p = key and r.participants[key]
    if p and p.teamId == identity.teamId then return p end
    return nil
end
-- Refold is a SAME-life delivery, including a legal loadout change. It never resets streak.
function Match:_hookIdentity(facts)
    local r = self.round
    if not r or type(facts) ~= "table" or facts.matchId ~= r.id or not id(facts.actorId)
        or not id(facts.participationId) or not id(facts.lifeId) then return nil end
    return r.participants[r.bindings[binding(facts)]]
end
function Match:_stopActivity(p)
    if p.lifeId then
        local key = binding({actorId=p.actorId,participationId=p.participationId,lifeId=p.lifeId})
        local bounds = self.round.lifeBounds[key]
        if bounds then bounds.endedAt = self.now end
    end
    for i = #p.activityIntervals, 1, -1 do
        local span = p.activityIntervals[i]
        span[2] = math.min(span[2], self.now)
        if span[2] &lt;= span[1] then table.remove(p.activityIntervals, i) end
    end
end
-- Non-crediting ActorService hook. DamageService lifeEnded must be delivered separately.
function Match:lifeEnded(facts)
    self:tick()
    if self.deliveryBlocked then return false, "combat_backlog" end
    local p = self:_hookIdentity(facts)
    if not p then return false, "unknown_identity" end
    if p.lifeId == facts.lifeId then
        self:_stopActivity(p)
        p.streak, p.sample, p.activityUntil = 0, nil, self.now
    end
    return true
end
function Match:_depart(key)
    self:tick()
    if self.deliveryBlocked then return false, "combat_backlog" end
    if self.phase == "ENDING" then return false, "awaiting_results" end
    local r = self.round
    local p = r and r.participants[key]
    if not p then return false, "unknown_participant" end
    self:_stopActivity(p)
    p.present, p.connected, p.forfeited, p.streak, p.sample = false, false, true, 0, nil
    p.activityUntil = self.now
    r.votes[key] = nil
    return true
end
function Match:withdraw(key) return self:_depart(key) end
function Match:disconnect(key) return self:_depart(key) end
-- Parent samples authoritative state at transitions and BEFORE advancing simulation time.
-- Samples are held piecewise constant; tick never guesses historical positions from a current pose.
function Match:observe(key, sample)
    self:tick()
    if self.deliveryBlocked then return false, "combat_backlog" end
    local p = self.round and self.round.participants[key]
    if self.phase ~= "ACTIVE" or not p or not p.present or not p.lifeId then return false, "not_active" end
    if type(sample) ~= "table" or type(sample.eligible) ~= "boolean" or type(sample.protected) ~= "boolean"
        or type(sample.state) ~= "string" then return false, "invalid_sample" end
    p.sample = MathUtil.copy(sample)
    return true
end
-- Validated, materially changed aim/boost/control action, not repeated packets or menu toggles.
function Match:controlActivity(key)
    self:tick()
    if self.deliveryBlocked then return false, "combat_backlog" end
    local p = self.round and self.round.participants[key]
    if self.phase ~= "ACTIVE" or not p or not p.present or not Rules.activeEligible(p.sample)
        or p.sample.overlay == true then return false end
    self:_activity(p, self.now)
    return true
end
local function interval(list, first, last)
    if last &lt;= first then return end
    table.insert(list, { first, last })
    table.sort(list, function(a, b) return a[1] &lt; b[1] end)
    local merged = {}
    for _, span in ipairs(list) do
        local previous = merged[#merged]
        if previous and previous[2] &gt;= span[1] then previous[2] = math.max(previous[2], span[2])
        else table.insert(merged, span) end
    end
    assert(#merged &lt;= Match.MAX_ACTIVITY_INTERVALS, "activity history full; parent must stop dispatch")
    table.clear(list)
    for _, span in ipairs(merged) do table.insert(list, span) end
end
function Match:_activeSeconds(p, horizon)
    local i, j, seconds = 1, 1, 0
    local cutoff = self.round.cutoffAt or horizon or self.now
    while i &lt;= #p.eligibleIntervals and j &lt;= #p.activityIntervals do
        local a, b = p.eligibleIntervals[i], p.activityIntervals[j]
        seconds += math.max(0, math.min(a[2], b[2], cutoff) - math.max(a[1], b[1]))
        if a[2] &lt;= b[2] then i += 1 else j += 1 end
    end
    p.activeSeconds = seconds
end
function Match:_activity(p, at, identity)
    -- Retained eligible intervals make delayed authoritative activity count only where the
    -- participant was actually eligible, even after withdrawal. No retroactive menu credit.
    identity = identity or {actorId=p.actorId,participationId=p.participationId,lifeId=p.lifeId}
    local bounds = self.round.lifeBounds[binding(identity)]
    local last = math.min(at + Rules.ACTIVITY_WINDOW_SECONDS, bounds and bounds.endedAt or math.huge)
    interval(p.activityIntervals, at, last)
    p.activityUntil = math.max(p.activityUntil, last)
    self:_activeSeconds(p)
end
-- One directed engagement per immutable pair of life bindings.
function Match:_damageEngagement(event)
    local r, e = self.round, self.context.economy
    local attackerKey, victimKey = binding(event.attacker), binding(event.victim)
    local pair = #attackerKey .. ":" .. attackerKey .. victimKey
    local engagement = r.damageEngagements[pair]
    if not engagement or event.at - engagement.lastHitAt &gt;= e.damage_engagement_idle_seconds then
        engagement = { damage = 0, lastHitAt = event.at, qualified = false }
        r.damageEngagements[pair] = engagement
    end
    engagement.lastHitAt = event.at
    -- Saturate after reaching the threshold. Held fire refreshes the gap without
    -- adding another qualification or growing a damage accumulator indefinitely.
    engagement.damage = math.min(e.damage_engagement_min_actual_damage, engagement.damage + event.amount)
    if not engagement.qualified and engagement.damage &gt;= e.damage_engagement_min_actual_damage then
        engagement.qualified = true
        return true
    end
    return false
end
-- Sole combat sink: detached, trusted DamageService facts. Never connect this method to a RemoteEvent.
function Match:consumeCombat(event)
    local r = self.round
    if type(event) ~= "table" or not id(event.eventId) then return false, "invalid_event" end
    if not r then return true, "retired_match" end
    if not event.victim or event.victim.matchId ~= r.id then return true, "foreign_or_retired_match" end
    if r.events[event.eventId] then return true, "duplicate" end
    if not Rules.finite(event.serverSequence) or event.serverSequence &lt; 1 or event.serverSequence % 1 ~= 0
        or not Rules.finite(event.at) or event.at &lt; r.startedAt or event.at &gt; self:_clock() then return false, "invalid_order" end
    if event.serverSequence &lt;= r.lastSequence then return true, "sequence_replay" end
    if event.at &lt; r.lastEventAt then return false, "out_of_order" end
    if event.kind ~= "weaponDamage" and event.kind ~= "lifeEnded" then return false, "unsupported_event" end
    if r.eventCount &gt;= Match.MAX_EVENTS then return false, "event_history_full" end
    local victim = self:_identity(event.victim)
    local attacker = event.kind == "weaponDamage" and self:_identity(event.attacker) or nil
    local killer = event.killer and self:_identity(event.killer) or nil
    if not victim or event.kind == "weaponDamage" and (not attacker or attacker == victim
        or attacker.teamId ~= nil and attacker.teamId == victim.teamId or not Rules.finite(event.amount) or event.amount &lt;= 0)
        or event.killer and not killer then return false, "unbound_identity" end
    if killer and (killer == victim or killer.teamId ~= nil and killer.teamId == victim.teamId) then return false, "friendly_credit" end
    if event.kind == "weaponDamage" then
        for _, identity in ipairs({ event.attacker, event.victim }) do
            local bounds = r.lifeBounds[binding(identity)]
            if not bounds or event.at &lt; bounds.startedAt or bounds.endedAt and event.at &gt; bounds.endedAt
                or bounds.combatEnded then return false, "outside_damage_life:"..identity.actorId..":"..identity.lifeId end
        end
    end
    local assists, assistIdentities = {}, {}
    for _, identity in ipairs(event.assists or {}) do
        local p = self:_identity(identity)
        if not p then return false, "unbound_assist" end
        if p ~= killer and p ~= victim then assists[p.key], assistIdentities[p.key] = p, identity end
    end
    -- Never score at the exact timer boundary. Advance time before applying ordered event.
    self:_advance(math.max(self.now, event.at))
    r.events[event.eventId], r.eventCount = true, r.eventCount + 1
    r.lastSequence, r.lastEventAt = event.serverSequence, event.at
    if r.ended or r.cutoffAt and (event.at &gt;= r.cutoffAt and r.endReason == "timer"
        or r.cutoffSequence and event.serverSequence &gt; r.cutoffSequence) then
        self.diagnostics.ignoredEvents += 1; return true, "scoring_closed"
    end
    if event.kind == "weaponDamage" then
        attacker.damage += event.amount
        -- Each new pair consumes an accepted event, so MAX_EVENTS bounds this
        -- round-local map. Retained-round cleanup releases it with the history.
        if self:_damageEngagement(event) then attacker.qualifyingEvents += 1 end
        self:_activity(attacker, event.at, event.attacker); self:_qualify(attacker)
    else
        r.lifeBounds[binding(event.victim)].combatEnded = true
        if event.reason ~= "fresh_plane" and event.reason ~= "round_end" then victim.deaths += 1 end
        if victim.lifeId == event.victim.lifeId then
            self:_stopActivity(victim)
            victim.streak, victim.sample = 0, nil
        end
        if killer and killer ~= victim then
            killer.kills += 1
            local killerBounds = r.lifeBounds[binding(event.killer)]
            if killer.present and killer.lifeId == event.killer.lifeId and killerBounds and killerBounds.endedAt == nil then
                killer.streak += 1; killer.bestStreak = math.max(killer.bestStreak, killer.streak)
            end
            killer.contribution += self.context.economy.points.elimination
            self:_earned(killer, self.context.economy.points.elimination, "elimination", event.eventId, event.at, event.killer)
            killer.qualifyingEvents += 1; self:_activity(killer, event.at, event.killer); self:_qualify(killer)
            if r.mode == "TDM" then r.teams[killer.teamId] += 1 end
        end
        for _, p in pairs(assists) do
            p.assists += 1; p.contribution += self.context.economy.points.assist
            self:_earned(p, self.context.economy.points.assist, "assist", event.eventId, event.at, assistIdentities[p.key])
            p.qualifyingEvents += 1; self:_activity(p, event.at, assistIdentities[p.key]); self:_qualify(p)
        end
        local target = r.mode == "FFA" and self.context.config.rounds.ffa_elimination_target
            or r.mode == "TDM" and self.context.config.rounds.tdm_elimination_target or math.huge
        local score = r.mode == "FFA" and killer and killer.kills or r.mode == "TDM" and killer and r.teams[killer.teamId] or 0
        if score &gt;= target then self:_close(event.at, "target", event.serverSequence) end
    end
    return true
end
-- Trusted world prop facts are score only; never qualify activity or rookie participation.
function Match:propContribution(eventId, key, occurrence)
    -- The trusted prop outbox bypasses tick/backpressure, just like consumeCombat.
    -- Parent holds the watermark and departure/settlement until BOTH outboxes drain.
    if not occurrence then
        self:tick()
        if self.deliveryBlocked then return false, "combat_backlog" end
    end
    local r, e = self.round, self.context.economy
    local p = r and r.participants[key]
    if not p or not id(eventId) then return false end
    if r.events[eventId] then return true end
    local at, identity = self.now, nil
    if occurrence then
        if type(occurrence) ~= "table" or not table.isfrozen(occurrence) or occurrence.eventId ~= eventId
            or occurrence.participantKey ~= key or occurrence.kind ~= "small_prop"
            or not Rules.finite(occurrence.at) or occurrence.at &lt; r.startedAt or occurrence.at &gt; self:_clock()
            or not Rules.finite(occurrence.afterCombatSequence) or occurrence.afterCombatSequence &lt; 0
            or occurrence.afterCombatSequence % 1 ~= 0 or self:_identity(occurrence) ~= p then return false, "invalid_occurrence" end
        local bounds = r.lifeBounds[binding(occurrence)]
        if not bounds or occurrence.at &lt; bounds.startedAt
            or bounds.endedAt and occurrence.at &gt; bounds.endedAt then return false, "outside_life" end
        if r.ended then return false, "settlement_already_sealed" end
        at, identity = occurrence.at, occurrence
    elseif self.phase ~= "ACTIVE" or not p.present then return false end
    if r.eventCount &gt;= Match.MAX_EVENTS then return false, "event_history_full" end
    if occurrence and (at &gt;= r.endsAt or r.cutoffAt and (at &gt; r.cutoffAt or at == r.cutoffAt
        and (r.endReason == "timer" or occurrence.afterCombatSequence &gt;= (r.cutoffSequence or 0)))) then
        r.events[eventId], r.eventCount = true, r.eventCount + 1
        return true, "scoring_closed"
    end
    -- Stage one earning before committing score/dedupe. A sink wrapper may throw either
    -- before or after _earned inserts. Keep the original receipt and never insert twice.
    local receipt = r.propDelivery
    if receipt and (receipt.eventId ~= eventId or receipt.key ~= key) then return false, "prop_backlog" end
    if not receipt then
        receipt = {eventId=eventId,key=key,at=at,identity=identity,earningIndex=#r.earnings+1,
            points=math.max(0,math.min(e.points.prop,e.points.prop_points_max_per_participation-p.propPoints))}
        r.propDelivery = receipt
    end
    local points, earned = receipt.points, false
    local factId = r.id .. ":earned:" .. eventId .. ":" .. p.key
    for i=receipt.earningIndex,#r.earnings do
        if r.earnings[i].factId == factId then earned = true; break end
    end
    if points &gt; 0 and not earned then self:_earned(p,points,"prop",eventId,receipt.at,receipt.identity) end
    p.propPoints += points; p.contribution += points
    r.events[eventId], r.eventCount = true, r.eventCount + 1
    r.propDelivery = nil
    return true
end
function Match:_occupants()
    local teams, occupants = {}, {}
    if self.round.mode ~= "CONTROL" then return nil, occupants end
    for _, p in pairs(self.round.participants) do
        if p.present and p.connected and p.lifeId and Rules.captureEligible(p.sample, self.context.config.rounds) then
            teams[p.teamId] = true; table.insert(occupants, p)
        end
    end
    if teams["team:1"] and teams["team:2"] then return nil, {} end
    return teams["team:1"] and "team:1" or teams["team:2"] and "team:2" or nil, occupants
end
function Match:_activeInterval(untilAt)
    local r, config, e = self.round, self.context.config, self.context.economy
    local team, occupants = self:_occupants()
    local finish = math.min(untilAt, r.endsAt)
    if team then
        finish = math.min(finish, self.now + (config.rounds.control_target - r.teams[team]) / config.rounds.control_points_per_second)
    end
    local dt = math.max(0, finish - self.now)
    for _, p in pairs(r.participants) do
        if p.present and p.connected and Rules.activeEligible(p.sample) then
            interval(p.eligibleIntervals, self.now, finish)
        end
    end
    if team then
        r.teams[team] = math.min(config.rounds.control_target, r.teams[team] + dt * config.rounds.control_points_per_second)
        for _, p in ipairs(occupants) do
            local before = p.objectiveEvents
            p.objectiveSeconds += dt
            p.objectiveEvents = math.floor((p.objectiveSeconds + 1e-8) / 10)
            local events = p.objectiveEvents - before
            p.qualifyingEvents += events
            local points = math.min(events * e.points.control_per_10_eligible_seconds,
                math.max(0, e.control_personal_points_max_per_match - before * e.points.control_per_10_eligible_seconds))
            p.contribution += points
            for i = before + 1, p.objectiveEvents do
                local earned = math.min(e.points.control_per_10_eligible_seconds,
                    math.max(0, e.control_personal_points_max_per_match - (i-1) * e.points.control_per_10_eligible_seconds))
                local at = finish - (p.objectiveSeconds - i * 10)
                self:_earned(p, earned, "objective", "objective:" .. i, at)
            end
            interval(p.activityIntervals, self.now, finish)
        end
    end
    for _, p in pairs(r.participants) do
        self:_activeSeconds(p, finish)
        self:_qualify(p)
    end
    self.now = finish
    if team and r.teams[team] &gt;= config.rounds.control_target then self:_close(finish, "target", r.lastSequence)
    elseif finish &gt;= r.endsAt then self:_close(finish, "timer") end
end
function Match:_close(at, reason, sequence)
    local r = self.round
    if r.ended or r.cutoffAt and at &gt;= r.cutoffAt then return end
    r.cutoffAt, r.endReason, r.cutoffSequence, self.phase = at, reason, sequence, "ENDING"
    -- A delayed target may move a timer cutoff earlier. Recompute active time against it.
    for _, p in pairs(r.participants) do self:_activeSeconds(p) end
end
-- Parent must flush the complete ordered DamageService outbox, stop old combat dispatch and
-- call this with the last delivered sequence. No economic result exists before this barrier.
function Match:sealCombatDrain(matchId, lastDeliveredSequence)
    local r = self.round
    if not r or r.id ~= matchId then return false, "wrong_match" end
    if r.ended then return true end
    if self.phase ~= "ENDING" or lastDeliveredSequence ~= r.lastSequence then return false, "drain_not_confirmed" end
    self:_safeNow()
    if self.deliveryBlocked then return false, "combat_backlog" end
    self:_end(r.cutoffAt, r.endReason)
    self:_advance(self:_clock())
    return true
end
function Match:_end(at, reason)
    local r, e = self.round, self.context.economy
    if r.ended then return end
    r.ended, r.endedAt, self.phase = true, at, "RESULTS" -- Close scoring BEFORE snapshot or external sink.
    self.phaseEndsAt = self:_clock() + self.context.config.rounds.results_seconds
    local winners, winningTeam, draw = {}, nil, false
    if r.mode == "FFA" then
        local best = -1
        for _, p in pairs(r.participants) do if p.present and not p.forfeited then best = math.max(best, p.kills) end end
        for _, p in pairs(r.participants) do if p.present and not p.forfeited and p.kills == best then winners[p.key] = true end end
    elseif r.teams["team:1"] == r.teams["team:2"] then draw = true
    else winningTeam = r.teams["team:1"] &gt; r.teams["team:2"] and "team:1" or "team:2" end
    local podiumRecords = {}
    for key, p in pairs(r.participants) do
        if p.present and (r.mode == "FFA" or p.teamId == winningTeam) then podiumRecords[key] = p end
        if p.present and p.teamId ~= nil and p.teamId == winningTeam then winners[key] = true end
    end
    local order, places = Rules.podium(podiumRecords, self.seed + self.serial), {}
    for place, p in ipairs(order) do places[p.key] = place end
    local rows = {}
    for _, p in ipairs(Rules.podium(r.participants, self.seed + self.serial)) do
        local row = MathUtil.copy(p)
        row.sample, row.activityUntil, row.eligibleIntervals, row.activityIntervals = nil, nil, nil, nil
        local eligible = p.present and not p.forfeited
            and Rules.qualified(p, e.completion_min_active_seconds, e.completion_min_qualifying_events)
        local win, place = eligible and winners[p.key] == true, places[p.key]
        local podium = eligible and not draw and place and place &lt;= 3
        row.place, row.victory, row.completion = place, winners[p.key] == true, eligible
        row.finalPaper = (eligible and e.completion_paper or 0) + (win and e.win_paper or 0)
            + (podium and e.podium_paper_by_place[place] or 0)
        row.finalXP = (eligible and e.completion_xp or 0) + (win and e.win_xp or 0)
            + (podium and e.podium_xp_by_place[place] or 0)
        -- Bots occupy real places and receive the same calculated rates; bots never get persistent wallets.
        table.insert(rows, row)
    end
    r.result = detached({ matchId = r.id, mode = r.mode, reason = reason, endedAt = at,
        teams = r.teams, draw = draw, winningTeam = winningTeam, participants = rows })
    r.settlementId = r.id .. ":final"
end
function Match:_advance(untilAt)
    while self.now &lt; untilAt do
        if self.phase == "ACTIVE" then self:_activeInterval(untilAt)
        elseif self.phase == "RESULTS" or self.phase == "VOTE" or self.phase == "COUNTDOWN" then
            self.now = math.min(untilAt, self.phaseEndsAt)
            if self.now &gt;= self.phaseEndsAt then
                if self.phase == "RESULTS" then
                    self.phase = "VOTE"; self.phaseEndsAt += self.context.config.rounds.vote_seconds
                elseif self.phase == "VOTE" then
                    self.nextMode = Rules.chooseMode(self.round.votes, self.lastPlayed, self.seed + self.serial)
                    self.phase = "COUNTDOWN"; self.phaseEndsAt += self.context.config.rounds.launch_countdown_seconds
                else self.phase, self.phaseEndsAt = "READY", nil end
            end
        else self.now = untilAt end
    end
end
function Match:tick() self:_advance(self:_safeNow()); return self.phase end
function Match:vote(key, mode)
    self:tick()
    if self.deliveryBlocked then return false, "combat_backlog" end
    local p = self.round and self.round.participants[key]
    if self.phase ~= "VOTE" or not p or not p.present or not p.connected or p.controllerType ~= "human"
        or not Rules.mode(mode) then return false, "ineligible_vote" end
    self.round.votes[key] = mode
    return true
end
-- SERVER-INTERNAL ONLY: account linkage, controller type and activity evidence are private.
function Match:snapshot()
    local r = self.round
    return detached({ phase = self.phase, now = self.now, phaseEndsAt = self.phaseEndsAt,
        nextMode = self.nextMode, matchId = r and r.id, mode = r and r.mode, teams = r and r.teams,
        participants = r and r.participants, votes = r and r.votes, result = r and r.result })
end
local function publicPilot(p)
    return { actorId = p.actorId, displayName = p.displayName, teamId = p.teamId,
        kills = p.kills, assists = p.assists, deaths = p.deaths, contribution = p.contribution,
        place = p.place, victory = p.victory, completion = p.completion }
end
function Match:publicSnapshot()
    local r, pilots, votes, results = self.round, {}, { FFA = 0, TDM = 0, CONTROL = 0 }, nil
    if r then
        for _, p in pairs(r.participants) do if p.present then table.insert(pilots, publicPilot(p)) end end
        table.sort(pilots, function(a, b) return a.actorId &lt; b.actorId end)
        assert(#pilots &lt;= self.context.config.world.maximum_actors, "public roster overflow")
        for _, mode in pairs(r.votes) do votes[mode] += 1 end
        if r.result then
            local rows = {}
            for _, p in ipairs(r.result.participants) do if p.present then table.insert(rows, publicPilot(p)) end end
            assert(#rows &lt;= self.context.config.world.maximum_actors, "public results overflow")
            results = { participants = rows, draw = r.result.draw, winningTeam = r.result.winningTeam,
                endedAt = r.result.endedAt, reason = r.result.reason }
        end
    end
    return detached({ matchId = r and r.id, mode = r and r.mode, phase = self.phase,
        phaseEndsAt = self.phaseEndsAt, nextMode = self.nextMode, pilots = pilots,
        voteTotals = votes, teams = r and r.teams, result = results })
end
function Match:acknowledgeSettlement(matchId, settlementId)
    local r = self.retained[matchId]
    if not r or settlementId ~= r.settlementId then return false, "wrong_settlement" end
    r.acknowledged = true
    return true
end
-- Round cleanup follows reward handoff and the end of all lives and shots.
function Match:cleanup(matchId, prerequisites)
    local r = self.retained[matchId]
    if not r or not r.ended or not r.acknowledged then return false, "unsettled" end
    if r == self.round and self.phase ~= "READY" then return false, "lifecycle_in_use" end
    if type(prerequisites) ~= "table" or prerequisites.upstreamDrained ~= true
        or prerequisites.livesEnded ~= true or prerequisites.replayBarrier ~= true then return false, "cleanup_prerequisites" end
    self.retained[matchId], self.retainedCount = nil, self.retainedCount - 1
    if r == self.round then self.round = nil end
    return true
end
return Match
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ROJO_237">
        <Properties>
          <string name="Name">Matchmaking</string>
          <string name="Source">local Run=game:GetService("RunService")
local Gameplay=require(game.ReplicatedStorage.FlyFightPaper.Generated.Gameplay)
local Config=require(game.ReplicatedStorage.FlyFightPaper.Generated.Server).routing
local Service={};Service.__index=Service
function Service.classFor(profile)
 return profile and profile.qualification and profile.qualification.count&gt;=Gameplay.bots.rookie_qualifying_matches and "regular" or "rookie"
end
function Service.new(profiles,options)
 options=options or {}
 local mock=options.mock;if mock==nil then mock=Run:IsStudio() or game.PlaceId==0 end
 local self=setmetatable({profiles=profiles,mock=mock,transfers={},loading=not mock},Service)
 if not mock then
  self.platform=options.platform or require(script.Parent.MatchmakingAdapter).new()
  self.platform:onFailure(function(player)self:failed(player)end)
  task.spawn(function()
   local attempt=0
   while self.loading or self.unavailable do
    attempt+=1
    local ok,class=pcall(function()return self.platform:currentClass()end)
    if ok then self.class=class;self.loading=false;self.unavailable=false;return end
    if attempt&gt;=Config.discovery_failure_attempts then self.loading=false;self.unavailable=true end
    task.wait(math.min(Config.discovery_retry_max_seconds,2^math.min(attempt-1,Config.discovery_retry_exponent_cap)))
   end
  end)
  task.spawn(function()
   while true do
    if self.class then pcall(function()self.platform:advertise(self.class)end) end
    task.wait(Config.advertise_seconds)
   end
  end)
 end
 return self
end
function Service:failed(player)
 if not self.transfers[player] then return end
 self.transfers[player]=nil;player:SetAttribute("Routing",false)
 player:SetAttribute("MenuMessage","Room transfer failed. Your saved progress is safe. Try Play again.")
 if player.Parent and not self.profiles.entries[player] then self.profiles:load(player) end
end
function Service:admit(player)
 local profile=self.profiles:view(player);if not profile or self.transfers[player] then return false end
 if self.loading or self.unavailable then player:SetAttribute("MenuMessage","Room matching is unavailable. Stay in the menu and try Play again shortly.");return false end
 local class=Service.classFor(profile)
 if not self.class then self.class=class end
 if class==self.class then return true end
 if self.mock then player:SetAttribute("MenuMessage","Studio keeps beginner and established rooms separate. Start a new Play session to test the other room.");return false end
 self.transfers[player]=true;player:SetAttribute("Routing",true);player:SetAttribute("MenuMessage","Finding a room for your experience level. Saving before the transfer.")
 task.spawn(function()
  local ok,destination=pcall(function()return self.platform:destination(class)end)
  if not ok then self:failed(player);return end
  local e=self.profiles.entries[player]
  if not e then self:failed(player);return end
  self.profiles:release(player)
  -- Wait for ProfileStore to confirm the final save before transferring.
  while self.profiles.entries[player] and player.Parent do task.wait(Config.transfer_poll_seconds) end
  if not player.Parent then self.transfers[player]=nil;return end
  local sent=pcall(function()self.platform:send(player,destination)end)
  if not sent then self:failed(player) end
 end)
 return false
end
return Service
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ROJO_238">
        <Properties>
          <string name="Name">MatchmakingAdapter</string>
          <string name="Source">-- Roblox supplies server discovery and transfers. Access codes remain server-only.
local Players=game:GetService("Players")
local Memory=game:GetService("MemoryStoreService")
local Teleport=game:GetService("TeleportService")
local Config=require(game.ReplicatedStorage.FlyFightPaper.Generated.Server).routing
local Gameplay=require(game.ReplicatedStorage.FlyFightPaper.Generated.Gameplay)
local Adapter={};Adapter.__index=Adapter
function Adapter.new()
 return setmetatable({index=Memory:GetSortedMap("PPD_DEV_room_index"),maps={rookie=Memory:GetSortedMap("PPD_DEV_rookie_rooms"),regular=Memory:GetSortedMap("PPD_DEV_regular_rooms")}},Adapter)
end
function Adapter:currentClass()
 if game.PrivateServerId=="" then return nil end
 local row=self.index:GetAsync(game.PrivateServerId)
 assert(row and (row.class=="rookie" or row.class=="regular"),"Reserved room class unavailable")
 self.row=row;return row.class
end
function Adapter:advertise(class)
 local row=self.row or {jobId=game.JobId}
 row.class=class;row.count=#Players:GetPlayers();row.updatedAt=os.time()
 local key=game.PrivateServerId~="" and game.PrivateServerId or game.JobId
 self.maps[class]:SetAsync(key,row,Config.entry_ttl_seconds,row.count)
 if game.PrivateServerId~="" then self.index:SetAsync(key,row,Config.entry_ttl_seconds,row.count) end
end
function Adapter:destination(class)
 for _,entry in ipairs(self.maps[class]:GetRangeAsync(Enum.SortDirection.Ascending,Config.destination_scan_limit)) do
  local row=entry.value
  if type(row)=="table" and row.class==class and type(row.count)=="number" and row.count&lt;Gameplay.world.maximum_actors and type(row.updatedAt)=="number" and os.time()-row.updatedAt&lt;Config.entry_fresh_seconds then
   if entry.key~=game.PrivateServerId and ((type(row.accessCode)=="string" and #row.accessCode&gt;0) or (type(row.jobId)=="string" and #row.jobId&gt;0 and row.jobId~=game.JobId)) then return row end
  end
 end
 local code,id=Teleport:ReserveServerAsync(game.PlaceId)
 local row={class=class,accessCode=code,count=0,updatedAt=os.time()}
 self.index:SetAsync(id,row,Config.entry_ttl_seconds,0);self.maps[class]:SetAsync(id,row,Config.entry_ttl_seconds,0)
 return row
end
function Adapter:send(player,destination)
 local options=Instance.new("TeleportOptions")
 if destination.accessCode then options.ReservedServerAccessCode=destination.accessCode else options.ServerInstanceId=destination.jobId end
 Teleport:TeleportAsync(game.PlaceId,{player},options)
end
function Adapter:onFailure(callback)
 return Teleport.TeleportInitFailed:Connect(function(player)callback(player)end)
end
return Adapter
</string>
        </Properties>
      </Item>
      <Item class="Folder" referent="ROJO_239">
        <Properties>
          <string name="Name">Packages</string>
        </Properties>
        <Item class="ModuleScript" referent="ROJO_240">
          <Properties>
            <string name="Name">ProfileStore</string>
            <string name="Source">--[[
MAD STUDIO (by loleris)

-[ProfileStore]---------------------------------------

	Periodic DataStore saving solution with session locking
	
	WARNINGS FOR "Profile.Data" VALUES:
	 	! Do not create numeric tables with gaps - attempting to store such tables will result in an error.
		! Do not create mixed tables (some values indexed by number and others by a string key)
			- only numerically indexed  data will be stored.
		! Do not index tables by anything other than numbers and strings.
		! Do not reference Roblox Instances
		! Do not reference userdata (Vector3, Color3, CFrame...) - Serialize userdata before referencing
		! Do not reference functions
		
	Members:
	
		ProfileStore.IsClosing          [bool]
			-- Set to true after a game:BindToClose() trigger
			
		ProfileStore.IsCriticalState    [bool]
			-- Set to true when ProfileStore experiences too many consecutive errors
		
		ProfileStore.OnError            [Signal] (message, store_name, profile_key)
			-- Most ProfileStore errors will be caught and passed to this signal
			
		ProfileStore.OnOverwrite        [Signal] (store_name, profile_key)
			-- Triggered when a DataStore key was likely used to store data that wasn't
			a ProfileStore profile or the ProfileStore structure was invalidly manually
			altered for that DataStore key
			
		ProfileStore.OnCriticalToggle   [Signal] (is_critical)
			-- Triggered when ProfileStore experiences too many consecutive errors
		
		ProfileStore.DataStoreState     [string] ("NotReady", "NoInternet", "NoAccess", "Access")
			-- This value resembles ProfileStore's access to the DataStore; The value starts
			as "NotReady" and will eventually change to one of the other 3 possible values.
	
	Functions:
	
		ProfileStore.New(store_name, template?) --&gt; [ProfileStore]
			store_name   [string] -- DataStore name
			template     [table] or nil -- Profiles will default to given table (hard-copy) when no data was saved previously
			
		ProfileStore.SetConstant(name, value)
			name    [string]
			value   [number]
				
	Members [ProfileStore]:
	
		ProfileStore.Mock   [ProfileStore]
			-- Reflection of ProfileStore methods, but the methods will now query a mock
			DataStore with no relation to the real DataStore
			
		ProfileStore.Name   [string]
		
	Methods [ProfileStore]:
	
		ProfileStore:StartSessionAsync(profile_key, params?) --&gt; [Profile] or nil
			profile_key [string] -- DataStore key
			params      nil or [table]: -- Custom params; E.g. {Steal = true}
				{
					Steal = true, -- Pass this to disregard an existing session lock
					Cancel = fn() -&gt; (boolean), -- Pass this to create a request cancel condition.
						-- If the cancel function returns true, ProfileStore will stop trying to
						-- start the session and return nil
				}
			
		ProfileStore:MessageAsync(profile_key, message) --&gt; is_success [bool]
			profile_key [string] -- DataStore key
			message     [table] -- Data to be messaged to the profile
			
		ProfileStore:GetAsync(profile_key, version?) --&gt; [Profile] or nil
			-- Reads a profile without starting a session - will not autosave
			profile_key   [string] -- DataStore key
			version       nil or [string] -- DataStore key version

		ProfileStore:VersionQuery(profile_key, sort_direction?, min_date?, max_date?) --&gt; [VersionQuery]
			profile_key      [string]
			sort_direction   nil or [Enum.SortDirection]
			min_date         nil or [DateTime]
			max_date         nil or [DateTime]
			
		ProfileStore:RemoveAsync(profile_key) --&gt; is_success [bool]
			-- Completely removes profile data from the DataStore / mock DataStore with no way to recover it.

	Methods [VersionQuery]:

		VersionQuery:NextAsync() --&gt; [Profile] or nil -- (Yields)
			-- Returned profile is similar to profiles returned by ProfileStore:GetAsync()
		
	Members [Profile]:
	
		Profile.Data               [table]
			-- When the profile is active changes to this table are guaranteed to be saved
		Profile.LastSavedData      [table] (Read-only)
			-- Last snapshot of "Profile.Data" that has been successfully saved to the DataStore;
			Useful for proper developer product purchase receipt handling
		
		Profile.FirstSessionTime   [number] (Read-only)
			-- os.time() timestamp of the first profile session
			
		Profile.SessionLoadCount   [number] (Read-only) -- Amount of times a session was started for this profile
			
		Profile.Session            [table] (Read-only) {PlaceId = number, JobId = string} / nil
			-- Set to a table if this profile is in use by a server; nil if released

		Profile.RobloxMetaData     [table] -- Writable table that gets saved automatically and once the profile is released
		Profile.UserIds            [table] -- (Read-only) -- {user_id [number], ...} -- User ids associated with this profile

		Profile.KeyInfo            [DataStoreKeyInfo] -- Changes before OnAfterSave signal
		
		Profile.OnSave             [Signal] ()
			-- Triggered right before changes to Profile.Data are saved to the DataStore
			
		Profile.OnLastSave         [Signal] (reason [string]: "Manual", "External", "Shutdown")
			-- Triggered right before changes to Profile.Data are saved to the DataStore
			for the last time; A reason is provided for the last save:
				- "Manual"   - Profile:EndSession() was called
				- "Shutdown" - The server that has ownership of this profile is shutting down
				- "External" - Another server has started a session for this profile
			Note that this event will not trigger for when a profile session is ended by
			another server trying to take ownership of the session - this is impossible to
			do without compromising on ProfileStore's speed.
			
		Profile.OnSessionEnd       [Signal] ()
			-- Triggered when the profile session is terminated on this server
		
		Profile.OnAfterSave        [Signal] (last_saved_data)
			-- Triggered after a successful save
			last_saved_data [table] -- Profile.LastSavedData
			
		Profile.ProfileStore       [ProfileStore] -- ProfileStore object this profile belongs to
		Profile.Key                [string] -- DataStore key
		
	Methods [Profile]:
	
		Profile:IsActive() --&gt; [bool] -- If "true" is returned, changes to Profile.Data are guaranteed to save;
			This guarantee is only valid until code yields (e.g. task.wait() is used).
			
		Profile:Reconcile() -- Fills in missing (nil) [string_key] = [value] pairs to the Profile.Data structure
			from the "template" argument that was passed to "ProfileStore.New()"
			
		Profile:EndSession() -- Call after the server has finished working with this profile
			e.g., after the player leaves (Profile object will become inactive)

		Profile:AddUserId(user_id) -- Associates user_id with profile (GDPR compliance)
			user_id   [number]

		Profile:RemoveUserId(user_id) -- Removes user_id association with profile (safe function)
			user_id   [number]
			
		Profile:MessageHandler(fn) -- Sets a message handler for this profile
			fn [function] (message [table], processed [function]())
			-- The handler function receives a message table and a callback function;
			The callback function is to be called when a message has been processed
			- this will discard the message from the profile message cache; If the
			callback function is not called, other message handlers will also be triggered
			with unprocessed message data.
			
		Profile:Save() -- If the profile session is still active makes an UpdateAsync call
			to the DataStore to immediately save profile data

		Profile:SetAsync() -- Forcefully saves changes to the profile; Only for profiles
			loaded with ProfileStore:GetAsync() or ProfileStore:VersionQuery()
		
--]]

local AUTO_SAVE_PERIOD = 300 -- (Seconds) Time between when changes to a profile are saved to the DataStore
local LOAD_REPEAT_PERIOD = 10 -- (Seconds) Time between successive profile reads when handling a session conflict
local FIRST_LOAD_REPEAT = 5 -- (Seconds) Time between first and second profile read when handling a session conflict
local SESSION_STEAL = 40 -- (Seconds) Time until a session conflict is resolved with the waiting server stealing the session
local ASSUME_DEAD = 630 -- (Seconds) If a profile hasn't had updates for this long, quickly assume an active session belongs to a crashed server
local START_SESSION_TIMEOUT = 120 -- (Seconds) If a session can't be started for a profile for this long, stop repeating calls to the DataStore

local CRITICAL_STATE_ERROR_COUNT = 5 -- Assume critical state if this many issues happen in a short amount of time
local CRITICAL_STATE_ERROR_EXPIRE = 120 -- (Seconds) Individual issue expiration
local CRITICAL_STATE_EXPIRE = 120 -- (Seconds) Critical state expiration

local MAX_MESSAGE_QUEUE = 1000 -- Max messages saved in a profile that were sent using "ProfileStore:MessageAsync()"

----- Dependencies -----

-- local Util = require(game.ReplicatedStorage.Shared.Util)
-- local Signal = Util.Signal

local Signal do

	local FreeRunnerThread

	--[[
		Yield-safe coroutine reusing by stravant;
		Sources:
		https://devforum.roblox.com/t/lua-signal-class-comparison-optimal-goodsignal-class/1387063
		https://gist.github.com/stravant/b75a322e0919d60dde8a0316d1f09d2f
	--]]

	local function AcquireRunnerThreadAndCallEventHandler(fn, ...)
		local acquired_runner_thread = FreeRunnerThread
		FreeRunnerThread = nil
		fn(...)
		-- The handler finished running, this runner thread is free again.
		FreeRunnerThread = acquired_runner_thread
	end

	local function RunEventHandlerInFreeThread(...)
		AcquireRunnerThreadAndCallEventHandler(...)
		while true do
			AcquireRunnerThreadAndCallEventHandler(coroutine.yield())
		end
	end

	local Connection = {}
	Connection.__index = Connection

	local SignalClass = {}
	SignalClass.__index = SignalClass

	function Connection:Disconnect()

		if self.is_connected == false then
			return
		end

		local signal = self.signal
		self.is_connected = false
		signal.listener_count -= 1

		if signal.head == self then
			signal.head = self.next
		else
			local prev = signal.head
			while prev ~= nil and prev.next ~= self do
				prev = prev.next
			end
			if prev ~= nil then
				prev.next = self.next
			end
		end

	end

	function SignalClass.New()

		local self = {
			head = nil,
			listener_count = 0,
		}
		setmetatable(self, SignalClass)

		return self

	end

	function SignalClass:Connect(listener: (...any) -&gt; ())

		if type(listener) ~= "function" then
			error(`[{script.Name}]: \"listener\" must be a function; Received {typeof(listener)}`)
		end

		local connection = {
			listener = listener,
			signal = self,
			next = self.head,
			is_connected = true,
		}
		setmetatable(connection, Connection)

		self.head = connection
		self.listener_count += 1

		return connection

	end

	function SignalClass:GetListenerCount(): number
		return self.listener_count
	end

	function SignalClass:Fire(...)
		local item = self.head
		while item ~= nil do
			if item.is_connected == true then
				if not FreeRunnerThread then
					FreeRunnerThread = coroutine.create(RunEventHandlerInFreeThread)
				end
				task.spawn(FreeRunnerThread, item.listener, ...)
			end
			item = item.next
		end
	end

	function SignalClass:Wait()
		local co = coroutine.running()
		local connection
		connection = self:Connect(function(...)
			connection:Disconnect()
			task.spawn(co, ...)
		end)
		return coroutine.yield()
	end

	Signal = table.freeze({
		New = SignalClass.New,
	})

end

----- Private -----

local ActiveSessionCheck = {} -- {[session_token] = profile, ...}
local AutoSaveList = {} -- {profile, ...} -- Loaded profile table which will be circularly auto-saved
local IssueQueue = {} -- {issue_time, ...}

local DataStoreService = game:GetService("DataStoreService")
local MessagingService = game:GetService("MessagingService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")

local PlaceId = game.PlaceId
local JobId = game.JobId

local AutoSaveIndex = 1 -- Next profile to auto save
local LastAutoSave = os.clock()

local LoadIndex = 0

local ActiveProfileLoadJobs = 0 -- Number of active threads that are loading in profiles
local ActiveProfileSaveJobs = 0 -- Number of active threads that are saving profiles

local CriticalStateStart = 0 -- os.clock()

local IsStudio = RunService:IsStudio()
local DataStoreState: "NotReady" | "NoInternet" | "NoAccess" | "Access" = "NotReady"

local MockStore = {}
local UserMockStore = {}
local MockFlag = false

local OnError = Signal.New() -- (message, store_name, profile_key)
local OnOverwrite = Signal.New() -- (store_name, profile_key)

local UpdateQueue = { -- For stability sake, we won't do UpdateAsync calls for the same key until all previous calls finish
	--[[
		[session_token] = {
			coroutine, ...
		},
		...
	--]]
}

local function WaitInUpdateQueue(session_token) --&gt; next_in_queue()

	local is_first = false

	if UpdateQueue[session_token] == nil then
		is_first = true
		UpdateQueue[session_token] = {}
	end

	local queue = UpdateQueue[session_token]

	if is_first == false then
		table.insert(queue, coroutine.running())
		coroutine.yield()
	end

	return function()
		local next_co = table.remove(queue, 1)
		if next_co ~= nil then
			coroutine.resume(next_co)
		else
			UpdateQueue[session_token] = nil
		end
	end

end

local function SessionToken(store_name, profile_key, is_mock)

	local session_token = "L_" -- Live

	if is_mock == true then
		session_token = "U_" -- User mock
	elseif DataStoreState ~= "Access" then
		session_token = "M_" -- Mock, cause no DataStore access
	end

	session_token ..= store_name .. "\0" .. profile_key

	return session_token

end

local function DeepCopyTable(t)
	local copy = {}
	for key, value in pairs(t) do
		if type(value) == "table" then
			copy[key] = DeepCopyTable(value)
		else
			copy[key] = value
		end
	end
	return copy
end

local function ReconcileTable(target, template)
	for k, v in pairs(template) do
		if type(k) == "string" then -- Only string keys will be reconciled
			if target[k] == nil then
				if type(v) == "table" then
					target[k] = DeepCopyTable(v)
				else
					target[k] = v
				end
			elseif type(target[k]) == "table" and type(v) == "table" then
				ReconcileTable(target[k], v)
			end
		end
	end
end

local function RegisterError(error_message, store_name, profile_key) -- Called when a DataStore API call errors
	warn(`[{script.Name}]: DataStore API error (STORE:{store_name}; KEY:{profile_key}) - {tostring(error_message)}`)
	table.insert(IssueQueue, os.clock()) -- Adding issue time to queue
	OnError:Fire(tostring(error_message), store_name, profile_key)
end

local function RegisterOverwrite(store_name, profile_key) -- Called when a corrupted profile is loaded
	warn(`[{script.Name}]: Invalid profile was overwritten (STORE:{store_name}; KEY:{profile_key})`)
	OnOverwrite:Fire(store_name, profile_key)
end

local function NewMockDataStoreKeyInfo(params)

	local version_id_string = tostring(params.VersionId or 0)
	local meta_data = params.MetaData or {}
	local user_ids = params.UserIds or {}

	return {
		CreatedTime = params.CreatedTime,
		UpdatedTime = params.UpdatedTime,
		Version = string.rep("0", 16) .. "."
			.. string.rep("0", 10 - string.len(version_id_string)) .. version_id_string
			.. "." .. string.rep("0", 16) .. "." .. "01",

		GetMetadata = function()
			return DeepCopyTable(meta_data)
		end,

		GetUserIds = function()
			return DeepCopyTable(user_ids)
		end,
	}

end

local function MockUpdateAsync(mock_data_store, profile_store_name, key, transform_function, is_get_call) --&gt; loaded_data, key_info

	local profile_store = mock_data_store[profile_store_name]

	if profile_store == nil then
		profile_store = {}
		mock_data_store[profile_store_name] = profile_store
	end

	local epoch_time = math.floor(os.time() * 1000)
	local mock_entry = profile_store[key]
	local mock_entry_was_nil = false

	if mock_entry == nil then
		mock_entry_was_nil = true
		if is_get_call ~= true then
			mock_entry = {
				Data = nil,
				CreatedTime = epoch_time,
				UpdatedTime = epoch_time,
				VersionId = 0,
				UserIds = {},
				MetaData = {},
			}
			profile_store[key] = mock_entry
		end
	end

	local mock_key_info = mock_entry_was_nil == false and NewMockDataStoreKeyInfo(mock_entry) or nil

	local transform, user_ids, roblox_meta_data = transform_function(mock_entry and mock_entry.Data, mock_key_info)

	if transform == nil then
		return nil
	else
		if mock_entry ~= nil and is_get_call ~= true then
			mock_entry.Data = DeepCopyTable(transform)
			mock_entry.UserIds = DeepCopyTable(user_ids or {})
			mock_entry.MetaData = DeepCopyTable(roblox_meta_data or {})
			mock_entry.VersionId += 1
			mock_entry.UpdatedTime = epoch_time
		end

		return DeepCopyTable(transform), mock_entry ~= nil and NewMockDataStoreKeyInfo(mock_entry) or nil
	end

end

local function UpdateAsync(profile_store, profile_key, transform_params, is_user_mock, is_get_call, version) --&gt; loaded_data, key_info
	--transform_params = {
	--	ExistingProfileHandle = function(latest_data),
	--	MissingProfileHandle = function(latest_data),
	--	EditProfile = function(latest_data),
	--}

	local loaded_data, key_info
	
	local next_in_queue = WaitInUpdateQueue(SessionToken(profile_store.Name, profile_key, is_user_mock))

	local success = true

	local success, error_message = pcall(function()
		local transform_function = function(latest_data)

			local missing_profile = false
			local overwritten = false
			local global_updates = {0, {}}

			if latest_data == nil then

				missing_profile = true

			elseif type(latest_data) ~= "table" then

				missing_profile = true
				overwritten = true

			else

				if type(latest_data.Data) == "table" and type(latest_data.MetaData) == "table" and type(latest_data.GlobalUpdates) == "table" then

					-- Regular profile structure detected:

					latest_data.WasOverwritten = false -- Must be set to false if set previously
					global_updates = latest_data.GlobalUpdates

					if transform_params.ExistingProfileHandle ~= nil then
						transform_params.ExistingProfileHandle(latest_data)
					end

				elseif latest_data.Data == nil and latest_data.MetaData == nil and type(latest_data.GlobalUpdates) == "table" then

					-- Regular structure not detected, but GlobalUpdate data exists:

					latest_data.WasOverwritten = false -- Must be set to false if set previously
					global_updates = latest_data.GlobalUpdates or global_updates
					missing_profile = true

				else

					missing_profile = true
					overwritten = true

				end

			end

			-- Profile was not created or corrupted and no GlobalUpdate data exists:
			if missing_profile == true then
				latest_data = {
					-- Data = nil,
					-- MetaData = nil,
					GlobalUpdates = global_updates,
				}
				if transform_params.MissingProfileHandle ~= nil then
					transform_params.MissingProfileHandle(latest_data)
				end
			end

			-- Editing profile:
			if transform_params.EditProfile ~= nil then
				transform_params.EditProfile(latest_data)
			end

			-- Invalid data handling (Silently override with empty profile)
			if overwritten == true then
				latest_data.WasOverwritten = true -- Temporary tag that will be removed on first save
			end

			return latest_data, latest_data.UserIds, latest_data.RobloxMetaData
		end

		if is_user_mock == true then -- Used when the profile is accessed through ProfileStore.Mock

			loaded_data, key_info = MockUpdateAsync(UserMockStore, profile_store.Name, profile_key, transform_function, is_get_call)
			task.wait() -- Simulate API call yield

		elseif DataStoreState ~= "Access" then -- Used when API access is disabled

			loaded_data, key_info = MockUpdateAsync(MockStore, profile_store.Name, profile_key, transform_function, is_get_call)
			task.wait() -- Simulate API call yield

		else

			if is_get_call == true then

				if version ~= nil then

					local success, error_message = pcall(function()
						loaded_data, key_info = profile_store.data_store:GetVersionAsync(profile_key, version)
					end)

					if success == false and type(error_message) == "string" and string.find(error_message, "not valid") ~= nil then
						warn(`[{script.Name}]: Passed version argument is not valid; Traceback:\n` .. debug.traceback())
					end

				else

					loaded_data, key_info = profile_store.data_store:GetAsync(profile_key)

				end

				loaded_data = transform_function(loaded_data)

			else

				loaded_data, key_info = profile_store.data_store:UpdateAsync(profile_key, transform_function)

			end

		end

	end)

	next_in_queue()

	if success == true and type(loaded_data) == "table" then
		-- Invalid data handling:
		if loaded_data.WasOverwritten == true and is_get_call ~= true then
			RegisterOverwrite(
				profile_store.Name,
				profile_key
			)
		end
		-- Return loaded_data:
		return loaded_data, key_info
	else
		-- Error handling:
		RegisterError(
			error_message or "Undefined error",
			profile_store.Name,
			profile_key
		)
		-- Return nothing:
		return nil
	end

end

local function IsThisSession(session_tag)
	return session_tag[1] == PlaceId and session_tag[2] == JobId
end

local function ReadMockFlag(): boolean
	local is_mock = MockFlag
	MockFlag = false
	return is_mock
end

local function WaitForStoreReady(profile_store)
	while profile_store.is_ready == false do
		task.wait()
	end
end

local function AddProfileToAutoSave(profile)

	ActiveSessionCheck[profile.session_token] = profile

	-- Add at AutoSaveIndex and move AutoSaveIndex right:

	table.insert(AutoSaveList, AutoSaveIndex, profile)

	if #AutoSaveList &gt; 1 then
		AutoSaveIndex = AutoSaveIndex + 1
	elseif #AutoSaveList == 1 then
		-- First profile created - make sure it doesn't get immediately auto saved:
		LastAutoSave = os.clock()
	end

end

local function RemoveProfileFromAutoSave(profile)

	ActiveSessionCheck[profile.session_token] = nil

	local auto_save_index = table.find(AutoSaveList, profile)

	if auto_save_index ~= nil then
		table.remove(AutoSaveList, auto_save_index)
		if auto_save_index &lt; AutoSaveIndex then
			AutoSaveIndex = AutoSaveIndex - 1 -- Table contents were moved left before AutoSaveIndex so move AutoSaveIndex left as well
		end
		if AutoSaveList[AutoSaveIndex] == nil then -- AutoSaveIndex was at the end of the AutoSaveList - reset to 1
			AutoSaveIndex = 1
		end
	end

end

local function SaveProfileAsync(profile, is_ending_session, is_overwriting, last_save_reason)

	if type(profile.Data) ~= "table" then
		error(`[{script.Name}]: Developer code likely set "Profile.Data" to a non-table value! (STORE:{profile.ProfileStore.Name}; KEY:{profile.Key})`)
	end

	profile.OnSave:Fire()
	if is_ending_session == true then
		profile.OnLastSave:Fire(last_save_reason or "Manual")
	end

	if is_ending_session == true and is_overwriting ~= true then
		if profile.roblox_message_subscription ~= nil then
			profile.roblox_message_subscription:Disconnect()
		end
		RemoveProfileFromAutoSave(profile)
		profile.OnSessionEnd:Fire()
	end

	ActiveProfileSaveJobs = ActiveProfileSaveJobs + 1

	-- Compare "SessionLoadCount" when writing to profile to prevent a rare case of repeat last save when the profile is loaded on the same server again

	local repeat_save_flag = true -- Released Profile save calls have to repeat until they succeed
	local exp_backoff = 1

	while repeat_save_flag == true do

		if is_ending_session ~= true then
			repeat_save_flag = false
		end

		local loaded_data, key_info = UpdateAsync(
			profile.ProfileStore,
			profile.Key,
			{
				ExistingProfileHandle = nil,
				MissingProfileHandle = nil,
				EditProfile = function(latest_data)
					
					-- Check if this session still owns the profile:

					local session_owns_profile = false

					if is_overwriting ~= true then

						local active_session = latest_data.MetaData.ActiveSession
						local session_load_count = latest_data.MetaData.SessionLoadCount

						if type(active_session) == "table" then
							session_owns_profile = IsThisSession(active_session) and session_load_count == profile.load_index
						end

					else
						session_owns_profile = true
					end

					-- We may only edit the profile if this server has ownership of the profile:

					if session_owns_profile == true then

						-- Clear processed updates (messages):

						local locked_updates = profile.locked_global_updates -- [index] = true, ...
						local active_updates = latest_data.GlobalUpdates[2]
						-- ProfileService module format: {{update_id, version_id, update_locked, update_data}, ...}
						-- ProfileStore module format: {{update_id, update_data}, ...}

						if next(locked_updates) ~= nil then
							local i = 1
							while i &lt;= #active_updates do
								local update = active_updates[i]
								if locked_updates[update[1]] == true then
									table.remove(active_updates, i)
								else
									i += 1
								end
							end
						end

						-- Save profile data:

						latest_data.Data = profile.Data
						latest_data.RobloxMetaData = profile.RobloxMetaData
						latest_data.UserIds = profile.UserIds

						if is_overwriting ~= true then

							latest_data.MetaData.LastUpdate = os.time()

							if is_ending_session == true then
								latest_data.MetaData.ActiveSession = nil
							end

						else

							latest_data.MetaData.ActiveSession = nil
							latest_data.MetaData.ForceLoadSession = nil

						end

					end

				end,
			},
			profile.is_mock
		)

		if loaded_data ~= nil and key_info ~= nil then

			if is_overwriting == true then
				break
			end
			
			repeat_save_flag = false
			
			local active_session = loaded_data.MetaData.ActiveSession
			local session_load_count = loaded_data.MetaData.SessionLoadCount
			local session_owns_profile = false

			if type(active_session) == "table" then
				session_owns_profile = IsThisSession(active_session) and session_load_count == profile.load_index
			end
			
			local force_load_session = loaded_data.MetaData.ForceLoadSession
			local force_load_pending = false
			if type(force_load_session) == "table" then
				force_load_pending = not IsThisSession(force_load_session)
			end
			
			local is_active = profile:IsActive()
			
			-- If another server is trying to start a session for this profile - end the session:

			if force_load_pending == true and session_owns_profile == true then
				if is_active == true then
					SaveProfileAsync(profile, true, false, "External")
				end
				break
			end
			
			-- Clearing processed update list / Detecting new updates:

			local locked_updates = profile.locked_global_updates -- [index] = true, ...
			local received_updates = profile.received_global_updates -- [index] = true, ...
			local active_updates = loaded_data.GlobalUpdates[2]

			local new_updates = {} -- {}, ...
			local still_pending = {} -- [index] = true, ...

			for _, update in ipairs(active_updates) do
				if locked_updates[update[1]] == true then
					still_pending[update[1]] = true
				elseif received_updates[update[1]] ~= true then
					received_updates[update[1]] = true
					table.insert(new_updates, update)
				end
			end

			for index in pairs(locked_updates) do
				if still_pending[index] ~= true then
					locked_updates[index] = nil
				end
			end

			-- Updating profile values:

			profile.KeyInfo = key_info
			profile.LastSavedData = loaded_data.Data
			profile.global_updates = loaded_data.GlobalUpdates and loaded_data.GlobalUpdates[2] or {}

			if session_owns_profile == true then
				if is_active == true and is_ending_session ~= true then

					-- Processing new global updates (messages):

					for _, update in ipairs(new_updates) do

						local index = update[1]
						local update_data = update[#update] -- Backwards compatibility with ProfileService

						for _, handler in ipairs(profile.message_handlers) do

							local is_processed = false
							local processed_callback = function()
								is_processed = true
								locked_updates[index] = true
							end
							
							local send_update_data = DeepCopyTable(update_data)

							task.spawn(handler, send_update_data, processed_callback)

							if is_processed == true then
								break
							end

						end

					end

				end
			else
				
				if profile.roblox_message_subscription ~= nil then
					profile.roblox_message_subscription:Disconnect()
				end

				if is_active == true then
					RemoveProfileFromAutoSave(profile)
					profile.OnSessionEnd:Fire()
				end

			end

			profile.OnAfterSave:Fire(profile.LastSavedData)

		elseif repeat_save_flag == true then
			
			-- DataStore call likely resulted in an error; Repeat the DataStore call shortly
			task.wait(exp_backoff)
			exp_backoff = math.min(if last_save_reason == "Shutdown" then 8 else 20, exp_backoff * 2)

		end

	end

	ActiveProfileSaveJobs = ActiveProfileSaveJobs - 1

end

----- Public -----

--[[
	Saved profile structure:
	
	{
		Data = {},
		
		MetaData = {
			ProfileCreateTime = 0,
			SessionLoadCount = 0,
			ActiveSession = {place_id, game_job_id, unique_session_id} / nil,
			ForceLoadSession = {place_id, game_job_id} / nil,
			LastUpdate = 0, -- os.time()
			MetaTags = {}, -- Backwards compatibility with ProfileService
		},
		
		RobloxMetaData = {},
		UserIds = {},
		
		GlobalUpdates = {
			update_index,
			{
				{update_index, data}, ...
			},
		},
	}

--]]

export type JSONAcceptable = { JSONAcceptable } | { [string]: JSONAcceptable } | number | string | boolean | buffer

export type Profile&lt;T&gt; = {
	Data: T &amp; JSONAcceptable,
	LastSavedData: T &amp; JSONAcceptable,
	FirstSessionTime: number,
	SessionLoadCount: number,
	Session: {PlaceId: number, JobId: string}?,
	RobloxMetaData: JSONAcceptable,
	UserIds: {number},
	KeyInfo: DataStoreKeyInfo,
	OnSave: {Connect: (self: any, listener: () -&gt; ()) -&gt; ({Disconnect: (self: any) -&gt; ()})},
	OnLastSave: {Connect: (self: any, listener: (reason: "Manual" | "External" | "Shutdown") -&gt; ()) -&gt; ({Disconnect: (self: any) -&gt; ()})},
	OnSessionEnd: {Connect: (self: any, listener: () -&gt; ()) -&gt; ({Disconnect: (self: any) -&gt; ()})},
	OnAfterSave: {Connect: (self: any, listener: (last_saved_data: T &amp; JSONAcceptable) -&gt; ()) -&gt; ({Disconnect: (self: any) -&gt; ()})},
	ProfileStore: JSONAcceptable,
	Key: string,

	IsActive: (self: any) -&gt; (boolean),
	Reconcile: (self: any) -&gt; (),
	EndSession: (self: any) -&gt; (),
	AddUserId: (self: any, user_id: number) -&gt; (),
	RemoveUserId: (self: any, user_id: number) -&gt; (),
	MessageHandler: (self: any, fn: (message: JSONAcceptable, processed: () -&gt; ()) -&gt; ()) -&gt; (),
	Save: (self: any) -&gt; (),
	SetAsync: (self: any) -&gt; (),
}

export type VersionQuery&lt;T&gt; = {
	NextAsync: (self: any) -&gt; (Profile&lt;T&gt;?),
}

type ProfileStoreStandard&lt;T&gt; = {
	Name: string,
	StartSessionAsync: (self: any, profile_key: string, params: {Steal: boolean?}) -&gt; (Profile&lt;T&gt;?),
	MessageAsync: (self: any, profile_key: string, message: JSONAcceptable) -&gt; (boolean),
	GetAsync: (self: any, profile_key: string, version: string?) -&gt; (Profile&lt;T&gt;?),
	VersionQuery: (self: any, profile_key: string, sort_direction: Enum.SortDirection?, min_date: DateTime | number | nil, max_date: DateTime | number | nil) -&gt; (VersionQuery&lt;T&gt;),
	RemoveAsync: (self: any, profile_key: string) -&gt; (boolean),
}

export type ProfileStore&lt;T&gt; = {
	Mock: ProfileStoreStandard&lt;T&gt;,
} &amp; ProfileStoreStandard&lt;T&gt;

type ConstantName = "AUTO_SAVE_PERIOD" | "LOAD_REPEAT_PERIOD" | "FIRST_LOAD_REPEAT" | "SESSION_STEAL"
| "ASSUME_DEAD" | "START_SESSION_TIMEOUT" | "CRITICAL_STATE_ERROR_COUNT" | "CRITICAL_STATE_ERROR_EXPIRE"
| "CRITICAL_STATE_EXPIRE" | "MAX_MESSAGE_QUEUE"

export type ProfileStoreModule = {
	IsClosing: boolean,
	IsCriticalState: boolean,
	OnError: {Connect: (self: any, listener: (message: string, store_name: string, profile_key: string) -&gt; ()) -&gt; ({Disconnect: (self: any) -&gt; ()})},
	OnOverwrite: {Connect: (self: any, listener: (store_name: string, profile_key: string) -&gt; ()) -&gt; ({Disconnect: (self: any) -&gt; ()})},
	OnCriticalToggle: {Connect: (self: any, listener: (is_critical: boolean) -&gt; ()) -&gt; ({Disconnect: (self: any) -&gt; ()})},
	DataStoreState: "NotReady" | "NoInternet" | "NoAccess" | "Access",
	New: &lt;T&gt;(store_name: string, template: (T &amp; JSONAcceptable)?) -&gt; (ProfileStore&lt;T&gt;),
	SetConstant: (name: ConstantName, value: number) -&gt; ()
}

local Profile = {}
Profile.__index = Profile

function Profile.New(raw_data, key_info, profile_store, key, is_mock, session_token)

	local data = raw_data.Data or {}
	local session = raw_data.MetaData and raw_data.MetaData.ActiveSession or nil

	local global_updates = raw_data.GlobalUpdates and raw_data.GlobalUpdates[2] or {}
	local received_global_updates = {}

	for _, update in ipairs(global_updates) do
		received_global_updates[update[1]] = true
	end

	local self = {

		Data = data,
		LastSavedData = DeepCopyTable(data),

		FirstSessionTime = raw_data.MetaData and raw_data.MetaData.ProfileCreateTime or 0,
		SessionLoadCount = raw_data.MetaData and raw_data.MetaData.SessionLoadCount or 0,
		Session = session and {PlaceId = session[1], JobId = session[2]},

		RobloxMetaData = raw_data.RobloxMetaData or {},
		UserIds = raw_data.UserIds or {},
		KeyInfo = key_info,

		OnAfterSave = Signal.New(),
		OnSave = Signal.New(),
		OnLastSave = Signal.New(),
		OnSessionEnd = Signal.New(),

		ProfileStore = profile_store,
		Key = key,

		load_timestamp = os.clock(),
		is_mock = is_mock,
		session_token = session_token or "",
		load_index = raw_data.MetaData and raw_data.MetaData.SessionLoadCount or 0,
		locked_global_updates = {},
		received_global_updates = received_global_updates,
		message_handlers = {},
		global_updates = global_updates,

	}
	setmetatable(self, Profile)

	return self

end

function Profile:IsActive()
	return ActiveSessionCheck[self.session_token] == self
end

function Profile:Reconcile()
	ReconcileTable(self.Data, self.ProfileStore.template)
end

function Profile:EndSession()
	if self:IsActive() == true then
		task.spawn(SaveProfileAsync, self, true, nil, "Manual") -- Call save function in a new thread with release_from_session = true
	end
end

function Profile:AddUserId(user_id) -- Associates user_id with profile (GDPR compliance)

	if type(user_id) ~= "number" or user_id % 1 ~= 0 then
		warn(`[{script.Name}]: Invalid UserId argument for :AddUserId() ({tostring(user_id)}); Traceback:\n` .. debug.traceback())
		return
	end

	if user_id &lt; 0 and self.is_mock ~= true and DataStoreState == "Access" then
		return -- Avoid giving real Roblox APIs negative UserId's
	end

	if table.find(self.UserIds, user_id) == nil then
		table.insert(self.UserIds, user_id)
	end

end

function Profile:RemoveUserId(user_id) -- Removes user_id association with profile (safe function)

	if type(user_id) ~= "number" or user_id % 1 ~= 0 then
		warn(`[{script.Name}]: Invalid UserId argument for :RemoveUserId() ({tostring(user_id)}); Traceback:\n` .. debug.traceback())
		return
	end

	local index = table.find(self.UserIds, user_id)

	if index ~= nil then
		table.remove(self.UserIds, index)
	end

end

function Profile:SetAsync() -- Saves the profile to the DataStore and removes the session lock

	if self.view_mode ~= true then
		error(`[{script.Name}]: :SetAsync() can only be used in view mode`)
	end

	SaveProfileAsync(self, nil, true)

end

function Profile:MessageHandler(fn)

	if type(fn) ~= "function" then
		error(`[{script.Name}]: fn argument is not a function`)
	end

	if self.view_mode ~= true and self:IsActive() ~= true then
		return -- Don't process messages if the profile session was ended
	end

	local locked_updates = self.locked_global_updates
	table.insert(self.message_handlers, fn)

	for _, update in ipairs(self.global_updates) do

		local index = update[1]
		local update_data = update[#update] -- Backwards compatibility with ProfileService

		if locked_updates[index] ~= true then

			local processed_callback = function()
				locked_updates[index] = true
			end
			
			local send_update_data = DeepCopyTable(update_data)

			task.spawn(fn, send_update_data, processed_callback)

		end

	end

end

function Profile:Save()
	
	if self.view_mode == true then
		error(`[{script.Name}]: Can't save profile in view mode; Should you be calling :SetAsync() instead?`)
	end
	
	if self:IsActive() == false then
		warn(`[{script.Name}]: Attempted saving an inactive profile (STORE:{self.ProfileStore.Name}; KEY:{self.Key});`
			.. ` Traceback:\n` .. debug.traceback())
		return
	end
	
	-- Move the profile right behind the auto save index to delay the next auto save for it:
	RemoveProfileFromAutoSave(self)
	AddProfileToAutoSave(self)
	
	-- Perform save in new thread:
	task.spawn(SaveProfileAsync, self)

end

local ProfileStore: ProfileStoreModule = {

	IsClosing = false,
	IsCriticalState = false,
	OnError = OnError, -- (message, store_name, profile_key)
	OnOverwrite = OnOverwrite, -- (store_name, profile_key)
	OnCriticalToggle = Signal.New(), -- (is_critical)
	DataStoreState = "NotReady", -- ("NotReady", "NoInternet", "NoAccess", "Access")

}
ProfileStore.__index = ProfileStore

function ProfileStore.SetConstant(name, value)

	if type(value) ~= "number" then
		error(`[{script.Name}]: Invalid value type`)
	end

	if name == "AUTO_SAVE_PERIOD" then
		AUTO_SAVE_PERIOD = value
	elseif name == "LOAD_REPEAT_PERIOD" then
		LOAD_REPEAT_PERIOD = value
	elseif name == "FIRST_LOAD_REPEAT" then
		FIRST_LOAD_REPEAT = value
	elseif name == "SESSION_STEAL" then
		SESSION_STEAL = value
	elseif name == "ASSUME_DEAD" then
		ASSUME_DEAD = value
	elseif name == "START_SESSION_TIMEOUT" then
		START_SESSION_TIMEOUT = value
	elseif name == "CRITICAL_STATE_ERROR_COUNT" then
		CRITICAL_STATE_ERROR_COUNT = value
	elseif name == "CRITICAL_STATE_ERROR_EXPIRE" then
		CRITICAL_STATE_ERROR_EXPIRE = value
	elseif name == "CRITICAL_STATE_EXPIRE" then
		CRITICAL_STATE_EXPIRE = value
	elseif name == "MAX_MESSAGE_QUEUE" then
		MAX_MESSAGE_QUEUE = value
	else
		error(`[{script.Name}]: Invalid constant name was provided`)
	end

end

function ProfileStore.Test()
	return {
		ActiveSessionCheck = ActiveSessionCheck,
		AutoSaveList = AutoSaveList,
		ActiveProfileLoadJobs = ActiveProfileLoadJobs,
		ActiveProfileSaveJobs = ActiveProfileSaveJobs,
		MockStore = MockStore,
		UserMockStore = UserMockStore,
		UpdateQueue = UpdateQueue,
	}
end

function ProfileStore.New(store_name, template)

	template = template or {}

	if type(store_name) ~= "string" then
		error(`[{script.Name}]: Invalid or missing "store_name"`)
	elseif string.len(store_name) == 0 then
		error(`[{script.Name}]: store_name cannot be an empty string`)
	elseif string.len(store_name) &gt; 50 then
		error(`[{script.Name}]: store_name is too long`)
	end

	if type(template) ~= "table" then
		error(`[{script.Name}]: Invalid template argument`)
	end

	local self
	self = {

		Mock = {

			Name = store_name,

			StartSessionAsync = function(_, profile_key)
				MockFlag = true
				return self:StartSessionAsync(profile_key)
			end,
			MessageAsync = function(_, profile_key, message)
				MockFlag = true
				return self:MessageAsync(profile_key, message)
			end,
			GetAsync = function(_, profile_key, version)
				MockFlag = true
				return self:GetAsync(profile_key, version)
			end,
			VersionQuery = function(_, profile_key, sort_direction, min_date, max_date)
				MockFlag = true
				return self:VersionQuery(profile_key, sort_direction, min_date, max_date)
			end,
			RemoveAsync = function(_, profile_key)
				MockFlag = true
				return self:RemoveAsync(profile_key)
			end
		},

		Name = store_name,

		template = template,
		data_store = nil,
		load_jobs = {},
		mock_load_jobs = {},
		is_ready = true,

	}
	setmetatable(self, ProfileStore)

	local options = Instance.new("DataStoreOptions")
	options:SetExperimentalFeatures({v2 = true})

	if DataStoreState == "NotReady" then

		-- The module is not sure whether DataStores are accessible yet:

		self.is_ready = false

		task.spawn(function()

			repeat task.wait() until DataStoreState ~= "NotReady"

			if DataStoreState == "Access" then
				self.data_store = DataStoreService:GetDataStore(store_name, nil, options)
			end

			self.is_ready = true

		end)

	elseif DataStoreState == "Access" then

		self.data_store = DataStoreService:GetDataStore(store_name, nil, options)

	end

	return self

end

local function RobloxMessageSubscription(profile, unique_session_id)

	local last_roblox_message = 0
	
	local roblox_message_subscription = MessagingService:SubscribeAsync("PS_" .. unique_session_id, function(message)
		if type(message.Data) == "table" and message.Data.LoadCount == profile.SessionLoadCount then
			-- High reaction rate, based on numPlayers × 10 DataStore budget as of writing
			if os.clock() - last_roblox_message &gt; 6 then 
				last_roblox_message = os.clock()
				if profile:IsActive() == true then
					if message.Data.EndSession == true then
						SaveProfileAsync(profile, true, false, "External")
					else
						profile:Save()
					end
				end
			end
		end
	end)

	if profile:IsActive() == true then
		profile.roblox_message_subscription = roblox_message_subscription
	else
		roblox_message_subscription:Disconnect()
	end

end

function ProfileStore:StartSessionAsync(profile_key, params)

	local is_mock = ReadMockFlag()

	if type(profile_key) ~= "string" then
		error(`[{script.Name}]: profile_key must be a string`)
	elseif string.len(profile_key) == 0 then
		error(`[{script.Name}]: Invalid profile_key`)
	elseif string.len(profile_key) &gt; 50 then
		error(`[{script.Name}]: profile_key is too long`)
	end
	
	if params ~= nil and type(params) ~= "table" then
		error(`[{script.Name}]: Invalid params`)
	end
	
	params = params or {}

	if ProfileStore.IsClosing == true then
		return nil
	end
	
	WaitForStoreReady(self)

	local session_token = SessionToken(self.Name, profile_key, is_mock)

	if ActiveSessionCheck[session_token] ~= nil then
		error(`[{script.Name}]: Profile (STORE:{self.Name}; KEY:{profile_key}) is already loaded in this session`)
	end

	ActiveProfileLoadJobs = ActiveProfileLoadJobs + 1
	
	local is_user_cancel = false
	
	local function cancel_condition()
		if is_user_cancel == false then
			if params.Cancel ~= nil then
				is_user_cancel = params.Cancel() == true
			end
			return is_user_cancel
		end
		return true
	end
	
	local user_steal = params.Steal == true

	local force_load_steps = 0 -- Session conflict handling values
	local request_force_load = true
	local steal_session = false

	local start = os.clock()
	local exp_backoff = 1

	while ProfileStore.IsClosing == false and cancel_condition() == false do

		-- Load profile:

		-- SPECIAL CASE - If StartSessionAsync is called for the same key again before another StartSessionAsync finishes,
		-- grab the DataStore return for the new call. The early call will return nil. This is supposed to retain
		-- expected and efficient behavior in cases where a player would quickly rejoin the same server.

		LoadIndex += 1
		local load_id = LoadIndex
		local profile_load_jobs = is_mock == true and self.mock_load_jobs or self.load_jobs
		local profile_load_job = profile_load_jobs[profile_key] -- {load_id, {loaded_data, key_info} or nil}

		local loaded_data, key_info
		local unique_session_id = HttpService:GenerateGUID(false)

		if profile_load_job ~= nil then

			profile_load_job[1] = load_id -- Steal load job
			while profile_load_job[2] == nil do -- Wait for job to finish
				task.wait()
			end
			if profile_load_job[1] == load_id then -- Load job hasn't been double-stolen
				loaded_data, key_info = table.unpack(profile_load_job[2])
				profile_load_jobs[profile_key] = nil
			else
				ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
				return nil
			end

		else

			profile_load_job = {load_id, nil}
			profile_load_jobs[profile_key] = profile_load_job

			profile_load_job[2] = table.pack(UpdateAsync(
				self,
				profile_key,
				{
					ExistingProfileHandle = function(latest_data)

						if ProfileStore.IsClosing == true or cancel_condition() == true then
							return
						end

						local active_session = latest_data.MetaData.ActiveSession
						local force_load_session = latest_data.MetaData.ForceLoadSession

						if active_session == nil then
							latest_data.MetaData.ActiveSession = {PlaceId, JobId, unique_session_id}
							latest_data.MetaData.ForceLoadSession = nil
						elseif type(active_session) == "table" then
							if IsThisSession(active_session) == false then
								local last_update = latest_data.MetaData.LastUpdate
								if last_update ~= nil then
									if os.time() - last_update &gt; ASSUME_DEAD then
										latest_data.MetaData.ActiveSession = {PlaceId, JobId, unique_session_id}
										latest_data.MetaData.ForceLoadSession = nil
										return
									end
								end
								if steal_session == true or user_steal == true then
									local force_load_interrupted = if force_load_session ~= nil then not IsThisSession(force_load_session) else true
									if force_load_interrupted == false or user_steal == true then
										latest_data.MetaData.ActiveSession = {PlaceId, JobId, unique_session_id}
										latest_data.MetaData.ForceLoadSession = nil
									end
								elseif request_force_load == true then
									latest_data.MetaData.ForceLoadSession = {PlaceId, JobId}
								end
							else
								latest_data.MetaData.ForceLoadSession = nil
							end
						end

					end,
					MissingProfileHandle = function(latest_data)
						
						local is_cancel = ProfileStore.IsClosing == true or cancel_condition() == true

						latest_data.Data = DeepCopyTable(self.template)
						latest_data.MetaData = {
							ProfileCreateTime = os.time(),
							SessionLoadCount = 0,
							ActiveSession = if is_cancel == false then {PlaceId, JobId, unique_session_id} else nil,
							ForceLoadSession = nil,
							MetaTags = {}, -- Backwards compatibility with ProfileService
						}

					end,
					EditProfile = function(latest_data)

						if ProfileStore.IsClosing == true or cancel_condition() == true then
							return
						end

						local active_session = latest_data.MetaData.ActiveSession
						if active_session ~= nil and IsThisSession(active_session) == true then
							latest_data.MetaData.SessionLoadCount = latest_data.MetaData.SessionLoadCount + 1
							latest_data.MetaData.LastUpdate = os.time()
						end

					end,
				},
				is_mock
				))
			if profile_load_job[1] == load_id then -- Load job hasn't been stolen
				loaded_data, key_info = table.unpack(profile_load_job[2])
				profile_load_jobs[profile_key] = nil
			else
				ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
				return nil -- Load job stolen
			end
		end

		-- Handle load_data:

		if loaded_data ~= nil and key_info ~= nil then
			local active_session = loaded_data.MetaData.ActiveSession
			if type(active_session) == "table" then

				if IsThisSession(active_session) == true then

					-- Profile is now taken by this session:

					local profile = Profile.New(loaded_data, key_info, self, profile_key, is_mock, session_token)
					AddProfileToAutoSave(profile)
					
					if is_mock ~= true and DataStoreState == "Access" then
						
						-- Use MessagingService to quickly detect session conflicts and resolve them quickly:
						task.spawn(RobloxMessageSubscription, profile, unique_session_id) -- Blocking prevention
						
					end

					if ProfileStore.IsClosing == true or cancel_condition() == true then
						-- The server has initiated a shutdown by the time this profile was loaded
						SaveProfileAsync(profile, true) -- Release profile and yield until the DataStore call is finished
						profile = nil -- Don't return the profile object
					end

					ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
					return profile

				else
					
					if ProfileStore.IsClosing == true or cancel_condition() == true then
						ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
						return nil
					end

					-- Profile is taken by some other session:

					local force_load_session = loaded_data.MetaData.ForceLoadSession
					local force_load_interrupted = if force_load_session ~= nil then not IsThisSession(force_load_session) else true

					if force_load_interrupted == false then

						if request_force_load == false then
							force_load_steps = force_load_steps + 1
							if force_load_steps &gt;= math.ceil(SESSION_STEAL / LOAD_REPEAT_PERIOD) then
								steal_session = true
							end
						end
						
						-- Request the remote server to end its session:
						if type(active_session[3]) == "string" then
							local session_load_count = loaded_data.MetaData.SessionLoadCount or 0
							task.spawn(MessagingService.PublishAsync, MessagingService, "PS_" .. active_session[3], {LoadCount = session_load_count, EndSession = true})
						end
						
						-- Attempt to load the profile again after a delay
						local wait_until = os.clock() + if request_force_load == true then FIRST_LOAD_REPEAT else LOAD_REPEAT_PERIOD
						repeat task.wait() until os.clock() &gt;= wait_until or ProfileStore.IsClosing == true

					else
						-- Another session tried to load this profile:
						ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
						return nil
					end

					request_force_load = false -- Only request a force load once

				end

			else
				ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
				return nil -- In this scenario it is likely that this server started shutting down
			end
		else
			
			-- A DataStore call has likely ended in an error:

			local default_timeout = false

			if params.Cancel == nil then
				default_timeout = os.clock() - start &gt;= START_SESSION_TIMEOUT
			end
			
			if default_timeout == true or ProfileStore.IsClosing == true or cancel_condition() == true then
				ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
				return nil
			end
			
			task.wait(exp_backoff)  -- Repeat the call shortly
			exp_backoff = math.min(20, exp_backoff * 2)
			
		end

	end

	ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
	return nil -- Game started shutting down or the request was cancelled - don't return the profile

end

function ProfileStore:MessageAsync(profile_key, message)

	local is_mock = ReadMockFlag()

	if type(profile_key) ~= "string" then
		error(`[{script.Name}]: profile_key must be a string`)
	elseif string.len(profile_key) == 0 then
		error(`[{script.Name}]: Invalid profile_key`)
	elseif string.len(profile_key) &gt; 50 then
		error(`[{script.Name}]: profile_key is too long`)
	end

	if type(message) ~= "table" then
		error(`[{script.Name}]: message must be a table`)
	end

	if ProfileStore.IsClosing == true then
		return false
	end

	WaitForStoreReady(self)

	local exp_backoff = 1

	while ProfileStore.IsClosing == false do

		-- Updating profile:

		local loaded_data = UpdateAsync(
			self,
			profile_key,
			{
				ExistingProfileHandle = nil,
				MissingProfileHandle = nil,
				EditProfile = function(latest_data)

					local global_updates = latest_data.GlobalUpdates
					local update_list = global_updates[2]
					--{
					--	update_index,
					--	{
					--		{update_index, data}, ...
					--	},
					--},

					global_updates[1] += 1
					table.insert(update_list, {global_updates[1], message})

					-- Clearing queue if above limit:

					while #update_list &gt; MAX_MESSAGE_QUEUE do
						table.remove(update_list, 1)
					end

				end,
			},
			is_mock
		)

		if loaded_data ~= nil then
			
			local session_token = SessionToken(self.Name, profile_key, is_mock)
			
			local profile = ActiveSessionCheck[session_token]
			
			if profile ~= nil then
				
				-- The message was sent to a profile that is active in this server:
				profile:Save()
				
			else
				
				local meta_data = loaded_data.MetaData or {}
				local active_session = meta_data.ActiveSession
				local session_load_count = meta_data.SessionLoadCount or 0
				
				if type(active_session) == "table" and type(active_session[3]) == "string" then
					-- Request the remote server to auto-save sooner and receive the message:
					task.spawn(MessagingService.PublishAsync, MessagingService, "PS_" .. active_session[3], {LoadCount = session_load_count})
				end
				
			end

			return true

		else

			task.wait(exp_backoff) -- A DataStore call has likely ended in an error - repeat the call shortly
			exp_backoff = math.min(20, exp_backoff * 2)

		end

	end

	return false

end

function ProfileStore:GetAsync(profile_key, version)

	local is_mock = ReadMockFlag()

	if type(profile_key) ~= "string" then
		error(`[{script.Name}]: profile_key must be a string`)
	elseif string.len(profile_key) == 0 then
		error(`[{script.Name}]: Invalid profile_key`)
	elseif string.len(profile_key) &gt; 50 then
		error(`[{script.Name}]: profile_key is too long`)
	end

	if ProfileStore.IsClosing == true then
		return nil
	end

	WaitForStoreReady(self)

	if version ~= nil and (is_mock or DataStoreState ~= "Access") then
		return nil -- No version support in mock mode
	end

	local exp_backoff = 1

	while ProfileStore.IsClosing == false do

		-- Load profile:

		local loaded_data, key_info = UpdateAsync(
			self,
			profile_key,
			{
				ExistingProfileHandle = nil,
				MissingProfileHandle = function(latest_data)

					latest_data.Data = DeepCopyTable(self.template)
					latest_data.MetaData = {
						ProfileCreateTime = os.time(),
						SessionLoadCount = 0,
						ActiveSession = nil,
						ForceLoadSession = nil,
						MetaTags = {}, -- Backwards compatibility with ProfileService
					}

				end,
				EditProfile = nil,
			},
			is_mock,
			true, -- Use :GetAsync()
			version -- DataStore key version
		)

		-- Handle load_data:

		if loaded_data ~= nil then

			if key_info == nil then
				return nil -- Load was successful, but the key was empty - return no profile object
			end

			local profile = Profile.New(loaded_data, key_info, self, profile_key, is_mock)
			profile.view_mode = true

			return profile

		else

			task.wait(exp_backoff) -- A DataStore call has likely ended in an error - repeat the call shortly
			exp_backoff = math.min(20, exp_backoff * 2)

		end

	end

	return nil -- Game started shutting down - don't return the profile

end

function ProfileStore:RemoveAsync(profile_key)

	local is_mock = ReadMockFlag()

	if type(profile_key) ~= "string" or string.len(profile_key) == 0 then
		error(`[{script.Name}]: Invalid profile_key`)
	end

	if ProfileStore.IsClosing == true then
		return false
	end

	WaitForStoreReady(self)

	local wipe_status = false
	
	local next_in_queue = WaitInUpdateQueue(SessionToken(self.Name, profile_key, is_mock))

	if is_mock == true then -- Used when the profile is accessed through ProfileStore.Mock

		local mock_data_store = UserMockStore[self.Name]

		if mock_data_store ~= nil then
			mock_data_store[profile_key] = nil
			if next(mock_data_store) == nil then
				UserMockStore[self.Name] = nil
			end
		end

		wipe_status = true
		task.wait() -- Simulate API call yield

	elseif DataStoreState ~= "Access" then -- Used when API access is disabled

		local mock_data_store = MockStore[self.Name]

		if mock_data_store ~= nil then
			mock_data_store[profile_key] = nil
			if next(mock_data_store) == nil then
				MockStore[self.Name] = nil
			end
		end

		wipe_status = true
		task.wait() -- Simulate API call yield

	else -- Live DataStore

		wipe_status = pcall(function()
			self.data_store:RemoveAsync(profile_key)
		end)

	end
	
	next_in_queue()

	return wipe_status

end

local ProfileVersionQuery = {}
ProfileVersionQuery.__index = ProfileVersionQuery

function ProfileVersionQuery.New(profile_store, profile_key, sort_direction, min_date, max_date, is_mock)

	local self = {
		profile_store = profile_store,
		profile_key = profile_key,
		sort_direction = sort_direction,
		min_date = min_date,
		max_date = max_date,

		query_pages = nil,
		query_index = 0,
		query_failure = false,

		is_query_yielded = false,
		query_queue = {},

		is_mock = is_mock,
	}
	setmetatable(self, ProfileVersionQuery)

	return self

end

function MoveVersionQueryQueue(self) -- Hidden ProfileVersionQuery method
	while #self.query_queue &gt; 0 do

		local queue_entry = table.remove(self.query_queue, 1)

		task.spawn(queue_entry)

		if self.is_query_yielded == true then
			break
		end

	end
end

local VersionQueryNextAsyncStackingFlag = false
local WarnAboutVersionQueryOnce = false

function ProfileVersionQuery:NextAsync()

	local is_stacking = VersionQueryNextAsyncStackingFlag == true
	VersionQueryNextAsyncStackingFlag = false

	WaitForStoreReady(self.profile_store)

	if ProfileStore.IsClosing == true then
		return nil -- Silently fail :NextAsync() requests
	end

	if self.is_mock == true or DataStoreState ~= "Access" then
		if IsStudio == true and WarnAboutVersionQueryOnce == false then
			WarnAboutVersionQueryOnce = true
			warn(`[{script.Name}]: :VersionQuery() is not supported in mock mode!`)
		end
		return nil -- Silently fail :NextAsync() requests
	end

	local profile
	local is_finished = false

	local function query_job()

		if self.query_failure == true then
			is_finished = true
			return
		end

		-- First "next" call loads version pages:

		if self.query_pages == nil then

			self.is_query_yielded = true

			task.spawn(function()
				VersionQueryNextAsyncStackingFlag = true
				profile = self:NextAsync()
				is_finished = true
			end)

			local list_success, error_message = pcall(function()
				self.query_pages = self.profile_store.data_store:ListVersionsAsync(
					self.profile_key,
					self.sort_direction,
					self.min_date,
					self.max_date
				)
				self.query_index = 0
			end)

			if list_success == false or self.query_pages == nil then
				warn(`[{script.Name}]: Version query fail - {tostring(error_message)}`)
				self.query_failure = true
			end

			self.is_query_yielded = false

			MoveVersionQueryQueue(self)

			return

		end

		local current_page = self.query_pages:GetCurrentPage()
		local next_item = current_page[self.query_index + 1]

		-- No more entries:

		if self.query_pages.IsFinished == true and next_item == nil then
			is_finished = true
			return
		end

		-- Load next page when this page is over:

		if next_item == nil then

			self.is_query_yielded = true
			task.spawn(function()
				VersionQueryNextAsyncStackingFlag = true
				profile = self:NextAsync()
				is_finished = true
			end)

			local success, error_message = pcall(function()
				self.query_pages:AdvanceToNextPageAsync()
				self.query_index = 0
			end)

			if success == false or #self.query_pages:GetCurrentPage() == 0 then
				self.query_failure = true
			end

			self.is_query_yielded = false
			MoveVersionQueryQueue(self)

			return

		end

		-- Next page item:

		self.query_index += 1
		profile = self.profile_store:GetAsync(self.profile_key, next_item.Version)
		is_finished = true

	end

	if self.is_query_yielded == false then
		query_job()
	else
		if is_stacking == true then
			table.insert(self.query_queue, 1, query_job)
		else
			table.insert(self.query_queue, query_job)
		end
	end

	while is_finished == false do
		task.wait()
	end

	return profile

end

function ProfileStore:VersionQuery(profile_key, sort_direction, min_date, max_date)

	local is_mock = ReadMockFlag()

	if type(profile_key) ~= "string" or string.len(profile_key) == 0 then
		error(`[{script.Name}]: Invalid profile_key`)
	end

	-- Type check:

	if sort_direction ~= nil and (typeof(sort_direction) ~= "EnumItem"
		or sort_direction.EnumType ~= Enum.SortDirection) then
		error(`[{script.Name}]: Invalid sort_direction ({tostring(sort_direction)})`)
	end

	if min_date ~= nil and typeof(min_date) ~= "DateTime" and typeof(min_date) ~= "number" then
		error(`[{script.Name}]: Invalid min_date ({tostring(min_date)})`)
	end

	if max_date ~= nil and typeof(max_date) ~= "DateTime" and typeof(max_date) ~= "number" then
		error(`[{script.Name}]: Invalid max_date ({tostring(max_date)})`)
	end

	min_date = typeof(min_date) == "DateTime" and min_date.UnixTimestampMillis or min_date
	max_date = typeof(max_date) == "DateTime" and max_date.UnixTimestampMillis or max_date

	return ProfileVersionQuery.New(self, profile_key, sort_direction, min_date, max_date, is_mock)

end

-- DataStore API access check:

if IsStudio == true then

	task.spawn(function()

		local new_state = "NoAccess"

		local status, message = pcall(function()
			-- This will error if current instance has no Studio API access:
			DataStoreService:GetDataStore("____PS"):SetAsync("____PS", os.time())
		end)

		local no_internet_access = status == false and string.find(message, "ConnectFail", 1, true) ~= nil

		if no_internet_access == true then
			warn(`[{script.Name}]: No internet access - check your network connection`)
		end

		if status == false and
			(string.find(message, "403", 1, true) ~= nil or -- Cannot write to DataStore from studio if API access is not enabled
				string.find(message, "must publish", 1, true) ~= nil or -- Game must be published to access live keys
				no_internet_access == true) then -- No internet access

			new_state = if no_internet_access == true then "NoInternet" else "NoAccess"
			print(`[{script.Name}]: Roblox API services unavailable - data will not be saved`)
		else
			new_state = "Access"
			print(`[{script.Name}]: Roblox API services available - data will be saved`)
		end

		DataStoreState = new_state
		ProfileStore.DataStoreState = new_state

	end)

else
	
	DataStoreState = "Access"
	ProfileStore.DataStoreState = "Access"
	
end

-- Update loop:

RunService.Heartbeat:Connect(function()

	-- Auto saving:

	local auto_save_list_length = #AutoSaveList
	if auto_save_list_length &gt; 0 then
		local auto_save_index_speed = AUTO_SAVE_PERIOD / auto_save_list_length
		local os_clock = os.clock()
		while os_clock - LastAutoSave &gt; auto_save_index_speed do
			LastAutoSave = LastAutoSave + auto_save_index_speed
			local profile = AutoSaveList[AutoSaveIndex]
			if os_clock - profile.load_timestamp &lt; AUTO_SAVE_PERIOD / 2 then
				-- This profile is freshly loaded - auto saving immediately is not necessary:
				profile = nil
				for _ = 1, auto_save_list_length - 1 do
					-- Move auto save index to the right:
					AutoSaveIndex = AutoSaveIndex + 1
					if AutoSaveIndex &gt; auto_save_list_length then
						AutoSaveIndex = 1
					end
					profile = AutoSaveList[AutoSaveIndex]
					if os_clock - profile.load_timestamp &gt;= AUTO_SAVE_PERIOD / 2 then
						break
					else
						profile = nil
					end
				end
			end
			-- Move auto save index to the right:
			AutoSaveIndex = AutoSaveIndex + 1
			if AutoSaveIndex &gt; auto_save_list_length then
				AutoSaveIndex = 1
			end
			-- Perform save call:
			if profile ~= nil then
				task.spawn(SaveProfileAsync, profile) -- Auto save profile in new thread
			end
		end
	end

	-- Critical state handling:

	if ProfileStore.IsCriticalState == false then
		if #IssueQueue &gt;= CRITICAL_STATE_ERROR_COUNT then
			ProfileStore.IsCriticalState = true
			ProfileStore.OnCriticalToggle:Fire(true)
			CriticalStateStart = os.clock()
			warn(`[{script.Name}]: Entered critical state`)
		end
	else
		if #IssueQueue &gt;= CRITICAL_STATE_ERROR_COUNT then
			CriticalStateStart = os.clock()
		elseif os.clock() - CriticalStateStart &gt; CRITICAL_STATE_EXPIRE then
			ProfileStore.IsCriticalState = false
			ProfileStore.OnCriticalToggle:Fire(false)
			warn(`[{script.Name}]: Critical state ended`)
		end
	end

	-- Issue queue:

	while true do
		local issue_time = IssueQueue[1]
		if issue_time == nil then
			break
		elseif os.clock() - issue_time &gt; CRITICAL_STATE_ERROR_EXPIRE then
			table.remove(IssueQueue, 1)
		else
			break
		end
	end

end)

-- Release all loaded profiles when the server is shutting down:

task.spawn(function()

	while DataStoreState == "NotReady" do
		task.wait()
	end

	if DataStoreState ~= "Access" then

		game:BindToClose(function()
			ProfileStore.IsClosing = true
			task.wait() -- Mock shutdown delay
		end)

		return -- Don't wait for profiles to properly save in mock mode so studio could end the simulation faster

	end

	game:BindToClose(function()

		ProfileStore.IsClosing = true

		-- Release all active profiles:
		-- (Clone AutoSaveList to a new table because AutoSaveList changes when profiles are released)

		local on_close_save_job_count = 0
		local active_profiles = {}
		for index, profile in ipairs(AutoSaveList) do
			active_profiles[index] = profile
		end

		-- Release the profiles; Releasing profiles can trigger listeners that release other profiles, so check active state:
		for _, profile in ipairs(active_profiles) do
			if profile:IsActive() == true then
				on_close_save_job_count = on_close_save_job_count + 1
				task.spawn(function() -- Save profile on new thread
					SaveProfileAsync(profile, true, nil, "Shutdown")
					on_close_save_job_count = on_close_save_job_count - 1
				end)
			end
		end

		-- Yield until all active profile jobs are finished:
		while on_close_save_job_count &gt; 0 or ActiveProfileLoadJobs &gt; 0 or ActiveProfileSaveJobs &gt; 0 do
			task.wait()
		end

		return -- We're done!

	end)

end)

return ProfileStore</string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="ROJO_241">
        <Properties>
          <string name="Name">ProfileRuntime</string>
          <string name="Source">-- One ProfileStore session per player. Rewards mutate its in-memory Data;
-- autosaves and final saves are the only normal DataStore writes.
local Players=game:GetService("Players")
local Run=game:GetService("RunService")
local Root=game.ReplicatedStorage.FlyFightPaper
local ProfileStore=require(script.Parent.Packages.ProfileStore)
local Profile=require(script.Parent.ProfileService)
local Schema=require(Root.Shared.ProfileSchema)
local Economy=require(Root.Shared.EconomyRules)
local Gameplay=require(Root.Generated.Gameplay)
local Config=require(Root.Generated.Server).profiles
local Runtime={};Runtime.__index=Runtime
function Runtime.new(catalog)
 ProfileStore.SetConstant("AUTO_SAVE_PERIOD",Config.auto_save_seconds)
 ProfileStore.SetConstant("START_SESSION_TIMEOUT",Config.load_timeout_seconds)
 ProfileStore.SetConstant("SESSION_STEAL",Config.session_steal_seconds)
 ProfileStore.SetConstant("LOAD_REPEAT_PERIOD",Config.load_repeat_seconds)
 ProfileStore.SetConstant("FIRST_LOAD_REPEAT",Config.first_load_repeat_seconds)
 local store=ProfileStore.New(Config.data_store,Schema.defaults(catalog))
 local mock=Run:IsStudio()
 local self=setmetatable({catalog=catalog,entries={},mock=mock,stopping=false,store=mock and store.Mock or store},Runtime)
 self.service=Profile.new({catalog=catalog,mock=mock})
 ProfileStore.OnError:Connect(function(_,storeName,key)
  if storeName~=Config.data_store then return end
  for player,e in pairs(self.entries) do
   if key=="Player_"..player.UserId then
    e.saveDelayed=true
    player:SetAttribute("ProfileStatus","Saving delayed. Progress is held in this server.")
   end
  end
 end)
 Players.PlayerAdded:Connect(function(player)self:load(player)end)
 Players.PlayerRemoving:Connect(function(player)
  -- Later removal callbacks may still award a valid contribution. Drain them before ending.
  local e=self.entries[player]
  if e then e.leaving=true;e.releaseAt=os.clock();self.service:setProducerConnected(e.account,false) end
 end)
 for _,player in Players:GetPlayers() do self:load(player) end
 game:BindToClose(function()
  self.stopping=true
  for player in pairs(self.entries) do self:release(player) end
  local deadline=os.clock()+Config.shutdown_seconds
  while next(self.entries) and os.clock()&lt;deadline do task.wait(Config.worker_seconds) end
 end)
 return self
end
function Runtime:release(player)
 local e=self.entries[player]
 if e then e.leaving=true;e.releaseAt=0;self.service:setProducerConnected(e.account,false) end
end
function Runtime:load(player)
 if self.entries[player] or self.stopping then return end
 local e={player=player,account=tostring(player.UserId),queue={},seen={},callbacks={},loaded=false,leaving=false,failures=0}
 self.entries[player]=e;player:SetAttribute("ProfileStatus","Loading")
 task.spawn(function()
  if not self.mock then
   local deadline=os.clock()+Config.access_wait_seconds
   while ProfileStore.DataStoreState=="NotReady" and os.clock()&lt;deadline and not e.leaving and not self.stopping do task.wait(Config.worker_seconds) end
   -- ProfileStore can fall back to memory without API access. Never accept that as live saving.
   if ProfileStore.DataStoreState~="Access" then
    self.entries[player]=nil;player:SetAttribute("ProfileStatus","Saving unavailable")
    if player.Parent then player:Kick("Saving is unavailable. Please rejoin later; your existing progress has not been replaced.") end
    return
   end
  end
  local loadDeadline=os.clock()+Config.load_timeout_seconds
  local ok,profile=pcall(function()
   return self.store:StartSessionAsync("Player_"..player.UserId,{Cancel=function()
    return self.stopping or e.leaving or player.Parent~=Players or os.clock()&gt;=loadDeadline
   end})
  end)
  if not ok or not profile then
   self.entries[player]=nil;player:SetAttribute("ProfileStatus","Progress unavailable. Rejoin to retry.")
   warn("Profile load failed for player "..player.UserId)
   if player.Parent and not e.leaving then player:Kick("Your saved progress could not be loaded. Please rejoin later.") end
   return
  end
  if e.leaving or self.stopping or player.Parent~=Players then profile:EndSession();self.entries[player]=nil;return end
  local attached=self.service:attach(e.account,profile,{connected=true,mapLoaded=player:GetAttribute("ClassroomLoaded")==true})
  if attached.status~="ok" then
   warn("Profile refused for player "..player.UserId..": "..tostring(attached.code))
   profile:EndSession();self.entries[player]=nil
   if player.Parent then player:Kick("Your progress needs recovery. It has not been reset.") end
   return
  end
  profile:AddUserId(player.UserId)
  -- Studio dev account (Alan, 2026-10-08): a real player in Studio owns every part at max level with plenty of
  -- Paper, so every build can be saved and tested. self.mock is only true in Studio; live saves never get this.
  if self.mock then
   local data=profile.Data
   for _,list in ipairs({self.catalog.weapons,self.catalog.utilities}) do for _,part in ipairs(list) do data.ownership[part.id]=true end end
   for _,list in pairs(self.catalog.structuresBySlot) do for _,part in ipairs(list) do data.ownership[part.id]=true end end
   data.xpMilli=math.max(data.xpMilli,60000000);data.paperMilli=math.max(data.paperMilli,100000000)
   attached=self.service:view(e.account)
  end
  e.profile=profile;e.loaded=true;e.snapshot=attached.value;e.lastSavedVersion=profile.LastSavedData and profile.LastSavedData.version or -1
  profile.OnSave:Connect(function()
   self:flush(e)
   local session=self.service.sessions[e.account]
   if session then self.service:_advance(session) end
  end)
  profile.OnAfterSave:Connect(function(data)
   e.lastSavedVersion=data.version;e.saveDelayed=false
   if not profile:IsActive() then
    self.service:detach(e.account)
    if self.entries[player]==e then self.entries[player]=nil end
   end
  end)
  profile.OnSessionEnd:Connect(function()
   if ProfileStore.IsClosing then e.closing=true;return end
   if e.closing or self.stopping then return end
   self.service:detach(e.account)
   if self.entries[player]==e then self.entries[player]=nil end
   player:SetAttribute("ProfileStatus","Session moved. Please rejoin.")
   if player.Parent then player:Kick("Your profile was opened in another server. Please rejoin to continue safely.") end
  end)
  self:update(e)
  local nextStatus=0;local processed=0
  while self.entries[player]==e and not e.closing do
   local op=e.queue[1]
   if op then
    processed+=1
    if processed&gt;=Config.operations_per_tick then processed=0;task.wait(Config.worker_seconds) end
    if not self:process(e) then
     e.failures+=1
     warn("Profile operation delayed for player "..player.UserId.."; retrying this player's queue")
     player:SetAttribute("ProfileStatus","Rewards delayed. Retrying.")
     task.wait(math.min(Config.retry_max_seconds,2^math.min(e.failures,3)))
    end
   elseif e.leaving and os.clock()&gt;=(e.releaseAt or 0) then
    e.closing=true
    self.service:setProducerConnected(e.account,false)
    profile:EndSession()
   else
    if os.clock()&gt;=nextStatus then self:update(e);nextStatus=os.clock()+Config.status_seconds end
    task.wait(Config.worker_seconds)
   end
  end
 end)
end
function Runtime:process(e)
 local op=e.queue[1];if not op then return true end
 local success,result=pcall(function()return self.service:apply(e.account,op)end)
 if not success or (result.status~="ok" and result.status~="error") then return false end
 table.remove(e.queue,1);e.failures=0
 local done=e.callbacks[op.id];e.callbacks[op.id]=nil
 if done then task.defer(done,result.status=="ok",result.value or result.code) end
 if result.status=="error" then warn("Profile operation refused for player "..e.player.UserId..": "..tostring(result.code)) end
 self:update(e)
 return true
end
function Runtime:flush(e)
 while e.queue[1] do if not self:process(e) then return false end end
 return true
end
function Runtime:update(e)
 local view=self.service:view(e.account);if view.status~="ok" then return end
 e.snapshot=view.value
 e.player:SetAttribute("Paper",math.floor(e.snapshot.paperMilli/Economy.MILLI))
 e.player:SetAttribute("XP",math.floor(e.snapshot.xpMilli/Economy.MILLI))
 e.player:SetAttribute("Level",Economy.levelForXP(e.snapshot.xpMilli))
 e.player:SetAttribute("Graduated",e.snapshot.qualification.count&gt;=Gameplay.bots.rookie_qualifying_matches)
 e.player:SetAttribute("ProfileStatus",self.mock and "Studio session only" or (e.saveDelayed and "Saving delayed. Progress is held in this server." or (e.lastSavedVersion&gt;=e.snapshot.version and "Saved" or "Waiting to save")))
end
function Runtime:view(player)
 local e=self.entries[player];if not e or not e.loaded or e.leaving or e.closing then return nil end
 local current=self.service:view(e.account)
 return current.status=="ok" and current.value or nil
end
function Runtime:playerForUserId(id)
 for player,e in pairs(self.entries) do if player.UserId==id and e.loaded and not e.closing then return player end end
 return nil
end
function Runtime:enqueue(player,input,source,callback)
 local e=self.entries[player];if not e or not e.loaded or e.closing then return false end
 if source and e.seen[source] then return true end
 if #e.queue&gt;=Config.queue_limit then return false end
 local copy=Schema.copy(input);if not copy then return false end
 if (copy.kind=="contribution" or copy.kind=="finalBonus") and not copy.multipliers then
  local capture=self.service:producerCapture(e.account)
  if capture.status~="ok" then return false end
  copy.multipliers=assert(Schema.copy(capture.value))
 end
 local op=self.service:prepare(e.account,copy);if not op then return false end
 if source then e.seen[source]=true end
 table.insert(e.queue,op);e.callbacks[op.id]=callback
 return true
end
return Runtime
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ROJO_242">
        <Properties>
          <string name="Name">ProfileService</string>
          <string name="Source">-- ProfileStore owns persistence and session locking. Operations below never yield.
local Http=game:GetService("HttpService")
local Run=game:GetService("RunService")
local Root=game.ReplicatedStorage.FlyFightPaper
local Schema=require(Root.Shared.ProfileSchema)
local Economy=require(Root.Shared.EconomyRules)
local BoostClock=require(Root.Shared.BoostClock)
local Gameplay=require(Root.Generated.Gameplay)
local Config=require(Root.Generated.Server).profiles
local Service={};Service.__index=Service
local function outcome(status,code,value) return {status=status,code=code,value=value} end
local function count(t) local n=0;for _ in pairs(t) do n+=1 end;return n end
function Service.new(options)
 return setmetatable({catalog=options.catalog,mono=options.monotonic or os.clock,
  mock=Run:IsStudio() and options.mock==true,sessions={}},Service)
end
function Service:operationID() return Http:GenerateGUID(false):gsub("%-",""):sub(1,24) end
function Service:attach(account,profile,availability)
 if self.sessions[account] then return outcome("error","already_loaded") end
 if not profile:IsActive() then return outcome("error","session_lost") end
 local data,why=Schema.migrate(profile.Data,self.catalog)
 if not data then return outcome("error",why) end
 -- An old plane cannot survive a server hop. Reserved but unused Paper returns once.
 for _,intent in pairs(data.refolds or {}) do
  if intent.state=="reserved" or intent.state=="delivered" then
   if data.paperMilli&gt;Economy.MAX_SAFE_INTEGER-intent.costMilli then return outcome("error","overflow") end
   data.paperMilli+=intent.costMilli
  end
 end
 if data.generation&gt;=Economy.MAX_SAFE_INTEGER then return outcome("error","generation_overflow") end
 data.refolds={};data.generation+=1
 local token=self:operationID()
 table.insert(data.operationSessions,token);data.operationIds[token]=0
 if #data.operationSessions&gt;Config.session_id_history then data.operationIds[table.remove(data.operationSessions,1)]=nil end
 local connected=availability.connected==true;local mapLoaded=availability.mapLoaded==true
 self.sessions[account]={profile=profile,token=token,sequence=0,connected=connected,mapLoaded=mapLoaded,
  clock=BoostClock.new(data.boosts,self.mono(),connected and mapLoaded,{historyLimit=Config.boost_history_limit}),results={},resultOrder={}}
 profile.Data=data
 return self:view(account)
end
function Service:_session(account)
 local s=self.sessions[account]
 if s and s.profile:IsActive() then return s end
 return nil
end
function Service:_advance(s)
 local ok,why=s.clock:advance(self.mono(),s.connected and s.mapLoaded)
 if not ok then return false,why end
 s.profile.Data.boosts=assert(Schema.copy(s.clock:snapshot()))
 return true
end
function Service:view(account)
 local s=self:_session(account);if not s then return outcome("error","profile_unavailable") end
 local ok,why=self:_advance(s);if not ok then return outcome("error",why) end
 local data=assert(Schema.copy(s.profile.Data))
 -- Compatibility for desk life checks. This is a session token, not a storage lock.
 data.lease={nonce=s.token,generation=data.generation,expires=0}
 return outcome("ok",nil,Schema.freeze(data))
end
function Service:prepare(account,input)
 local s=self:_session(account);if not s then return nil end
 local op=Schema.copy(input);if not op then return nil end
 s.sequence+=1;op.id=s.token..":"..s.sequence
 return op
end
function Service:setProducerConnected(account,connected)
 local s=self:_session(account);if not s then return outcome("error","profile_unavailable") end
 local ok,why=self:_advance(s);if not ok then return outcome("error",why) end
 s.connected=connected==true;assert(s.clock:advance(self.mono(),s.connected and s.mapLoaded))
 return outcome("ok")
end
function Service:setProducerMapLoaded(account,loaded)
 local s=self:_session(account);if not s then return outcome("error","profile_unavailable") end
 local ok,why=self:_advance(s);if not ok then return outcome("error",why) end
 s.mapLoaded=loaded==true;assert(s.clock:advance(self.mono(),s.connected and s.mapLoaded))
 return outcome("ok")
end
function Service:producerCapture(account,at)
 local s=self:_session(account);if not s then return outcome("error","profile_unavailable") end
 local ok,why=self:_advance(s);if not ok then return outcome("error",why) end
 local capture,err
 if at and at&lt;s.clock.now then capture,err=s.clock:multipliersAt(at)
 else
  local b=s.clock:snapshot()
  capture={paper=(b.permanentPaper or b.paperSeconds&gt;0) and 2 or 1,xp=(b.permanentXP or b.xpSeconds&gt;0) and 2 or 1,at=s.clock.now,revision=s.clock.revision}
 end
 return outcome(capture and "ok" or "error",err,capture)
end
function Service:liveBoostView(account)
 local s=self:_session(account);if not s then return outcome("error","profile_unavailable") end
 local ok,why=self:_advance(s);if not ok then return outcome("error",why) end
 return outcome("ok",nil,{boosts=s.clock:snapshot()})
end
function Service:detach(account)
 local s=self:_session(account)
 if s then self:_advance(s) end
 self.sessions[account]=nil
end
local function safeAdd(a,b) if not Schema.integer(b) or a&gt;Economy.MAX_SAFE_INTEGER-b then return nil end; return a+b end
function Service:_effect(p,op,boostState)
	if boostState then p.boosts=assert(Schema.copy(boostState)) end
	local v=Schema.economicView(p)
	local applied,err,result
	if op.kind=="contribution" then applied,err=Economy.applyContribution(v,op.points,op.multipliers,op.id)
	elseif op.kind=="finalBonus" then
		applied,err=Economy.applyFinalBonuses(v,{finalPaper=op.finalPaper,finalXP=op.finalXP},op.multipliers,op.id)
	elseif op.kind=="equipmentPurchase" then applied,err=Economy.validateEquipmentPurchase(v,self.catalog,op.catalogID,op.id)
	elseif op.kind=="purchasedPaper" then applied,err=Economy.addPurchasedPaper(v,op.wholePaper,op.id)
	elseif op.kind=="preset" then
		if not Schema.integer(op.slot) or op.slot&lt;1 or op.slot&gt;Gameplay.menus.saved_loadouts then return nil,"invalid_slot" end
		p.presets[op.slot]={name=op.name,loadout=op.loadout}; result={type="PresetSaved",slot=op.slot}
	elseif op.kind=="settings" then p.settings=op.settings; result={type="SettingsSaved"}
	elseif op.kind=="qualification" then
		if not Schema.id(op.matchId) or type(op.activeSeconds)~="number" or op.activeSeconds&lt;Gameplay.bots.qualification_active_seconds or not Schema.integer(op.events) or op.events&lt;Gameplay.bots.qualification_combat_or_objective_events then return nil,"not_qualified" end
		local already=p.qualification.history[op.matchId]==true or p.qualification.count&gt;=Gameplay.bots.rookie_qualifying_matches
		if not already then p.qualification.history[op.matchId]=true; p.qualification.count+=1 end
		result={type="QualificationRecorded",count=p.qualification.count,alreadyQualified=already}
	elseif op.kind=="boostIntent" then
		-- The preview from Shared.BoostClock has already settled time and applied this
		-- verified intent. No second consuming/granting authority lives in storage.
		if not boostState then return nil,"boost_preview_required" end
		result={type="BoostIntentApplied",resource=op.resource,action=op.action}
	elseif op.kind=="refoldIntent" then
		if not Schema.id(op.intentId) or type(op.fence)~="table" or type(op.loadout)~="table" then return nil,"invalid_refold_intent" end
		if op.fence.nonce~=p.lease.nonce or op.fence.generation~=p.generation then return nil,"refold_fence_lost" end
		if not self.catalog:validateLoadout(op.loadout,p.ownership,assert(Economy.levelForXP(p.xpMilli))) then return nil,"invalid_refold_build" end
		p.refolds=p.refolds or {}
		if p.refolds[op.intentId] then return nil,"intent_exists" end
		if count(p.refolds)&gt;=Config.max_refolds then return nil,"refold_backpressure" end
		local cost=require(Root.Generated.Gameplay).service.full_refold_paper*1000
		if p.paperMilli&lt;cost then return nil,"insufficient_paper" end
		p.paperMilli-=cost
		p.refolds[op.intentId]={state="reserved",costMilli=cost,fence=op.fence,loadout=op.loadout}
		result={type="RefoldReserved",intentId=op.intentId}
	elseif op.kind=="refoldDeliver" or op.kind=="refoldCancel" or op.kind=="refoldRetire" or op.kind=="refoldRefund" or op.kind=="refoldApplied" then
		local intent=p.refolds and p.refolds[op.intentId]
		if not intent then return nil,"missing_refold_intent" end
		if op.kind=="refoldApplied" then
			if intent.fence.nonce~=p.lease.nonce or intent.fence.generation~=p.generation then return nil,"refold_fence_lost" end
			if intent.state~="delivered" and intent.state~="applied" then return nil,"refold_not_delivered" end
			intent.state="applied";result={type="RefoldApplied",intentId=op.intentId}
		elseif op.kind=="refoldRetire" then
			if intent.state=="reserved" then return nil,"refold_not_terminal" end
			p.refolds[op.intentId]=nil; result={type="RefoldRetired",intentId=op.intentId}
		elseif op.kind=="refoldDeliver" then
			if intent.state=="cancelled" then return nil,"refold_cancelled" end
			if intent.state=="applied" then return nil,"refold_already_applied" end
			if intent.fence.nonce~=p.lease.nonce or intent.fence.generation~=p.generation then return nil,"refold_fence_lost" end
			intent.state="delivered"; result={type="RefoldDelivered",intentId=op.intentId}
		elseif op.kind=="refoldRefund" then
			-- Compensate when delivery finished after its life ended.
			-- The ordinary cancellation path still cannot undo an applied refold.
			if intent.fence.nonce~=p.lease.nonce or intent.fence.generation~=p.generation then return nil,"refold_fence_lost" end
			if intent.state=="reserved" then return nil,"refold_not_delivered" end
			if intent.state=="applied" then return nil,"refold_already_applied" end
			if intent.state=="delivered" then
				local refunded=safeAdd(p.paperMilli,intent.costMilli);if not refunded then return nil,"overflow" end
				p.paperMilli=refunded;intent.state="cancelled"
			end
			result={type="RefoldUndeliveredRefund",intentId=op.intentId}
		else
			if intent.state=="delivered" or intent.state=="applied" then return nil,"refold_already_delivered" end
			if intent.state=="reserved" then
				local refunded=safeAdd(p.paperMilli,intent.costMilli); if not refunded then return nil,"overflow" end
				p.paperMilli=refunded; intent.state="cancelled"
			end
			result={type="RefoldCancelled",intentId=op.intentId}
		end
	elseif op.kind=="statistics" then
		if type(op.deltas)~="table" then return nil,"invalid_statistics" end
		for k,n in pairs(op.deltas) do if p.statistics[k]==nil then return nil,"invalid_statistic" end; local value=safeAdd(p.statistics[k],n); if not value then return nil,"overflow" end; p.statistics[k]=value end
		result={type="StatisticsApplied"}
	end
	if err then return nil,err.code end
	if applied then Schema.mergeEconomic(p,applied.profile); result=applied.operation end
	if not result then return nil,"unsupported_operation" end
	return assert(Schema.copy(result))
end
local allowed={contribution=true,finalBonus=true,equipmentPurchase=true,preset=true,settings=true,
 qualification=true,purchasedPaper=true,boostIntent=true,statistics=true,refoldIntent=true,
 refoldDeliver=true,refoldCancel=true,refoldRetire=true,refoldRefund=true,refoldApplied=true}
function Service:apply(account,input)
 local s=self:_session(account);if not s then return outcome("retry","profile_unavailable") end
 local op=Schema.copy(input)
 if not op or not allowed[op.kind] or not Schema.id(op.id) then return outcome("error","invalid_operation") end
 local token,sequence=op.id:match("^(%w+):(%d+)$");sequence=tonumber(sequence)
 if token~=s.token or not Schema.integer(sequence) or sequence&lt;1 then return outcome("error","old_session_operation") end
 local identity=Schema.canonical(op)
 local cached=s.results[op.id]
 if cached and cached.identity~=identity then return outcome("error","operation_id_conflict") end
 if sequence&lt;=s.profile.Data.operationIds[token] then
  return outcome("ok",nil,cached and cached.value or {type="AlreadyApplied",operationID=op.id})
 end
 if (op.kind=="purchasedPaper" or op.kind=="boostIntent") and not self.mock then return outcome("error","studio_only") end
 local advanced,why=self:_advance(s);if not advanced then return outcome("retry",why) end
 local clock=s.clock
 if op.kind=="boostIntent" then
  clock=BoostClock.new(s.clock:snapshot(),s.clock.now,s.clock.eligible,{historyLimit=Config.boost_history_limit})
  clock.startedAt=s.clock.startedAt;clock.watermark=s.clock.watermark;clock.revision=s.clock.revision
  clock.intervals=assert(Schema.copy(s.clock.intervals));clock.changes=assert(Schema.copy(s.clock.changes))
  local ok,err
  if op.action=="duration" then ok,err=clock:grantVerifiedTemporary(op.resource,op.seconds,self.mono())
  elseif op.action=="permanent" then ok,err=clock:grantVerifiedPermanent(op.resource,self.mono()) end
  if not ok then return outcome("error",err or "invalid_boost_intent") end
 end
 local data=assert(Schema.copy(s.profile.Data));data.lease={nonce=s.token,generation=data.generation,expires=0}
 local result,err=self:_effect(data,op,clock:snapshot())
 if not result then return outcome("error",err) end
 data.lease=nil;data.version+=1;data.operationIds[token]=sequence
 local valid,validation=Schema.validate(data,self.catalog)
 if not valid then return outcome("error",validation) end
 -- No yield between active-session check and replacing Data. One saved profile contains
 -- both the balance change and its operation ID, so retries cannot pay it twice.
 s.profile.Data=valid;s.clock=clock
 result.operationID=op.id;result.version=data.version
 s.results[op.id]={identity=identity,value=result};table.insert(s.resultOrder,op.id)
 if #s.resultOrder&gt;Config.result_cache_limit then s.results[table.remove(s.resultOrder,1)]=nil end
 return outcome("ok",nil,result)
end
return Service
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ROJO_243">
        <Properties>
          <string name="Name">PropsService</string>
          <string name="Source">-- Only authored small flags can break. They reset once per round.
local Service={};Service.__index=Service
function Service.new(room)
 local self=setmetatable({parts={}},Service)
 for _,part in ipairs(room:GetDescendants()) do
  if part:IsA("BasePart") and part.Name:match("^Prop_Flag%d+$") then self.parts[part]={transparency=part.Transparency,query=part.CanQuery,collide=part.CanCollide} end
 end
 return self
end
function Service:breakPart(part)
 if not self.parts[part] or part:GetAttribute("Broken") then return false end
 part:SetAttribute("Broken",true);part.Transparency=1;part.CanQuery=false;part.CanCollide=false;return true
end
function Service:reset()
 for part,original in pairs(self.parts) do
  part:SetAttribute("Broken",false);part.Transparency=original.transparency;part.CanQuery=original.query;part.CanCollide=original.collide
 end
end
return Service
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ROJO_244">
        <Properties>
          <string name="Name">RewardQueue</string>
          <string name="Source">-- A failing profile only holds up that player's rewards. Round state never waits here.
local Root=game.ReplicatedStorage.FlyFightPaper
local Schema=require(Root.Shared.ProfileSchema)
local Config=require(Root.Generated.Server).rewards
local Queue={};Queue.__index=Queue
function Queue.new(profiles,clock,log)
 return setmetatable({profiles=profiles,clock=clock or os.clock,log=log or warn,players={}},Queue)
end
function Queue:add(userId,source,input,at,accepted)
 local bucket=self.players[userId]
 if not bucket then bucket={items={},order={}};self.players[userId]=bucket end
 if bucket.items[source] then return end
 local item={source=source,input=assert(Schema.copy(input)),at=at,accepted=accepted,nextTry=0,nextWarning=0}
 bucket.items[source]=item;table.insert(bucket.order,source)
 if #bucket.order==Config.pending_per_player then self.log("Many rewards pending for player "..userId) end
end
function Queue:step()
 local now=self.clock()
 for userId,bucket in pairs(self.players) do
  -- Each player has independent retries. Other players always get their turn.
  local i=1
  local attempted=0
  while i&lt;=#bucket.order and attempted&lt;Config.attempts_per_player do
   attempted+=1
   local source=bucket.order[i];local item=bucket.items[source]
   if now&lt;item.nextTry then break end
   local ok,accepted=pcall(function()
    local player=self.profiles:playerForUserId(userId)
    if not player then return false end
    if (item.input.kind=="contribution" or item.input.kind=="finalBonus") and not item.input.multipliers then
     local entry=self.profiles.entries[player]
     if not entry then return false end
     local capture=self.profiles.service:producerCapture(entry.account,item.at)
     if capture.status~="ok" then return false end
     item.input.multipliers=assert(Schema.copy(capture.value))
    end
    return self.profiles:enqueue(player,item.input,item.source)
   end)
   if ok and accepted then
    bucket.items[source]=nil;table.remove(bucket.order,i)
    if item.accepted then
     local notified,err=pcall(item.accepted,item.input)
     if not notified then self.log("Reward display update failed: "..tostring(err)) end
    end
   else
    item.nextTry=now+Config.retry_seconds
    if now&gt;=item.nextWarning then
     self.log("Reward delayed for player "..userId.."; retrying without blocking the round")
     item.nextWarning=now+Config.warning_seconds
    end
    break
   end
  end
  if #bucket.order==0 then self.players[userId]=nil end
 end
end
return Queue
</string>
        </Properties>
