			<Item class="Folder" referent="ROJO_206">
        <Properties>
          <string name="Name">Shared</string>
        </Properties>
        <Item class="ModuleScript" referent="ROJO_207">
          <Properties>
            <string name="Name">Aircraft</string>
            <string name="Source">-- Assemble uploaded modular assets. This module contains no mesh geometry.
local Root=script.Parent.Parent
local Aircraft={}
-- Plane A: slots 1/2 sit on the body at the pellet tubes' centres, 3/4 under the wings, 5/6 further out (odd = left).
-- `shift` (the body's catalog wing_shift) moves every slot out with the wings on a wider body.
function Aircraft.mountOffset(slot,factor,shift)
 local pair=math.floor((slot-1)/2)
 local side=slot%2==1 and -1 or 1
 shift=shift or 0
 if pair==0 then return Vector3.new(side*(1.76+shift),.08,-1.3134)*factor end
 return Vector3.new(side*(3.7+(pair-1)*1.5+shift),.38,-.6)*factor
end
-- Where a shot leaves: the weapon model's "Muzzle" (front of what it fires, left-slot frame, mirrored on the right),
-- else half a pellet tube ahead of the slot.
function Aircraft.muzzleOffset(slot,factor,weaponId,shift)
 local pieces=Root:FindFirstChild("Assets") and Root.Assets:FindFirstChild("AircraftPieces")
 local launcher=pieces and weaponId and pieces:FindFirstChild("launcher_"..weaponId)
 local muzzle=launcher and launcher:GetAttribute("Muzzle")
 if not muzzle then return Aircraft.mountOffset(slot,factor,shift)+Vector3.new(0,0,-1.5566*factor) end
 local x,y,z=string.match(muzzle,"([^,]+),([^,]+),([^,]+)")
 local side=slot%2==1 and 1 or -1
 return Aircraft.mountOffset(slot,factor,shift)+Vector3.new(side*tonumber(x),tonumber(y),tonumber(z))*factor
end
-- Team look: red or blue accent pieces; red square or blue circle wing stickers (no team: red accent, white stickers).
function Aircraft.paint(model)
 local appearance=model:FindFirstChild("Appearance");if not appearance then return end
 local team=model:GetAttribute("Team")
 local blue=team=="team:2"
 local accent=blue and Color3.fromRGB(40,95,200) or Color3.fromRGB(206,48,43)
 local pieces=Root:FindFirstChild("Assets") and Root.Assets:FindFirstChild("AircraftPieces")
 local stickers=pieces and pieces:FindFirstChild("Stickers")
 local template=(team=="team:1" or blue) and stickers and stickers:FindFirstChild(blue and "sticker-circle" or "sticker-square")
 local body=model:FindFirstChild("Root")
 local factor=appearance:GetAttribute("Factor") or 1
 local count=0
 for _,part in ipairs(appearance:GetChildren()) do
  local region=part:GetAttribute("Region")
  if part:GetAttribute("TeamSticker") then part:Destroy()
  elseif region=="accent" then part.Color=accent
  elseif region=="sticker" then
   part.Transparency=template and 1 or 0
   if template then
    count+=1
    local sticker=template:Clone();sticker.Name=part.Name:match("^[^-]+").."-team-sticker"..count;sticker.Size=template.Size*factor;sticker.Color=accent
    sticker.CFrame=part.CFrame;sticker.Anchored=part.Anchored;sticker.Massless=true;sticker:SetAttribute("TeamSticker",true);sticker.Parent=appearance
    if body and not part.Anchored then local weld=Instance.new("WeldConstraint");weld.Part0=body;weld.Part1=sticker;weld.Parent=sticker end
   end
  end
 end
end
function Aircraft.build(model,loadout,catalog,preview)
 local assets=Root:FindFirstChild("Assets")
 local library=assets and assets:FindFirstChild("AircraftParts")
 local pieces=assets and assets:FindFirstChild("AircraftPieces")
 if not library and not pieces then return false end
 for _,slot in ipairs({"body","nose","wings","tail"}) do
  local template=library and library:FindFirstChild(loadout[slot])
  if not (pieces and pieces:FindFirstChild(loadout[slot])) and (not template or template.MeshId=="") then return false end
 end
 local body=model:FindFirstChild("Root")
 local old=model:FindFirstChild("Appearance");if old then old:Destroy() end
 local appearance=Instance.new("Model");appearance.Name="Appearance";appearance.Parent=model
 local factor=catalog:get(loadout.body).visual_scale/2
 local shift=catalog:get(loadout.body).wing_shift or 0
 appearance:SetAttribute("Factor",factor)
 local function put(template,name,offset,rotation)
  local part=template:Clone();part.Name=name;part.Size*=factor
  part.CFrame=(body and body.CFrame or CFrame.identity)*CFrame.new(offset)*rotation
  part.Anchored=preview==true;part.Massless=true;part.CanCollide=false;part.CanQuery=false;part.CanTouch=false;part.Parent=appearance
  if body and not preview then local weld=Instance.new("WeldConstraint");weld.Part0=body;weld.Part1=part;weld.Parent=part end
 end
 for _,slot in ipairs({"body","nose","wings","tail"}) do
  local multi=pieces and pieces:FindFirstChild(loadout[slot])
  if multi then
   for _,child in ipairs(multi:GetChildren()) do if child:IsA("MeshPart") then
    -- Wing halves (and their stickers) slide out so each root meets a wide body's own side.
    local out=slot=="wings" and (child.Name:match("%-L$") or child.Name:match("%-left$")) and -shift
     or slot=="wings" and (child.Name:match("%-R$") or child.Name:match("%-right$")) and shift or 0
    put(child,slot.."-"..child.Name,(child.Position+Vector3.new(out,0,0))*factor,child.CFrame.Rotation)
   end end
  else
   local template=library and library:FindFirstChild(loadout[slot])
   if template then put(template,slot,template.CFrame.Position*factor,template.CFrame.Rotation) end
  end
 end
 local equipment=assets:FindFirstChild("EquipmentParts")
 for slot,id in ipairs(loadout.weapon_mounts) do if id then
  local launcher=pieces and pieces:FindFirstChild("launcher_"..id)
  if launcher then
   -- Pieces are modelled on the left tube; the right side mirrors them in X (they are symmetric).
   -- Each piece carries the 180-degree turn every uploaded FBX needs (Roblox imports them facing backwards).
   local side=slot%2==1 and 1 or -1
   for _,child in ipairs(launcher:GetChildren()) do if child:IsA("MeshPart") then
    local at=child.Position
    put(child,"Mount"..slot.."-"..child.Name,Aircraft.mountOffset(slot,factor,shift)+Vector3.new(side*at.X,at.Y,at.Z)*factor,child.CFrame.Rotation)
   end end
  elseif equipment and equipment:FindFirstChild("launcher_"..id) then
   local template=equipment["launcher_"..id]
   put(template,"Mount"..slot,Aircraft.mountOffset(slot,factor,shift),template.CFrame.Rotation)
  end
 end end
 local booster=loadout.utility and pieces and pieces:FindFirstChild(loadout.utility)
 if booster then
  -- Modelled under the standard body; other bodies say how much lower theirs hangs.
  local drop=tonumber(pieces[loadout.body]:GetAttribute("BoosterDrop") or 0) or 0
  for _,child in ipairs(booster:GetChildren()) do if child:IsA("MeshPart") then put(child,"Booster-"..child.Name,(child.Position+Vector3.new(0,drop,0))*factor,child.CFrame.Rotation) end end
 elseif equipment and loadout.utility and equipment:FindFirstChild(loadout.utility) then
  local template=equipment[loadout.utility]
  put(template,"Booster",Vector3.new(0,.9,2.4)*factor,template.CFrame.Rotation)
 end
 if body then body.Size=Vector3.new(14,2,15)*factor end
 Aircraft.paint(model)
 if not model:GetAttribute("PaintBound") then
  model:SetAttribute("PaintBound",true)
  model:GetAttributeChangedSignal("Team"):Connect(function() Aircraft.paint(model) end)
 end
 return true
end
-- Guns on the wings are angled to meet `distance` studs ahead of the plane, like a real fighter's guns,
-- so both streams cross the aim point instead of flying past either side of it.
function Aircraft.converge(body,position,direction,distance)
 return (body.Position+direction*distance-position).Unit
end
-- Projectiles are drawn from their ammo model (erasers 2.5x so they read as missiles); hits use the same box.
function Aircraft.projectile(weaponId,homing)
 local equipment=Root:FindFirstChild("Assets") and Root.Assets:FindFirstChild("EquipmentParts")
 local template=equipment and weaponId and equipment:FindFirstChild("ammo_"..weaponId)
 if not template then return nil end
 return template.Size*(homing and 2.5 or 1),template.CFrame.Rotation
end
-- What a shot looks like (Alan): the launcher's own round (its "fire"/"drop" piece), scaled evenly to the length of
-- the ammo box the hits use, and slimmed only where it would be over 1.5x that box (a thin wire stays a wire).
-- Launchers without one (rubber band) keep the ammo model. Pieces turn by 90-degree steps, so axes map one to one.
function Aircraft.shotLook(weaponId)
 local pieces=Root:FindFirstChild("Assets") and Root.Assets:FindFirstChild("AircraftPieces")
 local launcher=pieces and weaponId and pieces:FindFirstChild("launcher_"..weaponId)
 if not launcher then return nil end
 for _,child in ipairs(launcher:GetChildren()) do
  local role=child:GetAttribute("Role")
  if child:IsA("MeshPart") and (role=="fire" or role=="drop") then return child end
 end
 return nil
end
function Aircraft.shotSize(weaponId,homing,look)
 local size,rotation=Aircraft.projectile(weaponId,homing)
 if not size or not look then return size end
 local abs=function(v) return Vector3.new(math.abs(v.X),math.abs(v.Y),math.abs(v.Z)) end
 local box=abs(rotation:VectorToWorldSpace(size))
 local own=abs(look.CFrame.Rotation:VectorToWorldSpace(look.Size))
 local even=own*(math.max(box.X,box.Y,box.Z)/math.max(own.X,own.Y,own.Z))
 return abs(look.CFrame.Rotation:VectorToObjectSpace(even:Min(box*1.5)))
end
return Aircraft
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ROJO_208">
          <Properties>
            <string name="Name">BoostClock</string>
            <string name="Source">-- Loaded-online time only. Pure state/history, never a receipt verifier or durable store.
local Clock = {}
Clock.__index = Clock
local MAX = 9007199254740991
local fields = { paperSeconds = true, xpSeconds = true, permanentPaper = true, permanentXP = true }
local function finite(n) return type(n) == "number" and n == n and n &gt;= 0 and n &lt;= MAX end
local function copyState(s)
    assert(type(s) == "table" and getmetatable(s) == nil, "invalid_boost_state")
    for k in pairs(s) do assert(fields[k], "unknown_boost_field") end
    assert(finite(s.paperSeconds) and finite(s.xpSeconds), "invalid_remaining_seconds")
    assert(type(s.permanentPaper) == "boolean" and type(s.permanentXP) == "boolean", "invalid_permanent_flags")
    return table.clone(s)
end
local function multipliers(s)
    return (s.permanentPaper or s.paperSeconds &gt; 0) and 2 or 1,
        (s.permanentXP or s.xpSeconds &gt; 0) and 2 or 1
end
local function result(p, x, at, revision)
    return table.freeze({ paper = p, xp = x, at = at, revision = revision })
end
function Clock.new(state, now, eligible, options)
    assert(finite(now) and type(eligible) == "boolean", "invalid_clock_start")
    local limit = options and options.historyLimit or 256
    assert(finite(limit) and limit % 1 == 0 and limit &gt;= 3 and limit &lt;= 4096, "invalid_history_limit")
    return setmetatable({ state = copyState(state), now = now, eligible = eligible,
        startedAt = now, watermark = -1, revision = 0, intervals = {}, changes = {}, limit = limit }, Clock)
end
function Clock:snapshot() return table.freeze(copyState(self.state)) end
function Clock:capture()
    if not self.eligible then return nil, "ineligible_interval" end
    local p, x = multipliers(self.state)
    return result(p, x, self.now, self.revision)
end
-- Advance before changing loaded/available status, using the old status for elapsed time.
-- A newly restored clock starts at the current monotonic time; offline time is never subtracted.
function Clock:advance(now, eligible)
    if not finite(now) or now &lt; self.now or type(eligible) ~= "boolean" then return false, "invalid_clock" end
    local state, intervals, at = copyState(self.state), {}, self.now
    for _, old in ipairs(self.intervals) do table.insert(intervals, table.clone(old)) end
    while at &lt; now do
        local finish, paperEnd, xpEnd = now, nil, nil
        if self.eligible then
            if not state.permanentPaper and state.paperSeconds &gt; 0 then paperEnd = at + state.paperSeconds; finish = math.min(finish, paperEnd) end
            if not state.permanentXP and state.xpSeconds &gt; 0 then xpEnd = at + state.xpSeconds; finish = math.min(finish, xpEnd) end
        end
        if finish &lt;= at then return false, "clock_precision" end
        local p, x = multipliers(state)
        local last = intervals[#intervals]
        if last and last.finish == at and last.paper == p and last.xp == x and last.eligible == self.eligible then
            last.finish = finish
        else
            if #intervals &gt;= self.limit then return false, "history_backpressure" end
            table.insert(intervals, { start = at, finish = finish, paper = p, xp = x, eligible = self.eligible })
        end
        if self.eligible then
            local elapsed = finish - at
            -- A selected expiry consumes that duration exactly. Subtracting the
            -- rounded timestamp difference can otherwise leave a positive residue
            -- too small to advance the next timestamp. The guard above still
            -- rejects durations whose initial endpoint cannot be represented.
            if not state.permanentPaper then state.paperSeconds = finish == paperEnd and 0 or math.max(0, state.paperSeconds - elapsed) end
            if not state.permanentXP then state.xpSeconds = finish == xpEnd and 0 or math.max(0, state.xpSeconds - elapsed) end
        end
        at = finish
    end
    self.state, self.intervals, self.now, self.eligible = state, intervals, now, eligible
    return true
end
function Clock:canOfferTemporary(resource)
    if resource == "paper" then return not self.state.permanentPaper end
    if resource == "xp" then return not self.state.permanentXP end
    return false
end
-- Caller has already verified/journaled the grant. An in-flight receipt can add dormant
-- time after a permanent upgrade. Never call this from a purchase-prompt callback.
function Clock:grantVerifiedTemporary(resource, seconds, now)
    local field = resource == "paper" and "paperSeconds" or resource == "xp" and "xpSeconds" or nil
    if not field or not finite(seconds) or seconds &lt;= 0 or seconds % 1 ~= 0 then return false, "invalid_grant" end
    if self.state[field] &gt; MAX - seconds then return false, "overflow" end
    if #self.changes &gt;= self.limit then return false, "history_backpressure" end
    local ok, why = self:advance(now, self.eligible)
    if not ok then return false, why end
    self.state[field] += seconds
    self.revision += 1
    table.insert(self.changes, now)
    return true
end
function Clock:grantVerifiedPermanent(resource, now)
    local field = resource == "paper" and "permanentPaper" or resource == "xp" and "permanentXP" or nil
    if not field then return false, "invalid_resource" end
    if self.state[field] then return self:advance(now, self.eligible) end
    if #self.changes &gt;= self.limit then return false, "history_backpressure" end
    local ok, why = self:advance(now, self.eligible)
    if not ok then return false, why end
    self.state[field], self.revision = true, self.revision + 1
    table.insert(self.changes, now)
    return true
end
function Clock:multipliersAt(at)
    if not finite(at) or at &lt; self.startedAt or at &lt;= self.watermark or at &gt; self.now then return nil, "history_unavailable" end
    -- A timestamp alone cannot order a grant and reward at the same instant. Producers
    -- should capture() at occurrence; delayed timestamp-only events fail closed here.
    for _, changedAt in ipairs(self.changes) do if changedAt == at then return nil, "ambiguous_event_order" end end
    if at == self.now then return self:capture() end
    for _, span in ipairs(self.intervals) do
        if at &gt;= span.start and at &lt; span.finish then
            if not span.eligible then return nil, "ineligible_interval" end
            return result(span.paper, span.xp, at, nil)
        end
    end
    return nil, "history_unavailable"
end
-- Only call after the downstream durable earning/replay watermark proves older events
-- no longer need this history. History pressure must block earning, never assume 1x/2x.
function Clock:pruneThrough(at)
    if not finite(at) or at &lt; self.watermark or at &gt; self.now then return false, "invalid_watermark" end
    local intervals, changes = {}, {}
    for _, span in ipairs(self.intervals) do if span.finish &gt; at then table.insert(intervals, span) end end
    for _, changedAt in ipairs(self.changes) do if changedAt &gt; at then table.insert(changes, changedAt) end end
    self.intervals, self.changes, self.watermark = intervals, changes, at
    return true
end
return Clock
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ROJO_209">
          <Properties>
            <string name="Name">BotBuilds</string>
            <string name="Source">local Config=require(script.Parent.Parent.Generated.Gameplay)
local Rules=require(script.Parent.CombatRules)
local BotBuilds={}

BotBuilds.TIERS={
	rookie={
		{name="Starter Burst",loadout={
			body="body_standard",nose="nose_0",wings="wings_0",tail="tail_0",
			weapon_mounts={"staple","staple",false,false},
		}},
		-- The plane every new player starts with.
		{name="Classic Pellets",loadout={
			body="body_standard",nose="nose_0",wings="wings_0",tail="tail_0",
			weapon_mounts={"pellet","pellet",false,false},
		}},
		{name="Rubber Scout",loadout={
			body="body_slim",nose="nose_2",wings="wings_0",tail="tail_2",
			weapon_mounts={"rubber",false,false},
		}},
	},
	regular={
		{name="Clip Skirmisher",loadout={
			body="body_slim",nose="nose_4",wings="wings_2",tail="tail_3",
			weapon_mounts={"paperclip","pellet",false},
		}},
		{name="Guided Escort",loadout={
			body="body_standard",nose="nose_4",wings="wings_2",tail="tail_3",
			weapon_mounts={"eraser",false,"staple","staple"},
		}},
		{name="Burst Duelist",loadout={
			body="body_standard",nose="nose_4",wings="wings_3",tail="tail_1",
			weapon_mounts={"staple","staple","rubber",false},
		}},
	},
	experienced={
		{name="Clip Ace",loadout={
			body="body_slim",nose="nose_4",wings="wings_5",tail="tail_4",
			weapon_mounts={"paperclip","pellet","pellet"},
		}},
		{name="Guided Gunship",loadout={
			body="body_heavy",nose="nose_4",wings="wings_5",tail="tail_4",
			weapon_mounts={"eraser","pellet","pellet","pellet",false,false},
		}},
		{name="Pencil Interceptor",loadout={
			body="body_standard_mk2",nose="nose_4",wings="wings_5",tail="tail_4",
			weapon_mounts={"pencil",false,"pellet",false},
		}},
	},
}

function BotBuilds.weapon(catalog,weaponId,range)
	local weapon=catalog:get(weaponId)
	assert(weapon and weapon.class,"Unknown weapon: "..tostring(weaponId))
	local dps
	if weapon.fire_mode=="burst" then dps=weapon.damage*weapon.burst_count/weapon.burst_period
	else dps=weapon.damage/weapon.shot_interval end
	local time=weapon.windup_seconds+Rules.travelTime(weapon,range) -- math.huge when out of range
	return {
		dps=dps,timeToTarget=time,leadStuds=110*time,
		spreadStuds=range*math.tan(math.rad(weapon.spread_deg))+weapon.wobble_studs,
		homing=weapon.homing,
	}
end

function BotBuilds.measure(catalog,loadout,tier)
	local profile=assert(Config.bots.profiles[tier],"Unknown bot tier: "..tostring(tier))
	local stats=assert(catalog:deriveStats(loadout))
	local speed=stats.speed*profile.speed_factor
	local pitch,yaw=stats.pitch*profile.turn_factor,stats.yaw*profile.turn_factor
	local dps,dodge,erasers,pencils=0,math.huge,0,0
	for _,id in ipairs(loadout.weapon_mounts) do
		if id~=false then
			local gun=BotBuilds.weapon(catalog,id,300)
			dps+=gun.dps
			dodge=math.min(dodge,gun.homing and 0 or gun.timeToTarget)
			if id=="eraser" then erasers+=1 end
			if id=="pencil" then pencils+=1 end
		end
	end
	return {
		health=stats.health,speed=speed,pitch=pitch,yaw=yaw,
		turnRadius=speed/math.rad(math.min(pitch,yaw)),
		dps=dps,ttk=dps&gt;0 and Config.combat.reference_health/dps or math.huge,
		dodge=dodge,erasers=erasers,pencils=pencils,
	}
end

local function copy(value)
	if type(value)~="table" then return value end
	local result={}
	for key,item in pairs(value) do result[key]=copy(item) end
	return result
end

function BotBuilds.pick(tier,serial)
	local builds=assert(BotBuilds.TIERS[tier],"Unknown bot tier: "..tostring(tier))
	local build=builds[((serial-1)%#builds)+1]
	return copy(build.loadout),build.name
end

return BotBuilds
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ROJO_210">
          <Properties>
            <string name="Name">BotNames</string>
            <string name="Source">-- Made-up pilot names in the styles Roblox players use (word + word + digits, lowercase handles, a name and a
-- year, "its"/"im" tags, the odd xX..Xx). Never copied from real accounts (VISION: no forged Roblox accounts).
-- Every name follows Roblox's username rules: 3-20 letters/digits, at most one underscore, not at either end.
local BotNames = {}

local ADJECTIVES = { "Sneaky", "Fuzzy", "Frosty", "Crispy", "Sleepy", "Speedy", "Lucky", "Silly", "Mighty", "Tiny",
	"Cosmic", "Pixel", "Shadow", "Turbo", "Golden", "Hyper", "Epic", "Spicy", "Sunny", "Wobbly", "Chill", "Jolly",
	"Neon", "Lazy", "Swift", "Bouncy", "Crunchy", "Salty", "Mystic", "Royal", "Sparkly", "Stormy", "Icy", "Rusty",
	"Grumpy", "Happy", "Wild", "Dizzy", "Fluffy", "Sly" }
local NOUNS = { "Noodle", "Panda", "Taco", "Pickle", "Wolf", "Fox", "Dragon", "Ninja", "Cookie", "Potato", "Bean",
	"Toast", "Penguin", "Waffle", "Comet", "Rocket", "Blade", "Llama", "Gamer", "Pilot", "Muffin", "Burrito", "Frog",
	"Kitten", "Tiger", "Bunny", "Shark", "Ghost", "Knight", "Wizard", "Nugget", "Pancake", "Cactus", "Bear", "Raven",
	"Hawk", "Storm", "Spark", "Duck", "Owl", "Mango", "Kiwi", "Yeti", "Goose" }
local FIRST = { "Maya", "Jayden", "Luna", "Ethan", "Ava", "Liam", "Zoe", "Noah", "Mia", "Leo", "Ella", "Kai", "Lily",
	"Max", "Aria", "Owen", "Chloe", "Eli", "Nova", "Finn", "Ivy", "Theo", "Ruby", "Jack" }

-- pick(n) returns a whole number from 1 to n; the caller decides how it is seeded.
local function digits(pick)
	local style = pick(4)
	if style == 1 then return tostring(2007 + pick(12)) end -- a birth or join year
	if style == 2 then return tostring(pick(99)) end
	if style == 3 then return string.format("%02d", pick(99)) end
	return tostring(99 + pick(9900))
end

local function word(list, pick) return list[pick(#list)] end

local PATTERNS = {
	{ 30, function(p) return word(ADJECTIVES, p) .. word(NOUNS, p) .. digits(p) end },          -- SneakyNoodle482
	{ 14, function(p) return string.lower(word(ADJECTIVES, p) .. word(NOUNS, p)) .. (p(2) == 1 and digits(p) or "") end }, -- frostybanana
	{ 12, function(p) return string.lower(word(NOUNS, p) .. "_" .. word(NOUNS, p)) end },        -- toast_wizard
	{ 12, function(p)                                                                            -- maya2013, Jayden_09
		local name = word(FIRST, p)
		if p(2) == 1 then name = string.lower(name) end
		return name .. (p(3) == 1 and "_" or "") .. digits(p)
	end },
	{ 8, function(p) return (p(2) == 1 and "its" or "im") .. (p(2) == 1 and word(FIRST, p) or word(NOUNS, p)) end }, -- itsLuna
	{ 10, function(p) return word(ADJECTIVES, p) .. word(NOUNS, p) end },                        -- PixelPanda
	{ 9, function(p) return word(NOUNS, p) .. word(NOUNS, p) .. digits(p) end },                 -- BeanWolf77
	{ 5, function(p) return "xX" .. word(ADJECTIVES, p) .. word(NOUNS, p) .. "Xx" end },         -- xXShadowFoxXx
}
local TOTAL = 0
for _, pattern in ipairs(PATTERNS) do TOTAL += pattern[1] end

function BotNames.valid(name)
	return type(name) == "string" and #name &gt;= 3 and #name &lt;= 20 and name:match("^[%w]+_?[%w]+$") ~= nil
end

-- One candidate name. Callers retry with a fresh pick on a clash or an invalid result.
function BotNames.make(pick)
	local roll = pick(TOTAL)
	for _, pattern in ipairs(PATTERNS) do
		roll -= pattern[1]
		if roll &lt;= 0 then return pattern[2](pick) end
	end
	return PATTERNS[1][2](pick)
end

return BotNames
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ROJO_211">
          <Properties>
            <string name="Name">BotRosterRules</string>
            <string name="Source">-- Pure server-side roster planning. Inputs are trusted server summaries only.
-- Callers own persistence, actor creation/removal, routing, and monotonic bot identity allocation.
local Rules = {}

Rules.MAX_ACTORS = 12
Rules.MAX_PENDING_HUMANS = 64
local UINT32 = 4294967296
local PROFILE_NAMES = { "rookie", "regular", "experienced" }
local PRESETS = {
	"paper_pilot_skywright_v1", "paper_pilot_cloudtail_v1",
	"paper_pilot_inkwing_v1", "paper_pilot_foldcrest_v1",
}
local BotNames = require(script.Parent.BotNames)

local function integer(value, low, high)
	return type(value) == "number" and value == value and value % 1 == 0 and value &gt;= low and value &lt;= high
end

local function denseLength(list, maximum)
	if type(list) ~= "table" then return nil end
	local count, highest = 0, 0
	for key in pairs(list) do
		if not integer(key, 1, maximum) then return nil end
		count += 1
		if key &gt; highest then highest = key end
	end
	if count ~= highest then return nil end
	return count
end

-- FNV-style byte folding plus an integer avalanche. All arithmetic remains exactly
-- representable in Luau's number type; adjacent seat ordinals do not share a linear sample.
local function hash(seed, value)
	local result = seed % UINT32
	for index = 1, #value do
		result = bit32.bxor(result, string.byte(value, index))
		result = (result + bit32.lshift(result, 1) + bit32.lshift(result, 4)
			+ bit32.lshift(result, 7) + bit32.lshift(result, 8) + bit32.lshift(result, 24)) % UINT32
	end
	result = bit32.bxor(result, bit32.rshift(result, 16))
	result = (result + bit32.lshift(result, 3) + bit32.lshift(result, 7)) % UINT32
	result = bit32.bxor(result, bit32.rshift(result, 11))
	result = (result + bit32.lshift(result, 5) + bit32.lshift(result, 9)) % UINT32
	return bit32.bxor(result, bit32.rshift(result, 15))
end

local function teamMode(mode)
	return mode == "TDM" or mode == "CONTROL"
end

local function validMode(mode)
	return mode == "FFA" or teamMode(mode)
end

local function validProfile(profile)
	return profile == "rookie" or profile == "regular" or profile == "experienced"
end

local function validate(input)
	if type(input) ~= "table" then return nil, "input_required" end
	if input.eligibility ~= "rookie" and input.eligibility ~= "regular" then return nil, "invalid_eligibility" end
	if input.serverClass ~= "rookie" and input.serverClass ~= "regular" then return nil, "invalid_server_class" end
	if not integer(input.seed, 0, 4294967295) then return nil, "invalid_seed" end
	if not integer(input.botIdentitySerial, 1, 2147483647) then return nil, "invalid_bot_identity_serial" end
	if not validMode(input.mode) then return nil, "invalid_mode" end
	if type(input.config) ~= "table" or type(input.config.bots) ~= "table" or type(input.config.world) ~= "table" then
		return nil, "gameplay_config_required"
	end
	local maximum = input.config.world.maximum_actors
	local configuredCap = input.config.bots.experienced_cap_per_team_or_ffa
	if maximum ~= Rules.MAX_ACTORS or configuredCap ~= 1 then return nil, "unsupported_roster_config" end
	local actorCount = denseLength(input.actors, Rules.MAX_ACTORS)
	if actorCount == nil then return nil, "actors_must_be_dense_and_at_most_12" end
	local pendingCount = denseLength(input.pendingHumanQueue, Rules.MAX_PENDING_HUMANS)
	if pendingCount == nil then return nil, "pending_queue_must_be_dense_and_bounded" end

	local actorKeys, humanKeys, names, botNames = {}, {}, {}, {}
	local counts = { ["team:1"] = 0, ["team:2"] = 0 }
	local experiencedByGroup = {}
	for index = 1, actorCount do
		local actor = input.actors[index]
		if type(actor) ~= "table" or type(actor.key) ~= "string" or #actor.key &lt; 1 or #actor.key &gt; 80
			or actorKeys[actor.key] then return nil, "invalid_or_duplicate_actor_key" end
		actorKeys[actor.key] = true
		if actor.controllerType ~= "human" and actor.controllerType ~= "bot" then return nil, "invalid_actor_controller" end
		if teamMode(input.mode) then
			if actor.teamId ~= "team:1" and actor.teamId ~= "team:2" then return nil, "invalid_actor_team" end
			counts[actor.teamId] += 1
		elseif actor.teamId ~= nil then
			return nil, "unexpected_actor_team"
		end
		if actor.displayName ~= nil then
			if type(actor.displayName) ~= "string" or #actor.displayName &lt; 1 or #actor.displayName &gt; 48
				or actor.controllerType == "bot" and botNames[actor.displayName] then return nil, "invalid_or_duplicate_display_name" end
			names[actor.displayName] = true
			if actor.controllerType == "bot" then botNames[actor.displayName] = true end
		end
		if actor.controllerType == "human" then
			if type(actor.userKey) ~= "string" or #actor.userKey &lt; 1 or #actor.userKey &gt; 80 or humanKeys[actor.userKey] then
				return nil, "invalid_or_duplicate_human_key"
			end
			humanKeys[actor.userKey] = true
		else
			if not validProfile(actor.profileName) then return nil, "invalid_existing_bot_profile" end
			if type(actor.displayName) ~= "string" or #actor.displayName &lt; 1 or #actor.displayName &gt; 48 then
				return nil, "invalid_existing_bot_name"
			end
			if actor.avatarPresetId ~= nil then
				local presetKnown = false
				for _, preset in ipairs(PRESETS) do if actor.avatarPresetId == preset then presetKnown = true end end
				if not presetKnown then return nil, "invalid_existing_bot_preset" end
			end
			if input.serverClass == "rookie" and actor.profileName == "experienced" then
				return nil, "existing_rookie_roster_has_experienced_bot"
			end
			if actor.profileName == "experienced" then
				local group = input.mode == "FFA" and "ffa" or actor.teamId
				experiencedByGroup[group] = (experiencedByGroup[group] or 0) + 1
			end
		end
	end
	for _, count in pairs(experiencedByGroup) do
		if count &gt; configuredCap then return nil, "existing_experienced_cap_exceeded" end
	end

	local pendingSeen = {}
	for index = 1, pendingCount do
		local queued = input.pendingHumanQueue[index]
		if type(queued) ~= "table" or type(queued.userKey) ~= "string" or #queued.userKey &lt; 1 or #queued.userKey &gt; 80
			or pendingSeen[queued.userKey] or humanKeys[queued.userKey] then return nil, "invalid_or_duplicate_pending_human" end
		if not integer(queued.arrivalOrder, 0, 2147483647) then return nil, "invalid_arrival_order" end
		pendingSeen[queued.userKey] = true
	end
	return { actorCount = actorCount, pendingCount = pendingCount, counts = counts,
		experiencedByGroup = experiencedByGroup, names = names, actorKeys = actorKeys }
end

local function queuedOrder(input)
	local queue = {}
	for _, row in ipairs(input.pendingHumanQueue) do table.insert(queue, row) end
	table.sort(queue, function(a, b)
		if a.arrivalOrder ~= b.arrivalOrder then return a.arrivalOrder &lt; b.arrivalOrder end
		local left, right = hash(input.seed, a.userKey), hash(input.seed, b.userKey)
		if left ~= right then return left &lt; right end
		return a.userKey &lt; b.userKey
	end)
	return queue
end

local function newIdentity(input, names, serial)
	-- Names compare without case, as Roblox's do: "PixelPanda" and "pixelpanda" never meet in one match.
	local taken = {}
	for name in pairs(names) do taken[string.lower(name)] = true end
	for attempt = 1, 64 do
		local draws = 0
		local function pick(n)
			draws += 1
			return hash(input.seed, "identity:" .. tostring(serial) .. ":" .. attempt .. ":" .. draws) % n + 1
		end
		local displayName = BotNames.make(pick)
		if BotNames.valid(displayName) and not taken[string.lower(displayName)] then
			names[displayName] = true
			local presetIndex = (hash(input.seed, "preset:" .. tostring(serial)) % #PRESETS) + 1
			return displayName, PRESETS[presetIndex]
		end
	end
	return nil, nil
end

local function teamForBot(input, counts, ordinal)
	if not teamMode(input.mode) then return nil end
	if counts["team:1"] &lt; counts["team:2"] then return "team:1" end
	if counts["team:2"] &lt; counts["team:1"] then return "team:2" end
	return hash(input.seed, "team:" .. tostring(ordinal)) % 2 == 0 and "team:1" or "team:2"
end

local function teamForHuman(input, counts, userKey)
	if not teamMode(input.mode) then return nil end
	if counts["team:1"] &lt; counts["team:2"] then return "team:1" end
	if counts["team:2"] &lt; counts["team:1"] then return "team:2" end
	return hash(input.seed, "human-team:" .. userKey) % 2 == 0 and "team:1" or "team:2"
end

local function profileFor(input, group, serial, experiencedByGroup)
	local mix = input.config.bots[input.eligibility == "rookie" and "rookie_mix" or "regular_mix"]
	if type(mix) ~= "table" then return nil end
	local sample = hash(input.seed, "profile:" .. tostring(serial)) % 100000
	local profile, cumulative = nil, 0
	for _, name in ipairs(PROFILE_NAMES) do
		local weight = mix[name]
		if type(weight) ~= "number" or weight ~= weight or weight == math.huge or weight == -math.huge
			or weight &lt; 0 or weight &gt; 1 then return nil end
		cumulative += weight * 100000
		if profile == nil and sample &lt; cumulative then profile = name end
	end
	if math.abs(cumulative - 100000) &gt; 0.01 or not profile then return nil end
	if input.eligibility == "rookie" and profile == "experienced" then return nil end
	if profile == "experienced" and (experiencedByGroup[group] or 0) &gt;= input.config.bots.experienced_cap_per_team_or_ffa then
		return "regular"
	end
	return profile
end

-- plan(input) returns additions only. Required fields include trusted eligibility/serverClass,
-- mode/config, dense actor summaries, bounded pendingHumanQueue, uint32 seed, and botIdentitySerial.
-- botIdentitySerial is a caller-owned, match-monotonic next-identity counter. Reserve the returned
-- serial range atomically and never rewind it, including after bot removal, to avoid MatchService history reuse.
function Rules.plan(input)
	local checked, reason = validate(input)
	if not checked then return nil, reason end
	if input.eligibility ~= input.serverClass then
		return { status = "route_required", reason = "eligibility_class_changed", admissions = {}, botAdds = {},
			actorCount = checked.actorCount, nextBotIdentitySerial = input.botIdentitySerial }
	end
	local queue = queuedOrder(input)
	local available = Rules.MAX_ACTORS - checked.actorCount
	local admissions, admittedKeys = {}, {}
	for index = 1, math.min(available, #queue) do
		local queued = queue[index]
		local row = { userKey = queued.userKey, teamId = teamForHuman(input, checked.counts, queued.userKey) }
		if row.teamId then checked.counts[row.teamId] += 1 end
		table.insert(admissions, row)
		admittedKeys[queued.userKey] = true
	end

	local botAdds, seat = {}, checked.actorCount + 1
	local botSeats = available - #admissions
	if input.botIdentitySerial + botSeats &gt; 2147483648 then return nil, "bot_identity_serial_exhausted" end
	while #botAdds &lt; botSeats do
		local serial = input.botIdentitySerial + #botAdds
		local actorKey = "bot-roster:" .. tostring(serial)
		if checked.actorKeys[actorKey] then return nil, "bot_identity_serial_collision" end
		local teamId = teamForBot(input, checked.counts, seat)
		local group = input.mode == "FFA" and "ffa" or teamId
		local profile = profileFor(input, group, serial, checked.experiencedByGroup)
		if not profile then return nil, "invalid_profile_mix" end
		local displayName, avatarPresetId = newIdentity(input, checked.names, serial)
		if not displayName then return nil, "fictional_name_pool_exhausted" end
		checked.actorKeys[actorKey] = true
		table.insert(botAdds, { actorKey = actorKey, identitySerial = serial, profileName = profile,
			displayName = displayName, avatarPresetId = avatarPresetId, teamId = teamId })
		if teamId then checked.counts[teamId] += 1 end
		if profile == "experienced" then checked.experiencedByGroup[group] = (checked.experiencedByGroup[group] or 0) + 1 end
		seat += 1
	end
	local waiting = {}
	for _, queued in ipairs(queue) do if not admittedKeys[queued.userKey] then table.insert(waiting, queued.userKey) end end
	return { status = "ready", eligibility = input.eligibility, actorCount = checked.actorCount + #admissions + #botAdds,
		admissions = admissions, botAdds = botAdds, waitingHumanKeys = waiting,
		nextBotIdentitySerial = input.botIdentitySerial + #botAdds }
end

local function releaseOrder(input, candidates)
	table.sort(candidates, function(a, b)
		local rankA = a.state == "DESTROYED" and 0 or 1
		local rankB = b.state == "DESTROYED" and 0 or 1
		if rankA ~= rankB then return rankA &lt; rankB end
		local tieA, tieB = hash(input.seed, a.key), hash(input.seed, b.key)
		if tieA ~= tieB then return tieA &lt; tieB end
		return a.key &lt; b.key
	end)
	return candidates
end

-- Plan only; lifecycle ownership stays with the caller. Parked bodies require both an
-- approved parked state and explicit safe/no-credit server facts. Boundary rebuilds require
-- a trusted boundary and settled ledger plus bot cleanup readiness.
function Rules.humanPriority(input)
	local checked, reason = validate(input)
	if not checked then return nil, reason end
	if input.eligibility ~= input.serverClass then return { status = "route_required", admission = nil, releaseProposal = nil } end
	local queue = queuedOrder(input)
	local first = queue[1]
	if not first then return { status = "no_pending_human", admission = nil, releaseProposal = nil } end
	if Rules.MAX_ACTORS - checked.actorCount &gt; 0 then
		return { status = "admit_vacancy", admission = { userKey = first.userKey,
			teamId = teamForHuman(input, checked.counts, first.userKey) }, releaseProposal = nil }
	end
	if input.trustedRoundBoundary == true and input.roundLedgerSettled == true and input.botCleanupReady == true then
		return { status = "round_boundary_rebuild", admission = { userKey = first.userKey,
			teamId = teamForHuman(input, checked.counts, first.userKey) },
			releaseProposal = { reason = "round_boundary", preserveRoundLedger = true, cleanupReady = true } }
	end
	local candidates = {}
	for _, actor in ipairs(input.actors) do
		if actor.controllerType == "bot" and actor.state == "DESTROYED" then
			table.insert(candidates, actor)
		elseif actor.controllerType == "bot" and (actor.state == "SPAWN_READY" or actor.state == "SERVICING")
			and actor.trustedSafeParkedService == true and actor.recentDamageCredit == false then
			table.insert(candidates, actor)
		end
	end
	releaseOrder(input, candidates)
	if #candidates &gt; 0 then
		local candidate = candidates[1]
		return { status = "release_proposed", admission = nil,
			releaseProposal = { actorKey = candidate.key, reason = candidate.state == "DESTROYED" and "dead_life"
				or "safe_parked_service", damageCreditDisposition = "preserve_round_ledger" } }
	end
	return { status = "wait_menu", admission = nil, releaseProposal = nil }
end

-- Public presentation uses an ordinary opaque presentation ID supplied by the parent.
-- Internal actor keys, profile/controller fields, and native identity fields are never projected.
function Rules.publicProjection(actor)
	if type(actor) ~= "table" then return nil, "actor_required" end
	if type(actor.publicId) ~= "string" or #actor.publicId &lt; 1 or #actor.publicId &gt; 80
		or type(actor.displayName) ~= "string" or #actor.displayName &lt; 1 or #actor.displayName &gt; 48
		or type(actor.avatarPresetId) ~= "string" then return nil, "public_identity_required" end
	if actor.teamId ~= nil and actor.teamId ~= "team:1" and actor.teamId ~= "team:2" then return nil, "invalid_public_team" end
	if type(actor.state) ~= "string" then return nil, "public_state_required" end
	return { id = actor.publicId, displayName = actor.displayName, avatarPresetId = actor.avatarPresetId,
		state = actor.state, teamId = actor.teamId }
end

return Rules
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ROJO_212">
          <Properties>
            <string name="Name">BuilderModel</string>
            <string name="Source">-- Local-only equipment candidate. Catalog remains the only source of legality and stats.
local BuilderModel = {}
BuilderModel.__index = BuilderModel

local function cloneLoadout(source)
	if type(source) ~= "table" then return nil end
	local result = { body = source.body, nose = source.nose, wings = source.wings, tail = source.tail, utility = source.utility }
	result.weapon_mounts = {}
	for index, value in ipairs(source.weapon_mounts or {}) do result.weapon_mounts[index] = value end
	return result
end

local function equal(a, b)
	if not a or not b then return a == b end
	for _, key in ipairs({ "body", "nose", "wings", "tail", "utility" }) do
		if a[key] ~= b[key] then return false end
	end
	if #a.weapon_mounts ~= #b.weapon_mounts then return false end
	for i = 1, #a.weapon_mounts do if a.weapon_mounts[i] ~= b.weapon_mounts[i] then return false end end
	return true
end

function BuilderModel.new(catalog, loadout, ownership, level)
	assert(type(catalog) == "table" and type(catalog.validateLoadout) == "function" and type(catalog.deriveStats) == "function", "Builder requires Catalog")
	local self = setmetatable({ catalog = catalog, ownership = ownership or {}, level = level or 1, message = "", changed = false }, BuilderModel)
	self:reset(loadout, nil)
	return self
end

function BuilderModel:reset(loadout, revision)
	local candidate = cloneLoadout(loadout) or self.catalog:starterLoadout()
	local body = self.catalog:get(candidate.body)
	if body then
		local mounts = {}
		for index = 1, body.mount_count do mounts[index] = candidate.weapon_mounts[index] or false end
		candidate.weapon_mounts = mounts
	end
	self.candidate, self.baseline, self.authoritative, self.revision, self.message, self.changed = candidate, cloneLoadout(candidate), cloneLoadout(candidate), revision, "", false
end

function BuilderModel:update(vm)
	vm = type(vm) == "table" and vm or {}
	local profile = vm.profile or {}
	self.level = type(profile.level) == "number" and math.max(1, math.floor(profile.level)) or 1
	self.ownership = type(profile.ownership) == "table" and profile.ownership or {}
	local incoming = cloneLoadout(vm.selectedLoadout)
	local hasRevision = vm.selectedRevision ~= nil
	if hasRevision and vm.selectedRevision ~= self.revision then
		self:reset(incoming, vm.selectedRevision)
	elseif not hasRevision and incoming and not equal(incoming, self.authoritative) and not equal(incoming, self.candidate) then
		-- A changed selection matching this candidate reflects the local onSelect callback.
		-- A different selection from the parent is treated as an explicit external selection.
		self:reset(incoming, nil)
	end
	if incoming then self.authoritative = incoming end
end

function BuilderModel:validate(candidate)
	return self.catalog:validateLoadout(candidate, self.ownership, self.level)
end

function BuilderModel:stats(candidate)
	local valid, reason = self:validate(candidate or self.candidate)
	if not valid then return nil, reason end
	return self.catalog:deriveStats(candidate or self.candidate)
end

function BuilderModel:selectStructure(slot, id)
	if slot ~= "body" and slot ~= "nose" and slot ~= "wings" and slot ~= "tail" then return false, "Unknown structure slot" end
	local definition = self.catalog:get(id)
	if not definition or definition.slot ~= slot then return false, "This selection is not a " .. slot end
	if definition.min_level &gt; self.level then return false, id .. " requires level " .. tostring(definition.min_level) end
	if self.ownership[id] ~= true then return false, "not owned: " .. id end
	local nextBuild = cloneLoadout(self.candidate)
	nextBuild[slot] = id
	if slot == "body" then
		local body = definition
		local mounts = {}
		local cleared = 0
		for index = 1, body.mount_count do
			mounts[index] = false
		end
		nextBuild.weapon_mounts = mounts
		local baseValid, baseReason = self:validate(nextBuild)
		if not baseValid then return false, baseReason end
		-- Validate each retained ordered mount against Catalog. This preserves the
		-- earliest legal mounts without copying Catalog's compatibility/capacity rules.
		for index = 1, body.mount_count do
			local prior = self.candidate.weapon_mounts[index]
			if prior and prior ~= false then
				mounts[index] = prior
				local valid = self:validate(nextBuild)
				if not valid then mounts[index], cleared = false, cleared + 1 end
			end
		end
		for index = body.mount_count + 1, #self.candidate.weapon_mounts do if self.candidate.weapon_mounts[index] ~= false then cleared += 1 end end
		if cleared &gt; 0 then self.message = "Body changed. " .. tostring(cleared) .. " incompatible or excess mount(s) were cleared from this local draft." end
	end
	local valid, reason = self:validate(nextBuild)
	if not valid then return false, reason end
	return self:setCandidate(nextBuild)
end

function BuilderModel:setCandidate(candidate)
	local valid, reason = self:validate(candidate)
	if not valid then return false, reason end
	self.candidate = cloneLoadout(candidate)
	self.changed = not equal(self.candidate, self.baseline)
	return true
end

function BuilderModel:selectMount(index, id)
	local build = cloneLoadout(self.candidate)
	local body = self.catalog:get(build.body)
	if type(index) ~= "number" or index % 1 ~= 0 or index &lt; 1 or index &gt; body.mount_count then return false, "Mount is unavailable on this body" end
	build.weapon_mounts[index] = id or false
	return self:setCandidate(build)
end

function BuilderModel:selectUtility(id)
	local build = cloneLoadout(self.candidate)
	build.utility = id
	return self:setCandidate(build)
end

function BuilderModel:selectPreset(loadout)
	local candidate = cloneLoadout(loadout)
	if not candidate then return false, "Preset is empty" end
	local body = self.catalog:get(candidate.body)
	if not body then return false, "Preset has an unknown body" end
	local dense = {}
	for index = 1, body.mount_count do dense[index] = candidate.weapon_mounts[index] or false end
	candidate.weapon_mounts = dense
	local valid, reason = self:validate(candidate)
	if not valid then return false, reason end
	self.candidate, self.changed, self.message = candidate, not equal(candidate, self.baseline), "Preset loaded into the local draft. Apply it only when the server allows it."
	return true
end

function BuilderModel.clone(loadout) return cloneLoadout(loadout) end
function BuilderModel.equal(a, b) return equal(a, b) end
return BuilderModel
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ROJO_213">
          <Properties>
            <string name="Name">Catalog</string>
            <string name="Source">local JSONTypes = require(script.Parent.Parent.Generated.JSONTypes)
local CombatRules = require(script.Parent.CombatRules)

local Catalog = {}
Catalog.__index = Catalog

local STRUCTURE_SLOTS = { "body", "nose", "wings", "tail" }
local LOADOUT_FIELDS = {
	body = true,
	nose = true,
	wings = true,
	tail = true,
	weapon_mounts = true,
	utility = true,
}
local COMPATIBLE = {
	heavy = { heavy = true, medium = true, light = true },
	medium = { medium = true, light = true },
	light = { light = true },
}

local function isFiniteNumber(value)
	return type(value) == "number" and value == value and value &gt; -math.huge and value &lt; math.huge
end

local function isPlainTable(value)
	return type(value) == "table" and getmetatable(value) == nil
end

local function isDenseArray(value, expectedLength)
	if not isPlainTable(value) then
		return false
	end
	local count = 0
	for key in pairs(value) do
		if type(key) ~= "number" or key % 1 ~= 0 or key &lt; 1 or key &gt; expectedLength then
			return false
		end
		count += 1
	end
	return count == expectedLength
end

local function clamp(value, low, high)
	return math.max(low, math.min(high, value))
end

function Catalog.new(config, gameplay)
	assert(isPlainTable(config), "Catalog config must be a table")
	if gameplay == nil then
		gameplay = require(script.Parent.Parent.Generated.Gameplay)
	end
	assert(isPlainTable(gameplay) and isPlainTable(gameplay.flight), "Gameplay flight config is required")
	local self = setmetatable({
		config = config,
		flight = gameplay.flight,
		byId = {},
		structuresBySlot = {},
		weapons = {},
		utilities = {},
	}, Catalog)

	for _, slot in ipairs(STRUCTURE_SLOTS) do
		self.structuresBySlot[slot] = {}
	end
	local function indexAll(entries, destination, expectedSlot)
		assert(type(entries) == "table", "Catalog entry list is missing")
		for _, entry in ipairs(entries) do
			assert(isPlainTable(entry) and type(entry.id) == "string", "Catalog entry has invalid ID")
			assert(self.byId[entry.id] == nil, "Duplicate catalog ID: " .. entry.id)
			if expectedSlot then
				assert(entry.slot == expectedSlot, "Catalog structure has an invalid slot")
			end
			self.byId[entry.id] = entry
			table.insert(destination, entry)
		end
	end

	for _, slot in ipairs(STRUCTURE_SLOTS) do
		local entries = {}
		for _, entry in ipairs(config.structures or {}) do
			if entry.slot == slot then
				table.insert(entries, entry)
			end
		end
		indexAll(entries, self.structuresBySlot[slot], slot)
	end
	indexAll(config.weapons, self.weapons)
	indexAll(config.utilities, self.utilities)
	return self
end

function Catalog:get(id)
	if type(id) ~= "string" then
		return nil
	end
	return self.byId[id]
end

function Catalog:starterLoadout()
	local seed = self.config.starter_loadout
	assert(isPlainTable(seed), "Starter loadout is missing")
	local body = self.byId[seed.body]
	assert(body and body.slot == "body", "Starter body is invalid")
	local mounts = {}
	for index = 1, body.mount_count do
		local weaponId = seed.weapon_mounts[index]
		if weaponId == nil or weaponId == JSONTypes.Null then
			mounts[index] = false
		else
			mounts[index] = weaponId
		end
	end
	local utility = seed.utility
	if utility == JSONTypes.Null then
		utility = nil
	end
	return {
		body = seed.body,
		nose = seed.nose,
		wings = seed.wings,
		tail = seed.tail,
		weapon_mounts = mounts,
		utility = utility,
	}
end

function Catalog:validateLoadout(loadout, ownership, level)
	if not isPlainTable(loadout) then
		return nil, "loadout must be a plain table"
	end
	for key in pairs(loadout) do
		if not LOADOUT_FIELDS[key] then
			return nil, "unknown loadout field: " .. tostring(key)
		end
	end
	if ownership ~= nil and not isPlainTable(ownership) then
		return nil, "ownership must be a set keyed by catalog ID"
	end
	if not isFiniteNumber(level) or level % 1 ~= 0 or level &lt; 1 then
		return nil, "level must be a positive integer"
	end

	local selected = {}
	local body
	for _, slot in ipairs(STRUCTURE_SLOTS) do
		local id = loadout[slot]
		if type(id) ~= "string" then
			return nil, "missing or invalid " .. slot
		end
		local definition = self.byId[id]
		if not definition or definition.slot ~= slot then
			return nil, "unknown or incorrect " .. slot .. " ID: " .. id
		end
		selected[id] = definition
		if slot == "body" then
			body = definition
		end
	end

	if not isFiniteNumber(body.mount_count) or body.mount_count % 1 ~= 0 or body.mount_count &lt; 0 then
		return nil, "body mount count is invalid"
	end
	if not isDenseArray(loadout.weapon_mounts, body.mount_count) then
		return nil, "weapon_mounts must contain exactly the ordered body mount slots"
	end
	if not isFiniteNumber(body.capacity) or body.capacity &lt; 0 then
		return nil, "body capacity is invalid"
	end

	local usedCapacity = 0
	for mountIndex = 1, body.mount_count do
		local weaponId = loadout.weapon_mounts[mountIndex]
		if weaponId ~= false then
			if type(weaponId) ~= "string" then
				return nil, "empty mounts must be false and weapons must be string IDs"
			end
			local weapon = self.byId[weaponId]
			local mountType = body.mount_types and body.mount_types[mountIndex]
			if not weapon or not weapon.class then
				return nil, "unknown weapon ID: " .. weaponId
			end
			if not (COMPATIBLE[mountType] and COMPATIBLE[mountType][weapon.class]) then
				return nil, "weapon is incompatible with ordered mount " .. tostring(mountIndex)
			end
			selected[weaponId] = weapon
			usedCapacity += weapon.capacity
		end
	end
	local groups, groupError = CombatRules.triggerGroups(loadout)
	if not groups then return nil, groupError end
	if usedCapacity &gt; body.capacity then
		return nil, "weapon capacity exceeds body capacity"
	end

	local utilityId = loadout.utility
	if utilityId ~= nil then
		if type(utilityId) ~= "string" then
			return nil, "utility must be an ID or nil"
		end
		local utility = self.byId[utilityId]
		if not utility or utility.boost_seconds == nil then
			return nil, "unknown utility ID: " .. utilityId
		end
		selected[utilityId] = utility
	end

	for id, definition in pairs(selected) do
		if level &lt; definition.min_level then
			return nil, id .. " requires level " .. tostring(definition.min_level)
		end
		-- nil ownership is reserved for trusted internal all-owned analysis.
		if ownership ~= nil and ownership[id] ~= true then
			return nil, "not owned: " .. id
		end
	end
	return true
end

function Catalog:deriveStats(loadout)
	local valid, validationError = self:validateLoadout(loadout, nil, 1000000000)
	if not valid then
		return nil, validationError
	end
	local body = self.byId[loadout.body]
	local parts = { self.byId[loadout.nose], self.byId[loadout.wings], self.byId[loadout.tail] }
	local health = body.base_health
	local speed = body.base_speed
	local lift = body.base_lift
	local mass = 0
	local usedCapacity = 0
	for _, part in ipairs(parts) do
		health += part.health_delta
		speed += part.speed_delta
		lift += part.lift_delta
	end
	-- Like a real plane: the tail's elevator sets pitch (up/down), the wings' ailerons set yaw (left/right
	-- through banking). The nose trims both.
	local pitch = body.base_turn + parts[1].turn_delta + parts[3].turn_delta
	local yaw = body.base_turn + parts[1].turn_delta + parts[2].turn_delta
	for mountIndex = 1, body.mount_count do
		local weaponId = loadout.weapon_mounts[mountIndex]
		if weaponId ~= false then
			local weapon = self.byId[weaponId]
			mass += weapon.mass
			usedCapacity += weapon.capacity
		end
	end
	if loadout.utility ~= nil then
		mass += self.byId[loadout.utility].mass
	end

	local archetypeSpeedCeiling = { heavy = 95, standard = 135, slim = 155 }
	local finalSpeed = clamp(speed - self.flight.speed_equipment_penalty_per_mass * mass,
		self.flight.speed_min_studs_s, self.flight.speed_max_studs_s)
	finalSpeed = math.min(finalSpeed, archetypeSpeedCeiling[body.archetype] or math.huge)
	-- Catalog turn values are relative handling; the scale sets how fast planes really turn.
	local function rate(value)
		return clamp(value - self.flight.turn_equipment_penalty_per_mass * mass,
			self.flight.turn_min_deg_s, self.flight.turn_max_deg_s) * self.flight.turn_rate_scale
	end
	return {
		health = clamp(health, 45, 400),
		speed = finalSpeed,
		pitch = rate(pitch),
		yaw = rate(yaw),
		-- Fastest axis: server checks and aim slack use it as the limit.
		turn = math.max(rate(pitch), rate(yaw)),
		lift = clamp(lift - self.flight.lift_equipment_penalty_per_mass * mass,
			self.flight.lift_min_seconds, self.flight.lift_max_seconds),
		mass = mass,
		equipment_mass = mass,
		capacity = body.capacity,
		used_capacity = usedCapacity,
		remaining_capacity = body.capacity - usedCapacity,
	}
end

-- Damage per second from one gun firing nonstop (bursts count their pause; ignores misses and reloads).
function Catalog.weaponDPS(weapon)
	if weapon.fire_mode == "burst" then return weapon.damage * weapon.burst_count / weapon.burst_period end
	return weapon.damage / weapon.shot_interval
end

-- How hard one shot hits, 1-5, for the hangar's pips (per-shot damage runs from 1.6 to 260).
function Catalog.hitRating(weapon)
	for rating, limit in { 2, 10, 25, 60 } do if weapon.damage &lt;= limit then return rating end end
	return 5
end

return Catalog
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ROJO_214">
          <Properties>
            <string name="Name">CombatRules</string>
            <string name="Source">local Rules = {}
local Config = require(script.Parent.Parent.Generated.Gameplay).combat
-- The first filled mount's type goes on left click; every mount of the other type goes on right click.
function Rules.triggerGroups(loadout)
	local groups,types,count={},{},0
	for slot,id in ipairs(loadout.weapon_mounts) do
		groups[slot]=false
		if id and id~="" then
			if not types[id] then
				count+=1;if count&gt;2 then return nil,"two weapon types per plane" end
				types[id]=count
			end
			groups[slot]=types[id]
		end
	end
	return groups
end
function Rules.credit(history, now, maximum, victim)
	local damage, killer, latest = {}, nil, -math.huge
	for _, hit in ipairs(history) do
		if hit.attacker ~= victim and hit.at &lt;= now and now-hit.at &lt;= Config.assist_window_seconds then
			damage[hit.attacker] = (damage[hit.attacker] or 0)+hit.damage
			if hit.at &gt;= latest then killer, latest = hit.attacker, hit.at end
		end
	end
	local assists = {}
	for attacker, amount in pairs(damage) do
		if attacker ~= killer and amount &gt;= maximum*Config.assist_min_fraction_original_health then table.insert(assists,attacker) end
	end
	table.sort(assists)
	return killer, assists
end
function Rules.readyMount(mounts, group, now, after, fireMode)
	for offset=1,#mounts do
		local index = ((after or 0)+offset-1)%#mounts+1
		local mount = mounts[index]
		if mount.group == group and mount.readyAt &lt;= now and (not fireMode or mount.weapon.fire_mode==fireMode) then return index end
	end
	return nil
end
-- Like a real seeker: a target that gets too far off the eraser's nose is lost (nil) for good.
-- A hard break turn timed as the eraser closes in is how you dodge.
function Rules.eraserSteer(direction, toTarget, dt)
	if direction:Dot(toTarget) &lt; math.cos(math.rad(Config.eraser_seeker_deg)) then return nil end
	return Rules.turnDirection(direction, toTarget, math.rad(Config.eraser_turn_deg_s)*dt)
end
function Rules.canEraser(active)
	return active &lt; Config.eraser_max_active_per_pilot
end
function Rules.eraserSpeed(baseSpeed, flownStuds, config)
	config = config or Config
	local slow = math.clamp((flownStuds-config.eraser_slow_after_studs)/(config.eraser_slow_full_studs-config.eraser_slow_after_studs),0,1)
	return baseSpeed*(1-slow*(1-config.eraser_min_speed_factor))
end
-- Unguided shots start fast, lose speed to drag (k, 1/s) and fall (g, studs/s^2). Never used for homing weapons.
function Rules.shotDistance(weapon, t)
	local v,k=weapon.projectile_speed,weapon.drag or 0
	return k&gt;0 and v/k*(1-math.exp(-k*t)) or v*t
end
function Rules.shotSpeed(weapon, t)
	return weapon.projectile_speed*math.exp(-(weapon.drag or 0)*t)
end
-- Seconds to cover d studs along the aim line; math.huge when out of range.
function Rules.travelTime(weapon, d)
	local v,k=weapon.projectile_speed,weapon.drag or 0
	local t=d/v
	if k&gt;0 then
		local x=k*d/v
		if x&gt;=1 then return math.huge end
		t=-math.log(1-x)/k
	end
	return t&gt;weapon.lifetime+1e-9 and math.huge or t
end
function Rules.shotOffset(weapon, direction, t)
	return direction*Rules.shotDistance(weapon,t)-Vector3.yAxis*(0.5*(weapon.drop or 0)*t*t)
end
function Rules.shotRange(weapon)
	return Rules.shotDistance(weapon,weapon.lifetime)
end
-- A held trigger keeps its heat between shots. Cooling drains even while held, and stays latched until empty.
function Rules.heatStep(heat, cooling, firing, dt, weapon)
	if not weapon.shots_before_cooldown then return 0,false end
	if cooling or not firing then heat=math.max(0,heat-weapon.shots_before_cooldown/weapon.cooldown_seconds*math.max(0,dt)) end
	if heat&lt;1e-9 then return 0,false end
	return heat,cooling
end
-- The shot reaching the limit still fires; subsequent shots wait for a complete cooldown.
function Rules.heatShot(heat, cooling, weapon)
	local limit=weapon.shots_before_cooldown
	if not limit then return 0,false,true end
	if cooling or heat&gt;=limit then return heat,true,false end
	heat=math.min(limit,heat+1)
	return heat,heat&gt;=limit,true
end
function Rules.consume(mount, now)
	if mount.weapon.fire_mode~="burst" then mount.readyAt=now+mount.weapon.shot_interval end
end
Rules.turnDirection = require(script.Parent.FlightRules).turnDirection
-- Lag compensation: where a plane was at time `at`, from its recent {at, cf} samples (oldest first).
function Rules.sample(track, at)
	local count = #track
	if count == 0 then return nil end
	if at &gt;= track[count].at then return track[count].cf end
	for i = count-1, 1, -1 do
		local a = track[i]
		if a.at &lt;= at then
			local b = track[i+1]
			return a.cf:Lerp(b.cf, (at-a.at)/(b.at-a.at))
		end
	end
	return track[1].cf
end
-- Earliest fraction (0 to 1) of a shot's path that enters a plane's box, or nil if it misses.
function Rules.segmentBox(origin, delta, cf, half)
	local start, step = cf:PointToObjectSpace(origin), cf:VectorToObjectSpace(delta)
	local enter, exit = 0, 1
	for _, axis in ipairs({"X", "Y", "Z"}) do
		local p, v, h = start[axis], step[axis], half[axis]
		if math.abs(v) &lt; 1e-9 then
			if math.abs(p) &gt; h then return nil end
		else
			local a, b = (-h-p)/v, (h-p)/v
			if a &gt; b then a, b = b, a end
			enter, exit = math.max(enter, a), math.min(exit, b)
			if enter &gt; exit then return nil end
		end
	end
	return enter
end
return table.freeze(Rules)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ROJO_215">
          <Properties>
            <string name="Name">CommerceRules</string>
            <string name="Source">-- Pure catalog and narrow display contract. No platform or persistence authority.
local Root = game:GetService("ReplicatedStorage"):WaitForChild("FlyFightPaper")
local JSON = require(Root.Generated.JSONTypes)
local Rules = {}
local MAX = 9007199254740991
local expected = {}
for _, resource in ipairs({"xp", "paper"}) do
    for _, minutes in ipairs({15, 30, 60, 180, 300}) do
        expected[resource .. "_boost_" .. minutes .. "m"] = {kind="developer_product", benefit=resource .. "_seconds", amount=minutes*60}
    end
    expected["permanent_2x_" .. resource] = {kind="pass", benefit="permanent_" .. resource, amount=2}
end
for _, amount in ipairs({1000, 3500, 10000}) do
    expected["paper_pack_" .. amount] = {kind="developer_product", benefit="paper_balance", amount=amount}
end
function Rules.positiveInteger(n)
    return type(n)=="number" and n==n and n&gt;0 and n&lt;=MAX and n%1==0
end
function Rules.catalog(config)
    if type(config)~="table" or (config.mode~="mock" and config.mode~="live")
        or config.schema_version~=1 or type(config.live_sales_authorized)~="boolean"
        or config.allow_real_spend_tests~=false or config.offline_countdown~=false
        or config.loaded_online_menu_countdown~=true or config.multiplier_cap_per_resource~=2
        or config.permanent_hides_temporary_same_resource~=true or type(config.products)~="table"
        or type(config.mock_ui_label)~="string" or type(config.paper_pack_amounts_status)~="string"
        or type(config.source_of_live_display_price)~="string" then
        return nil,"invalid_commerce_config"
    end
    local allowedConfig={schema_version=true,mode=true,live_sales_authorized=true,allow_real_spend_tests=true,
        offline_countdown=true,loaded_online_menu_countdown=true,multiplier_cap_per_resource=true,
        permanent_hides_temporary_same_resource=true,products=true,paper_pack_amounts_status=true,
        mock_ui_label=true,source_of_live_display_price=true}
    for k in pairs(config) do if not allowedConfig[k] then return nil,"unknown_config_field" end end
    local byKey, byID, ordered, n = {}, {}, {}, 0
    for i in pairs(config.products) do
        if type(i)~="number" or i%1~=0 or i&lt;1 or i&gt;15 then return nil,"invalid_offer_array" end
        n+=1
    end
    if n~=15 then return nil,"offer_count" end
    local fields={key=true,kind=true,benefit=true,amount=true,roblox_product_id=true,approved_robux_price=true,enabled=true}
    for i=1,15 do
        local p=config.products[i]
        if type(p)~="table" then return nil,"malformed_offer" end
        for k in pairs(p) do if not fields[k] then return nil,"unknown_offer_field" end end
        local e=expected[p.key]
        if not e or p.kind~=e.kind or p.benefit~=e.benefit or p.amount~=e.amount or type(p.enabled)~="boolean" then
            return nil,"immutable_offer_mismatch"
        end
        if byKey[p.key] then return nil,"duplicate_offer" end
        -- Nil, empty tables and arbitrary generated maps are NOT the JSON null sentinel.
        local idNull, priceNull = p.roblox_product_id==JSON.Null, p.approved_robux_price==JSON.Null
        if (not idNull and not Rules.positiveInteger(p.roblox_product_id))
            or (not priceNull and not Rules.positiveInteger(p.approved_robux_price))
            or idNull~=priceNull or (p.enabled and idNull) then return nil,"invalid_mapping" end
        local offer=table.freeze({key=p.key,kind=p.kind,benefit=p.benefit,amount=p.amount,
            enabled=p.enabled,productID=not idNull and p.roblox_product_id or nil,
            approvedPrice=not priceNull and p.approved_robux_price or nil})
        if offer.productID then
            if byID[offer.productID] then return nil,"duplicate_mapping" end
            byID[offer.productID]=offer
        end
        byKey[p.key]=offer; ordered[i]=offer
    end
    return table.freeze({mode=config.mode,authorized=config.live_sales_authorized,
        byKey=table.freeze(byKey),byID=table.freeze(byID),offers=table.freeze(ordered)})
end
function Rules.resource(offer)
    if offer.benefit=="xp_seconds" or offer.benefit=="permanent_xp" then return "xp" end
    if offer.benefit=="paper_seconds" or offer.benefit=="permanent_paper" then return "paper" end
end
function Rules.owned(offer,boosts)
    local resource=Rules.resource(offer)
    return resource and boosts[resource=="xp" and "permanentXP" or "permanentPaper"]==true or false
end
function Rules.operation(offer,source,version)
    local op={sourceIdentity=source,expectedVersion=version}
    if offer.benefit=="paper_balance" then op.kind="purchasedPaper"; op.wholePaper=offer.amount
    else
        op.kind="boostIntent"; op.resource=Rules.resource(offer)
        op.action=offer.kind=="pass" and "permanent" or "duration"
        if op.action=="duration" then op.seconds=offer.amount end
    end
    return table.freeze(op)
end
function Rules.preview(catalog,boosts)
    local offers={}
    for i,p in ipairs(catalog.offers) do
        local owned=Rules.owned(p,boosts)
        offers[i]=table.freeze({key=p.key,kind=p.kind,benefit=p.benefit,amount=p.amount,
            label=catalog.mode=="mock" and "DEVELOPMENT ONLY - no real purchase" or "Live checkout unavailable",
            available=catalog.mode=="mock" and not owned,ownedPermanent=owned,
            reason=owned and "permanent_owned" or (catalog.mode~="mock" and "live_request_unavailable" or nil),
            onlineTime=p.benefit=="xp_seconds" or p.benefit=="paper_seconds"})
    end
    return table.freeze({mode=catalog.mode,remainingTimeBasis="last_durable",label=catalog.mode=="mock" and "DEVELOPMENT ONLY - no real purchase" or "Live checkout unavailable",
        offers=table.freeze(offers),xp=table.freeze({remainingSeconds=boosts.xpSeconds,permanent=boosts.permanentXP,
            multiplier=(boosts.permanentXP or boosts.xpSeconds&gt;0) and 2 or 1}),
        paper=table.freeze({remainingSeconds=boosts.paperSeconds,permanent=boosts.permanentPaper,
            multiplier=(boosts.permanentPaper or boosts.paperSeconds&gt;0) and 2 or 1})})
end
return table.freeze(Rules)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ROJO_216">
          <Properties>
            <string name="Name">EconomyRules</string>
            <string name="Source">-- Pure economy arithmetic. Callers persist returned copies and journal operation IDs.
-- Financial values are nonnegative safe integers in milliunits. Profiles must be bounded
-- JSON-like tables; functions, Instances/userdata, metatables and cyclic graphs are rejected.
local DefaultEconomy = require(script.Parent.Parent.Generated.Economy)
local EconomyRules = {}

EconomyRules.MILLI = 1000
EconomyRules.MAX_SAFE_INTEGER = 9007199254740991
EconomyRules.LEVEL_CAP = 50
EconomyRules.MAX_PROFILE_DEPTH = 8
EconomyRules.MAX_PROFILE_ENTRIES = 4096

local MAX_SAFE, MILLI = EconomyRules.MAX_SAFE_INTEGER, EconomyRules.MILLI

local function validSafeInteger(value)
	return type(value) == "number" and value == value and value &gt;= 0 and value &lt;= MAX_SAFE
		and value % 1 == 0
end

local function validMultiplier(value)
	return value == 1 or value == 2
end

local function validOperationID(value)
	return type(value) == "string" and #value &gt; 0 and #value &lt;= 160
end

local function failure(code, message)
	return nil, { type = "EconomyRejected", code = code, message = message }
end

local function safeAdd(a, b)
	if not validSafeInteger(a) or not validSafeInteger(b) or a &gt; MAX_SAFE - b then return nil end
	return a + b
end

local function safeMultiply(a, b)
	if not validSafeInteger(a) or not validSafeInteger(b) then return nil end
	if a ~= 0 and b &gt; math.floor(MAX_SAFE / a) then return nil end
	return a * b
end

local function boundedCopy(value, state, depth)
	local kind = type(value)
	if kind == "string" then
		if #value &gt; 512 then return nil, "profile string exceeds 512 bytes" end
		return value
	elseif kind == "boolean" then
		return value
	elseif kind == "number" then
		if value ~= value or value == math.huge or value == -math.huge then
			return nil, "profile contains a nonfinite number"
		end
		return value
	elseif kind ~= "table" then
		return nil, "profile contains a non-JSON value"
	end
	if depth &gt;= EconomyRules.MAX_PROFILE_DEPTH then return nil, "profile exceeds maximum depth" end
	if getmetatable(value) ~= nil then return nil, "profile contains a metatable" end
	if state.seen[value] then return nil, "profile contains a cycle or shared table" end
	state.seen[value] = true
	local copy = {}
	for key, child in pairs(value) do
		state.entries += 1
		if state.entries &gt; EconomyRules.MAX_PROFILE_ENTRIES then return nil, "profile exceeds maximum entry count" end
		local keyKind = type(key)
		if keyKind ~= "string" and keyKind ~= "number" then return nil, "profile has an invalid table key" end
		if keyKind == "number" and (key ~= key or key == math.huge or key == -math.huge) then
			return nil, "profile has a nonfinite numeric key"
		end
		local copied, err = boundedCopy(child, state, depth + 1)
		if err then return nil, err end
		copy[key] = copied
	end
	state.seen[value] = nil
	return copy
end

local function freezeDeep(value)
	if type(value) ~= "table" or table.isfrozen(value) then return value end
	for _, child in pairs(value) do freezeDeep(child) end
	table.freeze(value)
	return value
end

local FINANCIAL_FIELDS = { "paperMilli", "earnedPaperMilli", "purchasedPaperMilli", "xpMilli" }
local function cloneProfile(profile)
	if type(profile) ~= "table" or getmetatable(profile) ~= nil then return nil, "profile must be a plain table" end
	local copy, copyError = boundedCopy(profile, { seen = {}, entries = 0 }, 0)
	if not copy then return nil, copyError end
	if type(copy.ownership) ~= "table" or getmetatable(copy.ownership) ~= nil then
		return nil, "profile ownership must be a plain table"
	end
	for _, field in ipairs(FINANCIAL_FIELDS) do
		if copy[field] == nil then return nil, field .. " is required; migrate or initialize profile explicitly" end
		if not validSafeInteger(copy[field]) then return nil, field .. " must be a nonnegative safe integer" end
	end
	return copy
end

local function immutableResult(profileCopy, operation)
	return freezeDeep({ profile = profileCopy, operation = operation })
end

local function validateOperationID(operationID)
	if not validOperationID(operationID) then
		return failure("invalid_operation_id", "operationID must be a nonempty string of at most 160 bytes")
	end
	return true
end

local function economyConfig(config)
	if config == nil then config = DefaultEconomy end
	if type(config) ~= "table" or getmetatable(config) ~= nil then return nil end
	return config
end

local function rateToMilli(rate)
	if type(rate) ~= "number" or rate ~= rate or rate &lt;= 0 or rate == math.huge then return nil end
	local scaled = rate * MILLI
	if scaled ~= scaled or scaled == math.huge or scaled % 1 ~= 0 or scaled &gt; MAX_SAFE then return nil end
	return scaled
end

local function convertContribution(points, paperMultiplier, xpMultiplier, config)
	if not validSafeInteger(points) then return nil, nil, { type = "EconomyRejected", code = "invalid_points", message = "points must be a nonnegative safe integer" } end
	if not validMultiplier(paperMultiplier) or not validMultiplier(xpMultiplier) then
		return nil, nil, { type = "EconomyRejected", code = "invalid_multiplier", message = "each event-time multiplier must be exactly 1 or 2" }
	end
	config = economyConfig(config)
	if not config then return nil, nil, { type = "EconomyRejected", code = "invalid_economy_config", message = "economy config must be a plain table" } end
	local paperRate, xpRate = rateToMilli(config.paper_per_point), rateToMilli(config.xp_per_point)
	if not paperRate or not xpRate then
		return nil, nil, { type = "EconomyRejected", code = "invalid_economy_rate", message = "configured conversion rates must be positive exact milliunit rates" }
	end
	local basePaper, baseXP = safeMultiply(points, paperRate), safeMultiply(points, xpRate)
	if not basePaper or not baseXP then return nil, nil, { type = "EconomyRejected", code = "overflow", message = "base conversion exceeds safe integer range" } end
	local paperMilli, xpMilli = safeMultiply(basePaper, paperMultiplier), safeMultiply(baseXP, xpMultiplier)
	if not paperMilli or not xpMilli then return nil, nil, { type = "EconomyRejected", code = "overflow", message = "multiplied conversion exceeds safe integer range" } end
	return paperMilli, xpMilli
end

-- config defaults to Generated.Economy. Rates must map exactly to integer milliunits.
function EconomyRules.contributionMilli(points, paperMultiplier, xpMultiplier, config)
	local paperMilli, xpMilli, err = convertContribution(points, paperMultiplier, xpMultiplier, config)
	if err then return nil, err end
	return table.freeze({ paperMilli = paperMilli, xpMilli = xpMilli })
end

function EconomyRules.applyContribution(profile, points, multipliers, operationID, config)
	local ok, err = validateOperationID(operationID)
	if not ok then return nil, err end
	if type(multipliers) ~= "table" or getmetatable(multipliers) ~= nil then return failure("invalid_multiplier", "multipliers must be a plain table") end
	local paperMilli, xpMilli, conversionError = convertContribution(points, multipliers.paper, multipliers.xp, config)
	if conversionError then return nil, conversionError end
	local updated, profileError = cloneProfile(profile)
	if not updated then return failure("invalid_profile", profileError) end
	local paper, earned, xp = safeAdd(updated.paperMilli, paperMilli), safeAdd(updated.earnedPaperMilli, paperMilli), safeAdd(updated.xpMilli, xpMilli)
	if not paper or not earned or not xp then return failure("overflow", "contribution would exceed safe integer range") end
	updated.paperMilli, updated.earnedPaperMilli, updated.xpMilli = paper, earned, xp
	return immutableResult(updated, { type = "ContributionApplied", operationID = operationID,
		contributionPoints = points, paperMilli = paperMilli, xpMilli = xpMilli, purchasedPaperMilli = 0 })
end

-- finalPaper/finalXP are authoritative final bonuses, already computed by MatchService.
-- Any contribution fields in resultRow are informational and are never paid again here.
function EconomyRules.applyFinalBonuses(profile, resultRow, multipliers, operationID, config)
	local ok, err = validateOperationID(operationID)
	if not ok then return nil, err end
	if type(resultRow) ~= "table" or getmetatable(resultRow) ~= nil then return failure("invalid_result", "result row must be a plain table") end
	if not validSafeInteger(resultRow.finalPaper) or not validSafeInteger(resultRow.finalXP) then
		return failure("invalid_result", "finalPaper and finalXP must be nonnegative safe whole-unit integers")
	end
	if type(multipliers) ~= "table" or getmetatable(multipliers) ~= nil
		or not validMultiplier(multipliers.paper) or not validMultiplier(multipliers.xp) then
		return failure("invalid_multiplier", "each finalization multiplier must be exactly 1 or 2")
	end
	config = economyConfig(config)
	if not config then return failure("invalid_economy_config", "economy config must be a plain table") end
	local paperRate, xpRate = rateToMilli(config.paper_per_point), rateToMilli(config.xp_per_point)
	if not paperRate or not xpRate then return failure("invalid_economy_rate", "configured conversion rates must be positive exact milliunit rates") end
	local paperMilli, xpMilli = safeMultiply(resultRow.finalPaper, MILLI), safeMultiply(resultRow.finalXP, MILLI)
	if not paperMilli or not xpMilli then return failure("overflow", "final bonuses exceed safe integer range") end
	paperMilli, xpMilli = safeMultiply(paperMilli, multipliers.paper), safeMultiply(xpMilli, multipliers.xp)
	if not paperMilli or not xpMilli then return failure("overflow", "multiplied final bonuses exceed safe integer range") end
	local updated, profileError = cloneProfile(profile)
	if not updated then return failure("invalid_profile", profileError) end
	local paper, earned, xp = safeAdd(updated.paperMilli, paperMilli), safeAdd(updated.earnedPaperMilli, paperMilli), safeAdd(updated.xpMilli, xpMilli)
	if not paper or not earned or not xp then return failure("overflow", "final bonuses would exceed safe integer range") end
	updated.paperMilli, updated.earnedPaperMilli, updated.xpMilli = paper, earned, xp
	return immutableResult(updated, { type = "FinalBonusesApplied", operationID = operationID,
		paperMilli = paperMilli, xpMilli = xpMilli, purchasedPaperMilli = 0 })
end

function EconomyRules.wholeAndResidual(amountMilli)
	if not validSafeInteger(amountMilli) then return failure("invalid_amount", "amount must be a nonnegative safe integer") end
	return table.freeze({ whole = math.floor(amountMilli / MILLI), residualMilli = amountMilli % MILLI })
end

function EconomyRules.levelForXP(cumulativeXPmilli, config)
	if not validSafeInteger(cumulativeXPmilli) then return failure("invalid_xp", "cumulative XP must be a nonnegative safe integer") end
	config = economyConfig(config)
	if not config then return failure("invalid_level_config", "economy config must be a plain table") end
	local cap, base, step = config.level_cap, config.xp_next_level_base, config.xp_next_level_step
	if not validSafeInteger(cap) or cap &lt; 1 or cap &gt; EconomyRules.LEVEL_CAP
		or not validSafeInteger(base) or base &lt; 1 or not validSafeInteger(step) then
		return failure("invalid_level_config", "level cap must be 1..50, base positive, and step nonnegative safe integers")
	end
	local required = safeMultiply(base, MILLI)
	if not required then return failure("overflow", "level threshold exceeds safe integer range") end
	local level, remaining = 1, cumulativeXPmilli
	while level &lt; cap and remaining &gt;= required do
		remaining -= required
		level += 1
		local increment = safeMultiply(step, level - 1)
		local units = increment and safeAdd(base, increment)
		required = units and safeMultiply(units, MILLI)
		if not required then return failure("overflow", "level threshold exceeds safe integer range") end
	end
	return level, remaining, required
end

function EconomyRules.starterOwnership(catalog)
	if type(catalog) ~= "table" or type(catalog.starterLoadout) ~= "function" then return failure("invalid_catalog", "starter ownership requires an actual Catalog instance") end
	local ok, loadout = pcall(function() return catalog:starterLoadout() end)
	if not ok or type(loadout) ~= "table" then return failure("invalid_catalog", "Catalog could not provide its starter loadout") end
	local ownership = {}
	for _, slot in ipairs({ "body", "nose", "wings", "tail" }) do
		if type(loadout[slot]) ~= "string" then return failure("invalid_catalog", "Catalog starter loadout has an invalid " .. slot) end
		ownership[loadout[slot]] = true
	end
	for _, id in ipairs(loadout.weapon_mounts or {}) do if type(id) == "string" then ownership[id] = true end end
	if type(loadout.utility) == "string" then ownership[loadout.utility] = true end
	return freezeDeep(ownership)
end

function EconomyRules.validateEquipmentPurchase(profile, catalog, catalogID, operationID, config)
	local ok, err = validateOperationID(operationID)
	if not ok then return nil, err end
	if type(catalog) ~= "table" or type(catalog.get) ~= "function" then return failure("invalid_catalog", "purchase validation requires an actual Catalog instance") end
	if type(catalogID) ~= "string" or #catalogID == 0 or #catalogID &gt; 160 then return failure("invalid_catalog_id", "catalogID must be a nonempty bounded string") end
	local got, definition = pcall(function() return catalog:get(catalogID) end)
	if not got or type(definition) ~= "table" or definition.id ~= catalogID then return failure("unknown_catalog_id", "catalogID is not in the server Catalog") end
	if not validSafeInteger(definition.paper_price) or not validSafeInteger(definition.min_level) or definition.min_level &lt; 1 then
		return failure("invalid_catalog_entry", "Catalog price and min_level must be nonnegative safe whole integers")
	end
	local updated, profileError = cloneProfile(profile)
	if not updated then return failure("invalid_profile", profileError) end
	if updated.ownership[catalogID] == true then
		return immutableResult(updated, { type = "EquipmentPurchase", operationID = operationID,
			catalogID = catalogID, priceMilli = 0, chargedMilli = 0, alreadyOwned = true })
	end
	local level, levelError = EconomyRules.levelForXP(updated.xpMilli, config)
	if not level then return failure("invalid_level_config", levelError and levelError.message or "profile XP cannot produce a valid level") end
	if level &lt; definition.min_level then return failure("level_locked", "item requires level " .. tostring(definition.min_level)) end
	local priceMilli = safeMultiply(definition.paper_price, MILLI)
	if not priceMilli then return failure("overflow", "Catalog price exceeds safe integer range") end
	if updated.paperMilli &lt; priceMilli then return failure("insufficient_paper", "profile Paper is below Catalog price") end
	updated.paperMilli -= priceMilli
	updated.ownership[catalogID] = true
	return immutableResult(updated, { type = "EquipmentPurchase", operationID = operationID,
		catalogID = catalogID, priceMilli = priceMilli, chargedMilli = priceMilli, alreadyOwned = false })
end

-- Purchased Paper is added without conversion, multiplier, earned balance or XP effects.
function EconomyRules.addPurchasedPaper(profile, wholePaper, operationID)
	local ok, err = validateOperationID(operationID)
	if not ok then return nil, err end
	if not validSafeInteger(wholePaper) then return failure("invalid_amount", "purchased Paper must be a nonnegative safe whole-unit amount") end
	local amountMilli = safeMultiply(wholePaper, MILLI)
	if not amountMilli then return failure("overflow", "purchased Paper exceeds safe integer range") end
	local updated, profileError = cloneProfile(profile)
	if not updated then return failure("invalid_profile", profileError) end
	local paper, purchased = safeAdd(updated.paperMilli, amountMilli), safeAdd(updated.purchasedPaperMilli, amountMilli)
	if not paper or not purchased then return failure("overflow", "purchased Paper would exceed safe integer range") end
	updated.paperMilli, updated.purchasedPaperMilli = paper, purchased
	return immutableResult(updated, { type = "PurchasedPaperAdded", operationID = operationID,
		paperMilli = amountMilli, purchasedPaperMilli = amountMilli, earnedPaperMilli = 0, xpMilli = 0 })
end

return table.freeze(EconomyRules)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ROJO_217">
          <Properties>
            <string name="Name">FlightRules</string>
            <string name="Source">-- Resource and validation rules. Roblox owns movement and collision geometry.
local Rules = {}
local Config = require(script.Parent.Parent.Generated.Gameplay).flight

function Rules.finite(value)
	return type(value) == "number" and value == value and math.abs(value) &lt; math.huge
end
function Rules.vector(value)
	return typeof(value) == "Vector3" and Rules.finite(value.X) and Rules.finite(value.Y) and Rules.finite(value.Z)
end
function Rules.lift(current, maximum, dt)
	return math.clamp(current - math.max(0, dt), 0, maximum)
end
function Rules.fanEntry(wasInside, inside, lastUse, now)
	return inside and not wasInside and now - lastUse &gt;= Config.fan_reuse_seconds
end
function Rules.refill(current, maximum)
 return math.min(maximum, current + Config.fan_lift_restore_seconds)
end
function Rules.limitPitch(direction)
 local limit=math.sin(math.rad(Config.pitch_limit_deg))
 if math.abs(direction.Y)&lt;=limit then return direction end
 local flat=Vector3.new(direction.X,0,direction.Z)
 if flat.Magnitude&lt;.001 then flat=Vector3.new(0,0,-1) end
 return flat.Unit*math.cos(math.rad(Config.pitch_limit_deg))+Vector3.yAxis*math.sign(direction.Y)*limit
end
function Rules.turnDirection(current, desired, radians)
 local angle=math.acos(math.clamp(current:Dot(desired),-1,1))
 if angle&lt;=radians or angle&lt;.0001 then return desired end
 -- Rotate along the shortest arc; a straight reversal turns flat rather than looping.
 local axis=current:Cross(desired)
 if axis.Magnitude&lt;1e-4 then axis=Vector3.yAxis end
 return CFrame.fromAxisAngle(axis.Unit,radians):VectorToWorldSpace(current).Unit
end
-- Mouse-aim autopilot shared by players and scripted pilots: steer the nose toward an aim
-- direction at the loadout's turn rate, easing in near the target so it never overshoots.
-- Banks hard into big turns and levels the wings when the aim sits near the nose.
-- `up` is the pilot's sky direction. Players pass their aim's up, so loops and inverted flight work;
-- without it (bots for now) the world is up and pitch stays within the limit.
-- `yaw` (wings) limits left/right turning and `pitch` (tail) up/down; diagonal turns blend the two.
function Rules.autopilot(heading, bank, aim, yaw, pitch, dt, up)
 if not up then aim=Rules.limitPitch(aim) end
 local sky=up or Vector3.yAxis
 local function frameFor(look)
  local flatUp=sky-look*look:Dot(sky)
  if flatUp.Magnitude&lt;1e-3 then flatUp=look:Cross(math.abs(look.X)&lt;.9 and Vector3.xAxis or Vector3.zAxis):Cross(look) end
  return CFrame.lookAt(Vector3.zero,look,flatUp.Unit)
 end
 local before=frameFor(heading):VectorToObjectSpace(aim)
 local side=math.abs(before.X)/math.max(1e-6,math.sqrt(before.X^2+before.Y^2))
 local turn=math.sqrt((yaw*side)^2+(pitch*math.sqrt(1-side^2))^2)
 local angle=math.acos(math.clamp(heading:Dot(aim),-1,1))
 local step=math.min(math.rad(turn)*dt,angle*(1-math.exp(-Config.autopilot_settle_per_s*dt)))
 heading=Rules.turnDirection(heading,aim,step)
 if not up then heading=Rules.limitPitch(heading) end
 local frame=frameFor(heading)
 local around=frame:VectorToObjectSpace(aim)
 local lateral=around.X/math.max(1e-3,math.sqrt(around.X^2+around.Y^2))
 local target=-lateral*math.clamp(angle/math.rad(Config.autopilot_full_bank_deg),0,1)*math.rad(Config.bank_visual_limit_deg)
 bank+=(target-bank)*(1-math.exp(-Config.bank_response*dt))
 return heading,bank,frame*CFrame.Angles(0,0,bank)
end
-- When the pilot stops steering, roll the aim back toward the sky so diagonal mouse moves don't leave the
-- view tilted. Skipped near straight up or down, where "sky" has no direction.
function Rules.levelAim(frame, dt)
 local look=frame.LookVector
 if math.abs(look.Y)&gt;.95 then return frame end
 local target=(Vector3.yAxis-look*look.Y).Unit
 local up=frame.UpVector
 local angle=math.atan2(up:Cross(target):Dot(look),up:Dot(target))
 local limit=Config.aim_auto_level_per_s*dt
 return CFrame.fromAxisAngle(look,math.clamp(angle,-limit,limit))*frame
end
-- Near a room edge, bend the aim back inside. Returns the aim and whether the pilot was warned.
-- The floor is not an edge: it is a real surface you can scrape or crash into.
function Rules.boundsNudge(position, aim, center, size)
 local margin=Config.bounds_warning_studs
 local warned=false
 for _,axis in ipairs({Vector3.xAxis,Vector3.yAxis,Vector3.zAxis}) do
  local side=math.sign((position-center):Dot(axis))
  if axis==Vector3.yAxis and side&lt;0 then continue end
  local depth=math.abs((position-center):Dot(axis))-(size:Dot(axis)/2-margin)
  local outward=aim:Dot(axis)*side
  if depth&gt;0 and outward&gt;0 then
   -- Swap the outward part of the aim for an inward one that grows toward the wall.
   aim-=axis*side*(outward+math.min(1,depth/margin));warned=true
  end
 end
 return aim.Unit,warned
end
-- Hard turns cost speed: turning at the full rate keeps (1 - turn_speed_bleed) of cruise.
function Rules.turnSpeedFactor(before, after, dt, turn)
 local used=math.acos(math.clamp(before:Dot(after),-1,1))/math.max(1e-6,math.rad(turn)*dt)
 return 1-Config.turn_speed_bleed*math.clamp(used,0,1)
end
function Rules.velocity(direction, speed, lift, updraft)
	if lift &lt;= 0 then
		local horizontal = Vector3.new(direction.X, 0, direction.Z)
		if horizontal.Magnitude &lt; 0.01 then horizontal = Vector3.new(0, 0, -1) end
		return horizontal.Unit * speed * Config.empty_lift_speed_factor
			+ Vector3.new(0, -Config.empty_lift_descent_studs_s + updraft, 0)
	end
	return direction * speed + Vector3.new(0, updraft, 0)
end
-- Does the straight path a-&gt;b cross the world-axis box (centre, size)? Speed power-up holes are boxes measured
-- around each opening, so a plane passing between server checks still counts (slab test).
function Rules.segmentHitsBox(centre, size, a, b)
	local lo, hi, d = 0, 1, b - a
	for _, axis in ipairs({ "X", "Y", "Z" }) do
		local min, max = centre[axis] - size[axis] / 2, centre[axis] + size[axis] / 2
		if math.abs(d[axis]) &lt; 1e-6 then
			if a[axis] &lt; min or a[axis] &gt; max then return false end
		else
			local t1, t2 = (min - a[axis]) / d[axis], (max - a[axis]) / d[axis]
			lo, hi = math.max(lo, math.min(t1, t2)), math.min(hi, math.max(t1, t2))
			if lo &gt; hi then return false end
		end
	end
	return true
end
-- Alan's rule: each power-up adds its bonus and restarts the timer; the time itself never adds up.
function Rules.stackPickup(bonus, untilTime, now, pickups)
	local live = now &lt; untilTime and bonus or 0
	return math.min(live + pickups.speed_bonus, pickups.max_bonus), now + pickups.seconds
end
function Rules.movementAllowed(previous, position, velocity, elapsed, speed)
	if not Rules.vector(position) or not Rules.vector(velocity) then return false end
	local limit = speed * Config.horizontal_fan_speed_factor + 28
	return velocity.Magnitude &lt;= limit * 1.6 and (position - previous).Magnitude &lt;= limit * elapsed + 16
end
function Rules.turnAllowed(previousLook, look, elapsed, turn)
	local angle = math.acos(math.clamp(previousLook:Dot(look), -1, 1))
	return angle &lt;= math.rad(turn) * Config.orientation_angular_headroom * elapsed + math.rad(25)
end
function Rules.climbAllowed(previousY, y, elapsed, updraft)
	return y - previousY &lt;= (updraft - Config.empty_lift_descent_studs_s * 0.5) * elapsed + 6
end
-- Flying into a surface faster than the crash speed (nose-first, side-on) destroys the plane. A shallow
-- scrape or belly slide costs health that grows the longer contact lasts (doubling every few tenths of a second):
-- a quick touch is cheap, a long slide is deadly, and pulling up in time saves the plane.
-- `normalSpeed` is how fast the plane was moving into the surface; `touching` is how long contact has lasted.
function Rules.collisionDamage(normalSpeed, emptyOnFloor, maximum, dt, touching)
	local combat = require(script.Parent.Parent.Generated.Gameplay).combat
	if emptyOnFloor or normalSpeed &gt;= combat.collision_crash_speed then return maximum end
	return maximum * combat.collision_scrape_health_per_second * 2 ^ ((touching or 0) / combat.collision_scrape_doubling_seconds) * dt
end
-- Which solid part a plane's exact-shape Colliders touch, and that surface's outward normal. Shared by the
-- server (damage) and the pilot's client (stops the plane at the surface at once instead of a moment later).
function Rules.contact(model, travel, overlap, single)
	local colliders = model:FindFirstChild("Colliders")
	local body = model:FindFirstChild("Root")
	if not colliders or not body then return nil end
	-- Cheap gate first: anything solid near the flight body at all?
	if #workspace:GetPartBoundsInBox(body.CFrame, body.Size * 1.5, overlap) == 0 then return nil end
	for _, piece in ipairs(colliders:GetChildren()) do
		local touching = workspace:GetPartsInPart(piece, overlap)[1]
		if touching then
			-- The face it entered: look back along the flight path; a side scrape falls back to the nearest surface.
			single.FilterDescendantsInstances = { touching }
			local reach = piece.Size.Magnitude + 10
			local face = workspace:Raycast(piece.Position - travel * reach, travel * reach * 2, single)
			if face then return touching, face.Normal end
			local offset = piece.Position - touching:GetClosestPointOnSurface(piece.Position)
			return touching, offset.Magnitude &gt; .01 and offset.Unit or -travel
		end
	end
	return nil
end
return table.freeze(Rules)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ROJO_218">
          <Properties>
            <string name="Name">MatchRules</string>
            <string name="Source">-- Pure match decisions. No account, wallet, actor mutation or engine queries.
local Rules = {}
Rules.MODES = table.freeze({ "FFA", "TDM", "CONTROL" })
Rules.ACTIVITY_WINDOW_SECONDS = 10
function Rules.finite(n)
    return type(n) == "number" and n == n and math.abs(n) &lt; math.huge
end
function Rules.mode(mode)
    return mode == "FFA" or mode == "TDM" or mode == "CONTROL"
end
function Rules.seedOrder(seed, key)
    local n = 2166136261
    for i = 1, #key do
        n = bit32.bxor(n, string.byte(key, i))
        -- Exact uint32 multiply via 16-bit limbs, safe in a double.
        n = ((n % 65536) * 403 + (math.floor(n / 65536) * 403 + (n % 65536) * 256) * 65536) % 4294967296
    end
    n = bit32.bxor(n, seed % 4294967296)
    for _ = 1, 3 do
        n = bit32.bxor(n, bit32.lshift(n, 13))
        n = bit32.bxor(n, bit32.rshift(n, 17))
        n = bit32.bxor(n, bit32.lshift(n, 5))
    end
    return n
end
function Rules.chooseMode(votes, lastPlayed, seed)
    local counts, highest = {}, 0
    for _, mode in ipairs(Rules.MODES) do counts[mode] = 0 end
    for _, mode in pairs(votes) do
        if counts[mode] then counts[mode] += 1; highest = math.max(highest, counts[mode]) end
    end
    local candidates, oldest = {}, math.huge
    for _, mode in ipairs(Rules.MODES) do
        local last = lastPlayed[mode] or 0
        if counts[mode] == highest then
            if last &lt; oldest then candidates, oldest = {}, last end
            if last == oldest then table.insert(candidates, mode) end
        end
    end
    table.sort(candidates)
    return candidates[Rules.seedOrder(seed, "mode-vote") % #candidates + 1]
end
function Rules.inZone(position, rounds)
    if typeof(position) ~= "Vector3" then return false end
    if not Rules.finite(position.X) or not Rules.finite(position.Y) or not Rules.finite(position.Z) then return false end
    local c = rounds.control_center
    return math.abs(position.Y - c[2]) &lt;= rounds.control_half_height
        and (position.X - c[1])^2 + (position.Z - c[3])^2 &lt;= rounds.control_radius^2
end
function Rules.captureEligible(sample, rounds)
    return sample ~= nil and sample.state == "FLYING" and sample.protected == false
        and sample.eligible == true and sample.practice ~= true
        and Rules.inZone(sample.position, rounds)
end
function Rules.activeEligible(sample)
    return sample ~= nil and sample.eligible == true and sample.practice ~= true
        and (sample.state == "FLYING" or sample.state == "LANDING" or sample.state == "SERVICING")
end
function Rules.qualified(p, seconds, events)
    return p.activeSeconds &gt;= seconds and p.qualifyingEvents &gt;= events
end
function Rules.podium(records, seed)
    local ordered = {}
    for _, p in pairs(records) do table.insert(ordered, p) end
    table.sort(ordered, function(a, b)
        for _, field in ipairs({ "contribution", "kills", "assists" }) do
            if a[field] ~= b[field] then return a[field] &gt; b[field] end
        end
        if a.deaths ~= b.deaths then return a.deaths &lt; b.deaths end
        local x, y = Rules.seedOrder(seed, a.key), Rules.seedOrder(seed, b.key)
        return x &lt; y or x == y and a.key &lt; b.key
    end)
    return ordered
end
return table.freeze(Rules)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ROJO_219">
          <Properties>
            <string name="Name">MathUtil</string>
            <string name="Source">--!strict
local MathUtil = {}
function MathUtil.isFinite(value: any): boolean
    return type(value) == "number" and value == value and value &gt; -math.huge and value &lt; math.huge
end
function MathUtil.isInteger(value: any, minimum: number, maximum: number): boolean
    return MathUtil.isFinite(value) and value % 1 == 0 and value &gt;= minimum and value &lt;= maximum
end
function MathUtil.isFiniteVector(value: any, componentLimit: number?): boolean
    if typeof(value) ~= "Vector3" then return false end
    local limit = componentLimit or math.huge
    return MathUtil.isFinite(value.X) and MathUtil.isFinite(value.Y) and MathUtil.isFinite(value.Z)
        and math.abs(value.X) &lt;= limit and math.abs(value.Y) &lt;= limit and math.abs(value.Z) &lt;= limit
end
function MathUtil.unitDirection(value: any): Vector3?
    if not MathUtil.isFiniteVector(value, 1) then return nil end
    local length = value.Magnitude
    if length &lt; 0.001 or length &gt; 1.001 then return nil end
    return value / length
end
function MathUtil.copy(value: any): any
    if type(value) ~= "table" then return value end
    local seen = {}
    local function clone(item: any): any
        if type(item) ~= "table" then return item end
        if seen[item] then return seen[item] end
        local output = {}
        seen[item] = output
        for key, child in pairs(item) do output[clone(key)] = clone(child) end
        return output
    end
    return clone(value)
end
return table.freeze(MathUtil)
</string>
          </Properties>
