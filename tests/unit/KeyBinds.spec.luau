local KeyBinds=require(game.ReplicatedStorage.FlyFightPaper.Shared.KeyBinds)
local Suite=require(script.Parent.Parent.fixtures.Suite)
local Spec={}
function Spec.run()
 local result,test=Suite.new()
 test("no saved keys means the game's keys",function()
  local keys=KeyBinds.current(nil)
  assert(keys.boost=="LeftShift" and keys.brake=="Space" and keys.gotIt=="Space" and KeyBinds.valid(nil))
 end)
 test("a new key sticks and the others keep theirs",function()
  local keys=KeyBinds.set(nil,"boost","E")
  assert(keys.boost=="E" and keys.brake=="Space" and keys.gotIt=="Space" and KeyBinds.valid(keys))
 end)
 test("taking the other flight key swaps the two",function()
  local keys=KeyBinds.set(nil,"boost","Space")
  assert(keys.boost=="Space" and keys.brake=="LeftShift" and KeyBinds.valid(keys))
  keys=KeyBinds.set(keys,"brake","Space")
  assert(keys.brake=="Space" and keys.boost=="LeftShift")
 end)
 test("Got it can share a key without moving Boost or Brake",function()
  local keys=KeyBinds.set(nil,"gotIt","LeftShift")
  assert(keys.gotIt=="LeftShift" and keys.boost=="LeftShift" and keys.brake=="Space" and KeyBinds.valid(keys))
 end)
 test("Esc, Enter, Tab, digits, K and R can't be chosen",function()
  for _,key in {"Escape","Return","Tab","One","Five","K","R","F9","Slash"} do assert(not KeyBinds.name(key),key) end
  assert(KeyBinds.name("LeftControl")=="Ctrl" and KeyBinds.name("Q")=="Q")
 end)
 test("the save check takes only the three actions, keys on offer, Boost and Brake apart",function()
  assert(KeyBinds.valid({}) and KeyBinds.valid({brake="E"}))
  assert(not KeyBinds.valid({jump="E"}) and not KeyBinds.valid({brake="Escape"}) and not KeyBinds.valid({brake=7}) and not KeyBinds.valid("E"))
  assert(not KeyBinds.valid({boost="Space"}) and not KeyBinds.valid({boost="E",brake="E"}))
 end)
 return result
end
return Spec
