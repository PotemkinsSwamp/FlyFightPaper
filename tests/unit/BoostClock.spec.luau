local Shared = game:GetService("ReplicatedStorage"):WaitForChild("FlyFightPaper").Shared
local Clock = require(Shared.BoostClock)
local Suite = require(script.Parent.Parent.fixtures.Suite)
local Spec = {}
local function state(p, x)
    return { paperSeconds = p or 0, xpSeconds = x or 0, permanentPaper = false, permanentXP = false }
end
function Spec.run()
    local output, test = Suite.new()
    test("CM03 both timers consume online900, pause24h offline and resume", function()
        local clock = Clock.new(state(1800,1800),0,true)
        assert(clock:advance(900,false))
        assert(clock:advance(900+86400,true))
        assert(clock:snapshot().paperSeconds==900 and clock:snapshot().xpSeconds==900)
        assert(clock:advance(900+86400+100,true))
        assert(clock:snapshot().paperSeconds==800)
    end)
    test("loaded menus consume; loading and recovery intervals reject earning and pause", function()
        local c=Clock.new(state(100,100),10,false)
        assert(c:advance(30,true)); assert(c:snapshot().paperSeconds==100)
        assert(c:advance(40,false)); assert(c:snapshot().paperSeconds==90)
        assert(c:advance(80,true)); assert(c:snapshot().paperSeconds==90)
        assert(c:multipliersAt(50)==nil and c:multipliersAt(35).paper==2)
    end)
    test("CM04 repeated five-hour grants extend beyond largest single product", function()
        local c=Clock.new(state(),0,true)
        assert(c:grantVerifiedTemporary("xp",18000,0));assert(c:grantVerifiedTemporary("xp",18000,0))
        assert(c:snapshot().xpSeconds==36000 and c:snapshot().paperSeconds==0)
        assert(c:capture().xp==2 and c:capture().paper==1)
    end)
    test("CM05 independent expiration captures historical event multipliers", function()
        local c=Clock.new(state(10,20),0,true);assert(c:advance(30,true))
        assert(c:multipliersAt(5).paper==2 and c:multipliersAt(5).xp==2)
        assert(c:multipliersAt(10).paper==1 and c:multipliersAt(10).xp==2)
        assert(c:multipliersAt(20).paper==1 and c:multipliersAt(20).xp==1)
        assert(c:capture().paper==1)
    end)
    test("CM06 permanent upgrade preserves dormant time including in-flight grant", function()
        local c=Clock.new(state(1800,1800),0,true)
        assert(c:grantVerifiedPermanent("paper",100));assert(not c:canOfferTemporary("paper"))
        assert(c:grantVerifiedTemporary("paper",900,100));assert(c:advance(200,true))
        assert(c:snapshot().paperSeconds==2600 and c:snapshot().xpSeconds==1600)
        assert(c:capture().paper==2 and c:capture().xp==2)
        assert(c:grantVerifiedPermanent("paper",200));assert(c:snapshot().paperSeconds==2600)
    end)
    test("same-time grant/reward ordering requires occurrence capture", function()
        local c=Clock.new(state(),0,true);assert(c:advance(5,true))
        local before=c:capture();assert(c:grantVerifiedTemporary("paper",900,5));local after=c:capture()
        assert(before.paper==1 and after.paper==2 and before.revision<after.revision)
        local missing,why=c:multipliersAt(5);assert(missing==nil and why=="ambiguous_event_order")
    end)
    test("PS04 restore starts at current time without charging unknown offline gap", function()
        local c=Clock.new(state(1800,1800),0,true);assert(c:advance(30,true));local saved=c:snapshot()
        assert(c:advance(49,true)) -- crash loses19s since checkpoint, explicitly recoverable replay exposure
        local recovered=Clock.new(saved,86400,true);assert(recovered:snapshot().paperSeconds==1770)
        assert(recovered:advance(86400.25,true));assert(recovered:snapshot().paperSeconds==1769.75)
    end)
    test("history pressure rejects mutation until durable watermark permits pruning", function()
        local c=Clock.new(state(),0,true,{historyLimit=3})
        for n=1,3 do assert(c:grantVerifiedTemporary("paper",1,0)) end
        local before=c:snapshot();local ok,why=c:grantVerifiedTemporary("paper",1,8)
        assert(not ok and why=="history_backpressure" and c:snapshot().paperSeconds==before.paperSeconds)
        assert(c:pruneThrough(c.now));assert(c:grantVerifiedTemporary("paper",1,8))
        assert(c:multipliersAt(0)==nil)
    end)
    test("snapshots immutable and malformed clocks/grants rejected without state corruption", function()
        local original=state(10,20);local c=Clock.new(original,0,true)
        original.paperSeconds=999;assert(c:snapshot().paperSeconds==10)
        assert(not c:advance(-1,true));assert(not c:advance(0/0,true))
        assert(not c:grantVerifiedTemporary("paper",-1,0));assert(not c:grantVerifiedTemporary("other",900,0))
        assert(not c:grantVerifiedTemporary("paper",1.5,0));assert(c:snapshot().paperSeconds==10)
        assert(not pcall(function() c:snapshot().paperSeconds=1 end))
    end)
    test("interval saturation preserves clock and balances until safe pruning", function()
        local c=Clock.new(state(10,20),0,true,{historyLimit=3})
        assert(c:advance(30,false))
        local ok,why=c:advance(31,false)
        assert(not ok and why=="history_backpressure" and c.now==30)
        assert(c:multipliersAt(5).paper==2 and c:snapshot().xpSeconds==0)
        assert(c:pruneThrough(30));assert(c:advance(31,false))
        assert(c:multipliersAt(5)==nil and c:capture()==nil)
    end)
    test("overflow and sub-clock precision fail closed without losing value", function()
        local c=Clock.new(state(9007199254740991,0),0,true)
        assert(not c:grantVerifiedTemporary("paper",1,0))
        assert(c:snapshot().paperSeconds==9007199254740991)
        local fine=Clock.new(state(0.00000001,0),1000000000000,true)
        local ok,why=fine:advance(1000000000001,true)
        assert(not ok and why=="clock_precision")
        assert(fine.now==1000000000000 and fine:snapshot().paperSeconds==0.00000001)
    end)
    test("fractional start consumes selected expiry exactly without a precision residue", function()
        for _, start in ipairs({0.8, 123.8, 1000.8}) do
            local c=Clock.new(state(2,3),start,true)
            assert(c:advance(start+4,true))
            assert(c:snapshot().paperSeconds==0 and c:snapshot().xpSeconds==0)
            assert(c:multipliersAt(start+1).paper==2)
            assert(c:multipliersAt(start+2).paper==1 and c:multipliersAt(start+2).xp==2)
            assert(c:multipliersAt(start+3).xp==1)
        end
    end)
    test("fractional expiry remains ordered with paused intervals and simultaneous resources", function()
        local c=Clock.new(state(2,2),0.8,true)
        assert(c:advance(1.8,false));local saved=c:snapshot()
        assert(c:advance(20.8,true));assert(c:snapshot().paperSeconds==saved.paperSeconds)
        assert(c:advance(24.8,true));assert(c:snapshot().paperSeconds==0 and c:snapshot().xpSeconds==0)
        assert(c:multipliersAt(21).paper==2 and c:multipliersAt(22).paper==1)
        assert(c:multipliersAt(10)==nil)
    end)
    return output
end
return Spec
